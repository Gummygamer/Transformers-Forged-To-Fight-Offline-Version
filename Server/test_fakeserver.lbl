  resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"2.1.1-0\"\}")
  let revisit: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/0/0", "")
  fakeserver.dynamic("/quests/quest-begin/2.1.1", "\{\}")
  let after_rebegin: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/0/0", "")
  let starscream: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "")
  length(jsonout.list_items(jsonout.obj_get(result(revisit), "results"))) == 1 and length(jsonout.list_items(jsonout.obj_get(result(after_rebegin), "results"))) == 1 and current_battle_id(revisit) == "" and current_battle_state(revisit) == "" and current_battle_id(after_rebegin) == "" and current_battle_state(after_rebegin) == "" and pos_x(starscream) == 2 and jsonout.as_text(jsonout.obj_get(jsonout.obj_get(battle(starscream), "battleEnemy"), "key")) == "fte_stars_gs_t3"
end

