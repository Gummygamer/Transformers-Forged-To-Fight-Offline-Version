  intent: test
  fakeserver.dynamic("/some/unknown/path", "") == ""
end

function test_userprofile_returns_local_profile_without_capturing_bulk_or_find_part1(session: Session, profile: Json, prefixed: Json, level_rewards: Json, stat_level: integer, reward_level: integer): boolean
  intent: test
  jsonout.as_text(jsonout.obj_get(profile, "uid")) == "1000000000002" and jsonout.as_text(jsonout.obj_get(profile, "name")) == session.name and jsonout.as_text(jsonout.obj_get(prefixed, "name")) == session.name and stat_level == fakeserver.account_level() and reward_level == fakeserver.account_level() and stat_level == reward_level and jsonout.type_name(level_rewards) == "object" and jsonout.as_bool(jsonout.obj_get(level_rewards, "enabled")) and jsonout.as_bool(jsonout.obj_get(level_rewards, "isEnabled")) and jsonout.type_name(jsonout.obj_get(level_rewards, "types")) == "list"
end

function test_userprofile_returns_local_profile_without_capturing_bulk_or_find_part2(): boolean
  intent: test
  fakeserver.dynamic("/userprofile/bulk", "\{\}") == "" and fakeserver.dynamic("/userprofile/find", "\{\}") == ""
end

function test_userprofile_returns_local_profile_without_capturing_bulk_or_find(): boolean
  intent: test
  let session: Session = fakeserver.ensure_session("userprofile-test", "Profile Commander")
  let profile: Json = result(fakeserver.dynamic("/userprofile/?stoken=" ++ session.stoken, "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}"))
  let prefixed: Json = result(fakeserver.dynamic("/prod/userprofile/?stoken=" ++ session.stoken, "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}"))
  let stats: Json = jsonout.obj_get(profile, "gameIntStats")
  let level_rewards: Json = jsonout.obj_get(profile, "levelRewards")
  let stat_level: integer = jsonout.as_int(jsonout.obj_get(stats, "level"))
  let reward_level: integer = jsonout.as_int(jsonout.obj_get(level_rewards, "level"))
  let ok_1: boolean = test_userprofile_returns_local_profile_without_capturing_bulk_or_find_part1(session, profile, prefixed, level_rewards, stat_level, reward_level)
  let ok_2: boolean = ok_1 and test_userprofile_returns_local_profile_without_capturing_bulk_or_find_part2()
  ok_2
end

function test_tutorial_branches_block_live_and_complete(): boolean
  intent: test
  let blocked: text = fakeserver.dynamic("/tutorial/start-tutorial", "\{\"tid\":\"ShieldTutorial\"\}")
  let live: text = fakeserver.dynamic("/tutorial/start-branch", "\{\"tid\":\"FTE\",\"bid\":\"x\"\}")
  let complete: text = fakeserver.dynamic("/tutorial/complete-tutorial", "\{\"tid\":\"FTE\"\}")
  blocked == "\{\"err\": \"unavailable\", \"error\": \"unavailable\", \"retry\": false, \"fatal\": false, \"result\": \{\}\}" and contains_text(live, "\"s\": \"started\"") and contains_text(complete, "\"s\": \"completed\"") and fakeserver.dynamic("/tutorial/start-tutorial", "") == ""
end

function test_tutorial_login_starts_intro_once_then_reports_complete(): boolean
  intent: test
  fakeserver.reset_tutorial_login()
  let first: Json = jsonout.obj_get(result(fakeserver.dynamic("/tutorial/get-login-data", "")), "FTE")
  let first_branches: Json = jsonout.obj_get(first, "branches")
  let second: Json = jsonout.obj_get(result(fakeserver.dynamic("/tutorial/get-login-data", "")), "FTE")
  jsonout.as_int(jsonout.obj_get(first, "s")) == 1 and jsonout.as_text(jsonout.obj_get(first, "current_bid")) == "FTEIntroQuest" and jsonout.as_int(jsonout.obj_get(jsonout.obj_get(first_branches, "FTEIntroQuest"), "s")) == 1 and jsonout.as_int(jsonout.obj_get(second, "s")) == 2 and jsonout.as_text(jsonout.obj_get(second, "current_bid")) == "FTEComplete"
end

