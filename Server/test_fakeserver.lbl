  intent: test
  jsonout.as_int(jsonout.obj_get(pos, "x")) == gamedata.quest_start_x_for(gamedata.challenge_qid()) and jsonout.as_int(jsonout.obj_get(pos, "y")) == gamedata.quest_start_y_for(gamedata.challenge_qid()) and jsonout.as_bool(jsonout.obj_get(tile, "walkable")) and not jsonout.as_bool(jsonout.obj_get(tile, "hidden")) and jsonout.as_bool(jsonout.obj_get(tile, "start"))
end

function test_challenge_begin_uses_authored_start_on_first_entry(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  let begun: Json = result(fakeserver.dynamic("/quests/quest-begin/1.1.2", ""))
  let active: Json = jsonout.obj_get(jsonout.obj_get(begun, "activeQuests"), gamedata.challenge_qid())
  let instance: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(active, "instances")), 0), jsonout.json_obj([]))
  let pos: Json = jsonout.obj_get(instance, "currentPos")
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(jsonout.obj_get(active, "map"), "grid"))
  let row: Json = unwrap_or(get(grid, gamedata.quest_start_x_for(gamedata.challenge_qid())), jsonout.json_list([]))
  let tile: Json = unwrap_or(get(jsonout.list_items(row), gamedata.quest_start_y_for(gamedata.challenge_qid())), jsonout.json_obj([]))
  let ok_1: boolean = test_challenge_begin_uses_authored_start_on_first_entry_part1(pos, tile)
  ok_1
end

function test_pending_bludgeon_survives_reentry_and_reaches_starscream(): boolean
  intent: test
  let selected: a list of text = ["megatron_cin_rotf", "grimlock_gs_mp08"]
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/bcg/setSavedTeam", "\{\"heroes\":[\"megatron_cin_rotf\",\"grimlock_gs_mp08\"]\}")
  fakeserver.dynamic("/quests/quest-begin/2.1.1", "\{\}")
  let first: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "")
  fakeserver.dynamic("/quests/quest-begin/2.1.1", "\{\}")
  let replay: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"2.1.1-0\"\}")
  let starscream: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "")
  current_battle_id(first) == "bludgeon_gs_rd20" and current_battle_id(replay) == "bludgeon_gs_rd20" and current_battle_id(starscream) == "fte_stars_gs_t3" and fakeserver.get_saved_team() == selected
end

