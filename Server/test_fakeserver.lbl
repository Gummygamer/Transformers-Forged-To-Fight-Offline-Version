  intent: test
  fakeserver.reset_tutorial_login()
  fakeserver.reset_quest_positions()
  let intro: Json = jsonout.obj_get(result(fakeserver.dynamic("/tutorial/get-login-data", "")), "FTE")
  let active_result: Json = result(fakeserver.resolve_response("GET", "/quests/quest-active?categories.0=PvE").body)
  jsonout.as_int(jsonout.obj_get(intro, "s")) == 1 and jsonout.as_text(jsonout.obj_get(intro, "current_bid")) == "FTEIntroQuest" and jsonout.type_name(active_result) == "list" and length(jsonout.list_items(active_result)) == 0
end

function test_custom_story_set_is_first_without_removing_template_set(): boolean
  intent: test
  let sets: a list of Json = jsonout.list_items(result(fakeserver.resolve_response("GET", "/quests/quest-list").body))
  let first: Json = unwrap_or(get(sets, 0), jsonout.json_obj([]))
  mutable template_found: boolean = false
  mutable act3_found: boolean = false
  for quest_set in sets do
    if jsonout.as_text(jsonout.obj_get(quest_set, "setId")) == "story_act1" then set template_found = true end
    if jsonout.as_text(jsonout.obj_get(quest_set, "setId")) == gamedata.custom_story_set_id() then
      for quest in jsonout.list_items(jsonout.obj_get(quest_set, "availableQuests")) do
        if jsonout.as_text(jsonout.obj_get(quest, "id")) == gamedata.custom_story_act3_qid() and jsonout.as_text(jsonout.obj_get(quest, "image")) == "bludge_gs" then set act3_found = true end
      end
    end
  end
  jsonout.as_text(jsonout.obj_get(first, "setId")) == "custom_story_act1" and jsonout.as_text(jsonout.obj_get(first, "category")) == "Story" and template_found and act3_found
end

function quest_slot_ok(quest: Json, set_id: text, act_count: integer, chapter_counts: a list of Json): boolean
  intent: check one quest against the summary tables of its set
  let qid: text = jsonout.as_text(jsonout.obj_get(quest, "id"))
  let act: integer = jsonout.as_int(jsonout.obj_get(quest, "act"))
  let chapter: integer = jsonout.as_int(jsonout.obj_get(quest, "chapter"))
  let mission: integer = jsonout.as_int(jsonout.obj_get(quest, "mission"))
  let chapter_cap: integer = jsonout.as_int(unwrap_or(get(chapter_counts, act), jsonout.json_int(0)))
  let summary: Json = gamedata.build_quest_summary(qid, set_id)
  not (act < 1 or act > act_count or chapter < 1 or mission < 1) and chapter <= chapter_cap and jsonout.as_int(jsonout.obj_get(summary, "act")) == act and jsonout.as_int(jsonout.obj_get(summary, "chapter")) == chapter and jsonout.as_int(jsonout.obj_get(summary, "mission")) == mission
end

function quest_set_slots_ok(quest_set: Json): boolean
  intent: check every quest of a set against the summary tables of that set
  let act_count: integer = jsonout.as_int(jsonout.obj_get(quest_set, "actCount"))
  let chapter_counts: a list of Json = jsonout.list_items(jsonout.obj_get(quest_set, "chapterCount"))
  let set_id: text = jsonout.as_text(jsonout.obj_get(quest_set, "setId"))
  mutable ok: boolean = length(chapter_counts) == act_count + 1
  for quest in jsonout.list_items(jsonout.obj_get(quest_set, "availableQuests")) do
    let quest_ok: boolean = quest_slot_ok(quest, set_id, act_count, chapter_counts)
    set ok = ok and quest_ok
  end
  ok
end

function test_quest_list_slots_fit_client_summary_tables(): boolean
  intent: test
  -- Legacy.QuestSet.BuildSummaryTable gives each set actCount + 1 act slots and
  -- indexes every summary by its act/chapter/mission fields. A quest that points
  -- outside its own set's tables throws IndexOutOfRangeException while the quest
  -- list is parsed, which closes the client right after login.
  let sets: a list of Json = jsonout.list_items(result(fakeserver.resolve_response("GET", "/quests/quest-list").body))
  mutable ok: boolean = length(sets) > 0
  for quest_set in sets do
    let set_ok: boolean = quest_set_slots_ok(quest_set)
    set ok = ok and set_ok
  end
  ok
end

function test_movedir_walks_full_board_after_wins(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  mutable row: integer = 1
  mutable good: boolean = true
  while row < gamedata.quest_dim() do
  let moved: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  if pos_x(moved) != row or jsonout.as_int(jsonout.obj_get(move_to(moved), "x")) != row or jsonout.as_int(jsonout.obj_get(battle(moved), "x")) != row then set good = false end
  resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}")
  set row = row + 1
end
  let final_move: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  good and pos_x(final_move) == gamedata.quest_dim() - 1 and jsonout.as_int(jsonout.obj_get(move_to(final_move), "x")) == gamedata.quest_dim() - 1
end

function test_lost_replays_pending_battle(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"LOST\"\},\"qid\":\"1.1.1-0\"\}")
  let replay: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  pos_x(replay) == 1 and jsonout.as_int(jsonout.obj_get(move_to(replay), "x")) == 1 and jsonout.as_int(jsonout.obj_get(battle(replay), "x")) == 1 and current_battle_id(replay) == gamedata.minion_blueprint() and current_battle_state(replay) == "activated"
end

