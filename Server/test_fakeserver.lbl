end

function test_resolve_response_prefers_canned_then_rule_then_default(): boolean
  intent: test
  fakeserver.resolve_response("POST", "/auth/login").source == "canned POST__auth_login.json" and fakeserver.resolve_response("GET", "/auth/login").source == "default" and fakeserver.resolve_response("GET", "/bcg/getUserData").source == "canned GET__bcg_getUserData.json" and fakeserver.resolve_response("GET", "/autorefresh/somegroup/refresh").source == "rule /autorefresh/ -> _autorefresh.json" and fakeserver.resolve_response("GET", "/nope/nope").body == "\{\"error\":null,\"result\":\{\}\}"
end

function test_encode_spacing_matches_python(): boolean
  intent: test
  let value: Json = jsonout.json_obj([jsonout.json_pair("a", jsonout.json_list([jsonout.json_int(1), jsonout.json_int(2)])), jsonout.json_pair("b", jsonout.json_obj([jsonout.json_pair("c", jsonout.json_bool(true))]))])
  jsonout.encode_compact(value) == "\{\"a\":[1,2],\"b\":\{\"c\":true\}\}" and jsonout.encode_spaced(value) == "\{\"a\": [1, 2], \"b\": \{\"c\": true\}\}"
end

function test_login_reports_arena_capable_account_level(): boolean
  intent: test
  let dynamic_user: Json = jsonout.obj_get(result(fakeserver.dynamic("/auth/login", "\{\}")), "user")
  let canned_user: Json = jsonout.obj_get(result(fakeserver.resolve_response("POST", "/auth/login").body), "user")
  let level: integer = jsonout.as_int(jsonout.obj_get(dynamic_user, "level"))
  level == fakeserver.account_level() and level >= 10 and jsonout.as_int(jsonout.obj_get(canned_user, "level")) == level
end

function test_ave_event_and_difficulty_sets_are_served_part1(event_ok: boolean, normal: boolean, heroic: boolean, master: boolean): boolean
  intent: test
  event_ok and normal and heroic and master
end

record Difficulties
  normal: boolean
  heroic: boolean
  master: boolean
end

function ave_event_ok(events: Json): boolean
  intent: check the offline AvE operation event
  mutable event_ok: boolean = false
  for event in jsonout.list_items(events) do
    if jsonout.as_text(jsonout.obj_get(event, "_id")) == "offline_ave_operation" then
      let names: Json = jsonout.obj_get(event, "quest_sets")
      set event_ok = jsonout.as_text(jsonout.obj_get(event, "eventtype")) == "ave" and length(jsonout.list_items(names)) == 3
    end
  end
  event_ok
end

function ave_difficulties(sets: Json): Difficulties
  intent: find which AvE difficulties are served with quests
  mutable normal: boolean = false
  mutable heroic: boolean = false
  mutable master: boolean = false
  for quest_set in jsonout.list_items(sets) do
    let group: text = jsonout.as_text(jsonout.obj_get(quest_set, "group"))
    let category: text = jsonout.as_text(jsonout.obj_get(quest_set, "category"))
    let difficulty: text = jsonout.as_text(jsonout.obj_get(quest_set, "difficulty"))
    let present: boolean = length(jsonout.list_items(jsonout.obj_get(quest_set, "availableQuests"))) > 0
    if group == "offline_ave_operation" and category == "ave" and present then
      if difficulty == "normal" then set normal = true end
      if difficulty == "heroic" then set heroic = true end
      if difficulty == "master" then set master = true end
    end
  end
  Difficulties { normal: normal, heroic: heroic, master: master }
end

function test_ave_event_and_difficulty_sets_are_served(): boolean
  intent: test
  let events: Json = jsonout.obj_get(result(fakeserver.resolve_response("GET", "/events/refresh").body), "events")
  let sets: Json = result(fakeserver.resolve_response("GET", "/quests/quest-list").body)
  let event_ok: boolean = ave_event_ok(events)
  let difficulties: Difficulties = ave_difficulties(sets)
  let ok_1: boolean = test_ave_event_and_difficulty_sets_are_served_part1(event_ok, difficulties.normal, difficulties.heroic, difficulties.master)
  ok_1
end

function test_ave_profile_and_alliance_refresh_are_consistent(): boolean
  intent: test
  let session: Session = fakeserver.ensure_session("ave-alliance-test", "Alliance Commander")
  let profile: Json = result(fakeserver.dynamic("/userprofile/?stoken=" ++ session.stoken, ""))
  let refreshed: Json = result(fakeserver.dynamic("/alliances/refresh?stoken=" ++ session.stoken, ""))
  let profile_alliance: Json = jsonout.obj_get(profile, "alliance")
  jsonout.as_text(jsonout.obj_get(profile, "aid")) == "offline-alliance" and jsonout.as_text(jsonout.obj_get(profile_alliance, "aid")) == "offline-alliance" and jsonout.as_text(jsonout.obj_get(refreshed, "aid")) == "offline-alliance" and length(jsonout.list_items(jsonout.obj_get(refreshed, "members"))) == 1
end

function test_auth_login_data_populates_alliance_manager_contract(): boolean
  intent: test
  let data: Json = result(fakeserver.resolve_response("POST", "/auth/login").body)
  let alliance: Json = jsonout.obj_get(data, "alliance")
  let config: Json = jsonout.obj_get(data, "config")
  let set_data: Json = jsonout.obj_get(data, "set")
  let members: Json = jsonout.obj_get(alliance, "members")
  let local_member: Json = unwrap_or(get(jsonout.list_items(members), 0), jsonout.json_obj([]))
  jsonout.as_text(jsonout.obj_get(alliance, "aid")) == "offline-alliance" and length(jsonout.list_items(members)) == 1 and jsonout.as_text(jsonout.obj_get(local_member, "rank")) == "leader" and jsonout.type_name(jsonout.obj_get(config, "ranks")) == "object" and jsonout.type_name(set_data) == "object"
end

