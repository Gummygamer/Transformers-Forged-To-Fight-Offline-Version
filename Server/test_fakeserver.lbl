function main(): nothing
  intent: run
  mutable failed: integer = 0
  set failed = failed + main_group_1()
  set failed = failed + main_group_2()
  set failed = failed + main_group_3()
  set failed = failed + main_group_4()
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  print(to_text(28 - failed) ++ " passed, " ++ to_text(failed) ++ " failed")
  if failed > 0 then
  exit_process(1)
end
end

main()
