end

function custom_story_begin_user(body: text): Json
  intent: begin the custom story quest and read the local user from the new instance
  let begun: Json = result(fakeserver.dynamic("/quests/quest-begin/2.1.1", body))
  let active: Json = jsonout.obj_get(jsonout.obj_get(begun, "activeQuests"), "2.1.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(active, "instances")), 0), jsonout.json_obj([]))
  jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(instance, "progression"), "users"), gamedata.local_uid())
end

function test_custom_story_begin_without_team_preserves_saved_squad_across_navigation_and_reentry(): boolean
  intent: test
  let selected: a list of text = ["megatron_cin_rotf", "grimlock_gs_mp08"]
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/2.1.1", "\{\}")
  let empty_fallback_ok: boolean = fakeserver.get_saved_team() == gamedata.default_team()
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/bcg/setSavedTeam", "\{\"teamID\":\"0\",\"heroes\":[\"megatron_cin_rotf\",\"grimlock_gs_mp08\"]\}")
  let user: Json = custom_story_begin_user("\{\"setId\":\"custom_story_act1\"\}")
  let moved: Json = result(fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "\{\}"))
  let moved_team: Json = jsonout.obj_get(moved, "teamData")
  let reentered_user: Json = custom_story_begin_user("\{\}")
  let ok_1: boolean = test_custom_story_begin_without_team_preserves_saved_squad_across_navigation_and_reentry_part1(selected, empty_fallback_ok, user, moved_team, reentered_user)
  ok_1
end

