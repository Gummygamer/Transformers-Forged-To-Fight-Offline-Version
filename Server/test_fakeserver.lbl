use fakeserver
use jsonout
use gamedata

function report(name: text, passed: boolean): integer
  intent: print
  if passed then
  print("[ok] " ++ name)
  0
else
  print("[!] " ++ name)
  1
end
end

function response(body: text): Json
  intent: parse
  jsonout.parse_json(body)
end

function result(body: text): Json
  intent: get
  jsonout.obj_get(response(body), "result")
end

function object_keys(node: Json): a list of text
  intent: get
  match node
  when JObj { pairs } then 
    mutable keys: a list of text = []
    for pair in pairs do
      set keys = append(keys, pair.k)
    end
    keys
  otherwise then
    []
end
end

function hero_bids(node: Json): a list of text
  intent: get
  mutable bids: a list of text = []
  for hero in jsonout.list_items(node) do
    set bids = append(bids, jsonout.as_text(jsonout.obj_get(hero, "bid")))
  end
  bids
end

function current_pos(body: text): Json
  intent: get
  jsonout.obj_get(jsonout.obj_get(result(body), "progression"), "currentPos")
end

function move_to(body: text): Json
  intent: get
  let results: Json = jsonout.obj_get(result(body), "results")
  jsonout.obj_get(jsonout.obj_get(unwrap_or(get(jsonout.list_items(results), 0), jsonout.json_obj([])), "action"), "moveto")
end

function battle(body: text): Json
  intent: get
  let results: Json = jsonout.obj_get(result(body), "results")
  jsonout.obj_get(jsonout.obj_get(unwrap_or(get(jsonout.list_items(results), 1), jsonout.json_obj([])), "action"), "battle")
end

function current_battle_id(body: text): text
  intent: get
  jsonout.as_text(jsonout.obj_get(jsonout.obj_get(result(body), "progression"), "currentBattleId"))
end

function current_battle_state(body: text): text
  intent: get
  let users: Json = jsonout.obj_get(jsonout.obj_get(result(body), "progression"), "users")
  jsonout.as_text(jsonout.obj_get(jsonout.obj_get(users, gamedata.local_uid()), "currentBattleState"))
end

function pos_x(body: text): integer
  intent: get
  jsonout.as_int(jsonout.obj_get(current_pos(body), "x"))
end

function resolve(body: text): text
  intent: resolve
  fakeserver.dynamic("/matches/resolve-match/quests_fight", body)
end

function test_set_saved_team_updates_active_team_and_remembered_quest_squad(): boolean
  intent: test
  let team: a list of text = ["optimusprime_cin_tf", "optimusprimal_bw_mp32", "megatron_gs_leader2015", "grimlock_gs_mp08", "megatron_cin_rotf"]
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  let saved: Json = result(fakeserver.dynamic("/bcg/setSavedTeam", "\{\"teamID\":\"0\",\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\",\"megatron_gs_leader2015\",\"grimlock_gs_mp08\",\"megatron_cin_rotf\"]\}"))
  let updates: Json = jsonout.obj_get(saved, "updates")
  let active: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(updates, "activeTeams")), 0), jsonout.json_obj([]))
  let refreshed: Json = result(fakeserver.dynamic("/bcg/getUserData", ""))
  let refresh_updates: Json = jsonout.obj_get(refreshed, "updates")
  let saved_team: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(refresh_updates, "savedTeams")), 0), jsonout.json_obj([]))
  let begun: Json = result(fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\",\"tm2\":\"megatron_gs_leader2015\",\"tm3\":\"grimlock_gs_mp08\",\"tm4\":\"megatron_cin_rotf\"\}"))
  let active_quest: Json = jsonout.obj_get(jsonout.obj_get(begun, "activeQuests"), "1.1.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(active_quest, "instances")), 0), jsonout.json_obj([]))
  let users: Json = jsonout.obj_get(jsonout.obj_get(instance, "progression"), "users")
  let moved: Json = result(fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "\{\}"))
  fakeserver.get_saved_team() == team and length(object_keys(jsonout.obj_get(active, "heroes"))) == 5 and hero_bids(jsonout.obj_get(saved_team, "heroes")) == team and object_keys(jsonout.obj_get(active, "heroes")) == team and object_keys(jsonout.obj_get(jsonout.obj_get(users, gamedata.local_uid()), "team")) == team and object_keys(jsonout.obj_get(jsonout.obj_get(moved, "teamData"), "heroes")) == team
end

function test_sparse_and_overflow_quest_team_fields_follow_capacity_rules(): boolean
  intent: test
  let sparse: a list of text = ["optimusprime_cin_tf", "megatron_gs_leader2015", "megatron_cin_rotf"]
  fakeserver.reset_saved_team()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\"tm0\":\"optimusprime_cin_tf\",\"tm2\":\"megatron_gs_leader2015\",\"tm4\":\"megatron_cin_rotf\"\}")
  let sparse_ok: boolean = fakeserver.get_saved_team() == sparse
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\",\"tm2\":\"megatron_gs_leader2015\",\"tm3\":\"grimlock_gs_mp08\",\"tm4\":\"megatron_cin_rotf\",\"tm5\":\"soundwave_gs\"\}")
  sparse_ok and fakeserver.get_saved_team() == gamedata.default_team()
end

function test_resp_path_for_maps_routes_to_response_files(): boolean
  intent: test
  fakeserver.resp_path_for("GET", "/auth/login") == fakeserver.resp_dir() ++ "/GET__auth_login.json" and fakeserver.resp_path_for("POST", "/bcg/getUserData?x=1") == fakeserver.resp_dir() ++ "/POST__bcg_getUserData.json" and fakeserver.resp_path_for("GET", "/a/b/c.json") == fakeserver.resp_dir() ++ "/GET__a_b_c.json" and fakeserver.resp_path_for("GET", "/") == fakeserver.resp_dir() ++ "/GET__.json" and fakeserver.resp_path_for("POST", "/quests/quest-movedir/1.1.1-0/1/0") == fakeserver.resp_dir() ++ "/POST__quests_quest-movedir_1.1.1-0_1_0.json"
end

function test_dynamic_returns_empty_for_unhandled_path(): boolean
  intent: test
  fakeserver.dynamic("/some/unknown/path", "") == ""
end

function test_tutorial_branches_block_live_and_complete(): boolean
  intent: test
  let blocked: text = fakeserver.dynamic("/tutorial/start-tutorial", "\{\"tid\":\"ShieldTutorial\"\}")
  let live: text = fakeserver.dynamic("/tutorial/start-branch", "\{\"tid\":\"FTE\",\"bid\":\"x\"\}")
  let complete: text = fakeserver.dynamic("/tutorial/complete-tutorial", "\{\"tid\":\"FTE\"\}")
  blocked == "\{\"err\": \"unavailable\", \"error\": \"unavailable\", \"retry\": false, \"fatal\": false, \"result\": \{\}\}" and contains_text(live, "\"s\": \"started\"") and contains_text(complete, "\"s\": \"completed\"") and fakeserver.dynamic("/tutorial/start-tutorial", "") == ""
end

function test_movedir_walks_full_board_after_wins(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  mutable row: integer = 1
  mutable good: boolean = true
  while row < gamedata.quest_dim() do
  let moved: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  if pos_x(moved) != row or jsonout.as_int(jsonout.obj_get(move_to(moved), "x")) != row or jsonout.as_int(jsonout.obj_get(battle(moved), "x")) != row then set good = false end
  resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}")
  set row = row + 1
end
  let final_move: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  good and pos_x(final_move) == gamedata.quest_dim() - 1 and jsonout.as_int(jsonout.obj_get(move_to(final_move), "x")) == gamedata.quest_dim() - 1
end

function test_lost_replays_pending_battle(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"LOST\"\},\"qid\":\"1.1.1-0\"\}")
  let replay: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  pos_x(replay) == 1 and jsonout.as_int(jsonout.obj_get(move_to(replay), "x")) == 1 and jsonout.as_int(jsonout.obj_get(battle(replay), "x")) == 1 and current_battle_id(replay) == gamedata.minion_blueprint() and current_battle_state(replay) == "activated"
end

function test_nested_won_with_board_qid_advances(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  let reply: text = resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}")
  let moved: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  reply == "" and pos_x(moved) == 2
end

function test_quit_and_empty_keep_pending(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"QUIT\"\},\"qid\":\"1.1.1-0\"\}")
  let quit: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\}")
  let empty: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  pos_x(quit) == 1 and pos_x(empty) == 1
end

function test_qidless_won_clears_only_pending_quest(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"WON\"\}\}")
  pos_x(fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")) == 2
end

function test_plain_and_board_qids_normalize(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1\"\}")
  let plain: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  resolve("\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}")
  pos_x(plain) == 2 and pos_x(fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")) == 2
end

function test_quest_resets_and_legacy_state_disarm_pending(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  write_file(fakeserver.log_dir() ++ "/.fakeserver-state", "S|\nQ|1.1.1|1|1")
  let legacy: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  let reset_by_begin: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  fakeserver.reset_quest_positions()
  let reset_positions: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")
  pos_x(legacy) == 2 and pos_x(reset_by_begin) == 1 and pos_x(reset_positions) == 1
end

function test_resolve_response_prefers_canned_then_rule_then_default(): boolean
  intent: test
  fakeserver.resolve_response("POST", "/auth/login").source == "canned POST__auth_login.json" and fakeserver.resolve_response("GET", "/auth/login").source == "default" and fakeserver.resolve_response("GET", "/bcg/getUserData").source == "canned GET__bcg_getUserData.json" and fakeserver.resolve_response("GET", "/autorefresh/somegroup/refresh").source == "rule /autorefresh/ -> _autorefresh.json" and fakeserver.resolve_response("GET", "/nope/nope").body == "\{\"error\":null,\"result\":\{\}\}"
end

function test_encode_spacing_matches_python(): boolean
  intent: test
  let value: Json = jsonout.json_obj([jsonout.json_pair("a", jsonout.json_list([jsonout.json_int(1), jsonout.json_int(2)])), jsonout.json_pair("b", jsonout.json_obj([jsonout.json_pair("c", jsonout.json_bool(true))]))])
  jsonout.encode_compact(value) == "\{\"a\":[1,2],\"b\":\{\"c\":true\}\}" and jsonout.encode_spaced(value) == "\{\"a\": [1, 2], \"b\": \{\"c\": true\}\}"
end

function main(): nothing
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("test_set_saved_team_updates_active_team_and_remembered_quest_squad", test_set_saved_team_updates_active_team_and_remembered_quest_squad())
  set failed = failed + report("test_sparse_and_overflow_quest_team_fields_follow_capacity_rules", test_sparse_and_overflow_quest_team_fields_follow_capacity_rules())
  set failed = failed + report("test_resp_path_for_maps_routes_to_response_files", test_resp_path_for_maps_routes_to_response_files())
  set failed = failed + report("test_dynamic_returns_empty_for_unhandled_path", test_dynamic_returns_empty_for_unhandled_path())
  set failed = failed + report("test_tutorial_branches_block_live_and_complete", test_tutorial_branches_block_live_and_complete())
  set failed = failed + report("test_movedir_walks_full_board_after_wins", test_movedir_walks_full_board_after_wins())
  set failed = failed + report("test_lost_replays_pending_battle", test_lost_replays_pending_battle())
  set failed = failed + report("test_nested_won_with_board_qid_advances", test_nested_won_with_board_qid_advances())
  set failed = failed + report("test_quit_and_empty_keep_pending", test_quit_and_empty_keep_pending())
  set failed = failed + report("test_qidless_won_clears_only_pending_quest", test_qidless_won_clears_only_pending_quest())
  set failed = failed + report("test_plain_and_board_qids_normalize", test_plain_and_board_qids_normalize())
  set failed = failed + report("test_quest_resets_and_legacy_state_disarm_pending", test_quest_resets_and_legacy_state_disarm_pending())
  set failed = failed + report("test_resolve_response_prefers_canned_then_rule_then_default", test_resolve_response_prefers_canned_then_rule_then_default())
  set failed = failed + report("test_encode_spacing_matches_python", test_encode_spacing_matches_python())
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  print(to_text(14 - failed) ++ " passed, " ++ to_text(failed) ++ " failed")
  if failed > 0 then
  exit_process(1)
end
end

main()
