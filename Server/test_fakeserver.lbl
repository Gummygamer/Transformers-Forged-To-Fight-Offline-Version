function test_custom_story_routes_preserve_selected_team_and_keep_template_state_independent(): boolean
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.dynamic("/bcg/setSavedTeam", "\{\"teamID\":\"0\",\"heroes\":[\"megatron_cin_rotf\"]\}")
  let detail: Json = result(fakeserver.dynamic("/quests/quest-detail/2.1.1", "\{\}"))
  let begun: Json = result(fakeserver.dynamic("/quests/quest-begin/2.1.1", "\{\"tm0\":\"megatron_cin_rotf\"\}"))
  let active: Json = jsonout.obj_get(jsonout.obj_get(begun, "activeQuests"), "2.1.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(active, "instances")), 0), jsonout.json_obj([]))
  let custom_user: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(instance, "progression"), "users"), gamedata.local_uid())
  let moved: Json = result(fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "\{\}"))
  let ok_1: boolean = test_custom_story_routes_preserve_selected_team_and_keep_template_state_independent_part1(detail, active, custom_user, moved)
  let custom_battle: Json = battle(fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "\{\}"))
  fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\}")
  let template_move: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "\{\}")
  let ok_2: boolean = ok_1 and test_custom_story_routes_preserve_selected_team_and_keep_template_state_independent_part2(custom_battle, template_move)
  ok_2
end

function test_custom_story_begin_without_team_preserves_saved_squad_across_navigation_and_reentry_part1(selected: a list of text, empty_fallback_ok: boolean, user: Json, moved_team: Json, reentered_user: Json): boolean
