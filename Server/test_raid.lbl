-- Raid rules (raid.lbl) checked without a server: the NPC data, the board, the fight loop, results and claims.

use raid
use gamedata
use jsonout

function report(name: text, passed: boolean): integer
  intent: print
  if passed then
    print("[ok] " ++ name)
    0
  else
    print("[!] " ++ name)
    1
  end
end

function field(node: Json, key: text): Json
  intent: read one field of an object
  jsonout.obj_get(node, key)
end

function int_of(node: Json, key: text): integer
  intent: read an integer field, or minus one thousand when the field is missing
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "int" then jsonout.as_int(jsonout.obj_get(node, key)) else -1000 end
end

function bool_of(node: Json, key: text): boolean
  intent: read a boolean field, false when the field is missing
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "bool" then jsonout.as_bool(jsonout.obj_get(node, key)) else false end
end

function text_of(node: Json, key: text): text
  intent: read a text field, empty when the field is missing
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "text" then jsonout.as_text(jsonout.obj_get(node, key)) else "" end
end

function roster_has(bid: text): boolean
  intent: check that a blueprint is a roster bot the server ships
  mutable found: boolean = false
  for entry in gamedata.roster() do
    if entry.bid == bid then set found = true end
  end
  found
end

function started(index: integer): Json
  intent: start a raid against one NPC with the default team
  raid.start_raid(raid.empty_state(), index, gamedata.default_team(), 1000)
end

function fight_won(state: Json): Json
  intent: play the fight at the node the attacker stands on and win it
  let qid: text = text_of(field(state, "active"), "qid")
  field(raid.fight_reply(state, qid, true, 1100), "state")
end

function fight_lost(state: Json): Json
  intent: play the fight at the node the attacker stands on and lose it
  let qid: text = text_of(field(state, "active"), "qid")
  raid.fight_reply(state, qid, false, 1100)
end

function step_forward(state: Json): Json
  intent: move one node forward along the path
  raid.take_step(state, text_of(field(state, "active"), "qid"), 1, 0)
end

function test_every_defender_is_a_roster_bot(): boolean
  intent: test
  mutable ok: boolean = true
  for index in [0, 1, 2] do
    mutable position: integer = 0
    while position < raid.npc_defender_count(index) do
      if not roster_has(raid.npc_defender_key(index, position)) then set ok = false end
      set position = position + 1
    end
  end
  ok
end

function test_npc_list_has_three_opponents_with_negative_ids(): boolean
  intent: test
  length(raid.npcs()) == 3 and raid.npc_uid(0) == -1 and raid.npc_uid(1) == -2 and raid.npc_uid(2) == -3
end

function test_board_has_one_defender_tile_per_defender_and_only_the_last_is_final(): boolean
  intent: test
  let count: integer = raid.npc_defender_count(1)
  let board: Json = raid.raid_map_at(1)
  let grid: a list of Json = jsonout.list_items(field(board, "grid"))
  mutable ok: boolean = int_of(board, "gridDimension") == count + 1
  mutable row: integer = 1
  while row <= count do
    let tile: Json = unwrap_or(get(jsonout.list_items(unwrap_or(get(grid, row), jsonout.json_list([]))), 1), jsonout.json_obj([]))
    if text_of(tile, "boss") != raid.npc_defender_key(1, row - 1) then set ok = false end
    if bool_of(tile, "final") != (row == count) then set ok = false end
    set row = row + 1
  end
  let start: Json = unwrap_or(get(jsonout.list_items(unwrap_or(get(grid, 0), jsonout.json_list([]))), 1), jsonout.json_obj([]))
  ok and bool_of(start, "start")
end

function test_defender_entity_carries_the_npc_level(): boolean
  intent: test
  let grid: a list of Json = jsonout.list_items(field(raid.raid_map_at(0), "grid"))
  let tile: Json = unwrap_or(get(jsonout.list_items(unwrap_or(get(grid, 1), jsonout.json_list([]))), 1), jsonout.json_obj([]))
  let entity: Json = field(field(tile, "entities"), "kickback_gs_kabam")
  int_of(entity, "level") == raid.npc_defender_level(0, 0) and int_of(entity, "level") == 8 and int_of(entity, "todIndex") == 0
end

function test_start_creates_a_raid_at_the_start_with_the_team(): boolean
  intent: test
  let state: Json = started(0)
  let active: Json = field(state, "active")
  int_of(state, "seq") == 1 and text_of(active, "qid") == "raid.1" and int_of(active, "pos") == 0 and int_of(active, "beaten") == 0
end

function test_attacker_must_beat_a_defender_before_moving_on(): boolean
  intent: test
  let at_start: Json = started(0)
  let one: Json = step_forward(at_start)
  let blocked: Json = step_forward(one)
  let beaten: Json = fight_won(one)
  let after_win: Json = step_forward(beaten)
  int_of(field(one, "active"), "pos") == 1 and int_of(field(blocked, "active"), "pos") == 1 and int_of(field(after_win, "active"), "pos") == 2 and int_of(field(beaten, "active"), "beaten") == 1
end

function test_backward_and_diagonal_moves_are_ignored(): boolean
  intent: test
  let one: Json = step_forward(started(0))
  let qid: text = text_of(field(one, "active"), "qid")
  let back: Json = raid.take_step(one, qid, -1, 0)
  let side: Json = raid.take_step(started(0), qid, 1, 1)
  int_of(field(back, "active"), "pos") == 1 and int_of(field(side, "active"), "pos") == 0
end

function test_a_move_for_another_quest_is_ignored(): boolean
  intent: test
  let state: Json = started(0)
  int_of(field(raid.take_step(state, "raid.99", 1, 0), "active"), "pos") == 0
end

function test_a_fight_without_a_pending_node_changes_nothing(): boolean
  intent: test
  let state: Json = started(0)
  let reply: Json = raid.fight_reply(state, "raid.1", true, 1100)
  int_of(field(field(reply, "state"), "active"), "beaten") == 0 and not bool_of(reply, "ended") and length(jsonout.list_items(field(reply, "actions"))) == 0
end

function test_losing_a_fight_ends_the_raid_as_a_loss(): boolean
  intent: test
  let fighting: Json = step_forward(started(0))
  let reply: Json = fight_lost(fighting)
  let result: Json = field(reply, "result")
  bool_of(reply, "ended") and jsonout.type_name(field(field(reply, "state"), "active")) == "null" and not bool_of(result, "attackerWon") and text_of(result, "s") == "" and text_of(result, "_id") == "raid-result-1"
end

function test_losing_reports_fightlost_at_the_node(): boolean
  intent: test
  let reply: Json = fight_lost(step_forward(started(0)))
  let action: Json = field(unwrap_or(get(jsonout.list_items(field(reply, "actions")), 0), jsonout.json_obj([])), "action")
  let at: Json = field(action, "fightlost")
  int_of(at, "x") == 1 and int_of(at, "y") == 1 and not bool_of(at, "isFinalBoss")
end

function test_beating_the_last_defender_wins_the_raid(): boolean
  intent: test
  -- NPC 0 has two defenders: beat the first, step on to the second, and beat it
  let at_second: Json = step_forward(fight_won(step_forward(started(0))))
  let reply: Json = raid.fight_reply(at_second, "raid.1", true, 1200)
  let result: Json = field(reply, "result")
  bool_of(reply, "ended") and bool_of(result, "attackerWon") and text_of(result, "s") == "" and not raid.has_active(field(reply, "state"))
end

function test_the_final_win_reports_battlecomplete_as_the_final_boss(): boolean
  intent: test
  let at_second: Json = step_forward(fight_won(step_forward(started(0))))
  let reply: Json = raid.fight_reply(at_second, "raid.1", true, 1200)
  let action: Json = field(unwrap_or(get(jsonout.list_items(field(reply, "actions")), 0), jsonout.json_obj([])), "action")
  let at: Json = field(action, "battlecomplete")
  bool_of(reply, "ended") and bool_of(at, "isFinalBoss") and int_of(at, "x") == 2
end

function test_quit_records_a_quit_result(): boolean
  intent: test
  let quit: Json = raid.abandon(step_forward(started(0)), "raid.1", 1300)
  let result: Json = raid.first_result(quit)
  jsonout.type_name(field(quit, "active")) == "null" and text_of(result, "s") == "q" and not bool_of(result, "attackerWon")
end

function test_starting_a_second_raid_quits_the_first(): boolean
  intent: test
  let first: Json = step_forward(started(0))
  let second: Json = raid.start_raid(first, 2, gamedata.default_team(), 1400)
  int_of(second, "seq") == 2 and length(raid.results(second)) == 1 and text_of(raid.first_result(second), "s") == "q" and text_of(field(second, "active"), "qid") == "raid.2"
end

function test_claim_marks_the_result_claimed_and_lists_its_id(): boolean
  intent: test
  let ended: Json = raid.abandon(started(0), "raid.1", 1300)
  let claimed: Json = raid.claim(ended, "raid-result-1")
  let reply: Json = raid.claim_reply("raid-result-1", claimed)
  bool_of(raid.first_result(claimed), "rewardsClaimed") and raid.has_result(claimed, "raid-result-1") and length(jsonout.list_items(field(reply, "claimedIds"))) == 1
end

function test_claiming_an_unknown_id_lists_nothing(): boolean
  intent: test
  let reply: Json = raid.claim_reply("raid-result-9", raid.empty_state())
  length(jsonout.list_items(field(reply, "claimedIds"))) == 0
end

function test_find_result_lists_the_three_npcs(): boolean
  intent: test
  let found: Json = raid.find_result(raid.empty_state(), 1000)
  let matches: a list of Json = jsonout.list_items(field(found, "matches"))
  length(matches) == 3 and text_of(unwrap_or(get(matches, 0), jsonout.json_obj([])), "uid") == "-1" and int_of(found, "expiry") == 4600
end

function test_activation_is_an_active_quest_at_the_start(): boolean
  intent: test
  let reply: Json = raid.activation_result(started(0), 1000)
  let quest: Json = field(field(reply, "activeQuests"), "raid.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(field(quest, "instances")), 0), jsonout.json_obj([]))
  let position: Json = field(field(instance, "progression"), "currentPos")
  text_of(quest, "category") == "raid" and int_of(position, "x") == 0 and int_of(position, "y") == 1 and jsonout.obj_has(field(field(instance, "progression"), "users"), gamedata.local_uid())
end

function test_progression_has_the_keys_the_client_reads_on_the_instance(): boolean
  intent: test
  let quest: Json = field(field(raid.activation_result(started(0), 1000), "activeQuests"), "raid.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(field(quest, "instances")), 0), jsonout.json_obj([]))
  jsonout.obj_has(instance, "currentPos") and jsonout.obj_has(instance, "cleared") and jsonout.obj_has(instance, "revealed") and jsonout.obj_has(instance, "previouslyCleared") and jsonout.obj_has(instance, "version")
end

function test_active_quest_layout_names_the_npc_set_summary(): boolean
  intent: test
  let quest: Json = field(field(raid.activation_result(started(0), 1000), "activeQuests"), "raid.1")
  let data: Json = field(quest, "data")
  text_of(data, "id") == "raid-npc-1" and text_of(quest, "qid") == "raid.1"
end

function test_quest_detail_carries_the_raid_category_at_top_level(): boolean
  intent: test
  let detail: Json = raid.detail_result("raid-npc-1")
  text_of(detail, "category") == "raid" and jsonout.obj_has(detail, "map") and text_of(field(detail, "data"), "id") == "raid-npc-1"
end

function test_join_reply_marks_the_raid_team_as_joined(): boolean
  intent: test
  let reply: Json = raid.progress_reply(started(0))
  text_of(field(reply, "teamData"), "aid") == "raid.1-0" and jsonout.obj_has(reply, "progression")
end

function test_move_reply_names_the_new_node_only_when_the_attacker_moved(): boolean
  intent: test
  let before: Json = started(0)
  let after: Json = step_forward(before)
  let moved: Json = raid.move_reply(before, after)
  let blocked: Json = raid.move_reply(after, step_forward(after))
  length(jsonout.list_items(field(moved, "results"))) == 1 and length(jsonout.list_items(field(blocked, "results"))) == 0
end

function test_refresh_carries_the_history(): boolean
  intent: test
  let ended: Json = raid.abandon(started(0), "raid.1", 1300)
  let refresh: Json = raid.refresh_result(ended, 1300)
  let running: Json = raid.refresh_result(step_forward(started(0)), 1300)
  length(jsonout.list_items(field(field(refresh, "raid"), "historicalResults"))) == 1 and jsonout.obj_has(field(field(running, "raid"), "activeQuests"), "raid.1") and jsonout.type_name(field(field(refresh, "raid"), "activeQuests")) == "object"
end

function test_310_missions_response_serves_an_enabled_raid_config(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__autorefresh_missionsconfig_refresh.mono310.json")))
  let pvp: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(response, "result"), "missionsconfig"), "configs"), "pvp")
  let tier: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(pvp, "bucketSettings")), 0), jsonout.json_obj([]))
  bool_of(pvp, "enabled") and int_of(pvp, "attackTeamSizeMin") == 1 and int_of(pvp, "attackTeamSizeMax") == 3 and jsonout.obj_has(pvp, "characterExclusivityTeamTypes") and jsonout.obj_has(pvp, "DisabledLevels") and jsonout.obj_has(pvp, "leaderboardId") and jsonout.obj_has(pvp, "maxRevengeChain") and int_of(pvp, "revengeValidTime") == 86400 and text_of(tier, "id") != "" and int_of(tier, "maxRating") == -1
end

function run_tests_a(): integer
  intent: run the first half of the raid rule tests and print one line each
  let failed: integer = report("test_every_defender_is_a_roster_bot", test_every_defender_is_a_roster_bot()) + report("test_npc_list_has_three_opponents_with_negative_ids", test_npc_list_has_three_opponents_with_negative_ids()) + report("test_board_has_one_defender_tile_per_defender_and_only_the_last_is_final", test_board_has_one_defender_tile_per_defender_and_only_the_last_is_final()) + report("test_defender_entity_carries_the_npc_level", test_defender_entity_carries_the_npc_level()) + report("test_start_creates_a_raid_at_the_start_with_the_team", test_start_creates_a_raid_at_the_start_with_the_team()) + report("test_attacker_must_beat_a_defender_before_moving_on", test_attacker_must_beat_a_defender_before_moving_on()) + report("test_backward_and_diagonal_moves_are_ignored", test_backward_and_diagonal_moves_are_ignored()) + report("test_a_move_for_another_quest_is_ignored", test_a_move_for_another_quest_is_ignored()) + report("test_a_fight_without_a_pending_node_changes_nothing", test_a_fight_without_a_pending_node_changes_nothing()) + report("test_losing_a_fight_ends_the_raid_as_a_loss", test_losing_a_fight_ends_the_raid_as_a_loss()) + report("test_losing_reports_fightlost_at_the_node", test_losing_reports_fightlost_at_the_node()) + report("test_beating_the_last_defender_wins_the_raid", test_beating_the_last_defender_wins_the_raid()) + report("test_the_final_win_reports_battlecomplete_as_the_final_boss", test_the_final_win_reports_battlecomplete_as_the_final_boss())
  failed
end

function run_tests_b(): integer
  intent: run the second half of the raid rule tests and print one line each
  let failed: integer = report("test_quit_records_a_quit_result", test_quit_records_a_quit_result()) + report("test_starting_a_second_raid_quits_the_first", test_starting_a_second_raid_quits_the_first()) + report("test_claim_marks_the_result_claimed_and_lists_its_id", test_claim_marks_the_result_claimed_and_lists_its_id()) + report("test_claiming_an_unknown_id_lists_nothing", test_claiming_an_unknown_id_lists_nothing()) + report("test_find_result_lists_the_three_npcs", test_find_result_lists_the_three_npcs()) + report("test_activation_is_an_active_quest_at_the_start", test_activation_is_an_active_quest_at_the_start()) + report("test_progression_has_the_keys_the_client_reads_on_the_instance", test_progression_has_the_keys_the_client_reads_on_the_instance()) + report("test_move_reply_names_the_new_node_only_when_the_attacker_moved", test_move_reply_names_the_new_node_only_when_the_attacker_moved()) + report("test_refresh_carries_the_history", test_refresh_carries_the_history()) + report("test_310_missions_response_serves_an_enabled_raid_config", test_310_missions_response_serves_an_enabled_raid_config()) + report("test_active_quest_layout_names_the_npc_set_summary", test_active_quest_layout_names_the_npc_set_summary()) + report("test_quest_detail_carries_the_raid_category_at_top_level", test_quest_detail_carries_the_raid_category_at_top_level()) + report("test_join_reply_marks_the_raid_team_as_joined", test_join_reply_marks_the_raid_team_as_joined())
  failed
end

function run_tests(): integer
  intent: run every raid rule test and print one line each
  let failed: integer = run_tests_a() + run_tests_b()
  print(to_text(26 - failed) ++ " passed, " ++ to_text(failed) ++ " failed")
  failed
end

function main(): nothing
  intent: run the raid rule tests and exit non-zero on a failure
  let failed: integer = run_tests()
  if failed > 0 then exit_process(1) end
end

main()
