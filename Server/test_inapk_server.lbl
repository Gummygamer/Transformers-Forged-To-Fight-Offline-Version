use fakeserver
use export_payload
use gamedata
use jsonout

record TestResult
  passed: boolean
  detail: text
end

record HttpReply
  status: text
  body: text
  headers: text
end

record HarnessStart
  pid: text
  error: text
end

function object_keys(node: Json): a list of text
  intent: get
  match node
  when JObj { pairs } then 
    mutable keys: a list of text = []
    for pair in pairs do
      set keys = append(keys, pair.k)
    end
    keys
  otherwise then
    []
end
end

function ok(): TestResult
  intent: return
  TestResult { passed: true, detail: "" }
end

function failed(detail: text): TestResult
  intent: return
  TestResult { passed: false, detail: detail }
end

function report(name: text, result: TestResult): integer
  intent: report
  if result.passed then
    print("[ok] " ++ name)
    0
  else
    print("[!] " ++ name ++ ": " ++ result.detail)
    1
  end
end

function expect(label: text, got: text, want: text): boolean
  intent: compare
  if got == want then
    true
  else
    print(label ++ " got(" ++ to_text(text_length(got)) ++ "): " ++ substring(got, 0, 120))
    print(label ++ " want(" ++ to_text(text_length(want)) ++ "): " ++ substring(want, 0, 120))
    false
  end
end

function command_output(result: a mapping from text to text): text
  intent: get
  unwrap_or(get(result, "stdout"), "")
end

function command_error(result: a mapping from text to text): text
  intent: get
  unwrap_or(get(result, "stderr"), "")
end

function command_failed(result: a mapping from text to text): boolean
  intent: check
  unwrap_or(get(result, "exit_code"), -1) != 0
end

function find_port(): integer
  intent: find
  mutable port: integer = 0
  mutable attempts: integer = 0
  while attempts < 20 and port == 0 do
    let candidate: integer = 21000 + random_int(38000)
    let probe: a mapping from text to text = shell_exec("ss -ltn | grep -c ':" ++ to_text(candidate) ++ " ' || true")
    if trim(command_output(probe)) == "0" then set port = candidate end
    set attempts = attempts + 1
  end
  port
end

function start_harness(base: text, harness: text, payload: text, port: integer): HarnessStart
  intent: start
  let out: text = path_join(base, "out.log")
  let err: text = path_join(base, "err.log")
  let marker: text = path_join(base, "tutorial-seen")
  let quest_state: text = path_join(base, "quest-state")
  write_file(out, "")
  write_file(err, "")
  let started: a mapping from text to text = shell_exec("nohup env TFTF_TUTORIAL_STATE_FILE=" ++ marker ++ " TFTF_QUEST_STATE_FILE=" ++ quest_state ++ " " ++ harness ++ " " ++ payload ++ " > " ++ out ++ " 2> " ++ err ++ " & echo $!")
  let pid: text = trim(command_output(started))
  let deadline: integer = current_time_ms() + 10000
  mutable ready: boolean = false
  while not ready and current_time_ms() < deadline do
    if file_exists(out) and contains_text(read_file(out), "listening " ++ to_text(port)) then
      set ready = true
    else
      shell_exec("sleep 0.1")
    end
  end
  if ready and pid != "" then
    HarnessStart { pid: pid, error: "" }
  else
    HarnessStart { pid: pid, error: "native harness did not start: " ++ if file_exists(err) then read_file(err) else "no stderr log" end }
  end
end

function stop_harness(pid: text): nothing
  intent: stop
  if pid != "" then shell_exec("kill " ++ pid ++ " 2>/dev/null; sleep 0.3; kill -9 " ++ pid ++ " 2>/dev/null; true") end
end

function reply_file(path: text): text
  intent: read
  if file_exists(path) then read_file(path) else "" end
end

function request_command(base: text, close: boolean, method: text, body: text, has_body: boolean): text
  intent: build the curl command line and stage the request body
  let request_body: text = path_join(base, "req.bin")
  mutable command: text = "curl -sS --http1.1 --max-time 10 -D " ++ path_join(base, "resp.hdr") ++ " -o " ++ path_join(base, "resp.bin") ++ " -w \"%\{http_code\}\""
  if close then set command = command ++ " -H \"Connection: close\"" end
  if method == "HEAD" then
    set command = command ++ " -I"
  else if method == "POST" then
    set command = command ++ " -X POST"
    if has_body then
      write_file(request_body, body)
      set command = command ++ " --data-binary @" ++ request_body
    end
  end
  command
end

function request(base: text, port: integer, method: text, path: text, body: text, close: boolean, has_body: boolean): HttpReply
  intent: request
  let response: text = path_join(base, "resp.bin")
  let headers: text = path_join(base, "resp.hdr")
  write_file(response, "")
  write_file(headers, "")
  let command: text = request_command(base, close, method, body, has_body)
  let ran: a mapping from text to text = shell_exec(command ++ " '" ++ "http://127.0.0.1:" ++ to_text(port) ++ path ++ "'")
  if command_failed(ran) then print("[!] " ++ method ++ " " ++ path ++ ": " ++ command_error(ran)) end
  HttpReply { status: trim(command_output(ran)), body: reply_file(response), headers: reply_file(headers) }
end

function reused_bodies(base: text, port: integer, first: text, second: text): a list of text
  intent: request
  let a: text = path_join(base, "reuse-a.bin")
  let b: text = path_join(base, "reuse-b.bin")
  let url_a: text = "http://127.0.0.1:" ++ to_text(port) ++ first
  let url_b: text = "http://127.0.0.1:" ++ to_text(port) ++ second
  shell_exec("curl -sS --http1.1 --max-time 10 -o " ++ a ++ " '" ++ url_a ++ "' -o " ++ b ++ " '" ++ url_b ++ "'")
  [reply_file(a), reply_file(b)]
end

function payload_basic_checks_part1(account: text, auth: text, one: HttpReply, two: HttpReply, three: HttpReply, four: HttpReply): boolean
  intent: test
  expect("GET account status", one.status, "200") and expect("GET account", one.body, account) and expect("POST auth status", two.status, "200") and expect("POST auth", two.body, auth) and expect("unknown status", three.status, "200") and expect("unknown", three.body, "\{\"error\":null,\"result\":\{\}\}") and expect("autorefresh status", four.status, "200")
end

function payload_basic_checks_part2(account: text, prefix: text, four: HttpReply, reused: a list of text, head: HttpReply): boolean
  intent: test
  expect("autorefresh", four.body, prefix) and expect("reuse account", unwrap_or(get(reused, 0), ""), account) and expect("reuse autorefresh", unwrap_or(get(reused, 1), ""), prefix) and expect("HEAD status", head.status, "200") and contains_text(lowercase(head.headers), "content-length: 0")
end

function payload_basic_checks(base: text, port: integer): boolean
  intent: test
  let account: text = read_file(path_join(fakeserver.resp_dir(), "GET__account_data.json"))
  let auth: text = read_file(path_join(fakeserver.resp_dir(), "POST__auth_init.json"))
  let prefix: text = read_file(path_join(fakeserver.resp_dir(), "_autorefresh.json"))
  let one: HttpReply = request(base, port, "GET", "/account/data", "", false, false)
  let two: HttpReply = request(base, port, "POST", "/auth/init", "\{\}", false, true)
  let three: HttpReply = request(base, port, "GET", "/totally/unknown/route?x=1", "", false, false)
  let four: HttpReply = request(base, port, "GET", "/autorefresh/somethingelse", "", false, false)
  let ok_1: boolean = payload_basic_checks_part1(account, auth, one, two, three, four)
  let reused: a list of text = reused_bodies(base, port, "/account/data", "/autorefresh/somethingelse")
  let head: HttpReply = request(base, port, "HEAD", "/account/data", "", false, false)
  let ok_2: boolean = ok_1 and payload_basic_checks_part2(account, prefix, four, reused, head)
  ok_2
end

function payload_dynamic_checks(base: text, port: integer): boolean
  intent: test
  let one: text = "/autorefresh/grouprefresh?groups.0.name=gacha&groups.7.name=quests"
  let two: text = "/autorefresh/grouprefresh?groups.3.name=missionsconfig"
  let three: text = "/base/active"
  let one_reply: HttpReply = request(base, port, "GET", one, "", false, false)
  let two_reply: HttpReply = request(base, port, "GET", two, "", false, false)
  let three_reply: HttpReply = request(base, port, "GET", three, "", false, false)
  expect(one, one_reply.body, fakeserver.dynamic(one, "")) and expect(two, two_reply.body, fakeserver.dynamic(two, "")) and expect(three, three_reply.body, fakeserver.dynamic(three, ""))
end

function payload_tutorial_checks_part1(one: text, two: text, a: HttpReply, b: HttpReply, tutorial: HttpReply): boolean
  intent: test
  expect("tutorial one", a.body, fakeserver.dynamic("/tutorial/start-branch", one)) and expect("tutorial two", b.body, fakeserver.dynamic("/tutorial/start-branch", two))
end

function payload_tutorial_checks_part2(three: text, four: text, c: HttpReply, d: HttpReply, tutorial: HttpReply): boolean
  intent: test
  expect("tutorial three", c.body, fakeserver.dynamic("/tutorial/start-branch", three)) and expect("tutorial four", d.body, fakeserver.dynamic("/tutorial/start-branch", four))
end

function payload_tutorial_checks_part3(one: text, complete: HttpReply, tutorial: HttpReply, first_login: HttpReply): boolean
  intent: test
  expect("tutorial complete", complete.body, fakeserver.dynamic("/tutorial/complete-tutorial", one)) and expect("tutorial start", tutorial.body, read_file(path_join(fakeserver.resp_dir(), "POST__tutorial_start-tutorial.json"))) and expect("tutorial first login", first_login.body, fakeserver.tutorial_login_started_response())
end

function payload_tutorial_checks_part4(second_login: HttpReply): boolean
  intent: test
  expect("tutorial second login", second_login.body, fakeserver.tutorial_login_completed_response())
end

function payload_tutorial_checks(base: text, port: integer): boolean
  intent: test
  let a: HttpReply = request(base, port, "POST", "/tutorial/start-branch", "\{\"tid\":\"FTE\",\"bid\":\"IntroFight\"\}", false, true)
  let b: HttpReply = request(base, port, "POST", "/tutorial/start-branch", "\{\"tid\":\"ShieldTutorial\"\}", false, true)
  let c: HttpReply = request(base, port, "POST", "/tutorial/start-branch", "\{\"tid\":\"SomeOther\",\"bid\":\"b1\"\}", false, true)
  let d: HttpReply = request(base, port, "POST", "/tutorial/start-branch", "\{\"tid\":\"FTE\"\}", false, true)
  let complete: HttpReply = request(base, port, "POST", "/tutorial/complete-tutorial", "\{\"tid\":\"FTE\",\"bid\":\"IntroFight\"\}", false, true)
  let tutorial: HttpReply = request(base, port, "POST", "/tutorial/start-tutorial", "\{\}", false, true)
  let ok_1: boolean = payload_tutorial_checks_part1("\{\"tid\":\"FTE\",\"bid\":\"IntroFight\"\}", "\{\"tid\":\"ShieldTutorial\"\}", a, b, tutorial)
  let ok_2: boolean = ok_1 and payload_tutorial_checks_part2("\{\"tid\":\"SomeOther\",\"bid\":\"b1\"\}", "\{\"tid\":\"FTE\"\}", c, d, tutorial)
  let first_login: HttpReply = request(base, port, "POST", "/tutorial/get-login-data", "\{\}", false, true)
  let ok_3: boolean = ok_2 and payload_tutorial_checks_part3("\{\"tid\":\"FTE\",\"bid\":\"IntroFight\"\}", complete, tutorial, first_login)
  let second_login: HttpReply = request(base, port, "POST", "/tutorial/get-login-data", "\{\}", false, true)
  let ok_4: boolean = ok_3 and payload_tutorial_checks_part4(second_login)
  ok_4
end

function payload_custom_story_checks_part1(has_custom_team: boolean, active_path: text, active: HttpReply, begin: HttpReply, expected_begin: text): boolean
  intent: test
  has_custom_team and active.status == "200" and expect("custom quest is not preloaded", active.body, fakeserver.resolve_response("GET", active_path).body) and expect("custom quest begin", begin.body, expected_begin)
end

function payload_custom_story_checks_part2(begin: HttpReply, moved: HttpReply, expected_moved: text): boolean
  intent: test
  expect("custom quest movedir", moved.body, expected_moved) and contains_text(moved.body, "\"bludgeon_gs_rd20\"") and contains_text(moved.body, "\"mapOverride\": \"chicago\"") and contains_text(begin.body, "\"optimusprime_cin_tf\"") and contains_text(begin.body, "\"optimusprimal_bw_mp32\"") and contains_text(begin.body, "\"megatron_gs_leader2015\"")
end

function payload_custom_story_checks(base: text, port: integer): boolean
  intent: test
  -- A quest response alone is insufficient: QuestFlow also requires its BCG
  -- active-team record, otherwise it immediately sends quest-begin again.
  let user_data: HttpReply = request(base, port, "GET", "/bcg/getUserData", "", false, false)
  if user_data.status != "200" or user_data.body == "" then return false end
  let updates: Json = jsonout.obj_get(jsonout.obj_get(jsonout.parse_json(user_data.body), "result"), "updates")
  mutable has_custom_team: boolean = false
  for team in jsonout.list_items(jsonout.obj_get(updates, "activeTeams")) do
    if jsonout.as_text(jsonout.obj_get(team, "aid")) == "2.1.1-0" and length(object_keys(jsonout.obj_get(team, "heroes"))) > 0 then set has_custom_team = true end
  end
  let active: HttpReply = request(base, port, "GET", "/quests/quest-active?categories.0=PvE", "", false, false)
  let begin: HttpReply = request(base, port, "POST", "/quests/quest-begin/2.1.1", "\{\"setId\":\"custom_story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\",\"tm2\":\"megatron_gs_leader2015\"\}", false, true)
  let expected_begin: text = fakeserver.dynamic("/quests/quest-begin/2.1.1", "\{\"setId\":\"custom_story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\",\"tm2\":\"megatron_gs_leader2015\"\}")
  let moved: HttpReply = request(base, port, "POST", "/quests/quest-movedir/2.1.1-0/1/0", "\{\}", false, true)
  let expected_moved: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "\{\}")
  let ok_1: boolean = payload_custom_story_checks_part1(has_custom_team, "/quests/quest-active?categories.0=PvE", active, begin, expected_begin)
  let ok_2: boolean = ok_1 and payload_custom_story_checks_part2(begin, moved, expected_moved)
  ok_2
end

function session_first_ok_part1(hero_one: HttpReply): boolean
  intent: test
  expect("hero one", hero_one.body, fakeserver.dynamic("/bcg/getBaseHeroData", "\{\"heroes\":[\{\"level\":1,\"sig_lvl\":0,\"flvl\":0,\"rank\":1,\"bid\":\"sharkticon_gs_brawler\"\}],\"nonce\":\"x\",\"api\":6\}"))
end

function session_first_ok_part2(hero_two: HttpReply): boolean
  intent: test
  expect("hero two", hero_two.body, fakeserver.dynamic("/bcg/getBaseHeroData", "\{\"heroes\":[\{\"level\":1,\"sig_lvl\":3,\"rank\":1,\"bid\":\"sharkticon_gs_brawler\"\},\{\"level\":2,\"sig_lvl\":4,\"rank\":1,\"bid\":\"optimusprime_cin_tf\"\}]\}"))
end

function session_first_ok_part3(saved_reply: HttpReply, detail_reply: HttpReply): boolean
  intent: test
  expect("saved", saved_reply.body, fakeserver.dynamic("/bcg/setSavedTeam", "\{\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\"],\"api\":6,\"nonce\":\"x\",\"teamID\":\"0\"\}")) and expect("detail", detail_reply.body, fakeserver.dynamic("/quests/quest-detail/1.1.1?sig=x&stoken=y", "\{\"hash\":\"\",\"setId\":\"story_act1\"\}"))
end

function session_first_ok_part4(begin_reply: HttpReply): boolean
  intent: test
  expect("begin", begin_reply.body, fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\"\}"))
end

function session_first_ok(base: text, port: integer): boolean
  intent: test
  let hero_one: HttpReply = request(base, port, "POST", "/bcg/getBaseHeroData", "\{\"heroes\":[\{\"level\":1,\"sig_lvl\":0,\"flvl\":0,\"rank\":1,\"bid\":\"sharkticon_gs_brawler\"\}],\"nonce\":\"x\",\"api\":6\}", false, true)
  let ok_1: boolean = session_first_ok_part1(hero_one)
  let hero_two: HttpReply = request(base, port, "POST", "/bcg/getBaseHeroData", "\{\"heroes\":[\{\"level\":1,\"sig_lvl\":3,\"rank\":1,\"bid\":\"sharkticon_gs_brawler\"\},\{\"level\":2,\"sig_lvl\":4,\"rank\":1,\"bid\":\"optimusprime_cin_tf\"\}]\}", false, true)
  let ok_2: boolean = ok_1 and session_first_ok_part2(hero_two)
  let saved_reply: HttpReply = request(base, port, "POST", "/bcg/setSavedTeam", "\{\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\"],\"api\":6,\"nonce\":\"x\",\"teamID\":\"0\"\}", false, true)
  let detail_reply: HttpReply = request(base, port, "POST", "/quests/quest-detail/1.1.1?sig=x&stoken=y", "\{\"hash\":\"\",\"setId\":\"story_act1\"\}", false, true)
  let ok_3: boolean = ok_2 and session_first_ok_part3(saved_reply, detail_reply)
  let begin_reply: HttpReply = request(base, port, "POST", "/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\"\}", false, true)
  let ok_4: boolean = ok_3 and session_first_ok_part4(begin_reply)
  ok_4
end

function session_movedir_ok(base: text, port: integer): boolean
  intent: test
  mutable good: boolean = true
  mutable index: integer = 0
  while index < 3 do
    let path: text = "/quests/quest-movedir/1.1.1-0/1/0"
    let moved: HttpReply = request(base, port, "POST", path, "\{\}", false, true)
    if not expect("movedir " ++ to_text(index), moved.body, fakeserver.dynamic(path, "\{\}")) then set good = false end
    let resolve_body: text = "\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}"
    let resolved: HttpReply = request(base, port, "POST", "/matches/resolve-match/quests_fight", resolve_body, false, true)
    if resolved.status != "200" or resolved.body != "\{\"error\":null,\"result\":\{\}\}" or fakeserver.dynamic("/matches/resolve-match/quests_fight", resolve_body) != "" then set good = false end
    set index = index + 1
  end
  good
end

function payload_session_checks(base: text, port: integer): boolean
  intent: test
  let first: boolean = session_first_ok(base, port)
  let loop_ok: boolean = session_movedir_ok(base, port)
  first and loop_ok
end

function native_retry_gate_checks_part1(begin: HttpReply, expected_begin: text, first: HttpReply, expected_first: text, lost: HttpReply): boolean
  intent: test
  expect("retry begin", begin.body, expected_begin) and expect("retry first", first.body, expected_first) and lost.status == "200" and lost.body == "\{\"error\":null,\"result\":\{\}\}"
end

function native_retry_gate_checks_part2(replay: HttpReply, expected_replay: text, won: HttpReply, completed_revisit: HttpReply, expected_completed_revisit: text): boolean
  intent: test
  expect("retry replay", replay.body, expected_replay) and won.status == "200" and won.body == "\{\"error\":null,\"result\":\{\}\}" and completed_revisit.status == "200" and expect("retry completed revisit", completed_revisit.body, expected_completed_revisit)
end

function native_retry_gate_checks_part3(advanced: HttpReply, expected_advanced: text, missing: HttpReply, held: HttpReply, expected_held: text): boolean
  intent: test
  expect("retry advance", advanced.body, expected_advanced) and missing.status == "200" and missing.body == "\{\"error\":null,\"result\":\{\}\}" and expect("retry missing held", held.body, expected_held)
end

function native_retry_gate_checks_tail(base: text, port: integer, ok_1: boolean, replay: HttpReply, expected_replay: text, won: HttpReply): boolean
  intent: test
  let completed_revisit: HttpReply = request(base, port, "POST", "/quests/quest-movedir/1.1.1-0/0/0", "\{\}", false, true)
  let expected_completed_revisit: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/0/0", "\{\}")
  let ok_2: boolean = ok_1 and native_retry_gate_checks_part2(replay, expected_replay, won, completed_revisit, expected_completed_revisit)
  let advanced: HttpReply = request(base, port, "POST", "/quests/quest-movedir/1.1.1-0/1/0", "\{\}", false, true)
  let expected_advanced: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "\{\}")
  let missing: HttpReply = request(base, port, "POST", "/matches/resolve-match/quests_fight", "\{\}", false, true)
  fakeserver.dynamic("/matches/resolve-match/quests_fight", "\{\}")
  let held: HttpReply = request(base, port, "POST", "/quests/quest-movedir/1.1.1-0/1/0", "\{\}", false, true)
  let expected_held: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "\{\}")
  let ok_3: boolean = ok_2 and native_retry_gate_checks_part3(advanced, expected_advanced, missing, held, expected_held)
  ok_3
end

function native_retry_gate_checks(base: text, port: integer): boolean
  intent: test
  let begin: HttpReply = request(base, port, "POST", "/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\"\}", false, true)
  let expected_begin: text = fakeserver.dynamic("/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\"\}")
  let first: HttpReply = request(base, port, "POST", "/quests/quest-movedir/1.1.1-0/1/0", "\{\}", false, true)
  let expected_first: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "\{\}")
  let lost: HttpReply = request(base, port, "POST", "/matches/resolve-match/quests_fight", "\{\"results\":\{\"result\":\"LOST\"\},\"qid\":\"1.1.1-0\"\}", false, true)
  let ok_1: boolean = native_retry_gate_checks_part1(begin, expected_begin, first, expected_first, lost)
  fakeserver.dynamic("/matches/resolve-match/quests_fight", "\{\"results\":\{\"result\":\"LOST\"\},\"qid\":\"1.1.1-0\"\}")
  let replay: HttpReply = request(base, port, "POST", "/quests/quest-movedir/1.1.1-0/1/0", "\{\}", false, true)
  let expected_replay: text = fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "\{\}")
  let won: HttpReply = request(base, port, "POST", "/matches/resolve-match/quests_fight", "\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}", false, true)
  fakeserver.dynamic("/matches/resolve-match/quests_fight", "\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"1.1.1-0\"\}")
  native_retry_gate_checks_tail(base, port, ok_1, replay, expected_replay, won)
end

record RestartFirst
  begin: HttpReply
  expected_begin: text
  first: HttpReply
  expected_first: text
  won: HttpReply
end

function restart_first_phase(base: text, port: integer): RestartFirst
  intent: begin, move and win a fight before the native server restarts
  let begin_body: text = "\{\"tm0\":\"megatron_cin_rotf\",\"tm1\":\"grimlock_gs_mp08\"\}"
  let begin: HttpReply = request(base, port, "POST", "/quests/quest-begin/2.1.1", begin_body, false, true)
  let expected_begin: text = fakeserver.dynamic("/quests/quest-begin/2.1.1", begin_body)
  let first: HttpReply = request(base, port, "POST", "/quests/quest-movedir/2.1.1-0/1/0", "\{\}", false, true)
  let expected_first: text = fakeserver.dynamic("/quests/quest-movedir/2.1.1-0/1/0", "\{\}")
  let won_body: text = "\{\"results\":\{\"result\":\"WON\"\},\"qid\":\"2.1.1-0\"\}"
  let won: HttpReply = request(base, port, "POST", "/matches/resolve-match/quests_fight", won_body, false, true)
  fakeserver.dynamic("/matches/resolve-match/quests_fight", won_body)
  RestartFirst { begin: begin, expected_begin: expected_begin, first: first, expected_first: expected_first, won: won }
end

function restart_first_ok(phase: RestartFirst): boolean
  intent: check the replies from before the restart
  phase.begin.status == "200" and phase.begin.body == phase.expected_begin and phase.first.status == "200" and phase.first.body == phase.expected_first and phase.won.status == "200" and phase.won.body == "\{\"error\":null,\"result\":\{\}\}"
end

function restart_resumed_ok(resumed_begin: HttpReply, resumed: HttpReply): boolean
  intent: check the replies after the restart restored the completed position
  resumed_begin.status == "200" and resumed.status == "200" and contains_text(resumed_begin.body, "megatron_cin_rotf") and contains_text(resumed_begin.body, "grimlock_gs_mp08") and contains_text(resumed.body, "megatron_cin_rotf") and contains_text(resumed.body, "grimlock_gs_mp08") and contains_text(resumed.body, "fte_stars_gs_t3")
end

function native_progression_restart_checks(harness: text, payload: text, port: integer): TestResult
  intent: test
  let base: text = "/tmp/tftf-inapk-restart-" ++ random_hex(8)
  create_dir(base)
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  let started: HarnessStart = start_harness(base, harness, payload, port)
  if started.error != "" then
    stop_harness(started.pid)
    failed(started.error)
  else
    let phase: RestartFirst = restart_first_phase(base, port)
    stop_harness(started.pid)
    let restarted: HarnessStart = start_harness(base, harness, payload, port)
    if restarted.error != "" then
      stop_harness(restarted.pid)
      shell_exec("rm -rf -- " ++ base)
      failed(restarted.error)
    else
      let resumed_begin: HttpReply = request(base, port, "POST", "/quests/quest-begin/2.1.1", "\{\}", false, true)
      let resumed: HttpReply = request(base, port, "POST", "/quests/quest-movedir/2.1.1-0/1/0", "\{\}", false, true)
      stop_harness(restarted.pid)
      shell_exec("rm -rf -- " ++ base)
      let good: boolean = restart_first_ok(phase) and restart_resumed_ok(resumed_begin, resumed)
      if good then ok() else failed("completed quest position was not restored across native server restart") end
    end
  end
end

function normalize_profile_timestamp(body: text, key: text): text
  intent: get
  let needle: text = "\"" ++ key ++ "\":"
  let at: integer = unwrap_or(index_of(body, needle), -1)
  if at < 0 then
    body
  else
    let start: integer = at + text_length(needle)
    mutable finish: integer = start
    while finish < text_length(body) and contains_text("0123456789", substring(body, finish, 1)) do set finish = finish + 1 end
    substring(body, 0, start) ++ "%TIME%" ++ substring(body, finish, text_length(body) - finish)
  end
end

function normalized_profile(body: text): text
  intent: get
  normalize_profile_timestamp(normalize_profile_timestamp(body, "lastLogin"), "_createTime")
end

function user_profile_checks_part1(profile: HttpReply, no_slash: HttpReply, prefixed: HttpReply, unsafe: HttpReply, expected: text): boolean
  intent: test
  profile.status == "200" and expect("userprofile", normalized_profile(profile.body), normalized_profile(expected)) and no_slash.status == "200" and expect("userprofile no slash", normalized_profile(no_slash.body), normalized_profile(expected)) and prefixed.status == "200" and expect("userprofile prefixed", normalized_profile(prefixed.body), normalized_profile(expected)) and unsafe.status == "200"
end

function user_profile_checks_part2(body: text, unsafe: HttpReply, bulk: HttpReply, find: HttpReply): boolean
  intent: test
  contains_text(unsafe.body, "\"uid\":\"1000000000001\"") and bulk.status == "200" and find.status == "200" and fakeserver.dynamic("/userprofile/bulk", body) == "" and fakeserver.dynamic("/userprofile/find", body) == "" and expect("userprofile bulk", bulk.body, "\{\"error\":null,\"result\":\{\}\}") and expect("userprofile find", find.body, "\{\"error\":null,\"result\":\{\}\}")
end

function user_profile_checks(base: text, port: integer): boolean
  intent: test
  fakeserver.reset_sessions()
  let profile: HttpReply = request(base, port, "POST", "/userprofile/", "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}", false, true)
  let no_slash: HttpReply = request(base, port, "POST", "/userprofile", "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}", false, true)
  let prefixed: HttpReply = request(base, port, "POST", "/prod/userprofile/?stoken=unknown", "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}", false, true)
  let unsafe: HttpReply = request(base, port, "POST", "/userprofile", "\{\"uid\":\"invalid uid\"\}", false, true)
  let bulk: HttpReply = request(base, port, "POST", "/userprofile/bulk", "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}", false, true)
  let find: HttpReply = request(base, port, "POST", "/userprofile/find", "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}", false, true)
  let expected: text = fakeserver.dynamic("/userprofile/", "\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}")
  let ok_1: boolean = user_profile_checks_part1(profile, no_slash, prefixed, unsafe, expected)
  let ok_2: boolean = ok_1 and user_profile_checks_part2("\{\"uid\":\"1000000000002\",\"nonce\":\"x\",\"api\":1\}", unsafe, bulk, find)
  ok_2
end

function payload_wire_checks(base: text, port: integer): boolean
  intent: run every wire comparison against the started native server
  let a: boolean = payload_basic_checks(base, port)
  let b: boolean = payload_dynamic_checks(base, port)
  let c: boolean = payload_tutorial_checks(base, port)
  let d: boolean = payload_session_checks(base, port)
  let e: boolean = native_retry_gate_checks(base, port)
  let f: boolean = payload_custom_story_checks(base, port)
  a and b and c and d and e and f
end

function tutorial_login_persisted(base: text, port: integer, restarted: HarnessStart): boolean
  intent: check the completed tutorial login survives a native server restart
  if restarted.error == "" then
    let login: HttpReply = request(base, port, "POST", "/tutorial/get-login-data", "\{\}", false, true)
    expect("tutorial login after restart", login.body, fakeserver.tutorial_login_completed_response())
  else
    false
  end
end

function test_payload_server_matches_fake_server(base: text, harness: text, payload: text, port: integer): TestResult
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  fakeserver.reset_tutorial_login()
  shell_exec("rm -f -- " ++ path_join(base, "tutorial-seen"))
  let started: HarnessStart = start_harness(base, harness, payload, port)
  if started.error != "" then
    stop_harness(started.pid)
    failed(started.error)
  else
    let wire: boolean = payload_wire_checks(base, port)
    stop_harness(started.pid)
    let restarted: HarnessStart = start_harness(base, harness, payload, port)
    let persisted: boolean = tutorial_login_persisted(base, port, restarted)
    stop_harness(restarted.pid)
    if wire and persisted then ok() else failed("wire regressions") end
  end
end

function test_user_profile_matches_fake_server(base: text, harness: text, payload: text, port: integer): TestResult
  intent: test
  let started: HarnessStart = start_harness(base, harness, payload, port)
  if started.error != "" then
    stop_harness(started.pid)
    failed(started.error)
  else
    let good: boolean = user_profile_checks(base, port)
    stop_harness(started.pid)
    if good then ok() else failed("user profile regressions") end
  end
end

function selected_squad_checks_part1(path: text, default_reply: HttpReply, selected: text, selected_reply: HttpReply, after_selected: HttpReply): boolean
  intent: test
  expect("default user", default_reply.body, fakeserver.dynamic(path, "")) and expect("default canned", default_reply.body, read_file(path_join(fakeserver.resp_dir(), "GET__bcg_getUserData.json"))) and expect("selected", selected_reply.body, fakeserver.dynamic("/bcg/setSavedTeam", selected)) and expect("after selected", after_selected.body, fakeserver.dynamic(path, ""))
end

function selected_squad_checks_part2(set_id: text, simple_begin: HttpReply, empty_move: HttpReply, switched: text, switched_reply: HttpReply): boolean
  intent: test
  expect("simple begin", simple_begin.body, fakeserver.dynamic("/quests/quest-begin/1.1.1", set_id)) and expect("empty move", empty_move.body, fakeserver.dynamic("/quests/quest-movedir/1.1.1-0/1/0", "")) and expect("switched", switched_reply.body, fakeserver.dynamic("/quests/quest-begin/1.1.1", switched))
end

function selected_squad_checks_part3(path: text, unknown: text, unknown_reply: HttpReply, overcap: text, overcap_reply: HttpReply, final_reply: HttpReply): boolean
  intent: test
  expect("unknown preserves", unknown_reply.body, fakeserver.dynamic("/bcg/setSavedTeam", unknown)) and expect("overcap preserves", overcap_reply.body, fakeserver.dynamic("/bcg/setSavedTeam", overcap)) and expect("final", final_reply.body, fakeserver.dynamic(path, ""))
end

function selected_squad_checks_part4(bid: text, team: a list of text): boolean
  intent: test
  expect("selection retained", bid, unwrap_or(get(team, 0), ""))
end

function selected_squad_checks_tail(base: text, port: integer, ok_2: boolean, unknown_reply: HttpReply, overcap_reply: HttpReply): boolean
  intent: test
  let final_reply: HttpReply = request(base, port, "GET", "/bcg/getUserData", "", true, false)
  let ok_3: boolean = ok_2 and selected_squad_checks_part3("/bcg/getUserData", "\{\"heroes\":[\"not_a_real_bot\",\"optimusprimal_bw_mp32\"],\"teamID\":\"0\"\}", unknown_reply, "\{\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\",\"megatron_gs_leader2015\",\"grimlock_gs_mp08\",\"megatron_cin_rotf\",\"soundwave_gs\"],\"teamID\":\"0\"\}", overcap_reply, final_reply)
  let decoded: Json = jsonout.parse_json(final_reply.body)
  let saved_teams: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(decoded, "result"), "updates"), "savedTeams")
  let first_team: Json = unwrap_or(get(jsonout.list_items(saved_teams), 0), jsonout.json_obj([]))
  let heroes: Json = jsonout.obj_get(first_team, "heroes")
  let first_hero: Json = unwrap_or(get(jsonout.list_items(heroes), 0), jsonout.json_obj([]))
  let bid: text = jsonout.as_text(jsonout.obj_get(first_hero, "bid"))
  let ok_4: boolean = ok_3 and selected_squad_checks_part4(bid, ["optimusprime_cin_tf", "optimusprimal_bw_mp32", "megatron_gs_leader2015", "grimlock_gs_mp08", "megatron_cin_rotf"])
  ok_4
end

function selected_squad_checks(base: text, port: integer): boolean
  intent: test
  let default_reply: HttpReply = request(base, port, "GET", "/bcg/getUserData", "", true, false)
  let selected_reply: HttpReply = request(base, port, "POST", "/bcg/setSavedTeam", "\{\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\",\"megatron_gs_leader2015\",\"grimlock_gs_mp08\",\"megatron_cin_rotf\"],\"teamID\":\"0\"\}", true, true)
  let after_selected: HttpReply = request(base, port, "GET", "/bcg/getUserData", "", true, false)
  let ok_1: boolean = selected_squad_checks_part1("/bcg/getUserData", default_reply, "\{\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\",\"megatron_gs_leader2015\",\"grimlock_gs_mp08\",\"megatron_cin_rotf\"],\"teamID\":\"0\"\}", selected_reply, after_selected)
  let simple_begin: HttpReply = request(base, port, "POST", "/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\"\}", true, true)
  let empty_move: HttpReply = request(base, port, "POST", "/quests/quest-movedir/1.1.1-0/1/0", "", true, false)
  let switched_reply: HttpReply = request(base, port, "POST", "/quests/quest-begin/1.1.1", "\{\"setId\":\"story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\",\"tm2\":\"megatron_gs_leader2015\",\"tm3\":\"grimlock_gs_mp08\",\"tm4\":\"megatron_cin_rotf\"\}", true, true)
  let ok_2: boolean = ok_1 and selected_squad_checks_part2("\{\"setId\":\"story_act1\"\}", simple_begin, empty_move, "\{\"setId\":\"story_act1\",\"tm0\":\"optimusprime_cin_tf\",\"tm1\":\"optimusprimal_bw_mp32\",\"tm2\":\"megatron_gs_leader2015\",\"tm3\":\"grimlock_gs_mp08\",\"tm4\":\"megatron_cin_rotf\"\}", switched_reply)
  let unknown_reply: HttpReply = request(base, port, "POST", "/bcg/setSavedTeam", "\{\"heroes\":[\"not_a_real_bot\",\"optimusprimal_bw_mp32\"],\"teamID\":\"0\"\}", true, true)
  let overcap_reply: HttpReply = request(base, port, "POST", "/bcg/setSavedTeam", "\{\"heroes\":[\"optimusprime_cin_tf\",\"optimusprimal_bw_mp32\",\"megatron_gs_leader2015\",\"grimlock_gs_mp08\",\"megatron_cin_rotf\",\"soundwave_gs\"],\"teamID\":\"0\"\}", true, true)
  selected_squad_checks_tail(base, port, ok_2, unknown_reply, overcap_reply)
end

function test_selected_squad_session_matches_fake_server(base: text, harness: text, payload: text, port: integer): TestResult
  intent: test
  fakeserver.reset_saved_team()
  fakeserver.reset_quest_positions()
  shell_exec("rm -f -- " ++ path_join(base, "quest-state"))
  let started: HarnessStart = start_harness(base, harness, payload, port)
  if started.error != "" then
    stop_harness(started.pid)
    failed(started.error)
  else
    let good: boolean = selected_squad_checks(base, port)
    stop_harness(started.pid)
    if good then ok() else failed("selected squad regressions") end
  end
end

function candidates(base: text, harness: text, maps: text, cmdline: text, has_cmdline: boolean): a list of text
  intent: run
  let maps_path: text = path_join(base, "maps")
  let cmdline_path: text = path_join(base, "cmdline")
  write_file(maps_path, maps)
  if has_cmdline then
    let raw: integer = bytes_from_text(cmdline)
    let data: integer = bytes_new(bytes_length(raw) + 1)
    bytes_write_bytes(data, 0, raw)
    bytes_set(data, bytes_length(raw), 0)
    write_file_bytes(cmdline_path, data)
    bytes_free(raw)
    bytes_free(data)
  else shell_exec("rm -f -- " ++ cmdline_path) end
  let ran: a mapping from text to text = shell_exec("timeout 30 " ++ harness ++ " " ++ maps_path ++ " " ++ cmdline_path)
  split(trim(command_output(ran)), "\n")
end

function test_game_apk_is_ranked_ahead_of_earlier_play_services_apk(base: text, harness: text): TestResult
  intent: test
  let gms: text = "/data/app/~~sdunyrwN8nShSO2adhEEjg==/com.google.android.gms-Db7dSfGIhIufd1UUBDv5Ww==/base.apk"
  let game: text = "/data/app/~~vxoZ9FQU_8mVV2lHYIaJuA==/com.kabam.bigrobot-TLmfuByms-uLJyuSkKWlAA==/base.apk"
  let split_apk: text = "/data/app/~~vxoZ9FQU_8mVV2lHYIaJuA==/com.kabam.bigrobot-xyz==/split_config.arm64_v8a.apk"
  let maps: text = "7a1b000000-7a1b100000 r--p 00000000 fd:03 12345  " ++ gms ++ "\n7a1c000000-7a1c100000 r--p 00000000 fd:03 12346  " ++ game ++ "\n7a1c100000-7a1c200000 r-xp 00010000 fd:03 12346  " ++ game ++ "\n7a1d000000-7a1d100000 r--p 00000000 fd:03 12347  " ++ split_apk ++ "\n7a1e000000-7a1e100000 r-xp 00000000 fd:03 12348  /apex/com.android.art/lib64/libart.so\n"
  let found: a list of text = candidates(base, harness, maps, "com.kabam.bigrobot", true)
  let first: text = unwrap_or(get(found, 0), "")
  let all: text = join(found, "\n")
  if expect("candidate first", first, game) and expect("candidate game count", to_text(length(split(all, game)) - 1), "1") and contains_text(all, split_apk) and contains_text(all, gms) then ok() else failed("candidate ranking") end
end

function test_empty_or_missing_cmdline_still_returns_all_apks(base: text, harness: text): TestResult
  intent: test
  let first: text = "/data/app/a/com.google.android.gms-x/base.apk"
  let second: text = "/data/app/b/com.kabam.bigrobot-y/base.apk"
  let maps: text = "1-2 r--p 0 00:00 1 " ++ first ++ "\n2-3 r--p 0 00:00 2 " ++ second ++ "\n"
  let expected: a list of text = sort_text([first, second])
  let empty: a list of text = sort_text(candidates(base, harness, maps, "", true))
  let missing: a list of text = sort_text(candidates(base, harness, maps, "", false))
  if expect("empty cmdline candidates", join(empty, "\n"), join(expected, "\n")) and expect("missing cmdline candidates", join(missing, "\n"), join(expected, "\n")) then ok() else failed("candidate cmdline handling") end
end

function compile_harness(base: text, root: text, output: text, source: text): TestResult
  intent: compile
  let built: a mapping from text to text = shell_exec("timeout 300 cc -std=c11 -O1 -Wall -Wextra -o " ++ output ++ " " ++ path_join(root, "tools/nativehook/" ++ source) ++ " " ++ path_join(root, "tools/nativehook/inapk_server.c") ++ " -lpthread")
  if command_failed(built) then
    print(command_error(built))
    failed("cc failed for " ++ source)
  else
    ok()
  end
end

function suite_names(): a list of text
  intent: list the names reported for the suite results
  ["test_payload_server_matches_fake_server", "test_user_profile_matches_fake_server", "test_selected_squad_session_matches_fake_server", "test_native_progression_restart_checks", "test_game_apk_is_ranked_ahead_of_earlier_play_services_apk", "test_empty_or_missing_cmdline_still_returns_all_apks"]
end

function suite_results(base: text, harness: text, candidate_harness: text, payload: text, port: integer, restart: TestResult): a list of TestResult
  intent: run the suite tests in reporting order
  [test_payload_server_matches_fake_server(base, harness, payload, port), test_user_profile_matches_fake_server(base, harness, payload, port), test_selected_squad_session_matches_fake_server(base, harness, payload, port), restart, test_game_apk_is_ranked_ahead_of_earlier_play_services_apk(base, candidate_harness), test_empty_or_missing_cmdline_still_returns_all_apks(base, candidate_harness)]
end

function report_all(names: a list of text, results: a list of TestResult): integer
  intent: report each named result and count the failures
  mutable failures: integer = 0
  mutable index: integer = 0
  while index < length(names) do
    set failures = failures + report(unwrap_or(get(names, index), ""), unwrap_or(get(results, index), failed("missing result")))
    set index = index + 1
  end
  failures
end

function compile_failed(base: text, server_build: TestResult, candidate_build: TestResult): nothing
  intent: report the harness compile failures and stop
  report("compile inapk server harness", server_build)
  report("compile inapk candidate harness", candidate_build)
  shell_exec("rm -rf -- " ++ base)
  exit_process(1)
end

function run_compiled_suite(base: text, harness: text, candidate_harness: text, port: integer): nothing
  intent: export the payload and run the suite against the compiled harnesses
  print("using port " ++ to_text(port))
  let payload: text = path_join(base, to_text(port) ++ ".bin")
  let blob: integer = export_payload.build_payload(port)
  write_file_bytes(payload, blob)
  bytes_free(blob)
  let restart: TestResult = native_progression_restart_checks(harness, payload, port)
  let failures: integer = report_all(suite_names(), suite_results(base, harness, candidate_harness, payload, port, restart))
  shell_exec("rm -rf -- " ++ base)
  print(to_text(6 - failures) ++ " passed, " ++ to_text(failures) ++ " failed")
  if failures != 0 then exit_process(1) end
end

function run_suite(): nothing
  intent: run
  let base: text = "/tmp/tftf-inapk-" ++ random_hex(8)
  create_dir(base)
  let root: text = path_join(fakeserver.here(), "..")
  let harness: text = path_join(base, "harness")
  let candidate_harness: text = path_join(base, "candidates")
  let server_build: TestResult = compile_harness(base, root, harness, "inapk_server_main.c")
  let candidate_build: TestResult = compile_harness(base, root, candidate_harness, "inapk_candidates_main.c")
  let port: integer = find_port()
  if not server_build.passed or not candidate_build.passed then
    compile_failed(base, server_build, candidate_build)
  else if port == 0 then
    print("[!] could not select a free TCP port")
    shell_exec("rm -rf -- " ++ base)
    exit_process(1)
  else
    run_compiled_suite(base, harness, candidate_harness, port)
  end
end

function main(): nothing
  intent: run
  let cc: a mapping from text to text = shell_exec("command -v cc")
  let curl: a mapping from text to text = shell_exec("command -v curl")
  if command_failed(cc) then
    print("skipping: cc is not on PATH")
  else if command_failed(curl) then
    print("skipping: curl is not on PATH")
  else
    run_suite()
  end
end

main()
