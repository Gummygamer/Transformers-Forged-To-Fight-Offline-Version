use jsonout
use gamedata
use server_paths

record ResponseChoice
  source: text
  body: text
end

record Position
  qid: text
  x: integer
  y: integer
  pending: boolean
end

record ServerState
  team: a list of text
  positions: a list of Position
end

record Roster
  peer: text
  name: text
  heroes: a list of text
end

record Session
  fingerprint: text
  stoken: text
  uid: text
  name: text
end

record Presence
  peer: text
  name: text
  seen_ms: integer
end

record Match
  match_id: text
  arena: text
  peer_a: text
  peer_b: text
  created_ms: integer
end

record FightEvent
  match_id: text
  peer: text
  seq: integer
  kind: text
  payload: text
  sent_ms: integer
end

record MatchReport
  match_id: text
  peer: text
  outcome: text
  reported_ms: integer
end

record Reconciliation
  match_id: text
  status: text
  winner: text
  loser: text
  reports: integer
end

record Request
  method: text
  path: text
  body: text
  query: text
  headers: a mapping from text to text
end

function last_slash(path: text): integer
  intent: find
  mutable result: integer = -1
  mutable index: integer = 0
  while index < text_length(path) do
    if substring(path, index, 1) == "/" then
  set result = index
end
    set index = index + 1
  end
  result
end

public function here(): text
  intent: get
  server_paths.entry_directory("Server/fakeserver.lbl")
end

public function resp_dir(): text
  intent: get
  path_join(here(), "responses")
end

public function log_dir(): text
  intent: get
  path_join(here(), "logs")
end

public function pem_path(): text
  intent: get
  path_join(path_join(here(), "certs"), "server.pem")
end

public function logfile(): text
  intent: get
  path_join(log_dir(), "requests.log")
end

function state_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-state")
end

public function block_tutorials(): a list of text
  intent: return
  ["ShieldTutorial"]
end

public function live_tutorials(): a list of text
  intent: return
  ["FTE"]
end

function load_state(): ServerState
  intent: get
  if not file_exists(state_file()) then
  ServerState { team: [], positions: [] }
else
  let lines: a list of text = split(read_file(state_file()), "\n")
  mutable team: a list of text = []
  mutable positions: a list of Position = []
  for line in lines do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    if kind == "S" then
  let joined: text = unwrap_or(get(fields, 1), "")
  if joined != "" then
  set team = split(joined, ",")
end
else if kind == "Q" then
  let qid: text = unwrap_or(get(fields, 1), "")
  let x: integer = unwrap_or(to_integer(unwrap_or(get(fields, 2), "0")), 0)
  let y: integer = unwrap_or(to_integer(unwrap_or(get(fields, 3), "1")), 1)
  let pending: boolean = unwrap_or(get(fields, 5), "0") == "1"
  if qid != "" then
  set positions = append(positions, Position { qid: qid, x: x, y: y, pending: pending })
end
end
  end
  ServerState { team: team, positions: positions }
end
end

function save_state(state: ServerState): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = ["S|" ++ join(state.team, ",")]
  for position in state.positions do
    set lines = append(lines, "Q|" ++ position.qid ++ "|" ++ to_text(position.x) ++ "|" ++ to_text(position.y) ++ "|1|" ++ if position.pending then "1" else "0" end)
  end
  write_file(state_file(), join(lines, "\n"))
end

public function get_saved_team(): a list of text
  intent: get
  load_state().team
end

public function reset_saved_team(): nothing
  intent: reset
  let state: ServerState = load_state()
  save_state(ServerState { team: [], positions: state.positions })
end

public function reset_quest_positions(): nothing
  intent: reset
  let state: ServerState = load_state()
  save_state(ServerState { team: state.team, positions: [] })
end

function set_saved_team(team: a list of text): nothing
  intent: save
  let state: ServerState = load_state()
  save_state(ServerState { team: gamedata.resolve_team(team), positions: state.positions })
end

function position_for(qid: text): Position
  intent: get
  let state: ServerState = load_state()
  for position in state.positions do
    if position.qid == qid then
  return position
end
  end
  Position { qid: qid, x: 0, y: 1, pending: false }
end

function set_position(qid: text, x: integer, y: integer, pending: boolean): nothing
  intent: save
  let state: ServerState = load_state()
  mutable positions: a list of Position = []
  mutable replaced: boolean = false
  for position in state.positions do
    if position.qid == qid then
  set positions = append(positions, Position { qid: qid, x: x, y: y, pending: pending })
  set replaced = true
else
  set positions = append(positions, position)
end
  end
  if not replaced then
  set positions = append(positions, Position { qid: qid, x: x, y: y, pending: pending })
end
  save_state(ServerState { team: state.team, positions: positions })
end

function roster_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-rosters")
end

function roster_safe(value: text): text
  intent: clean
  replace(replace(replace(value, "|", "_"), ",", "_"), "\n", "_")
end

function session_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-sessions")
end

function presence_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-presence")
end

function match_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-matches")
end

function fight_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-fights")
end

function report_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-results")
end

function relay_safe(value: text): text
  intent: clean
  replace(replace(replace(value, "|", "_"), "\n", "_"), "\r", "_")
end

public function presence_ttl_ms(): integer
  intent: get
  let configured: integer = unwrap_or(to_integer(unwrap_or(env_get("TFTF_PRESENCE_TTL_MS"), "")), 0)
  if configured > 0 then configured else 15000 end
end

public function account_level(): integer
  intent: get
  let configured: integer = unwrap_or(to_integer(unwrap_or(env_get("TFTF_ACCOUNT_LEVEL"), "")), 0)
  if configured > 0 then configured else 30 end
end

public function load_sessions(): a list of Session
  intent: load
  if not file_exists(session_file()) then
  []
else
  mutable sessions: a list of Session = []
  for line in split(read_file(session_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let fingerprint: text = unwrap_or(get(fields, 1), "")
    let stoken: text = unwrap_or(get(fields, 2), "")
    let uid: text = unwrap_or(get(fields, 3), "")
    let name: text = unwrap_or(get(fields, 4), "")
    if kind == "S" and fingerprint != "" and stoken != "" and uid != "" then
  set sessions = append(sessions, Session { fingerprint: fingerprint, stoken: stoken, uid: uid, name: name })
end
  end
  sessions
end
end

public function reset_sessions(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(session_file(), "")
end

public function session_for_token(stoken: text): Session
  intent: get
  for session in load_sessions() do
    if session.stoken == stoken then return session end
  end
  Session { fingerprint: "", stoken: "", uid: "", name: "" }
end

public function has_session_for_token(stoken: text): boolean
  intent: check
  session_for_token(stoken).stoken != ""
end

public function load_presence(): a list of Presence
  intent: load
  if not file_exists(presence_file()) then
  []
else
  mutable presence: a list of Presence = []
  for line in split(read_file(presence_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let peer: text = unwrap_or(get(fields, 1), "")
    let name: text = unwrap_or(get(fields, 2), "")
    let seen_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 3), "0")), 0)
    if kind == "P" and peer != "" then
  set presence = append(presence, Presence { peer: peer, name: name, seen_ms: seen_ms })
end
  end
  presence
end
end

public function reset_presence(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(presence_file(), "")
end

public function touch_presence_at(peer: text, name: text, now_ms: integer): Presence
  intent: save
  create_dir(log_dir())
  let key: text = roster_safe(peer)
  mutable previous_name: text = ""
  mutable lines: a list of text = []
  for presence in load_presence() do
    if presence.peer == key then
  set previous_name = presence.name
else
  set lines = append(lines, "P|" ++ roster_safe(presence.peer) ++ "|" ++ roster_safe(presence.name) ++ "|" ++ roster_safe(to_text(presence.seen_ms)))
end
  end
  let session: Session = session_for_token(key)
  let selected_name: text = if name != "" then name else if previous_name != "" then previous_name else if session.name != "" then session.name else "Commander" end
  let touched: Presence = Presence { peer: key, name: roster_safe(selected_name), seen_ms: now_ms }
  set lines = append(lines, "P|" ++ roster_safe(touched.peer) ++ "|" ++ roster_safe(touched.name) ++ "|" ++ roster_safe(to_text(touched.seen_ms)))
  write_file(presence_file(), join(lines, "\n"))
  touched
end

public function touch_presence(peer: text, name: text): Presence
  intent: save
  touch_presence_at(peer, name, current_time_ms())
end

public function live_peers_at(now_ms: integer): a list of Presence
  intent: get
  mutable peers: a list of Presence = []
  for presence in load_presence() do
    let age: integer = now_ms - presence.seen_ms
    if age >= 0 and age < presence_ttl_ms() then
  set peers = append(peers, presence)
end
  end
  peers
end

public function live_peers(): a list of Presence
  intent: get
  live_peers_at(current_time_ms())
end

public function load_matches(): a list of Match
  intent: load
  if not file_exists(match_file()) then
  []
else
  mutable matches: a list of Match = []
  for line in split(read_file(match_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let match_id: text = unwrap_or(get(fields, 1), "")
    let arena: text = unwrap_or(get(fields, 2), "")
    let peer_a: text = unwrap_or(get(fields, 3), "")
    let peer_b: text = unwrap_or(get(fields, 4), "")
    let created_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 5), "0")), 0)
    if kind == "M" and match_id != "" then
  set matches = append(matches, Match { match_id: match_id, arena: arena, peer_a: peer_a, peer_b: peer_b, created_ms: created_ms })
end
  end
  matches
end
end

function save_matches(matches: a list of Match): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = []
  for m in matches do
    set lines = append(lines, "M|" ++ roster_safe(m.match_id) ++ "|" ++ roster_safe(m.arena) ++ "|" ++ roster_safe(m.peer_a) ++ "|" ++ roster_safe(m.peer_b) ++ "|" ++ roster_safe(to_text(m.created_ms)))
  end
  write_file(match_file(), join(lines, "\n"))
end

public function reset_matches(): nothing
  intent: reset
  save_matches([])
end

public function match_for_peer(peer: text): Match
  intent: get
  let key: text = roster_safe(peer)
  for m in load_matches() do
    if m.peer_a == key or m.peer_b == key then return m end
  end
  Match { match_id: "", arena: "", peer_a: "", peer_b: "", created_ms: 0 }
end

public function match_opponent(m: Match, peer: text): text
  intent: get
  let key: text = roster_safe(peer)
  if m.peer_a == key then m.peer_b else if m.peer_b == key then m.peer_a else "" end
end

public function end_match(match_id: text): nothing
  intent: save
  mutable remaining: a list of Match = []
  for m in load_matches() do
    if m.match_id != match_id then set remaining = append(remaining, m) end
  end
  save_matches(remaining)
end

public function pair_peers_at(peer: text, arena: text, now_ms: integer): Match
  intent: pair
  let caller: Presence = touch_presence_at(peer, "", now_ms)
  let existing: Match = match_for_peer(caller.peer)
  if existing.match_id != "" then return existing end
  mutable candidate: Presence = Presence { peer: "", name: "", seen_ms: -1 }
  for live in live_peers_at(now_ms) do
    if live.peer != caller.peer and match_for_peer(live.peer).match_id == "" and live.seen_ms > candidate.seen_ms then
  set candidate = live
end
  end
  if candidate.peer == "" then
  Match { match_id: "", arena: "", peer_a: "", peer_b: "", created_ms: 0 }
else
  let matches: a list of Match = load_matches()
  let base_id: text = roster_safe(arena) ++ "-" ++ to_text(now_ms)
  mutable collides: boolean = false
  for m in matches do
    if m.match_id == base_id then set collides = true end
  end
  let match_id: text = if collides then base_id ++ "-" ++ to_text(length(matches)) else base_id end
  let created: Match = Match { match_id: match_id, arena: roster_safe(arena), peer_a: caller.peer, peer_b: candidate.peer, created_ms: now_ms }
  save_matches(append(matches, created))
  created
end
end

public function pair_peers(peer: text, arena: text): Match
  intent: pair
  pair_peers_at(peer, arena, current_time_ms())
end

public function load_fight_events(): a list of FightEvent
  intent: load
  if not file_exists(fight_file()) then
  []
else
  mutable events: a list of FightEvent = []
  for line in split(read_file(fight_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let match_id: text = unwrap_or(get(fields, 1), "")
    let peer: text = unwrap_or(get(fields, 2), "")
    let seq: integer = unwrap_or(to_integer(unwrap_or(get(fields, 3), "0")), 0)
    let event_kind: text = unwrap_or(get(fields, 4), "")
    let payload: text = unwrap_or(get(fields, 5), "")
    let sent_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 6), "0")), 0)
    if kind == "F" and match_id != "" then
  set events = append(events, FightEvent { match_id: match_id, peer: peer, seq: seq, kind: event_kind, payload: payload, sent_ms: sent_ms })
end
  end
  events
end
end

function save_fight_events(events: a list of FightEvent): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = []
  for event in events do
    set lines = append(lines, "F|" ++ roster_safe(event.match_id) ++ "|" ++ roster_safe(event.peer) ++ "|" ++ to_text(event.seq) ++ "|" ++ relay_safe(event.kind) ++ "|" ++ relay_safe(event.payload) ++ "|" ++ to_text(event.sent_ms))
  end
  write_file(fight_file(), join(lines, "\n"))
end

public function reset_fight_events(): nothing
  intent: reset
  save_fight_events([])
end

public function next_fight_seq(match_id: text): integer
  intent: get
  let key: text = roster_safe(match_id)
  mutable highest: integer = 0
  for event in load_fight_events() do
    if event.match_id == key and event.seq > highest then set highest = event.seq end
  end
  highest + 1
end

public function append_fight_event_at(match_id: text, peer: text, kind: text, payload: text, now_ms: integer): FightEvent
  intent: save
  let event: FightEvent = FightEvent { match_id: roster_safe(match_id), peer: roster_safe(peer), seq: next_fight_seq(match_id), kind: relay_safe(kind), payload: relay_safe(payload), sent_ms: now_ms }
  save_fight_events(append(load_fight_events(), event))
  event
end

public function append_fight_event(match_id: text, peer: text, kind: text, payload: text): FightEvent
  intent: save
  append_fight_event_at(match_id, peer, kind, payload, current_time_ms())
end

function append_event_in_seq_order(events: a list of FightEvent, candidate: FightEvent): a list of FightEvent
  intent: sort
  mutable ordered: a list of FightEvent = []
  mutable inserted: boolean = false
  for event in events do
    if not inserted and candidate.seq < event.seq then
  set ordered = append(ordered, candidate)
  set inserted = true
end
    set ordered = append(ordered, event)
  end
  if not inserted then set ordered = append(ordered, candidate) end
  ordered
end

public function fight_events_since(match_id: text, after_seq: integer): a list of FightEvent
  intent: get
  let key: text = roster_safe(match_id)
  mutable events: a list of FightEvent = []
  for event in load_fight_events() do
    if event.match_id == key and event.seq > after_seq then set events = append_event_in_seq_order(events, event) end
  end
  events
end

public function purge_fight_events(match_id: text): nothing
  intent: save
  let key: text = roster_safe(match_id)
  mutable remaining: a list of FightEvent = []
  for event in load_fight_events() do
    if event.match_id != key then set remaining = append(remaining, event) end
  end
  save_fight_events(remaining)
end

public function load_reports(): a list of MatchReport
  intent: load
  if not file_exists(report_file()) then
  []
else
  mutable reports: a list of MatchReport = []
  for line in split(read_file(report_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let match_id: text = unwrap_or(get(fields, 1), "")
    let peer: text = unwrap_or(get(fields, 2), "")
    let outcome: text = unwrap_or(get(fields, 3), "")
    let reported_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 4), "0")), 0)
    if kind == "R" and match_id != "" then
  set reports = append(reports, MatchReport { match_id: match_id, peer: peer, outcome: outcome, reported_ms: reported_ms })
end
  end
  reports
end
end

function save_reports(reports: a list of MatchReport): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = []
  for report in reports do
    set lines = append(lines, "R|" ++ roster_safe(report.match_id) ++ "|" ++ roster_safe(report.peer) ++ "|" ++ relay_safe(report.outcome) ++ "|" ++ to_text(report.reported_ms))
  end
  write_file(report_file(), join(lines, "\n"))
end

public function reset_reports(): nothing
  intent: reset
  save_reports([])
end

public function normalize_outcome(value: text): text
  intent: normalize
  let upper: text = uppercase(value)
  if upper == "WIN" or upper == "WON" or upper == "VICTORY" then
  "WON"
else if upper == "LOSE" or upper == "LOST" or upper == "LOSS" or upper == "DEFEAT" then
  "LOST"
else if upper == "DRAW" or upper == "TIE" then
  "DRAW"
else
  "UNKNOWN"
end
end

function report_is_more_recent(first: MatchReport, second: MatchReport): boolean
  intent: compare
  first.reported_ms > second.reported_ms or (first.reported_ms == second.reported_ms and first.peer < second.peer)
end

function latest_report_for_peer(match_id: text, peer: text): MatchReport
  intent: get
  let key: text = roster_safe(match_id)
  let reporter: text = roster_safe(peer)
  mutable latest: MatchReport = MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
  for report in load_reports() do
    if report.match_id == key and report.peer == reporter and (latest.peer == "" or report_is_more_recent(report, latest)) then
  set latest = report
end
  end
  latest
end

function reports_for_reconciliation(match_id: text): a list of MatchReport
  intent: get
  let key: text = roster_safe(match_id)
  mutable first: MatchReport = MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
  mutable second: MatchReport = MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
  for report in load_reports() do
    let latest: MatchReport = latest_report_for_peer(key, report.peer)
    if report.match_id == key and report.reported_ms == latest.reported_ms and report.outcome == latest.outcome then
  if report.peer != first.peer and (first.peer == "" or report_is_more_recent(report, first)) then
  set second = first
  set first = report
else if report.peer != first.peer and (second.peer == "" or report_is_more_recent(report, second)) then
  set second = report
end
end
  end
  mutable selected: a list of MatchReport = []
  if first.peer != "" then set selected = append(selected, first) end
  if second.peer != "" and second.peer != first.peer then set selected = append(selected, second) end
  selected
end

public function reconcile_match(match_id: text): Reconciliation
  intent: reconcile
  let reports: a list of MatchReport = reports_for_reconciliation(match_id)
  let count: integer = length(reports)
  if count == 0 then
  Reconciliation { match_id: roster_safe(match_id), status: "pending", winner: "", loser: "", reports: 0 }
else if count == 1 then
  Reconciliation { match_id: roster_safe(match_id), status: "pending", winner: "", loser: "", reports: 1 }
else
  let first: MatchReport = unwrap_or(get(reports, 0), MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 })
  let second: MatchReport = unwrap_or(get(reports, 1), MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 })
  if first.outcome == "WON" and second.outcome == "LOST" then
  Reconciliation { match_id: roster_safe(match_id), status: "agreed", winner: first.peer, loser: second.peer, reports: 2 }
else if first.outcome == "LOST" and second.outcome == "WON" then
  Reconciliation { match_id: roster_safe(match_id), status: "agreed", winner: second.peer, loser: first.peer, reports: 2 }
else if first.outcome == "DRAW" and second.outcome == "DRAW" then
  Reconciliation { match_id: roster_safe(match_id), status: "agreed", winner: "", loser: "", reports: 2 }
else
  let tiebreak: MatchReport = if first.reported_ms < second.reported_ms or (first.reported_ms == second.reported_ms and first.peer < second.peer) then first else second end
  let other: MatchReport = if tiebreak.peer == first.peer then second else first end
  if tiebreak.outcome == "WON" then
  Reconciliation { match_id: roster_safe(match_id), status: "disputed", winner: tiebreak.peer, loser: other.peer, reports: 2 }
else if tiebreak.outcome == "LOST" then
  Reconciliation { match_id: roster_safe(match_id), status: "disputed", winner: other.peer, loser: tiebreak.peer, reports: 2 }
else
  Reconciliation { match_id: roster_safe(match_id), status: "disputed", winner: "", loser: "", reports: 2 }
end
end
end
end

public function report_result_at(match_id: text, peer: text, outcome: text, now_ms: integer): Reconciliation
  intent: save
  let key: text = roster_safe(match_id)
  let reporter: text = roster_safe(peer)
  mutable reports: a list of MatchReport = []
  for report in load_reports() do
    if report.match_id != key or report.peer != reporter then set reports = append(reports, report) end
  end
  set reports = append(reports, MatchReport { match_id: key, peer: reporter, outcome: normalize_outcome(outcome), reported_ms: now_ms })
  save_reports(reports)
  let reconciliation: Reconciliation = reconcile_match(key)
  if reconciliation.status == "agreed" or reconciliation.status == "disputed" then
  end_match(key)
  purge_fight_events(key)
end
  reconciliation
end

public function report_result(match_id: text, peer: text, outcome: text): Reconciliation
  intent: save
  report_result_at(match_id, peer, outcome, current_time_ms())
end

function token_characters(value: text): text
  intent: clean
  mutable result: text = ""
  mutable index: integer = 0
  while index < text_length(value) do
    let character: text = substring(value, index, 1)
    if contains_text("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", character) then
  set result = result ++ character
end
    set index = index + 1
  end
  result
end

function token_for_fingerprint(fingerprint: text, sessions: a list of Session): text
  intent: mint
  let base: text = substring("sess" ++ token_characters(fingerprint), 0, min(32, text_length("sess" ++ token_characters(fingerprint))))
  mutable taken: boolean = false
  for session in sessions do
    if session.stoken == base and session.fingerprint != fingerprint then
  set taken = true
end
  end
  if not taken then
  base
else
  let suffix: text = to_text(length(sessions))
  substring(base, 0, max(0, 32 - text_length(suffix))) ++ suffix
end
end

public function ensure_session(fingerprint: text, name: text): Session
  intent: ensure
  let safe_fingerprint: text = roster_safe(fingerprint)
  let safe_name: text = roster_safe(name)
  let sessions: a list of Session = load_sessions()
  for session in sessions do
    if session.fingerprint == safe_fingerprint then return session end
  end
  let created: Session = Session { fingerprint: safe_fingerprint, stoken: token_for_fingerprint(safe_fingerprint, sessions), uid: to_text(1000000000001 + length(sessions)), name: safe_name }
  create_dir(log_dir())
  let line: text = "S|" ++ created.fingerprint ++ "|" ++ created.stoken ++ "|" ++ created.uid ++ "|" ++ created.name
  let existing: text = if file_exists(session_file()) then read_file(session_file()) else "" end
  write_file(session_file(), if existing == "" then line else existing ++ "\n" ++ line end)
  created
end

public function load_rosters(): a list of Roster
  intent: load
  if not file_exists(roster_file()) then
  []
else
  mutable rosters: a list of Roster = []
  for line in split(read_file(roster_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let peer: text = unwrap_or(get(fields, 1), "")
    if kind == "R" and peer != "" then
  let joined: text = unwrap_or(get(fields, 3), "")
  let heroes: a list of text = if joined == "" then [] else split(joined, ",") end
  set rosters = append(rosters, Roster { peer: peer, name: unwrap_or(get(fields, 2), ""), heroes: heroes })
end
  end
  rosters
end
end

public function store_roster(peer: text, name: text, heroes: a list of text): nothing
  intent: save
  create_dir(log_dir())
  let key: text = roster_safe(peer)
  let heroes_resolved: a list of text = gamedata.resolve_team(heroes)
  mutable lines: a list of text = []
  for roster in load_rosters() do
    if roster.peer != key then
  set lines = append(lines, "R|" ++ roster.peer ++ "|" ++ roster.name ++ "|" ++ join(roster.heroes, ","))
end
  end
  set lines = append(lines, "R|" ++ key ++ "|" ++ roster_safe(name) ++ "|" ++ join(heroes_resolved, ","))
  write_file(roster_file(), join(lines, "\n"))
end

public function reset_rosters(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(roster_file(), "")
end

public function opponent_roster(peer: text): Roster
  intent: get
  let key: text = roster_safe(peer)
  mutable found: boolean = false
  mutable opponent: Roster = Roster { peer: "house", name: "Autobot Garrison", heroes: gamedata.default_team() }
  for roster in load_rosters() do
    if roster.peer != key then
  set opponent = roster
  set found = true
end
  end
  if found then opponent else Roster { peer: "house", name: "Autobot Garrison", heroes: gamedata.default_team() } end
end

public function resp_path_for(method: text, path: text): text
  intent: get
  let stripped: text = trim_path(path)
  let key: text = method ++ "__" ++ unwrap_or(get(split(replace(stripped, "/", "_"), "?"), 0), "")
  if ends_with(key, ".json") then
  path_join(resp_dir(), key)
else
  path_join(resp_dir(), key ++ ".json")
end
end

function trim_path(path: text): text
  intent: path
  mutable start: integer = 0
  mutable finish: integer = text_length(path)
  while start < finish and substring(path, start, 1) == "/" do
    set start = start + 1
  end
  while finish > start and substring(path, finish - 1, 1) == "/" do
    set finish = finish - 1
  end
  substring(path, start, finish - start)
end

function request_object(body: text): Json
  intent: parse
  if starts_with(trim(body), "\{") then
  jsonout.parse_json(body)
else
  jsonout.json_obj([])
end
end

function json_text_or(node: Json, key: text, fallback: text): text
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "text" then
  jsonout.as_text(jsonout.obj_get(node, key))
else
  fallback
end
end

function json_text_first(node: Json, first: text, second: text, third: text): text
  intent: get
  let one: text = json_text_or(node, first, "")
  if one != "" then
  one
else
  let two: text = json_text_or(node, second, "")
  if two != "" then
  two
else
  json_text_or(node, third, "")
end
end
end

function json_list_or_empty(node: Json, key: text): a list of Json
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "list" then
  jsonout.list_items(jsonout.obj_get(node, key))
else
  []
end
end

function text_list_from_json(node: Json): a list of text
  intent: get
  mutable result: a list of text = []
  if jsonout.type_name(node) == "list" then
  for item in jsonout.list_items(node) do
    if jsonout.type_name(item) == "text" then
  set result = append(result, jsonout.as_text(item))
end
  end
end
  result
end

function json_value_text(node: Json, fallback: text): text
  intent: get
  if jsonout.type_name(node) == "text" then
  jsonout.as_text(node)
else if jsonout.type_name(node) == "int" then
  to_text(jsonout.as_int(node))
else
  fallback
end
end

function query_has_missionsconfig(path: text): boolean
  intent: find
  let pieces: a list of text = split(path, "?")
  let query: text = unwrap_or(get(pieces, 1), "")
  mutable found: boolean = false
  for item in split(query, "&") do
    let pair: a list of text = split(item, "=")
    let key: text = url_decode(unwrap_or(get(pair, 0), ""))
    let value: text = url_decode(unwrap_or(get(pair, 1), ""))
    if starts_with(key, "groups.") and ends_with(key, ".name") and value == "missionsconfig" then
  set found = true
end
  end
  found
end

public function query_value(path: text, name: text): text
  intent: get
  let pieces: a list of text = split(path, "?")
  let query: text = unwrap_or(get(pieces, 1), "")
  mutable result: text = ""
  for item in split(query, "&") do
    let pair: a list of text = split(item, "=")
    let key: text = url_decode(unwrap_or(get(pair, 0), ""))
    let value: text = url_decode(unwrap_or(get(pair, 1), ""))
    if key == name then
  set result = value
end
  end
  result
end

public function peer_key(path: text): text
  intent: get
  let peer: text = query_value(path, "peer")
  let stoken: text = query_value(path, "stoken")
  if peer != "" then
  peer
else if stoken != "" then
  stoken
else
  "local"
end
end

function pvp_caller_name(path: text, btxt: text): text
  intent: get
  let session: Session = session_for_token(query_value(path, "stoken"))
  if session.name != "" then
  session.name
else
  let req: Json = request_object(btxt)
  let supplied: text = json_text_first(req, "name", "playerName", "")
  if supplied != "" then supplied else peer_key(path) end
end
end

function json_int_or(node: Json, key: text, fallback: integer): integer
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "int" then
  jsonout.as_int(jsonout.obj_get(node, key))
else
  fallback
end
end

function endpoint_is_tutorial(path: text): boolean
  intent: check
  ends_with(path, "/tutorial/start-tutorial") or ends_with(path, "/tutorial/start-branch") or ends_with(path, "/tutorial/early-start-branch") or ends_with(path, "/tutorial/complete-tutorial")
end

function last_segment(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then
  path
else
  substring(path, slash + 1, text_length(path) - slash - 1)
end
end

function movedir_qid(path: text): text
  intent: get
  let parts: a list of text = split(path, "/")
  let segment: text = unwrap_or(get(parts, length(parts) - 3), "")
  let bits: a list of text = split(segment, "-")
  mutable out: text = ""
  mutable index: integer = 0
  while index < length(bits) - 1 do
    if index > 0 then
  set out = out ++ "-"
end

    set out = out ++ unwrap_or(get(bits, index), "")
    set index = index + 1
  end
  out
end

function normalize_qid(qid: text): text
  intent: get
  let bits: a list of text = split(qid, "-")
  if length(bits) < 2 then
  qid
else
  mutable out: text = ""
  mutable index: integer = 0
  while index < length(bits) - 1 do
    if index > 0 then set out = out ++ "-" end
    set out = out ++ unwrap_or(get(bits, index), "")
    set index = index + 1
  end
  out
end
end

function movedir_offset(path: text, index: integer): integer
  intent: get
  let parts: a list of text = split(path, "/")
  unwrap_or(to_integer(unwrap_or(get(parts, length(parts) - index), "x")), 999999)
end

function compact_envelope(result: Json): text
  intent: encode
  jsonout.encode_compact(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result)]))
end

function spaced_envelope(result: Json): text
  intent: encode
  jsonout.encode_spaced(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result)]))
end

function credentials_object(req: Json): Json
  intent: get
  if jsonout.obj_has(req, "credentials") and jsonout.type_name(jsonout.obj_get(req, "credentials")) == "object" then
  jsonout.obj_get(req, "credentials")
else
  jsonout.json_obj([])
end
end

function auth_login_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let credentials: Json = credentials_object(req)
  let udid: text = json_text_or(credentials, "udid", "")
  let bid: text = json_text_or(req, "bid", "")
  let device_name: text = json_text_or(credentials, "deviceName", "")
  let device_model: text = json_text_or(credentials, "deviceModel", "")
  let fingerprint: text = if udid != "" then
  udid
else if bid != "" then
  bid
else if device_name != "" then
  device_name
else if device_model != "" then
  device_model
else
  "local"
end
  let name: text = if device_name != "" then device_name else if device_model != "" then device_model else "Commander" end
  let session: Session = ensure_session(fingerprint, name)
  compact_envelope(jsonout.json_obj([jsonout.json_pair("stoken", jsonout.json_text(session.stoken)), jsonout.json_pair("server_tag", jsonout.json_text("prod")), jsonout.json_pair("userToken", jsonout.json_text("")), jsonout.json_pair("auth_data", jsonout.json_obj([])), jsonout.json_pair("user", jsonout.json_obj([jsonout.json_pair("uid", jsonout.json_int(unwrap_or(to_integer(session.uid), 1000000000001))), jsonout.json_pair("name", jsonout.json_text(session.name)), jsonout.json_pair("level", jsonout.json_int(account_level())), jsonout.json_pair("email", jsonout.json_text("")), jsonout.json_pair("fbid", jsonout.json_text("")), jsonout.json_pair("geo", jsonout.json_text("US")), jsonout.json_pair("naid", jsonout.json_text("")), jsonout.json_pair("cohort", jsonout.json_int(0)), jsonout.json_pair("revenue", jsonout.json_int(0))]))]))
end

function tutorial_response(p: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let tid: text = json_text_first(req, "tid", "tutorialId", "id")
  if tid == "" then
  ""
else if contains(block_tutorials(), tid) then
  jsonout.encode_spaced(jsonout.json_obj([jsonout.json_pair("err", jsonout.json_text("unavailable")), jsonout.json_pair("error", jsonout.json_text("unavailable")), jsonout.json_pair("retry", jsonout.json_bool(false)), jsonout.json_pair("fatal", jsonout.json_bool(false)), jsonout.json_pair("result", jsonout.json_obj([]))]))
else
  let bid: text = json_text_first(req, "bid", "branchId", "")
  let state: text = if contains(live_tutorials(), tid) and not ends_with(p, "/tutorial/complete-tutorial") then
  "started"
else
  "completed"
end
  let branches: Json = if bid == "" then
  jsonout.json_obj([])
else
  jsonout.json_obj([jsonout.json_pair(bid, jsonout.json_obj([jsonout.json_pair("s", jsonout.json_text(state))]))])
end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair(tid, jsonout.json_obj([jsonout.json_pair("current_bid", jsonout.json_text(bid)), jsonout.json_pair("s", jsonout.json_text(state)), jsonout.json_pair("branches", branches)]))]))
end
end

function live_presence_name(peer: text): text
  intent: get
  let key: text = roster_safe(peer)
  for presence in live_peers() do
    if presence.peer == key and presence.name != "" then return presence.name end
  end
  let session: Session = session_for_token(key)
  if session.name != "" then session.name else "Commander" end
end

function pvp_lobby_result(peer: text, include_self: boolean, now_ms: integer): Json
  intent: build
  let key: text = roster_safe(peer)
  mutable peers: a list of Json = []
  for presence in live_peers_at(now_ms) do
    if include_self or presence.peer != key then
  let m: Match = match_for_peer(presence.peer)
  set peers = append(peers, jsonout.json_obj([jsonout.json_pair("peer", jsonout.json_text(presence.peer)), jsonout.json_pair("name", jsonout.json_text(presence.name)), jsonout.json_pair("ageMs", jsonout.json_int(now_ms - presence.seen_ms)), jsonout.json_pair("inMatch", jsonout.json_text(m.match_id))]))
end
  end
  let own_match: Match = match_for_peer(key)
  jsonout.json_obj([jsonout.json_pair("peer", jsonout.json_text(key)), jsonout.json_pair("now", jsonout.json_int(now_ms)), jsonout.json_pair("ttl", jsonout.json_int(presence_ttl_ms())), jsonout.json_pair("peers", jsonout.json_list(peers)), jsonout.json_pair("match", jsonout.json_text(own_match.match_id))])
end

function pvp_heartbeat_response(path: text, btxt: text): text
  intent: encode
  let peer: Presence = touch_presence(peer_key(path), json_text_or(request_object(btxt), "name", ""))
  let now_ms: integer = current_time_ms()
  spaced_envelope(pvp_lobby_result(peer.peer, false, now_ms))
end

function pvp_lobby_response(path: text): text
  intent: encode
  let now_ms: integer = current_time_ms()
  spaced_envelope(pvp_lobby_result(peer_key(path), true, now_ms))
end

function pvp_leave_match_response(path: text): text
  intent: encode
  let peer: text = roster_safe(peer_key(path))
  let m: Match = match_for_peer(peer)
  let left: boolean = m.match_id != ""
  if left then end_match(m.match_id) end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("peer", jsonout.json_text(peer)), jsonout.json_pair("left", jsonout.json_bool(left))]))
end

function relay_match_id(path: text, req: Json, peer: text): text
  intent: get
  let body_match_id: text = json_text_or(req, "matchID", "")
  let query_match_id: text = query_value(path, "matchID")
  if body_match_id != "" then
  roster_safe(body_match_id)
else if query_match_id != "" then
  roster_safe(query_match_id)
else
  match_for_peer(peer).match_id
end
end

function match_by_id(match_id: text): Match
  intent: get
  let key: text = roster_safe(match_id)
  for m in load_matches() do
    if m.match_id == key then return m end
  end
  Match { match_id: "", arena: "", peer_a: "", peer_b: "", created_ms: 0 }
end

function relay_member(m: Match, peer: text): boolean
  intent: check
  let key: text = roster_safe(peer)
  m.match_id != "" and (m.peer_a == key or m.peer_b == key)
end

function pvp_fight_post_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  let match_id: text = relay_match_id(path, req, peer)
  let m: Match = match_by_id(match_id)
  let accepted: boolean = match_id != "" and relay_member(m, peer)
  let error: text = if match_id == "" then "no active match" else if not relay_member(m, peer) then "peer is not in match" else "" end
  let event: FightEvent = if accepted then
  append_fight_event(match_id, peer, json_text_or(req, "kind", "input"), json_text_or(req, "payload", ""))
else
  FightEvent { match_id: match_id, peer: peer, seq: 0, kind: "", payload: "", sent_ms: 0 }
end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("peer", jsonout.json_text(peer)), jsonout.json_pair("matchID", jsonout.json_text(match_id)), jsonout.json_pair("seq", jsonout.json_int(event.seq)), jsonout.json_pair("accepted", jsonout.json_bool(accepted)), jsonout.json_pair("error", jsonout.json_text(error))]))
end

function requested_since(path: text, req: Json): integer
  intent: get
  let body_since: text = if jsonout.obj_has(req, "since") then json_value_text(jsonout.obj_get(req, "since"), "") else "" end
  let raw: text = if body_since != "" then body_since else query_value(path, "since") end
  let parsed: integer = unwrap_or(to_integer(raw), 0)
  if parsed < 0 then 0 else parsed end
end

function pvp_fight_poll_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  let match_id: text = relay_match_id(path, req, peer)
  let since: integer = requested_since(path, req)
  let events: a list of FightEvent = fight_events_since(match_id, since)
  let m: Match = match_by_id(match_id)
  mutable rows: a list of Json = []
  mutable next_seq: integer = since
  for event in events do
    set rows = append(rows, jsonout.json_obj([jsonout.json_pair("seq", jsonout.json_int(event.seq)), jsonout.json_pair("peer", jsonout.json_text(event.peer)), jsonout.json_pair("kind", jsonout.json_text(event.kind)), jsonout.json_pair("payload", jsonout.json_text(event.payload)), jsonout.json_pair("sentMs", jsonout.json_int(event.sent_ms)), jsonout.json_pair("mine", jsonout.json_bool(event.peer == peer))]))
    if event.seq > next_seq then set next_seq = event.seq end
  end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("peer", jsonout.json_text(peer)), jsonout.json_pair("matchID", jsonout.json_text(match_id)), jsonout.json_pair("since", jsonout.json_int(since)), jsonout.json_pair("nextSeq", jsonout.json_int(next_seq)), jsonout.json_pair("opponent", jsonout.json_text(match_opponent(m, peer))), jsonout.json_pair("events", jsonout.json_list(rows))]))
end

function reconciliation_json(peer: text, reconciliation: Reconciliation): Json
  intent: build
  jsonout.json_obj([jsonout.json_pair("peer", jsonout.json_text(peer)), jsonout.json_pair("matchID", jsonout.json_text(reconciliation.match_id)), jsonout.json_pair("status", jsonout.json_text(reconciliation.status)), jsonout.json_pair("winner", jsonout.json_text(reconciliation.winner)), jsonout.json_pair("loser", jsonout.json_text(reconciliation.loser)), jsonout.json_pair("reports", jsonout.json_int(reconciliation.reports))])
end

function pvp_report_result_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  let match_id: text = relay_match_id(path, req, peer)
  let posted_result: text = json_text_or(req, "result", "")
  let outcome: text = if posted_result != "" then posted_result else json_text_or(req, "outcome", "") end
  let reconciliation: Reconciliation = report_result_at(match_id, peer, outcome, current_time_ms())
  let base: Json = reconciliation_json(peer, reconciliation)
  spaced_envelope(jsonout.obj_set(base, "outcome", jsonout.json_text(normalize_outcome(outcome))))
end

function pvp_match_result_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  spaced_envelope(reconciliation_json(peer, reconcile_match(relay_match_id(path, req, peer))))
end

function pvp_arena_state_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let peer: text = caller.peer
  let arena: text = json_text_or(req, "arenaID", "arena_versus")
  mutable wins: integer = 0
  mutable losses: integer = 0
  mutable win_streak: integer = 0
  for report in load_reports() do
    if report.peer == peer and report.outcome == "WON" then
  set wins = wins + 1
  set win_streak = win_streak + 1
else if report.peer == peer and report.outcome == "LOST" then
  set losses = losses + 1
  set win_streak = 0
else if report.peer == peer then
  set win_streak = 0
end
  end
  let m: Match = match_for_peer(peer)
  mutable other_live_peers: integer = 0
  for presence in live_peers() do
    if presence.peer != peer then set other_live_peers = other_live_peers + 1 end
  end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("pid", jsonout.json_text(peer)), jsonout.json_pair("winStreak", jsonout.json_int(win_streak)), jsonout.json_pair("wins", jsonout.json_int(wins)), jsonout.json_pair("losses", jsonout.json_int(losses)), jsonout.json_pair("arenaID", jsonout.json_text(arena)), jsonout.json_pair("matchID", jsonout.json_text(m.match_id)), jsonout.json_pair("live", jsonout.json_bool(m.match_id != "")), jsonout.json_pair("livePeers", jsonout.json_int(other_live_peers))]))
end

function pvp_lock_in_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let arena: text = json_text_or(req, "arenaID", "arena_versus")
  let posted: a list of Json = json_list_or_empty(req, "heroes")
  let hero_nodes: a list of Json = if length(posted) > 0 then posted else json_list_or_empty(req, "team") end
  let heroes: a list of text = text_list_from_json(jsonout.json_list(hero_nodes))
  if length(heroes) == 0 then
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("locked", jsonout.json_bool(false)), jsonout.json_pair("matchID", jsonout.json_text(match_for_peer(caller.peer).match_id)), jsonout.json_pair("live", jsonout.json_bool(match_for_peer(caller.peer).match_id != "")), jsonout.json_pair("arenaID", jsonout.json_text(arena)), jsonout.json_pair("error", jsonout.json_text("heroes are required"))]))
else
  store_roster(caller.peer, caller.name, heroes)
  let m: Match = pair_peers(caller.peer, arena)
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("locked", jsonout.json_bool(true)), jsonout.json_pair("matchID", jsonout.json_text(m.match_id)), jsonout.json_pair("live", jsonout.json_bool(m.match_id != "")), jsonout.json_pair("arenaID", jsonout.json_text(arena)), jsonout.json_pair("error", jsonout.json_text(""))]))
end
end

function pvp_select_opponent_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let arena: text = json_text_or(req, "arenaID", "arena_versus")
  let m: Match = pair_peers(caller.peer, arena)
  let fallback_opponent: text = if m.match_id != "" then match_opponent(m, caller.peer) else "" end
  let opponent_id: text = json_text_or(req, "opponentID", fallback_opponent)
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("selected", jsonout.json_bool(true)), jsonout.json_pair("matchID", jsonout.json_text(m.match_id)), jsonout.json_pair("live", jsonout.json_bool(m.match_id != "")), jsonout.json_pair("opponentIndex", jsonout.json_int(json_int_or(req, "index", 0))), jsonout.json_pair("opponentID", jsonout.json_text(opponent_id))]))
end

function pvp_quit_arena_response(path: text, btxt: text): text
  intent: encode
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let m: Match = match_for_peer(caller.peer)
  if m.match_id != "" then
  end_match(m.match_id)
  purge_fight_events(m.match_id)
end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("quit", jsonout.json_bool(true)), jsonout.json_pair("matchID", jsonout.json_text(m.match_id))]))
end

function pvp_matchups(user_heroes: a list of text, opponent_heroes: a list of text): a list of Json
  intent: build
  mutable matchups: a list of Json = []
  mutable index: integer = 0
  for opponent_hero in opponent_heroes do
    let user_hero: text = unwrap_or(get(user_heroes, index), unwrap_or(get(user_heroes, 0), opponent_hero))
    set matchups = append(matchups, jsonout.json_obj([jsonout.json_pair("userHero", jsonout.json_text(user_hero)), jsonout.json_pair("opponentHero", jsonout.json_text(opponent_hero)), jsonout.json_pair("aip", jsonout.json_text("normal")), jsonout.json_pair("state", jsonout.json_text("none")), jsonout.json_pair("outcome", jsonout.json_text("NONE")), jsonout.json_pair("basePoints", jsonout.json_dec(0)), jsonout.json_pair("actualPoints", jsonout.json_dec(0)), jsonout.json_pair("fightId", jsonout.json_text(""))]))
    set index = index + 1
  end
  matchups
end

function pvp_opponent_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let arena: text = json_text_or(req, "arenaID", "arena_versus")
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let peer: text = caller.peer
  let m: Match = pair_peers(peer, arena)
  mutable caller_roster: Roster = Roster { peer: peer, name: caller.name, heroes: gamedata.default_team() }
  mutable opponent: Roster = opponent_roster(peer)
  for roster in load_rosters() do
    if roster.peer == peer then set caller_roster = roster end
  end
  if m.match_id != "" then
  let opponent_peer: text = match_opponent(m, peer)
  mutable found: boolean = false
  for roster in load_rosters() do
    if roster.peer == opponent_peer then
  set opponent = roster
  set found = true
end
  end
  if not found then
  set opponent = Roster { peer: opponent_peer, name: live_presence_name(opponent_peer), heroes: gamedata.default_team() }
end
end
  mutable opponent_uid: integer = 1000000000
  mutable session_index: integer = 0
  for session in load_sessions() do
    if session.stoken == opponent.peer then set opponent_uid = 1000000001 + session_index end
    set session_index = session_index + 1
  end
  let opponent_heroes: a list of text = gamedata.resolve_team(opponent.heroes)
  mutable team: a list of Json = []
  for hero in opponent_heroes do
    set team = append(team, gamedata.build_hero_entry(hero, 1, 1))
  end
  let matchups: a list of Json = pvp_matchups(gamedata.resolve_team(caller_roster.heroes), opponent_heroes)
  let portrait: text = unwrap_or(get(opponent_heroes, 0), "")
  let arena_stats: Json = jsonout.json_obj([jsonout.json_pair("pid", jsonout.json_text(arena)), jsonout.json_pair("winStreak", jsonout.json_int(0)), jsonout.json_pair("wins", jsonout.json_int(0)), jsonout.json_pair("losses", jsonout.json_int(0)), jsonout.json_pair("longestStreak", jsonout.json_int(0)), jsonout.json_pair("findAttempts", jsonout.json_int(0))])
  let match_data: Json = jsonout.json_obj([jsonout.json_pair("pid", jsonout.json_text(arena)), jsonout.json_pair("matchID", jsonout.json_text(m.match_id)), jsonout.json_pair("live", jsonout.json_bool(m.match_id != "")), jsonout.json_pair("state", jsonout.json_text("selecting")), jsonout.json_pair("opponentIndex", jsonout.json_int(0)), jsonout.json_pair("opponents", jsonout.json_list([jsonout.json_obj([jsonout.json_pair("uid", jsonout.json_int(opponent_uid)), jsonout.json_pair("team", jsonout.json_list(team)), jsonout.json_pair("matchups", jsonout.json_list(matchups)), jsonout.json_pair("userData", jsonout.json_obj([jsonout.json_pair("name", jsonout.json_text(opponent.name)), jsonout.json_pair("tag", jsonout.json_text("LAN")), jsonout.json_pair("level", jsonout.json_int(40)), jsonout.json_pair("portrait", jsonout.json_text(portrait)), jsonout.json_pair("factionId", jsonout.json_text("")), jsonout.json_pair("pvpStats", arena_stats)]))])])), jsonout.json_pair("fightRewards", jsonout.json_list([])), jsonout.json_pair("seriesRewards", jsonout.json_obj([jsonout.json_pair("claimed", jsonout.json_bool(false)), jsonout.json_pair("box", jsonout.json_text(""))])), jsonout.json_pair("milestones", jsonout.json_list([]))])
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("pvpMatchData", jsonout.json_list([match_data])), jsonout.json_pair("pvpUserData", jsonout.json_list([arena_stats]))]))
end

function pvp_static_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if ends_with(p, "/pvp/heartbeat") then
  pvp_heartbeat_response(path, btxt)
else if ends_with(p, "/pvp/lobby") then
  pvp_lobby_response(path)
else if ends_with(p, "/pvp/leave-match") then
  pvp_leave_match_response(path)
else if ends_with(p, "/pvp/fight-post") then
  pvp_fight_post_response(path, btxt)
else if ends_with(p, "/pvp/fight-poll") then
  pvp_fight_poll_response(path, btxt)
else if ends_with(p, "/pvp/report-result") then
  pvp_report_result_response(path, btxt)
else if ends_with(p, "/pvp/match-result") then
  pvp_match_result_response(path, btxt)
else if ends_with(p, "/pvp/get-login-data") then
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  ""
else if ends_with(p, "/pvp/get-user-data") or ends_with(p, "/pvp/get-active-pvp-data") then
  pvp_arena_state_response(path, btxt)
else if ends_with(p, "/pvp/lock-in") then
  pvp_lock_in_response(path, btxt)
else if ends_with(p, "/pvp/select-opponent") then
  pvp_select_opponent_response(path, btxt)
else if ends_with(p, "/pvp/quit-arena") then
  pvp_quit_arena_response(path, btxt)
else if ends_with(p, "/pvp/find-arena-opponent") or ends_with(p, "/pvp/get-new-arena-opponent") or ends_with(p, "/pvp/get-opponents") then
  pvp_opponent_response(path, btxt)
else
  ""
end
end

function static_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if ends_with(p, "/auth/login") then
  auth_login_response(path, btxt)
else if ends_with(p, "/bcg/getUserData") then
  compact_envelope(gamedata.build_user_data(get_saved_team()))
else if ends_with(p, "/autorefresh/grouprefresh") then
  let updates: a list of Json = if query_has_missionsconfig(path) then
  [gamedata.build_missions_autorefresh_update()]
else
  []
end
  compact_envelope(jsonout.json_obj([jsonout.json_pair("updates", jsonout.json_list(updates))]))
else if ends_with(p, "/base/active") then
  compact_envelope(gamedata.build_base_active())
else if contains_text(p, "/pvp/") then
  pvp_static_dynamic(path, p, btxt)
else if endpoint_is_tutorial(p) then
  tutorial_response(p, btxt)
else if ends_with(p, "/bcg/getBaseHeroData") then
  let req: Json = request_object(btxt)
  spaced_envelope(gamedata.build_base_hero_details(json_list_or_empty(req, "heroes")))
else if contains_text(p, "/quests/quest-detail/") then
  let req: Json = request_object(btxt)
  spaced_envelope(gamedata.build_quest_detail(last_segment(p), json_text_or(req, "setId", "story_act1")))
else
  ""
end
end

function quest_begin_response(p: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  mutable posted: a list of text = []
  mutable index: integer = 0
  while index < gamedata.team_size_max() do
  let member: text = json_text_or(req, "tm" ++ to_text(index), "")
  if member != "" then set posted = append(posted, member) end
  set index = index + 1
end
  let overflow: text = json_text_or(req, "tm" ++ to_text(gamedata.team_size_max()), "")
  if overflow != "" then set posted = append(posted, overflow) end
  if length(posted) > 0 then
  set_saved_team(posted)
end
  let qid: text = last_segment(p)
  set_position(qid, 0, 1, false)
  spaced_envelope(gamedata.build_quest_begin(qid, json_text_or(req, "setId", "story_act1"), get_saved_team()))
end

function movedir_response(p: text): text
  intent: encode
  let qid: text = movedir_qid(p)
  mutable offx: integer = movedir_offset(p, 2)
  mutable offy: integer = movedir_offset(p, 1)
  if offx == 999999 or offy == 999999 then
  set offx = 1
  set offy = 0
  end
  let start: Position = position_for(qid)
  if start.pending then
  set offx = 0
  set offy = 0
  else
  let candidate_x: integer = start.x + offx
  let candidate_y: integer = start.y + offy
  if candidate_x >= 0 and candidate_x < gamedata.quest_dim() and candidate_y == gamedata.quest_path_col() then
  set_position(qid, candidate_x, candidate_y, gamedata.quest_has_encounter(candidate_x))
  else
    set offx = 0
    set offy = 0
  end
  end
  spaced_envelope(gamedata.build_quest_movedir(qid, offx, offy, start.x, start.y, get_saved_team()))
end

function resolve_match_response(path: text, btxt: text): text
  intent: resolve
  let req: Json = request_object(btxt)
  let nested: Json = if jsonout.obj_has(req, "results") and jsonout.type_name(jsonout.obj_get(req, "results")) == "object" then jsonout.obj_get(req, "results") else jsonout.json_obj([]) end
  let outcome: text = json_text_or(nested, "result", json_text_or(req, "result", ""))
  if uppercase(outcome) == "WON" then
  let submitted: text = json_text_or(req, "qid", "")
  let state: ServerState = load_state()
  mutable positions: a list of Position = []
  for position in state.positions do
    let clears: boolean = if submitted == "" then true else position.qid == normalize_qid(submitted) end
    set positions = append(positions, Position { qid: position.qid, x: position.x, y: position.y, pending: if clears then false else position.pending end })
  end
  save_state(ServerState { team: state.team, positions: positions })
end
  let peer: text = peer_key(path)
  let m: Match = match_for_peer(peer)
  if m.match_id != "" and outcome != "" then
  report_result_at(m.match_id, peer, normalize_outcome(outcome), current_time_ms())
end
  ""
end

function saved_team_envelope(team_id: text, heroes: a list of text): text
  intent: encode
  let active_team_id: text = if starts_with(team_id, "PVP") then "arena_versus" else "1.1.1-" ++ team_id end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("updates", jsonout.json_obj([jsonout.json_pair("savedTeams", jsonout.json_list([gamedata.build_saved_team(team_id, heroes)])), jsonout.json_pair("activeTeams", jsonout.json_list([gamedata.build_active_team(active_team_id, heroes)]))])), jsonout.json_pair("deletes", jsonout.json_obj([]))]))
end

function saved_team_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let team_id: text = if jsonout.obj_has(req, "teamID") then
  json_value_text(jsonout.obj_get(req, "teamID"), "0")
else
  "0"
end
  let heroes: a list of text = text_list_from_json(if jsonout.obj_has(req, "heroes") then
  jsonout.obj_get(req, "heroes")
else
  jsonout.json_list([])
end)
  set_saved_team(heroes)
  let peer: text = peer_key(path)
  let session: Session = session_for_token(peer)
  let default_name: text = if session.name != "" then session.name else "Commander" end
  let name: text = if jsonout.obj_has(req, "name") and jsonout.type_name(jsonout.obj_get(req, "name")) == "text" then jsonout.as_text(jsonout.obj_get(req, "name")) else default_name end
  store_roster(peer, name, heroes)
  saved_team_envelope(team_id, heroes)
end

function quest_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if contains_text(p, "/quests/quest-begin/") then quest_begin_response(p, btxt)
  else if contains_text(p, "/quests/quest-movedir/") then movedir_response(p)
  else if contains_text(p, "/matches/resolve-match/") then resolve_match_response(path, btxt)
  else if ends_with(p, "/bcg/setSavedTeam") then saved_team_response(path, btxt)
  else ""
  end
end

