  intent: encode
  let profile: Json = jsonout.json_obj([jsonout.json_pair("uid", jsonout.json_text(uid)), jsonout.json_pair("aid", jsonout.json_text("offline-alliance")), jsonout.json_pair("name", jsonout.json_text(name)), jsonout.json_pair("tag", jsonout.json_text("")), jsonout.json_pair("locale", jsonout.json_text("en")), jsonout.json_pair("language", jsonout.json_text("en")), jsonout.json_pair("highestRank", jsonout.json_text("")), jsonout.json_pair("activeTitle", jsonout.json_null()), jsonout.json_pair("myTitles", jsonout.json_list([])), jsonout.json_pair("lastLogin", jsonout.json_int(now)), jsonout.json_pair("alliance", synthetic_alliance(uid, name, now)), jsonout.json_pair("levelRewards", jsonout.json_obj([jsonout.json_pair("level", jsonout.json_int(level)), jsonout.json_pair("enabled", jsonout.json_bool(true)), jsonout.json_pair("isEnabled", jsonout.json_bool(true)), jsonout.json_pair("types", jsonout.json_list([]))])), jsonout.json_pair("resources", jsonout.json_obj([])), jsonout.json_pair("gameIntStats", jsonout.json_obj([jsonout.json_pair("level", jsonout.json_int(level))])), jsonout.json_pair("gameFloatStats", jsonout.json_obj([])), jsonout.json_pair("gameStringStats", jsonout.json_obj([])), jsonout.json_pair("gameJSONStats", jsonout.json_obj([])), jsonout.json_pair("gameData", jsonout.json_obj([])), jsonout.json_pair("_createTime", jsonout.json_int(now)), jsonout.json_pair("_abbrivated", jsonout.json_bool(false))])
