  emit("dyn_movedir_east_3_blocked", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 0, 0, 2, 1, team)))
  emit("dyn_movedir_north_blocked", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 0, 0, 2, 1, team)))
