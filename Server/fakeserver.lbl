use jsonout
use gamedata
use server_paths

record ResponseChoice
  source: text
  body: text
end

record Position
  qid: text
  x: integer
  y: integer
  pending: boolean
  completed: boolean
  cleared: a list of text
end

record ServerState
  team: a list of text
  positions: a list of Position
end

record Roster
  peer: text
  name: text
  heroes: a list of text
end

record Session
  fingerprint: text
  stoken: text
  uid: text
  name: text
end

record Presence
  peer: text
  name: text
  seen_ms: integer
end

record Match
  match_id: text
  arena: text
  peer_a: text
  peer_b: text
  created_ms: integer
end

record FightEvent
  match_id: text
  peer: text
  seq: integer
  kind: text
  payload: text
  sent_ms: integer
end

record MatchReport
  match_id: text
  peer: text
  outcome: text
  reported_ms: integer
end

record Reconciliation
  match_id: text
  status: text
  winner: text
  loser: text
  reports: integer
end

record Request
  method: text
  path: text
  body: text
  query: text
  headers: a mapping from text to text
end

function last_slash(path: text): integer
  intent: find
  mutable result: integer = -1
  mutable index: integer = 0
  while index < text_length(path) do
    if substring(path, index, 1) == "/" then
  set result = index
end
    set index = index + 1
  end
  result
end

public function here(): text
  intent: get
  server_paths.entry_directory("Server/fakeserver.lbl")
end

public function resp_dir(): text
  intent: get
  path_join(here(), "responses")
end

public function log_dir(): text
  intent: get
  path_join(here(), "logs")
end

public function pem_path(): text
  intent: get
  path_join(path_join(here(), "certs"), "server.pem")
end

public function logfile(): text
  intent: get
  path_join(log_dir(), "requests.log")
end

function state_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-state")
end

function tutorial_state_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-tutorial")
end

public function reset_tutorial_login(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(tutorial_state_file(), "0")
end

function tutorial_login_seen(): boolean
  intent: check
  -- `and` does not short-circuit, so read_file must be guarded by a nested if rather
  -- than by the left-hand operand. On a fresh clone Server/logs/ is gitignored and the
  -- state file does not exist, so the unguarded read aborted the server mid-session.
  if file_exists(tutorial_state_file()) then
  trim(read_file(tutorial_state_file())) == "1"
else
  false
end
end

public function tutorial_login_started_response(): text
  intent: encode
  compact_envelope(jsonout.json_obj([jsonout.json_pair("FTE", jsonout.json_obj([pair_int("s", 1), pair_text("current_bid", "FTEIntroQuest"), jsonout.json_pair("branches", jsonout.json_obj([jsonout.json_pair("FTEIntroQuest", jsonout.json_obj([pair_int("s", 1)]))]))]))]))
end

public function tutorial_login_completed_response(): text
  intent: encode
  compact_envelope(jsonout.json_obj([jsonout.json_pair("FTE", jsonout.json_obj([pair_int("s", 2), pair_text("current_bid", "FTEComplete"), jsonout.json_pair("branches", jsonout.json_obj([]))]))]))
end

function tutorial_login_response(): text
  intent: encode
  if tutorial_login_seen() then
  tutorial_login_completed_response()
else
  create_dir(log_dir())
  write_file(tutorial_state_file(), "1")
  tutorial_login_started_response()
end
end

public function block_tutorials(): a list of text
  intent: return
  ["ShieldTutorial"]
end

public function live_tutorials(): a list of text
  intent: return
  ["FTE"]
end

function parse_position(fields: a list of text): Position
  intent: read one saved quest position from the fields of a Q line
  let joined: text = unwrap_or(get(fields, 7), "")
  Position { qid: unwrap_or(get(fields, 1), ""), x: unwrap_or(to_integer(unwrap_or(get(fields, 2), "0")), 0), y: unwrap_or(to_integer(unwrap_or(get(fields, 3), "1")), 1), pending: unwrap_or(get(fields, 5), "0") == "1", completed: unwrap_or(get(fields, 6), "0") == "1", cleared: if joined == "" then [] else split(joined, ";") end }
end

function state_from_lines(lines: a list of text): ServerState
  intent: rebuild the saved squad and quest positions from the state file lines
  mutable team: a list of text = []
  mutable positions: a list of Position = []
  for line in lines do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    if kind == "S" and unwrap_or(get(fields, 1), "") != "" then
      set team = split(unwrap_or(get(fields, 1), ""), ",")
    else if kind == "Q" and parse_position(fields).qid != "" then
      set positions = append(positions, parse_position(fields))
    end
  end
  ServerState { team: team, positions: positions }
end

function load_state(): ServerState
  intent: get the saved squad and quest positions or an empty state
  if not file_exists(state_file()) then
    ServerState { team: [], positions: [] }
  else
    state_from_lines(split(read_file(state_file()), "\n"))
  end
end

function save_state(state: ServerState): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = ["S|" ++ join(state.team, ",")]
  for position in state.positions do
    set lines = append(lines, "Q|" ++ position.qid ++ "|" ++ to_text(position.x) ++ "|" ++ to_text(position.y) ++ "|1|" ++ if position.pending then "1" else "0" end ++ "|" ++ if position.completed then "1" else "0" end ++ "|" ++ join(position.cleared, ";"))
  end
  write_file(state_file(), join(lines, "\n"))
end

public function get_saved_team(): a list of text
  intent: get
  load_state().team
end

public function reset_saved_team(): nothing
  intent: reset
  let state: ServerState = load_state()
  save_state(ServerState { team: [], positions: state.positions })
end

public function reset_quest_positions(): nothing
  intent: reset
  let state: ServerState = load_state()
  save_state(ServerState { team: state.team, positions: [] })
end

function set_saved_team(team: a list of text): nothing
  intent: save
  -- A malformed or transient squad update must never erase the last valid choice.
  -- The default trio is only used when no squad has ever been saved.
  let resolved: a list of text = gamedata.resolve_team(team)
  if length(team) > 0 and resolved == team then
  let state: ServerState = load_state()
  save_state(ServerState { team: resolved, positions: state.positions })
end
end

function position_exists(qid: text): boolean
  intent: check
  for position in load_state().positions do
    if position.qid == qid then return true end
  end
  false
end

function position_for(qid: text): Position
  intent: get
  let state: ServerState = load_state()
  for position in state.positions do
    if position.qid == qid then
  return position
end
  end
  Position { qid: qid, x: 0, y: 1, pending: false, completed: false, cleared: [] }
end

function set_position(position: Position): nothing
  intent: save one quest position replacing any earlier entry for the same quest
  let state: ServerState = load_state()
  mutable positions: a list of Position = []
  mutable replaced: boolean = false
  for existing in state.positions do
    if existing.qid == position.qid then
      set positions = append(positions, position)
      set replaced = true
    else
      set positions = append(positions, existing)
    end
  end
  if not replaced then set positions = append(positions, position) end
  save_state(ServerState { team: state.team, positions: positions })
end

function roster_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-rosters")
end

function roster_safe(value: text): text
  intent: clean
  replace(replace(replace(value, "|", "_"), ",", "_"), "\n", "_")
end

function session_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-sessions")
end

function presence_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-presence")
end

function match_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-matches")
end

function fight_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-fights")
end

function report_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-results")
end

function relay_safe(value: text): text
  intent: clean
  replace(replace(replace(value, "|", "_"), "\n", "_"), "\r", "_")
end

public function presence_ttl_ms(): integer
  intent: get
  let configured: integer = unwrap_or(to_integer(unwrap_or(env_get("TFTF_PRESENCE_TTL_MS"), "")), 0)
  if configured > 0 then configured else 15000 end
end

public function account_level(): integer
  intent: get
  let configured: integer = unwrap_or(to_integer(unwrap_or(env_get("TFTF_ACCOUNT_LEVEL"), "")), 0)
  if configured > 0 then configured else 30 end
end

public function load_sessions(): a list of Session
  intent: load
  if not file_exists(session_file()) then
  []
else
  mutable sessions: a list of Session = []
  for line in split(read_file(session_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let fingerprint: text = unwrap_or(get(fields, 1), "")
    let stoken: text = unwrap_or(get(fields, 2), "")
    let uid: text = unwrap_or(get(fields, 3), "")
    let name: text = unwrap_or(get(fields, 4), "")
    if kind == "S" and fingerprint != "" and stoken != "" and uid != "" then
  set sessions = append(sessions, Session { fingerprint: fingerprint, stoken: stoken, uid: uid, name: name })
end
  end
  sessions
end
end

public function reset_sessions(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(session_file(), "")
end

public function session_for_token(stoken: text): Session
  intent: get
  for session in load_sessions() do
    if session.stoken == stoken then return session end
  end
  Session { fingerprint: "", stoken: "", uid: "", name: "" }
end

public function has_session_for_token(stoken: text): boolean
  intent: check
  session_for_token(stoken).stoken != ""
end

public function load_presence(): a list of Presence
  intent: load
  if not file_exists(presence_file()) then
  []
else
  mutable presence: a list of Presence = []
  for line in split(read_file(presence_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let peer: text = unwrap_or(get(fields, 1), "")
    let name: text = unwrap_or(get(fields, 2), "")
    let seen_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 3), "0")), 0)
    if kind == "P" and peer != "" then
  set presence = append(presence, Presence { peer: peer, name: name, seen_ms: seen_ms })
end
  end
  presence
end
end

public function reset_presence(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(presence_file(), "")
end

public function touch_presence_at(peer: text, name: text, now_ms: integer): Presence
  intent: save
  create_dir(log_dir())
  let key: text = roster_safe(peer)
  mutable previous_name: text = ""
  mutable lines: a list of text = []
  for presence in load_presence() do
    if presence.peer == key then
  set previous_name = presence.name
else
  set lines = append(lines, "P|" ++ roster_safe(presence.peer) ++ "|" ++ roster_safe(presence.name) ++ "|" ++ roster_safe(to_text(presence.seen_ms)))
end
  end
  let session: Session = session_for_token(key)
  let selected_name: text = if name != "" then name else if previous_name != "" then previous_name else if session.name != "" then session.name else "Commander" end
  let touched: Presence = Presence { peer: key, name: roster_safe(selected_name), seen_ms: now_ms }
  set lines = append(lines, "P|" ++ roster_safe(touched.peer) ++ "|" ++ roster_safe(touched.name) ++ "|" ++ roster_safe(to_text(touched.seen_ms)))
  write_file(presence_file(), join(lines, "\n"))
  touched
end

public function touch_presence(peer: text, name: text): Presence
  intent: save
  touch_presence_at(peer, name, current_time_ms())
end

public function live_peers_at(now_ms: integer): a list of Presence
  intent: get
  mutable peers: a list of Presence = []
  for presence in load_presence() do
    let age: integer = now_ms - presence.seen_ms
    if age >= 0 and age < presence_ttl_ms() then
  set peers = append(peers, presence)
end
  end
  peers
end

public function live_peers(): a list of Presence
  intent: get
  live_peers_at(current_time_ms())
end

public function load_matches(): a list of Match
  intent: load
  if not file_exists(match_file()) then
  []
else
  mutable matches: a list of Match = []
  for line in split(read_file(match_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let match_id: text = unwrap_or(get(fields, 1), "")
    let arena: text = unwrap_or(get(fields, 2), "")
    let peer_a: text = unwrap_or(get(fields, 3), "")
    let peer_b: text = unwrap_or(get(fields, 4), "")
    let created_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 5), "0")), 0)
    if kind == "M" and match_id != "" then
  set matches = append(matches, Match { match_id: match_id, arena: arena, peer_a: peer_a, peer_b: peer_b, created_ms: created_ms })
end
  end
  matches
end
end

function save_matches(matches: a list of Match): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = []
  for m in matches do
    set lines = append(lines, "M|" ++ roster_safe(m.match_id) ++ "|" ++ roster_safe(m.arena) ++ "|" ++ roster_safe(m.peer_a) ++ "|" ++ roster_safe(m.peer_b) ++ "|" ++ roster_safe(to_text(m.created_ms)))
  end
  write_file(match_file(), join(lines, "\n"))
end

public function reset_matches(): nothing
  intent: reset
  save_matches([])
end

public function match_for_peer(peer: text): Match
  intent: get
  let key: text = roster_safe(peer)
  for m in load_matches() do
    if m.peer_a == key or m.peer_b == key then return m end
  end
  Match { match_id: "", arena: "", peer_a: "", peer_b: "", created_ms: 0 }
end

public function match_opponent(m: Match, peer: text): text
  intent: get
  let key: text = roster_safe(peer)
  if m.peer_a == key then m.peer_b else if m.peer_b == key then m.peer_a else "" end
end

public function end_match(match_id: text): nothing
  intent: save
  mutable remaining: a list of Match = []
  for m in load_matches() do
    if m.match_id != match_id then set remaining = append(remaining, m) end
  end
  save_matches(remaining)
end

public function pair_peers_at(peer: text, arena: text, now_ms: integer): Match
  intent: pair
  let caller: Presence = touch_presence_at(peer, "", now_ms)
  let existing: Match = match_for_peer(caller.peer)
  if existing.match_id != "" then return existing end
  mutable candidate: Presence = Presence { peer: "", name: "", seen_ms: -1 }
  for live in live_peers_at(now_ms) do
    if live.peer != caller.peer and match_for_peer(live.peer).match_id == "" and live.seen_ms > candidate.seen_ms then
  set candidate = live
end
  end
  if candidate.peer == "" then
  Match { match_id: "", arena: "", peer_a: "", peer_b: "", created_ms: 0 }
else
  let matches: a list of Match = load_matches()
  let base_id: text = roster_safe(arena) ++ "-" ++ to_text(now_ms)
  mutable collides: boolean = false
  for m in matches do
    if m.match_id == base_id then set collides = true end
  end
  let match_id: text = if collides then base_id ++ "-" ++ to_text(length(matches)) else base_id end
  let created: Match = Match { match_id: match_id, arena: roster_safe(arena), peer_a: caller.peer, peer_b: candidate.peer, created_ms: now_ms }
  save_matches(append(matches, created))
  created
end
end

public function pair_peers(peer: text, arena: text): Match
  intent: pair
  pair_peers_at(peer, arena, current_time_ms())
end

public function load_fight_events(): a list of FightEvent
  intent: load
  if not file_exists(fight_file()) then
  []
else
  mutable events: a list of FightEvent = []
  for line in split(read_file(fight_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let match_id: text = unwrap_or(get(fields, 1), "")
    let peer: text = unwrap_or(get(fields, 2), "")
    let seq: integer = unwrap_or(to_integer(unwrap_or(get(fields, 3), "0")), 0)
    let event_kind: text = unwrap_or(get(fields, 4), "")
    let payload: text = unwrap_or(get(fields, 5), "")
    let sent_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 6), "0")), 0)
    if kind == "F" and match_id != "" then
  set events = append(events, FightEvent { match_id: match_id, peer: peer, seq: seq, kind: event_kind, payload: payload, sent_ms: sent_ms })
end
  end
  events
end
end

function save_fight_events(events: a list of FightEvent): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = []
  for event in events do
    set lines = append(lines, "F|" ++ roster_safe(event.match_id) ++ "|" ++ roster_safe(event.peer) ++ "|" ++ to_text(event.seq) ++ "|" ++ relay_safe(event.kind) ++ "|" ++ relay_safe(event.payload) ++ "|" ++ to_text(event.sent_ms))
  end
  write_file(fight_file(), join(lines, "\n"))
end

public function reset_fight_events(): nothing
  intent: reset
  save_fight_events([])
end

public function next_fight_seq(match_id: text): integer
  intent: get
  let key: text = roster_safe(match_id)
  mutable highest: integer = 0
  for event in load_fight_events() do
    if event.match_id == key and event.seq > highest then set highest = event.seq end
  end
  highest + 1
end

public function append_fight_event_at(match_id: text, peer: text, kind: text, payload: text, now_ms: integer): FightEvent
  intent: save
  let event: FightEvent = FightEvent { match_id: roster_safe(match_id), peer: roster_safe(peer), seq: next_fight_seq(match_id), kind: relay_safe(kind), payload: relay_safe(payload), sent_ms: now_ms }
  save_fight_events(append(load_fight_events(), event))
  event
end

public function append_fight_event(match_id: text, peer: text, kind: text, payload: text): FightEvent
  intent: save
  append_fight_event_at(match_id, peer, kind, payload, current_time_ms())
end

function append_event_in_seq_order(events: a list of FightEvent, candidate: FightEvent): a list of FightEvent
  intent: sort
  mutable ordered: a list of FightEvent = []
  mutable inserted: boolean = false
  for event in events do
    if not inserted and candidate.seq < event.seq then
  set ordered = append(ordered, candidate)
  set inserted = true
end
    set ordered = append(ordered, event)
  end
  if not inserted then set ordered = append(ordered, candidate) end
  ordered
end

public function fight_events_since(match_id: text, after_seq: integer): a list of FightEvent
  intent: get
  let key: text = roster_safe(match_id)
  mutable events: a list of FightEvent = []
  for event in load_fight_events() do
    if event.match_id == key and event.seq > after_seq then set events = append_event_in_seq_order(events, event) end
  end
  events
end

public function purge_fight_events(match_id: text): nothing
  intent: save
  let key: text = roster_safe(match_id)
  mutable remaining: a list of FightEvent = []
  for event in load_fight_events() do
    if event.match_id != key then set remaining = append(remaining, event) end
  end
  save_fight_events(remaining)
end

public function load_reports(): a list of MatchReport
  intent: load
  if not file_exists(report_file()) then
  []
else
  mutable reports: a list of MatchReport = []
  for line in split(read_file(report_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let match_id: text = unwrap_or(get(fields, 1), "")
    let peer: text = unwrap_or(get(fields, 2), "")
    let outcome: text = unwrap_or(get(fields, 3), "")
    let reported_ms: integer = unwrap_or(to_integer(unwrap_or(get(fields, 4), "0")), 0)
    if kind == "R" and match_id != "" then
  set reports = append(reports, MatchReport { match_id: match_id, peer: peer, outcome: outcome, reported_ms: reported_ms })
end
  end
  reports
end
end

function save_reports(reports: a list of MatchReport): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = []
  for report in reports do
    set lines = append(lines, "R|" ++ roster_safe(report.match_id) ++ "|" ++ roster_safe(report.peer) ++ "|" ++ relay_safe(report.outcome) ++ "|" ++ to_text(report.reported_ms))
  end
  write_file(report_file(), join(lines, "\n"))
end

public function reset_reports(): nothing
  intent: reset
  save_reports([])
end

public function normalize_outcome(value: text): text
  intent: normalize
  let upper: text = uppercase(value)
  if upper == "WIN" or upper == "WON" or upper == "VICTORY" then
  "WON"
else if upper == "LOSE" or upper == "LOST" or upper == "LOSS" or upper == "DEFEAT" then
  "LOST"
else if upper == "DRAW" or upper == "TIE" then
  "DRAW"
else
  "UNKNOWN"
end
end

function report_is_more_recent(first: MatchReport, second: MatchReport): boolean
  intent: compare
  first.reported_ms > second.reported_ms or (first.reported_ms == second.reported_ms and first.peer < second.peer)
end

function latest_report_for_peer(match_id: text, peer: text): MatchReport
  intent: get
  let key: text = roster_safe(match_id)
  let reporter: text = roster_safe(peer)
  mutable latest: MatchReport = MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
  for report in load_reports() do
    if report.match_id == key and report.peer == reporter and (latest.peer == "" or report_is_more_recent(report, latest)) then
  set latest = report
end
  end
  latest
end

function reports_for_reconciliation(match_id: text): a list of MatchReport
  intent: get
  let key: text = roster_safe(match_id)
  mutable first: MatchReport = MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
  mutable second: MatchReport = MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
  for report in load_reports() do
    let latest: MatchReport = latest_report_for_peer(key, report.peer)
    if report.match_id == key and report.reported_ms == latest.reported_ms and report.outcome == latest.outcome then
  if report.peer != first.peer and (first.peer == "" or report_is_more_recent(report, first)) then
  set second = first
  set first = report
else if report.peer != first.peer and (second.peer == "" or report_is_more_recent(report, second)) then
  set second = report
end
end
  end
  mutable selected: a list of MatchReport = []
  if first.peer != "" then set selected = append(selected, first) end
  if second.peer != "" and second.peer != first.peer then set selected = append(selected, second) end
  selected
end

function unknown_report(): MatchReport
  intent: build the placeholder report used when a peer has not reported
  MatchReport { match_id: "", peer: "", outcome: "UNKNOWN", reported_ms: 0 }
end

function settled(key: text, status: text, winner: text, loser: text): Reconciliation
  intent: build a reconciliation backed by two reports
  Reconciliation { match_id: key, status: status, winner: winner, loser: loser, reports: 2 }
end

function disputed_reconciliation(key: text, first: MatchReport, second: MatchReport): Reconciliation
  intent: settle disagreeing reports by trusting whichever peer reported first
  let tiebreak: MatchReport = if first.reported_ms < second.reported_ms or (first.reported_ms == second.reported_ms and first.peer < second.peer) then first else second end
  let other: MatchReport = if tiebreak.peer == first.peer then second else first end
  if tiebreak.outcome == "WON" then
    settled(key, "disputed", tiebreak.peer, other.peer)
  else if tiebreak.outcome == "LOST" then
    settled(key, "disputed", other.peer, tiebreak.peer)
  else
    settled(key, "disputed", "", "")
  end
end

function two_report_reconciliation(key: text, first: MatchReport, second: MatchReport): Reconciliation
  intent: agree when the two outcomes are consistent and dispute otherwise
  if first.outcome == "WON" and second.outcome == "LOST" then
    settled(key, "agreed", first.peer, second.peer)
  else if first.outcome == "LOST" and second.outcome == "WON" then
    settled(key, "agreed", second.peer, first.peer)
  else if first.outcome == "DRAW" and second.outcome == "DRAW" then
    settled(key, "agreed", "", "")
  else
    disputed_reconciliation(key, first, second)
  end
end

public function reconcile_match(match_id: text): Reconciliation
  intent: reconcile the reports filed for a match
  let reports: a list of MatchReport = reports_for_reconciliation(match_id)
  let count: integer = length(reports)
  if count < 2 then
    Reconciliation { match_id: roster_safe(match_id), status: "pending", winner: "", loser: "", reports: count }
  else
    two_report_reconciliation(roster_safe(match_id), unwrap_or(get(reports, 0), unknown_report()), unwrap_or(get(reports, 1), unknown_report()))
  end
end

public function report_result_at(match_id: text, peer: text, outcome: text, now_ms: integer): Reconciliation
  intent: save
  let key: text = roster_safe(match_id)
  let reporter: text = roster_safe(peer)
  mutable reports: a list of MatchReport = []
  for report in load_reports() do
    if report.match_id != key or report.peer != reporter then set reports = append(reports, report) end
  end
  set reports = append(reports, MatchReport { match_id: key, peer: reporter, outcome: normalize_outcome(outcome), reported_ms: now_ms })
  save_reports(reports)
  let reconciliation: Reconciliation = reconcile_match(key)
  if reconciliation.status == "agreed" or reconciliation.status == "disputed" then
  end_match(key)
  purge_fight_events(key)
end
  reconciliation
end

public function report_result(match_id: text, peer: text, outcome: text): Reconciliation
  intent: save
  report_result_at(match_id, peer, outcome, current_time_ms())
end

function token_characters(value: text): text
  intent: clean
  mutable result: text = ""
  mutable index: integer = 0
  while index < text_length(value) do
    let character: text = substring(value, index, 1)
    if contains_text("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", character) then
  set result = result ++ character
end
    set index = index + 1
  end
  result
end

function token_for_fingerprint(fingerprint: text, sessions: a list of Session): text
  intent: mint
  let base: text = substring("sess" ++ token_characters(fingerprint), 0, min(32, text_length("sess" ++ token_characters(fingerprint))))
  mutable taken: boolean = false
  for session in sessions do
    if session.stoken == base and session.fingerprint != fingerprint then
  set taken = true
end
  end
  if not taken then
  base
else
  let suffix: text = to_text(length(sessions))
  substring(base, 0, max(0, 32 - text_length(suffix))) ++ suffix
end
end

public function ensure_session(fingerprint: text, name: text): Session
  intent: ensure
  let safe_fingerprint: text = roster_safe(fingerprint)
  let safe_name: text = roster_safe(name)
  let sessions: a list of Session = load_sessions()
  for session in sessions do
    if session.fingerprint == safe_fingerprint then return session end
  end
  let created: Session = Session { fingerprint: safe_fingerprint, stoken: token_for_fingerprint(safe_fingerprint, sessions), uid: to_text(1000000000001 + length(sessions)), name: safe_name }
  create_dir(log_dir())
  let line: text = "S|" ++ created.fingerprint ++ "|" ++ created.stoken ++ "|" ++ created.uid ++ "|" ++ created.name
  let existing: text = if file_exists(session_file()) then read_file(session_file()) else "" end
  write_file(session_file(), if existing == "" then line else existing ++ "\n" ++ line end)
  created
end

public function load_rosters(): a list of Roster
  intent: load
  if not file_exists(roster_file()) then
  []
else
  mutable rosters: a list of Roster = []
  for line in split(read_file(roster_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let peer: text = unwrap_or(get(fields, 1), "")
    if kind == "R" and peer != "" then
  let joined: text = unwrap_or(get(fields, 3), "")
  let heroes: a list of text = if joined == "" then [] else split(joined, ",") end
  set rosters = append(rosters, Roster { peer: peer, name: unwrap_or(get(fields, 2), ""), heroes: heroes })
end
  end
  rosters
end
end

public function store_roster(peer: text, name: text, heroes: a list of text): nothing
  intent: save
  create_dir(log_dir())
  let key: text = roster_safe(peer)
  let heroes_resolved: a list of text = gamedata.resolve_team(heroes)
  mutable lines: a list of text = []
  for roster in load_rosters() do
    if roster.peer != key then
  set lines = append(lines, "R|" ++ roster.peer ++ "|" ++ roster.name ++ "|" ++ join(roster.heroes, ","))
end
  end
  set lines = append(lines, "R|" ++ key ++ "|" ++ roster_safe(name) ++ "|" ++ join(heroes_resolved, ","))
  write_file(roster_file(), join(lines, "\n"))
end

public function reset_rosters(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(roster_file(), "")
end

public function opponent_roster(peer: text): Roster
  intent: get
  let key: text = roster_safe(peer)
  mutable found: boolean = false
  mutable opponent: Roster = Roster { peer: "house", name: "Autobot Garrison", heroes: gamedata.default_team() }
  for roster in load_rosters() do
    if roster.peer != key then
  set opponent = roster
  set found = true
end
  end
  if found then opponent else Roster { peer: "house", name: "Autobot Garrison", heroes: gamedata.default_team() } end
end

public function resp_path_for(method: text, path: text): text
  intent: get
  let stripped: text = trim_path(path)
  let key: text = method ++ "__" ++ unwrap_or(get(split(replace(stripped, "/", "_"), "?"), 0), "")
  if ends_with(key, ".json") then
  path_join(resp_dir(), key)
else
  path_join(resp_dir(), key ++ ".json")
end
end

function trim_path(path: text): text
  intent: path
  mutable start: integer = 0
  mutable finish: integer = text_length(path)
  while start < finish and substring(path, start, 1) == "/" do
    set start = start + 1
  end
  while finish > start and substring(path, finish - 1, 1) == "/" do
    set finish = finish - 1
  end
  substring(path, start, finish - start)
end

function request_object(body: text): Json
  intent: parse
  if starts_with(trim(body), "\{") then
  jsonout.parse_json(body)
else
  jsonout.json_obj([])
end
end

function json_text_or(node: Json, key: text, fallback: text): text
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "text" then
  jsonout.as_text(jsonout.obj_get(node, key))
else
  fallback
end
end

function json_text_first(node: Json, first: text, second: text, third: text): text
  intent: get
  let one: text = json_text_or(node, first, "")
  if one != "" then
  one
else
  let two: text = json_text_or(node, second, "")
  if two != "" then
  two
else
  json_text_or(node, third, "")
end
end
end

function json_list_or_empty(node: Json, key: text): a list of Json
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "list" then
  jsonout.list_items(jsonout.obj_get(node, key))
else
  []
end
end

function text_list_from_json(node: Json): a list of text
  intent: get
  mutable result: a list of text = []
  if jsonout.type_name(node) == "list" then
  for item in jsonout.list_items(node) do
    if jsonout.type_name(item) == "text" then
  set result = append(result, jsonout.as_text(item))
end
  end
end
  result
end

function json_value_text(node: Json, fallback: text): text
  intent: get
  if jsonout.type_name(node) == "text" then
  jsonout.as_text(node)
else if jsonout.type_name(node) == "int" then
  to_text(jsonout.as_int(node))
else
  fallback
end
end

function query_has_missionsconfig(path: text): boolean
  intent: find
  let pieces: a list of text = split(path, "?")
  let query: text = unwrap_or(get(pieces, 1), "")
  mutable found: boolean = false
  for item in split(query, "&") do
    let pair: a list of text = split(item, "=")
    let key: text = url_decode(unwrap_or(get(pair, 0), ""))
    let value: text = url_decode(unwrap_or(get(pair, 1), ""))
    if starts_with(key, "groups.") and ends_with(key, ".name") and value == "missionsconfig" then
  set found = true
end
  end
  found
end

public function query_value(path: text, name: text): text
  intent: get
  let pieces: a list of text = split(path, "?")
  let query: text = unwrap_or(get(pieces, 1), "")
  mutable result: text = ""
  for item in split(query, "&") do
    let pair: a list of text = split(item, "=")
    let key: text = url_decode(unwrap_or(get(pair, 0), ""))
    let value: text = url_decode(unwrap_or(get(pair, 1), ""))
    if key == name then
  set result = value
end
  end
  result
end

public function peer_key(path: text): text
  intent: get
  let peer: text = query_value(path, "peer")
  let stoken: text = query_value(path, "stoken")
  if peer != "" then
  peer
else if stoken != "" then
  stoken
else
  "local"
end
end

function pvp_caller_name(path: text, btxt: text): text
  intent: get
  let session: Session = session_for_token(query_value(path, "stoken"))
  if session.name != "" then
  session.name
else
  let req: Json = request_object(btxt)
  let supplied: text = json_text_first(req, "name", "playerName", "")
  if supplied != "" then supplied else peer_key(path) end
end
end

function json_int_or(node: Json, key: text, fallback: integer): integer
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "int" then
  jsonout.as_int(jsonout.obj_get(node, key))
else
  fallback
end
end

function endpoint_is_tutorial(path: text): boolean
  intent: check
  ends_with(path, "/tutorial/start-tutorial") or ends_with(path, "/tutorial/start-branch") or ends_with(path, "/tutorial/early-start-branch") or ends_with(path, "/tutorial/complete-tutorial")
end

function last_segment(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then
  path
else
  substring(path, slash + 1, text_length(path) - slash - 1)
end
end

function movedir_qid(path: text): text
  intent: get
  let parts: a list of text = split(path, "/")
  let segment: text = unwrap_or(get(parts, length(parts) - 3), "")
  let bits: a list of text = split(segment, "-")
  mutable out: text = ""
  mutable index: integer = 0
  while index < length(bits) - 1 do
    if index > 0 then
  set out = out ++ "-"
end

    set out = out ++ unwrap_or(get(bits, index), "")
    set index = index + 1
  end
  out
end

function normalize_qid(qid: text): text
  intent: get
  let bits: a list of text = split(qid, "-")
  if length(bits) < 2 then
  qid
else
  mutable out: text = ""
  mutable index: integer = 0
  while index < length(bits) - 1 do
    if index > 0 then set out = out ++ "-" end
    set out = out ++ unwrap_or(get(bits, index), "")
    set index = index + 1
  end
  out
end
end

function movedir_offset(path: text, index: integer): integer
  intent: get
  let parts: a list of text = split(path, "/")
  unwrap_or(to_integer(unwrap_or(get(parts, length(parts) - index), "x")), 999999)
end

function compact_envelope(result: Json): text
  intent: encode
  jsonout.encode_compact(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result)]))
end

function pair_text(key: text, value: text): Pair
  intent: build an object pair holding a text value
  jsonout.json_pair(key, jsonout.json_text(value))
end

function pair_int(key: text, value: integer): Pair
  intent: build an object pair holding an integer value
  jsonout.json_pair(key, jsonout.json_int(value))
end

function pair_bool(key: text, value: boolean): Pair
  intent: build an object pair holding a boolean value
  jsonout.json_pair(key, jsonout.json_bool(value))
end

function spaced_envelope(result: Json): text
  intent: encode
  jsonout.encode_spaced(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result)]))
end

function spaced_envelope_async(result: Json, async_items: a list of Json): text
  intent: encode
  jsonout.encode_spaced(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result), jsonout.json_pair("async", jsonout.json_list(async_items))]))
end

function credentials_object(req: Json): Json
  intent: get
  if jsonout.obj_has(req, "credentials") and jsonout.type_name(jsonout.obj_get(req, "credentials")) == "object" then
  jsonout.obj_get(req, "credentials")
else
  jsonout.json_obj([])
end
end

function auth_login_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let credentials: Json = credentials_object(req)
  let udid: text = json_text_or(credentials, "udid", "")
  let bid: text = json_text_or(req, "bid", "")
  let device_name: text = json_text_or(credentials, "deviceName", "")
  let device_model: text = json_text_or(credentials, "deviceModel", "")
  let fingerprint: text = if udid != "" then
  udid
else if bid != "" then
  bid
else if device_name != "" then
  device_name
else if device_model != "" then
  device_model
else
  "local"
end
  let name: text = if device_name != "" then device_name else if device_model != "" then device_model else "Commander" end
  let session: Session = ensure_session(fingerprint, name)
  compact_envelope(jsonout.json_obj([pair_text("stoken", session.stoken), pair_text("server_tag", "prod"), pair_text("userToken", ""), jsonout.json_pair("auth_data", jsonout.json_obj([])), jsonout.json_pair("user", jsonout.json_obj([pair_int("uid", unwrap_or(to_integer(session.uid), 1000000000001)), pair_text("name", session.name), pair_int("level", account_level()), pair_text("email", ""), pair_text("fbid", ""), pair_text("geo", "US"), pair_text("naid", ""), pair_int("cohort", 0), pair_int("revenue", 0)]))]))
end

function tutorial_response(p: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let tid: text = json_text_first(req, "tid", "tutorialId", "id")
  if tid == "" then
  ""
else if contains(block_tutorials(), tid) then
  jsonout.encode_spaced(jsonout.json_obj([pair_text("err", "unavailable"), pair_text("error", "unavailable"), pair_bool("retry", false), pair_bool("fatal", false), jsonout.json_pair("result", jsonout.json_obj([]))]))
else
  let bid: text = json_text_first(req, "bid", "branchId", "")
  let state: text = if contains(live_tutorials(), tid) and not ends_with(p, "/tutorial/complete-tutorial") then
  "started"
else
  "completed"
end
  let branches: Json = if bid == "" then
  jsonout.json_obj([])
else
  jsonout.json_obj([jsonout.json_pair(bid, jsonout.json_obj([pair_text("s", state)]))])
end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair(tid, jsonout.json_obj([pair_text("current_bid", bid), pair_text("s", state), jsonout.json_pair("branches", branches)]))]))
end
end

function live_presence_name(peer: text): text
  intent: get
  let key: text = roster_safe(peer)
  for presence in live_peers() do
    if presence.peer == key and presence.name != "" then return presence.name end
  end
  let session: Session = session_for_token(key)
  if session.name != "" then session.name else "Commander" end
end

function pvp_lobby_result(peer: text, include_self: boolean, now_ms: integer): Json
  intent: build
  let key: text = roster_safe(peer)
  mutable peers: a list of Json = []
  for presence in live_peers_at(now_ms) do
    if include_self or presence.peer != key then
  let m: Match = match_for_peer(presence.peer)
  set peers = append(peers, jsonout.json_obj([pair_text("peer", presence.peer), pair_text("name", presence.name), pair_int("ageMs", now_ms - presence.seen_ms), pair_text("inMatch", m.match_id)]))
end
  end
  let own_match: Match = match_for_peer(key)
  jsonout.json_obj([pair_text("peer", key), pair_int("now", now_ms), pair_int("ttl", presence_ttl_ms()), jsonout.json_pair("peers", jsonout.json_list(peers)), pair_text("match", own_match.match_id)])
end

