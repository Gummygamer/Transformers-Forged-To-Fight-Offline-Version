function user_profile_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let session: Session = session_for_token(query_value(path, "stoken"))
  let uid: text = json_text_or(req, "uid", if session.uid != "" then session.uid else "1000000000001" end)
  let name: text = if session.name != "" then session.name else "Commander" end
  let now: integer = floor(current_time_ms() / 1000)
  user_profile_response_values(uid, name, account_level(), now)
end

function profile_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if ends_with("/" ++ trim_path(p), "/userprofile") then user_profile_response(path, btxt) else "" end
end

function alliance_dynamic(path: text, p: text): text
  intent: encode
  if ends_with(p, "/alliances/refresh") or ends_with(p, "/alliances/details") then
  let session: Session = session_for_token(query_value(path, "stoken"))
  compact_envelope(synthetic_alliance(if session.uid != "" then session.uid else "1000000000001" end, if session.name != "" then session.name else "Commander" end, floor(current_time_ms() / 1000)))
else
  ""
end
end

public function dynamic(path: text, btxt: text): text
  intent: encode
  let p: text = unwrap_or(get(split(path, "?"), 0), path)
  let static: text = static_dynamic(path, p, btxt)
  if static != "" then
  static
else
  let profile: text = profile_dynamic(path, p, btxt)
  if profile != "" then profile else
  let alliance: text = alliance_dynamic(path, p)
  if alliance != "" then alliance else quest_dynamic(path, p, btxt) end
end
end
end

function file_name(path: text): text
  intent: get
  last_segment(path)
end

function advertised_canned_body(body: text): text
  intent: rewrite
  let host: text = unwrap_or(env_get("TFTF_SERVER_HOST"), "")
  if host == "" then
  body
else
  replace(body, "https://tform-0901-hzlhiniyfcwf.tf-cdn.net", gamedata.advertised_base_url())
end
end

public function resolve_response(method: text, path: text): ResponseChoice
  intent: response
  let exact: text = resp_path_for(method, path)
  if file_exists(exact) then
  ResponseChoice { source: "canned " ++ file_name(exact), body: advertised_canned_body(read_file(exact)) }
else
  let rules_path: text = path_join(resp_dir(), "_prefix_rules.json")
  if file_exists(rules_path) then
  let rules: a list of Json = jsonout.list_items(jsonout.parse_json(read_file(rules_path)))
  let p: text = unwrap_or(get(split(path, "?"), 0), path)
  for rule in rules do
    let pair: a list of Json = jsonout.list_items(rule)
    let prefix: text = jsonout.as_text(unwrap_or(get(pair, 0), jsonout.json_text("")))
    let filename: text = jsonout.as_text(unwrap_or(get(pair, 1), jsonout.json_text("")))
    let response: text = path_join(resp_dir(), filename)
    if starts_with(p, prefix) and file_exists(response) then
  return ResponseChoice { source: "rule " ++ prefix ++ " -> " ++ filename, body: advertised_canned_body(read_file(response)) }
end
  end
end
  ResponseChoice { source: "default", body: "\{" ++ "\"error\":null,\"result\":\{\}" ++ "\}" }
end
end

function timestamp(): text
  intent: get
  trim(unwrap_or(get(shell_exec("date +%H:%M:%S.%3N"), "stdout"), ""))
end

function log_line(line: text): nothing
  intent: log
  create_dir(log_dir())
  print(line)
  let old: text = if file_exists(logfile()) then
  read_file(logfile())
else
  ""
end
  write_file(logfile(), old ++ line ++ "\n")
end

function headers_text(headers: a mapping from text to text): text
  intent: get
  mutable out: text = ""
  mutable first: boolean = true
  for key in keys(headers) do
    if not first then
  set out = out ++ "; "
end
    set out = out ++ key ++ "=" ++ unwrap_or(get(headers, key), "")
    set first = false
  end
  out
end

function request_loop(): nothing
  intent: serve
  while true do
    let req: Request = http_next_request()
    let path: text = if req.query == "" then
  req.path
else
  req.path ++ "?" ++ req.query
end
    let stamp: text = timestamp()
    let host: text = unwrap_or(get(req.headers, "host"), "?")
    log_line("[" ++ stamp ++ "] " ++ req.method ++ " https://" ++ host ++ path)
    log_line("    HDRS: " ++ headers_text(req.headers))
    if req.body != "" then
  log_line("    BODY(" ++ to_text(text_length(req.body)) ++ "): " ++ substring(req.body, 0, min(4000, text_length(req.body))))
end
    if req.method == "HEAD" then
  http_respond_with_headers(200, {"Content-Length": "0"}, "")
else
  let generated: text = dynamic(path, req.body)
  let choice: ResponseChoice = if generated == "" then
  resolve_response(req.method, path)
else
  ResponseChoice { source: "dynamic", body: generated }
end
  if choice.source == "dynamic" then
  log_line("    -> dynamic (" ++ to_text(text_length(choice.body)) ++ "B)")
else if starts_with(choice.source, "canned ") then
  log_line("    -> " ++ choice.source ++ " (" ++ to_text(text_length(choice.body)) ++ "B)")
else if starts_with(choice.source, "rule ") then
  log_line("    -> " ++ choice.source ++ " (" ++ to_text(text_length(choice.body)) ++ "B)")
else
  log_line("    -> default 200 envelope")
end
  http_respond_with_headers(200, {"Content-Type": "application/json", "Content-Length": to_text(text_length(choice.body))}, choice.body)
end
  end
end

public function serve_http(port: integer): nothing
  intent: serve
  create_dir(log_dir())
  http_start(port)
  log_line("[*] HTTP  listening on :" ++ to_text(port))
  request_loop()
end

public function serve_https(port: integer): nothing
  intent: serve
  create_dir(log_dir())
  http_start_https(port, pem_path(), pem_path())
  log_line("[*] HTTPS listening on :" ++ to_text(port))
  request_loop()
end

function emit(name: text, value: text): nothing
  intent: print
  print("## " ++ name)
  if value == "" then
  print("<NONE>")
else
  print(value)
end
end

function emit_resolve(name: text, method: text, path: text): nothing
  intent: print
  let choice: ResponseChoice = resolve_response(method, path)
  emit(name, "SRC " ++ choice.source ++ " LEN " ++ to_text(text_length(choice.body)))
end

function dump_first_half(): nothing
  intent: print
  emit("respath_get_auth_login", resp_path_for("GET", "/auth/login"))
  emit("respath_post_getuserdata_query", resp_path_for("POST", "/bcg/getUserData?x=1"))
  emit("respath_already_json", resp_path_for("GET", "/a/b/c.json"))
  emit("respath_root", resp_path_for("GET", "/"))
  emit("respath_movedir", resp_path_for("POST", "/quests/quest-movedir/1.1.1-0/1/0"))
  emit("dyn_getuserdata_noteam", compact_envelope(gamedata.build_user_data([])))
  emit("dyn_grouprefresh_missionsconfig", dynamic("/autorefresh/grouprefresh?groups.0.name=missionsconfig&groups.1.name=tuning", ""))
  emit("dyn_grouprefresh_other", dynamic("/autorefresh/grouprefresh?groups.0.name=tuning", ""))
  emit("dyn_grouprefresh_noquery", dynamic("/autorefresh/grouprefresh", ""))
  emit("dyn_base_active", dynamic("/base/active", ""))
  emit("dyn_tut_start_with_bid", dynamic("/tutorial/start-tutorial", "\{\"tid\":\"IntroTutorial\",\"bid\":\"Step1\"\}"))
  emit("dyn_tut_start_no_bid", dynamic("/tutorial/start-tutorial", "\{\"tid\":\"IntroTutorial\"\}"))
  emit("dyn_tut_branch_fte", dynamic("/tutorial/start-branch", "\{\"tutorialId\":\"FTE\",\"branchId\":\"LightAttack\"\}"))
  emit("dyn_tut_early_branch_fte_nobid", dynamic("/tutorial/early-start-branch", "\{\"id\":\"FTE\"\}"))
  emit("dyn_tut_complete_fte", dynamic("/tutorial/complete-tutorial", "\{\"tid\":\"FTE\",\"bid\":\"LightAttack\"\}"))
  emit("dyn_tut_blocked", dynamic("/tutorial/start-tutorial", "\{\"tid\":\"ShieldTutorial\",\"bid\":\"x\"\}"))
  emit("dyn_tut_empty_body", dynamic("/tutorial/start-tutorial", ""))
  emit("dyn_tut_bad_json", dynamic("/tutorial/start-tutorial", "not json"))
  emit("dyn_basehero_two", dynamic("/bcg/getBaseHeroData", "\{\"heroes\":[\{\"bid\":\"optimusprime_cin_tf\",\"rank\":3,\"level\":30,\"sig_lvl\":1\},\{\"bid\":\"grimlock_gs_mp08\",\"rank\":1,\"level\":1\}]\}"))
  emit("dyn_basehero_empty", dynamic("/bcg/getBaseHeroData", "\{\}"))
  emit("dyn_quest_detail_story", dynamic("/quests/quest-detail/1.1.1", "\{\"setId\":\"story_act1\"\}"))
  emit("dyn_quest_detail_default_set", dynamic("/quests/quest-detail/1.1.2", ""))
end

function dump_second_half(): nothing
  intent: print
  let team: a list of text = ["grimlock_gs_mp08", "megatron_cin_rotf"]
  emit("dyn_quest_begin_posted_team", spaced_envelope(gamedata.build_quest_begin("1.1.1", "story_act1", team)))
  emit("dyn_movedir_east_1", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 1, 0, 0, 1, team)))
  emit("dyn_movedir_east_2", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 1, 0, 1, 1, team)))
  emit("dyn_movedir_east_3_blocked", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 0, 0, 2, 1, team)))
  emit("dyn_movedir_north_blocked", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 0, 0, 2, 1, team)))
  emit("dyn_movedir_unparseable", spaced_envelope(gamedata.build_quest_movedir("1.1.1", 0, 0, 2, 1, team)))
  emit("dyn_set_saved_team", saved_team_envelope("0", team))
  print("## saved_team_after_set")
  print(join(team, ","))
  emit("dyn_getuserdata_after_set", compact_envelope(gamedata.build_user_data(team)))
  emit("dyn_quest_begin_saved_team", spaced_envelope(gamedata.build_quest_begin("1.1.1", "story_act1", team)))
  emit("dyn_set_saved_team_nonlist", saved_team_envelope("7", []))
  emit("dyn_set_saved_team_empty_body", saved_team_envelope("0", []))
end

function dump_final_half(): nothing
  intent: print
  print("## saved_team_after_reset")
  print("")
  emit("dyn_unknown_path", "")
  emit_resolve("resolve_post_auth_login", "POST", "/auth/login")
  emit_resolve("resolve_get_auth_login", "GET", "/auth/login")
  emit_resolve("resolve_get_userdata", "GET", "/bcg/getUserData")
  emit_resolve("resolve_autorefresh_rule", "GET", "/autorefresh/somegroup/refresh")
  emit_resolve("resolve_unknown_default", "GET", "/nope/nope")
  emit("resolve_default_body", resolve_response("GET", "/nope/nope").body)
  emit("block_tutorials", join(sort_text(block_tutorials()), ","))
  emit("live_tutorials", join(sort_text(live_tutorials()), ","))
end

function dump_dynamic(): nothing
  intent: print
  dump_first_half()
  dump_second_half()
  dump_final_half()
end

function main(): nothing
  intent: serve
  let arguments: a list of text = get_args()
  let command: text = unwrap_or(get(arguments, 1), "")
  if command == "--dump-dynamic" then
  dump_dynamic()
else if command == "--http" then
  serve_http(unwrap_or(to_integer(unwrap_or(get(arguments, 2), "80")), 80))
else if command == "--https" then
  serve_https(unwrap_or(to_integer(unwrap_or(get(arguments, 2), "443")), 443))
else
  print("[*] One listener per process: run this with --http 80 and a second copy with --https 443.")
  serve_http(80)
end
end

main()
