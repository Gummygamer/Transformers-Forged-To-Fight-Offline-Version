  let peer: Presence = touch_presence(peer_key(path), json_text_or(request_object(btxt), "name", ""))
  let now_ms: integer = current_time_ms()
  spaced_envelope(pvp_lobby_result(peer.peer, false, now_ms))
end

function pvp_lobby_response(path: text): text
  intent: encode
  let now_ms: integer = current_time_ms()
  spaced_envelope(pvp_lobby_result(peer_key(path), true, now_ms))
end

function pvp_leave_match_response(path: text): text
  intent: encode
  let peer: text = roster_safe(peer_key(path))
  let m: Match = match_for_peer(peer)
  let left: boolean = m.match_id != ""
  if left then end_match(m.match_id) end
  spaced_envelope(jsonout.json_obj([pair_text("peer", peer), pair_bool("left", left)]))
end

function relay_match_id(path: text, req: Json, peer: text): text
  intent: get
  let body_match_id: text = json_text_or(req, "matchID", "")
  let query_match_id: text = query_value(path, "matchID")
  if body_match_id != "" then
  roster_safe(body_match_id)
else if query_match_id != "" then
  roster_safe(query_match_id)
else
  match_for_peer(peer).match_id
end
end

function match_by_id(match_id: text): Match
  intent: get
  let key: text = roster_safe(match_id)
  for m in load_matches() do
    if m.match_id == key then return m end
  end
  Match { match_id: "", arena: "", peer_a: "", peer_b: "", created_ms: 0 }
end

function relay_member(m: Match, peer: text): boolean
  intent: check
  let key: text = roster_safe(peer)
  m.match_id != "" and (m.peer_a == key or m.peer_b == key)
end

function pvp_fight_post_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  let match_id: text = relay_match_id(path, req, peer)
  let m: Match = match_by_id(match_id)
  let accepted: boolean = match_id != "" and relay_member(m, peer)
  let error: text = if match_id == "" then "no active match" else if not relay_member(m, peer) then "peer is not in match" else "" end
  let event: FightEvent = if accepted then
  append_fight_event(match_id, peer, json_text_or(req, "kind", "input"), json_text_or(req, "payload", ""))
else
  FightEvent { match_id: match_id, peer: peer, seq: 0, kind: "", payload: "", sent_ms: 0 }
end
  spaced_envelope(jsonout.json_obj([pair_text("peer", peer), pair_text("matchID", match_id), pair_int("seq", event.seq), pair_bool("accepted", accepted), pair_text("error", error)]))
end

function requested_since(path: text, req: Json): integer
  intent: get
  let body_since: text = if jsonout.obj_has(req, "since") then json_value_text(jsonout.obj_get(req, "since"), "") else "" end
  let raw: text = if body_since != "" then body_since else query_value(path, "since") end
  let parsed: integer = unwrap_or(to_integer(raw), 0)
  if parsed < 0 then 0 else parsed end
end

function pvp_fight_poll_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  let match_id: text = relay_match_id(path, req, peer)
  let since: integer = requested_since(path, req)
  let events: a list of FightEvent = fight_events_since(match_id, since)
  let m: Match = match_by_id(match_id)
  mutable rows: a list of Json = []
  mutable next_seq: integer = since
  for event in events do
    set rows = append(rows, jsonout.json_obj([pair_int("seq", event.seq), pair_text("peer", event.peer), pair_text("kind", event.kind), pair_text("payload", event.payload), pair_int("sentMs", event.sent_ms), pair_bool("mine", event.peer == peer)]))
    if event.seq > next_seq then set next_seq = event.seq end
  end
  spaced_envelope(jsonout.json_obj([pair_text("peer", peer), pair_text("matchID", match_id), pair_int("since", since), pair_int("nextSeq", next_seq), pair_text("opponent", match_opponent(m, peer)), jsonout.json_pair("events", jsonout.json_list(rows))]))
end

function reconciliation_json(peer: text, reconciliation: Reconciliation): Json
  intent: build
  jsonout.json_obj([pair_text("peer", peer), pair_text("matchID", reconciliation.match_id), pair_text("status", reconciliation.status), pair_text("winner", reconciliation.winner), pair_text("loser", reconciliation.loser), pair_int("reports", reconciliation.reports)])
end

function pvp_report_result_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  let match_id: text = relay_match_id(path, req, peer)
  let posted_result: text = json_text_or(req, "result", "")
  let outcome: text = if posted_result != "" then posted_result else json_text_or(req, "outcome", "") end
  let reconciliation: Reconciliation = report_result_at(match_id, peer, outcome, current_time_ms())
  let base: Json = reconciliation_json(peer, reconciliation)
  spaced_envelope(jsonout.obj_set(base, "outcome", jsonout.json_text(normalize_outcome(outcome))))
end

function pvp_match_result_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let peer: text = roster_safe(peer_key(path))
  spaced_envelope(reconciliation_json(peer, reconcile_match(relay_match_id(path, req, peer))))
end

function pvp_arena_state_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let peer: text = caller.peer
  let arena: text = json_text_or(req, "arenaID", "arena_versus")
  mutable wins: integer = 0
  mutable losses: integer = 0
  mutable win_streak: integer = 0
  for report in load_reports() do
    if report.peer == peer and report.outcome == "WON" then
  set wins = wins + 1
  set win_streak = win_streak + 1
else if report.peer == peer and report.outcome == "LOST" then
  set losses = losses + 1
  set win_streak = 0
else if report.peer == peer then
  set win_streak = 0
end
  end
  let m: Match = match_for_peer(peer)
  mutable other_live_peers: integer = 0
  for presence in live_peers() do
    if presence.peer != peer then set other_live_peers = other_live_peers + 1 end
  end
  spaced_envelope(jsonout.json_obj([pair_text("pid", peer), pair_int("winStreak", win_streak), pair_int("wins", wins), pair_int("losses", losses), pair_text("arenaID", arena), pair_text("matchID", m.match_id), pair_bool("live", m.match_id != ""), pair_int("livePeers", other_live_peers)]))
end

function pvp_arena_id(req: Json): text
  intent: get
  let arena_id: text = json_text_or(req, "arenaID", "")
  if arena_id != "" then arena_id else json_text_or(req, "pid", "arena_versus") end
end

function pvp_lock_rejected(caller: Presence, arena: text): text
  intent: answer a lock in that carried no heroes
  spaced_envelope(jsonout.json_obj([pair_bool("locked", false), pair_text("matchID", match_for_peer(caller.peer).match_id), pair_bool("live", match_for_peer(caller.peer).match_id != ""), pair_text("arenaID", arena), pair_text("error", "heroes are required")]))
end

function pvp_lock_accepted(path: text, btxt: text, caller: Presence, arena: text, heroes: a list of text): text
  intent: store the roster, pair the peers and answer a lock in
  store_roster(caller.peer, caller.name, heroes)
  let m: Match = pair_peers(caller.peer, arena)
  let result: Json = pvp_match_result(path, btxt, "active")
  let with_locked: Json = jsonout.obj_set(result, "locked", jsonout.json_bool(true))
  let with_match: Json = jsonout.obj_set(with_locked, "matchID", jsonout.json_text(m.match_id))
  let with_live: Json = jsonout.obj_set(with_match, "live", jsonout.json_bool(m.match_id != ""))
  let with_arena: Json = jsonout.obj_set(with_live, "arenaID", jsonout.json_text(arena))
  spaced_envelope(jsonout.obj_set(with_arena, "error", jsonout.json_text("")))
end

function pvp_lock_in_response(path: text, btxt: text): text
  intent: encode the answer to a lock in request
  let req: Json = request_object(btxt)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let arena: text = pvp_arena_id(req)
  let posted: a list of Json = json_list_or_empty(req, "heroes")
  let hero_nodes: a list of Json = if length(posted) > 0 then posted else json_list_or_empty(req, "team") end
  let heroes: a list of text = text_list_from_json(jsonout.json_list(hero_nodes))
  if length(heroes) == 0 then pvp_lock_rejected(caller, arena) else pvp_lock_accepted(path, btxt, caller, arena, heroes) end
end

function pvp_select_opponent_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let arena: text = pvp_arena_id(req)
  let m: Match = pair_peers(caller.peer, arena)
  let fallback_opponent: text = if m.match_id != "" then match_opponent(m, caller.peer) else "" end
  let opponent_id: text = json_text_or(req, "opponentID", fallback_opponent)
  let result: Json = pvp_match_result(path, btxt, "selecting")
  let with_selected: Json = jsonout.obj_set(result, "selected", jsonout.json_bool(true))
  let with_match: Json = jsonout.obj_set(with_selected, "matchID", jsonout.json_text(m.match_id))
  let with_live: Json = jsonout.obj_set(with_match, "live", jsonout.json_bool(m.match_id != ""))
  let with_index: Json = jsonout.obj_set(with_live, "opponentIndex", jsonout.json_int(json_int_or(req, "index", 0)))
  spaced_envelope(jsonout.obj_set(with_index, "opponentID", jsonout.json_text(opponent_id)))
end

function pvp_quit_arena_response(path: text, btxt: text): text
  intent: encode
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let m: Match = match_for_peer(caller.peer)
  if m.match_id != "" then
  end_match(m.match_id)
  purge_fight_events(m.match_id)
end
  spaced_envelope(jsonout.json_obj([pair_bool("quit", true), pair_text("matchID", m.match_id)]))
end

function pvp_matchups(user_heroes: a list of text, opponent_heroes: a list of text): a list of Json
  intent: build
  mutable matchups: a list of Json = []
  mutable index: integer = 0
  for opponent_hero in opponent_heroes do
    let user_hero: text = unwrap_or(get(user_heroes, index), unwrap_or(get(user_heroes, 0), opponent_hero))
    set matchups = append(matchups, jsonout.json_obj([pair_text("userHero", user_hero), pair_text("opponentHero", opponent_hero), pair_text("aip", "normal"), pair_text("state", "none"), pair_text("outcome", "NONE"), jsonout.json_pair("basePoints", jsonout.json_dec(0.0)), jsonout.json_pair("actualPoints", jsonout.json_dec(0.0)), pair_text("fightId", "")]))
    set index = index + 1
  end
  matchups
end

function caller_roster_for(peer: text, name: text): Roster
  intent: find the roster the caller stored or fall back to the default team
  mutable found: Roster = Roster { peer: peer, name: name, heroes: gamedata.default_team() }
  for roster in load_rosters() do
    if roster.peer == peer then set found = roster end
  end
  found
end

function match_opponent_roster(m: Match, peer: text, fallback: Roster): Roster
  intent: find the roster of the peer paired with the caller or fall back
  if m.match_id == "" then
    fallback
  else
    let opponent_peer: text = match_opponent(m, peer)
    mutable opponent: Roster = Roster { peer: opponent_peer, name: live_presence_name(opponent_peer), heroes: gamedata.default_team() }
    for roster in load_rosters() do
      if roster.peer == opponent_peer then set opponent = roster end
    end
    opponent
  end
end

function opponent_uid_for(opponent_peer: text): integer
  intent: pick the uid of the session that owns the opponent token
  mutable uid: integer = 1000000000
  mutable session_index: integer = 0
  for session in load_sessions() do
    if session.stoken == opponent_peer then set uid = 1000000001 + session_index end
    set session_index = session_index + 1
  end
  uid
end

function hero_entries(heroes: a list of text): a list of Json
  intent: build the team entry of every hero at rank one and level one
  mutable team: a list of Json = []
  for hero in heroes do
    set team = append(team, gamedata.build_hero_entry(hero, 1, 1))
  end
  team
end

function pvp_arena_stats(arena: text): Json
  intent: build the empty arena statistics node
  jsonout.json_obj([pair_text("pid", arena), pair_int("winStreak", 0), pair_int("wins", 0), pair_int("losses", 0), pair_int("longestStreak", 0), pair_int("findAttempts", 0)])
end

function pvp_opponent_node(opponent: Roster, heroes: a list of text, matchups: a list of Json, stats: Json): Json
  intent: build the opponent node with its team, matchups and user data
  let user_data: Json = jsonout.json_obj([pair_text("name", opponent.name), pair_text("tag", "LAN"), pair_int("level", 40), pair_text("portrait", unwrap_or(get(heroes, 0), "")), pair_text("factionId", ""), jsonout.json_pair("pvpStats", stats)])
  jsonout.json_obj([pair_int("uid", opponent_uid_for(opponent.peer)), jsonout.json_pair("team", jsonout.json_list(hero_entries(heroes))), jsonout.json_pair("matchups", jsonout.json_list(matchups)), jsonout.json_pair("userData", user_data)])
end

function pvp_match_data(arena: text, m: Match, state: text, node: Json): Json
  intent: build the match data node around one opponent node
  jsonout.json_obj([pair_text("pid", arena), pair_text("matchID", m.match_id), pair_bool("live", m.match_id != ""), pair_text("state", state), pair_int("opponentIndex", 0), jsonout.json_pair("opponents", jsonout.json_list([node])), jsonout.json_pair("fightRewards", jsonout.json_list([])), jsonout.json_pair("seriesRewards", jsonout.json_obj([pair_bool("claimed", false), pair_text("box", "")])), jsonout.json_pair("milestones", jsonout.json_list([]))])
end

function pvp_match_json(m: Match, arena: text, state: text, caller_roster: Roster, opponent: Roster): Json
  intent: build the match and user data returned for a match
  let stats: Json = pvp_arena_stats(arena)
  let heroes: a list of text = gamedata.resolve_team(opponent.heroes)
  let matchups: a list of Json = pvp_matchups(gamedata.resolve_team(caller_roster.heroes), heroes)
  let node: Json = pvp_opponent_node(opponent, heroes, matchups, stats)
  jsonout.json_obj([jsonout.json_pair("pvpMatchData", jsonout.json_list([pvp_match_data(arena, m, state, node)])), jsonout.json_pair("pvpUserData", jsonout.json_list([stats]))])
end

function pvp_match_result(path: text, btxt: text, state: text): Json
  intent: build the match result for the caller after pairing peers
  let req: Json = request_object(btxt)
  let arena: text = pvp_arena_id(req)
  let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
  let m: Match = pair_peers(caller.peer, arena)
  let caller_roster: Roster = caller_roster_for(caller.peer, caller.name)
  let opponent: Roster = match_opponent_roster(m, caller.peer, opponent_roster(caller.peer))
  pvp_match_json(m, arena, state, caller_roster, opponent)
end

function pvp_opponent_response(path: text, btxt: text): text
  intent: encode
  spaced_envelope(pvp_match_result(path, btxt, "selecting"))
end

function pvp_fight_loaded_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  spaced_envelope(jsonout.json_obj([pair_bool("loaded", true), pair_text("fightID", json_text_or(req, "fightID", json_text_or(req, "fid", "")))]))
end

function pvp_retry_match_response(path: text, btxt: text): text
  intent: encode
  spaced_envelope(pvp_match_result(path, btxt, "active"))
end

function activation_teams(path: text, req: Json): a list of text
  intent: pick the posted or saved squad and the stored opponent squad
  let posted: a list of text = text_list_from_json(if jsonout.obj_has(req, "heroes") then jsonout.obj_get(req, "heroes") else jsonout.json_list([]) end)
  let user_team: a list of text = gamedata.resolve_team(if length(posted) > 0 then posted else get_saved_team() end)
  let stored_opponent: Roster = opponent_roster(peer_key(path))
  let opponent_team: a list of text = gamedata.resolve_team(if length(stored_opponent.heroes) > 0 then stored_opponent.heroes else gamedata.default_team() end)
  [unwrap_or(get(user_team, 0), unwrap_or(get(gamedata.default_team(), 0), "")), unwrap_or(get(opponent_team, 0), unwrap_or(get(gamedata.default_team(), 0), ""))]
end

function activation_match_attributes(path: text, req: Json): Json
  intent: build the matchAttributes node from the first hero of each squad
  let bids: a list of text = activation_teams(path, req)
  let details: a list of Json = jsonout.list_items(gamedata.build_base_hero_details([jsonout.json_obj([pair_text("bid", unwrap_or(get(bids, 0), ""))]), jsonout.json_obj([pair_text("bid", unwrap_or(get(bids, 1), ""))])]))
  jsonout.json_obj([jsonout.json_pair("userHero", unwrap_or(get(details, 0), jsonout.json_obj([]))), jsonout.json_pair("opponentHero", unwrap_or(get(details, 1), jsonout.json_obj([])))])
end

function pvp_activate_match_response(path: text, btxt: text): text
  intent: encode the match activation with its async payload
  let req: Json = request_object(btxt)
  -- PVPFlow discards this response body; the fight data is read from
  -- PVPManager.CurrentMatchData + CurrentMatchAttributes. CurrentMatchAttributes is
  -- only populated by the "match-activated" async, which the client dispatches from a
  -- response's "async" array via EB.Sparx.PushManager.HandleMessage @0x12fe17c:
  -- it reads payload = EB.Dot.Find(msg, "payload") (the raw node) and virtual-dispatches
  -- manager.Async(channel, message, payload). PVPManager.Async @0x120006c, "match-activated"
  -- branch, does NOT extract a "data" child -- it casts the payload node itself
  -- (il2cpp_isinst @slot 0x2c1c918), passes THAT to UpdatePVPData (reads .pvpMatchData /
  -- .pvpUserData arrays) and to BCGManagerBase.ParseMatchAttributes(BCGManager.Instance, .)
  -- @0x1698884, which reads EB.Dot.Object(payload, "matchAttributes") and, if non-null,
  -- builds BCGMatchAttributes @0xa5d4d0 from matchAttributes.userHero / .opponentHero.
  -- A missing "matchAttributes" leaves CurrentMatchAttributes null and
  -- PVPUtil.GenerateFightData @0xb34cd8 NREs on it. So the async payload node itself must
  -- be the flat data dict: { pvpMatchData, pvpUserData, matchAttributes } at the top level.
  let match_attributes: Json = activation_match_attributes(path, req)
  let match_state: Json = pvp_match_result(path, btxt, "active")
  let data: Json = jsonout.obj_set(match_state, "matchAttributes", match_attributes)
  let async_msg: Json = jsonout.json_obj([pair_text("component", "PVPManager"), pair_text("channel", ""), pair_text("message", "match-activated"), jsonout.json_pair("payload", data)])
  spaced_envelope_async(data, [async_msg])
end



function pvp_static_dynamic_second(path: text, p: text, btxt: text): text
  intent: encode the arena state, lock in, quit, match loaded, retry and opponent search endpoints
  if ends_with(p, "/pvp/get-user-data") or ends_with(p, "/pvp/get-active-pvp-data") then
    pvp_arena_state_response(path, btxt)
  else if ends_with(p, "/pvp/lockin") or ends_with(p, "/pvp/lock-in") then
    pvp_lock_in_response(path, btxt)
  else if ends_with(p, "/pvp/select-opponent") then
    pvp_select_opponent_response(path, btxt)
  else if ends_with(p, "/pvp/quit") or ends_with(p, "/pvp/quit-arena") then
    pvp_quit_arena_response(path, btxt)
  else if ends_with(p, "/pvp/match-loaded") then
    pvp_fight_loaded_response(path, btxt)
  else if ends_with(p, "/pvp/retry-match") then
    pvp_retry_match_response(path, btxt)
  else if ends_with(p, "/pvp/find-arena-opponent") or ends_with(p, "/pvp/get-new-opponent") or ends_with(p, "/pvp/get-new-arena-opponent") or ends_with(p, "/pvp/get-opponents") then
    pvp_opponent_response(path, btxt)
  else
    ""
  end
end

function pvp_static_dynamic(path: text, p: text, btxt: text): text
  intent: encode the presence, relay and result endpoints and hand the rest to the second group
  if ends_with(p, "/pvp/heartbeat") then
    pvp_heartbeat_response(path, btxt)
  else if ends_with(p, "/pvp/lobby") then
    pvp_lobby_response(path)
  else if ends_with(p, "/pvp/leave-match") then
    pvp_leave_match_response(path)
  else if ends_with(p, "/pvp/fight-post") then
    pvp_fight_post_response(path, btxt)
  else if ends_with(p, "/pvp/fight-poll") then
    pvp_fight_poll_response(path, btxt)
  else if ends_with(p, "/pvp/report-result") then
    pvp_report_result_response(path, btxt)
  else if ends_with(p, "/pvp/match-result") then
    pvp_match_result_response(path, btxt)
  else if ends_with(p, "/pvp/get-login-data") then
    let caller: Presence = touch_presence(peer_key(path), pvp_caller_name(path, btxt))
    ""
  else
    pvp_static_dynamic_second(path, p, btxt)
  end
end

function grouprefresh_response(path: text): text
  intent: encode the group refresh with the missions config update when it was requested
  let updates: a list of Json = if query_has_missionsconfig(path) then [gamedata.build_missions_autorefresh_update()] else [] end
  compact_envelope(jsonout.json_obj([jsonout.json_pair("updates", jsonout.json_list(updates))]))
end

function base_hero_response(btxt: text): text
  intent: encode the base hero details for the heroes in the request
  spaced_envelope(gamedata.build_base_hero_details(json_list_or_empty(request_object(btxt), "heroes")))
end

function quest_detail_response(p: text, btxt: text): text
  intent: encode the quest detail for the quest named at the end of the path
  let req: Json = request_object(btxt)
  let qid: text = last_segment(p)
  spaced_envelope(gamedata.build_quest_detail(qid, json_text_or(req, "setId", gamedata.quest_set_id_for(qid))))
end

function static_dynamic_second(path: text, p: text, btxt: text): text
  intent: encode the pvp, tutorial, base hero and quest detail endpoints
  if ends_with(p, "/matches/activate-match/pvp_fight") then
    pvp_activate_match_response(path, btxt)
  else if contains_text(p, "/pvp/") then
    pvp_static_dynamic(path, p, btxt)
  else if endpoint_is_tutorial(p) then
    tutorial_response(p, btxt)
  else if ends_with(p, "/bcg/getBaseHeroData") then
    base_hero_response(btxt)
  else if contains_text(p, "/quests/quest-detail/") then
    quest_detail_response(p, btxt)
  else
    ""
  end
end

function static_dynamic(path: text, p: text, btxt: text): text
  intent: encode the login, user data and base endpoints and hand the rest to the second group
  if ends_with(p, "/auth/login") then
    auth_login_response(path, btxt)
  else if ends_with(p, "/tutorial/get-login-data") then
    tutorial_login_response()
  else if ends_with(p, "/bcg/getUserData") then
    compact_envelope(gamedata.build_user_data(get_saved_team()))
  else if ends_with(p, "/autorefresh/grouprefresh") then
    grouprefresh_response(path)
  else if ends_with(p, "/base/active") then
    compact_envelope(gamedata.build_base_active())
  else
    static_dynamic_second(path, p, btxt)
  end
end

function cleared_json(points: a list of text): Json
  intent: build
  mutable nodes: a list of Json = []
  for point in points do
    let coords: a list of text = split(point, ",")
    set nodes = append(nodes, jsonout.json_obj([pair_int("x", unwrap_or(to_integer(unwrap_or(get(coords, 0), "0")), 0)), pair_int("y", unwrap_or(to_integer(unwrap_or(get(coords, 1), "1")), 1))]))
  end
  jsonout.json_list(nodes)
end

function posted_team(req: Json): a list of text
  intent: collect the squad members posted as tm0 to the overflow slot
  mutable posted: a list of text = []
  mutable index: integer = 0
  while index < gamedata.team_size_max() do
    let member: text = json_text_or(req, "tm" ++ to_text(index), "")
    if member != "" then set posted = append(posted, member) end
    set index = index + 1
  end
  let overflow: text = json_text_or(req, "tm" ++ to_text(gamedata.team_size_max()), "")
  if overflow != "" then set posted = append(posted, overflow) end
  posted
end

function is_custom_story(qid: text): boolean
  intent: check whether the quest is one of the custom story acts
  qid == gamedata.custom_story_qid() or qid == gamedata.custom_story_act2_qid() or qid == gamedata.custom_story_act3_qid()
end

function begin_position(qid: text): Position
  intent: save the quest start position keeping earlier progress and return it
  let previous: Position = position_for(qid)
  let preserve_progress: boolean = position_exists(qid)
  let begin_x: integer = if preserve_progress then previous.x else gamedata.quest_start_x_for(qid) end
  let begin_y: integer = if preserve_progress then previous.y else gamedata.quest_start_y_for(qid) end
  let begun: Position = Position { qid: qid, x: begin_x, y: begin_y, pending: previous.pending and preserve_progress, completed: previous.completed and preserve_progress, cleared: previous.cleared }
  set_position(begun)
  begun
end

function quest_begin_response(p: text, btxt: text): text
  intent: encode the quest start after saving the posted squad and position
  let req: Json = request_object(btxt)
  let qid: text = last_segment(p)
  let posted: a list of text = posted_team(req)
  if length(posted) > 0 then set_saved_team(posted) end
  let begun: Position = begin_position(qid)
  let saved: a list of text = get_saved_team()
  let story_default: boolean = length(posted) == 0 and is_custom_story(qid)
  let team: a list of text = if story_default then gamedata.resolve_quest_team(qid, saved) else saved end
  if story_default and team != saved then set_saved_team(team) end
  spaced_envelope(gamedata.build_quest_begin_with_cleared(qid, json_text_or(req, "setId", gamedata.quest_set_id_for(qid)), team, begun.x, begun.y, cleared_json(begun.cleared)))
end

function movedir_dx(p: text): integer
  intent: read the horizontal step of a move path defaulting to one step east
  if movedir_offset(p, 2) == 999999 or movedir_offset(p, 1) == 999999 then 1 else movedir_offset(p, 2) end
end

function movedir_dy(p: text): integer
  intent: read the vertical step of a move path defaulting to none
  if movedir_offset(p, 2) == 999999 or movedir_offset(p, 1) == 999999 then 0 else movedir_offset(p, 1) end
end

function cleared_with_start(qid: text, start: Position): a list of text
  intent: add the start tile to the cleared tiles when it holds no encounter
  let start_point: text = to_text(start.x) ++ "," ++ to_text(start.y)
  if not gamedata.quest_has_encounter_at(qid, start.x, start.y) and not contains(start.cleared, start_point) then append(start.cleared, start_point) else start.cleared end
end

function moved_offsets(qid: text, start: Position, cleared: a list of text, dx: integer, dy: integer): a list of integer
  intent: save the new position when the step is allowed and return the offsets actually taken
  let candidate_x: integer = start.x + dx
  let candidate_y: integer = start.y + dy
  if start.pending then
    [0, 0]
  else if candidate_x >= 0 and candidate_x < gamedata.quest_dim_for(qid) and gamedata.quest_can_move(qid, start.x, start.y, candidate_x, candidate_y) then
    let point: text = to_text(candidate_x) ++ "," ++ to_text(candidate_y)
    let revisiting_completed: boolean = contains(start.cleared, point) or (start.completed and candidate_x == start.x and candidate_y == start.y)
    set_position(Position { qid: qid, x: candidate_x, y: candidate_y, pending: gamedata.quest_has_encounter_at(qid, candidate_x, candidate_y) and not revisiting_completed, completed: revisiting_completed, cleared: cleared })
    [dx, dy]
  else
    [0, 0]
  end
end

function movedir_envelope(qid: text, start: Position, cleared: a list of text, offx: integer, offy: integer): text
  intent: encode the move result with the cleared tiles attached to the progression
  let team: a list of text = get_saved_team()
  let progression: Json = if contains(cleared, to_text(start.x + offx) ++ "," ++ to_text(start.y + offy)) or (start.completed and offx == 0 and offy == 0) then
    gamedata.build_quest_movedir_completed(qid, offx, offy, start.x, start.y, team)
  else
    gamedata.build_quest_movedir(qid, offx, offy, start.x, start.y, team)
  end
  spaced_envelope(jsonout.obj_set(progression, "progression", jsonout.obj_set(jsonout.obj_get(progression, "progression"), "cleared", cleared_json(cleared))))
end

function movedir_response(p: text): text
  intent: encode the result of moving one step on the quest map
  let qid: text = movedir_qid(p)
  let start: Position = position_for(qid)
  let cleared: a list of text = cleared_with_start(qid, start)
  let offsets: a list of integer = moved_offsets(qid, start, cleared, movedir_dx(p), movedir_dy(p))
  movedir_envelope(qid, start, cleared, unwrap_or(get(offsets, 0), 0), unwrap_or(get(offsets, 1), 0))
end

function position_after_win(position: Position, submitted: text): Position
  intent: mark a pending position as cleared and completed when the winning quest matches
  let clears: boolean = position.pending and (submitted == "" or position.qid == normalize_qid(submitted))
  let point: text = to_text(position.x) ++ "," ++ to_text(position.y)
  let cleared: a list of text = if clears and not contains(position.cleared, point) then append(position.cleared, point) else position.cleared end
  Position { qid: position.qid, x: position.x, y: position.y, pending: if clears then false else position.pending end, completed: if clears then true else position.completed end, cleared: cleared }
end

function record_win(submitted: text): nothing
  intent: save every position after applying a won match
  let state: ServerState = load_state()
  mutable positions: a list of Position = []
  for position in state.positions do
    set positions = append(positions, position_after_win(position, submitted))
  end
  save_state(ServerState { team: state.team, positions: positions })
end

function resolved_outcome(req: Json): text
  intent: read the match result from the nested results or the request itself
  let nested: Json = if jsonout.obj_has(req, "results") and jsonout.type_name(jsonout.obj_get(req, "results")) == "object" then jsonout.obj_get(req, "results") else jsonout.json_obj([]) end
  json_text_or(nested, "result", json_text_or(req, "result", ""))
end

function resolve_match_response(path: text, btxt: text): text
  intent: record a won quest match and report the outcome to the pvp reconciliation
  let req: Json = request_object(btxt)
  let outcome: text = resolved_outcome(req)
  if uppercase(outcome) == "WON" then record_win(json_text_or(req, "qid", "")) end
  let peer: text = peer_key(path)
  let m: Match = match_for_peer(peer)
  if m.match_id != "" and outcome != "" then
    report_result_at(m.match_id, peer, normalize_outcome(outcome), current_time_ms())
  end
  ""
end

function saved_team_envelope(team_id: text, heroes: a list of text): text
  intent: encode
  let active_team_id: text = if starts_with(team_id, "PVP") then "arena_versus" else "1.1.1-" ++ team_id end
  let active_teams: a list of Json = if starts_with(team_id, "PVP") then [gamedata.build_active_team(active_team_id, heroes)] else [gamedata.build_active_team(active_team_id, heroes), gamedata.build_active_team(gamedata.custom_story_qid() ++ "-0", heroes), gamedata.build_active_team(gamedata.custom_story_act2_qid() ++ "-0", heroes), gamedata.build_active_team(gamedata.custom_story_act3_qid() ++ "-0", heroes), gamedata.build_active_team(gamedata.challenge_qid() ++ "-0", heroes)] end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("updates", jsonout.json_obj([jsonout.json_pair("savedTeams", jsonout.json_list([gamedata.build_saved_team(team_id, heroes)])), jsonout.json_pair("activeTeams", jsonout.json_list(active_teams))])), jsonout.json_pair("deletes", jsonout.json_obj([]))]))
end

function saved_team_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let team_id: text = if jsonout.obj_has(req, "teamID") then
  json_value_text(jsonout.obj_get(req, "teamID"), "0")
else
  "0"
end
  let heroes: a list of text = text_list_from_json(if jsonout.obj_has(req, "heroes") then
  jsonout.obj_get(req, "heroes")
else
  jsonout.json_list([])
end)
  set_saved_team(heroes)
  let peer: text = peer_key(path)
  let session: Session = session_for_token(peer)
  let default_name: text = if session.name != "" then session.name else "Commander" end
  let name: text = if jsonout.obj_has(req, "name") and jsonout.type_name(jsonout.obj_get(req, "name")) == "text" then jsonout.as_text(jsonout.obj_get(req, "name")) else default_name end
  let saved: a list of text = get_saved_team()
  store_roster(peer, name, saved)
  saved_team_envelope(team_id, saved)
end

function quest_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if contains_text(p, "/quests/quest-begin/") then quest_begin_response(p, btxt)
  else if contains_text(p, "/quests/quest-movedir/") then movedir_response(p)
  else if contains_text(p, "/matches/resolve-match/") then resolve_match_response(path, btxt)
  else if ends_with(p, "/bcg/setSavedTeam") then saved_team_response(path, btxt)
  else ""
  end
end

function synthetic_alliance(uid: text, name: text, now: integer): Json
  intent: build
  -- creationTime / joinTime are fixed (not `now`) so the exported @userprofile:template
  -- stays byte-identical to the live /userprofile response, which the payload parity test checks.
  jsonout.json_obj([pair_text("aid", "offline-alliance"), pair_text("name", "Offline Alliance"), pair_text("tag", "OFF"), pair_text("msg", "A local alliance for offline missions."), pair_text("privMsg", ""), pair_text("language", "en"), pair_text("locale", "en"), pair_text("localizedCountry", ""), pair_text("geo", ""), pair_text("pubType", "open"), jsonout.json_pair("data", jsonout.json_obj([])), jsonout.json_pair("joinReqs", jsonout.json_list([])), pair_int("creationTime", 1), jsonout.json_pair("stats", jsonout.json_obj([])), jsonout.json_pair("resourcesStatus", jsonout.json_obj([])), pair_int("numMembers", 1), jsonout.json_pair("members", jsonout.json_list([jsonout.json_obj([pair_text("uid", uid), pair_text("name", name), pair_text("tag", ""), pair_int("rank", 0), pair_int("joinTime", 1)])])), jsonout.json_pair("kickedMembers", jsonout.json_list([]))])
end

public function user_profile_response_values(uid: text, name: text, level: integer, now: integer): text
  intent: encode
  let profile: Json = jsonout.json_obj([pair_text("uid", uid), pair_text("aid", "offline-alliance"), pair_text("name", name), pair_text("tag", ""), pair_text("locale", "en"), pair_text("language", "en"), pair_text("highestRank", ""), jsonout.json_pair("activeTitle", jsonout.json_null()), jsonout.json_pair("myTitles", jsonout.json_list([])), pair_int("lastLogin", now), jsonout.json_pair("alliance", synthetic_alliance(uid, name, now)), jsonout.json_pair("levelRewards", jsonout.json_obj([pair_int("level", level), pair_bool("enabled", true), pair_bool("isEnabled", true), jsonout.json_pair("types", jsonout.json_list([]))])), jsonout.json_pair("resources", jsonout.json_obj([])), jsonout.json_pair("gameIntStats", jsonout.json_obj([pair_int("level", level)])), jsonout.json_pair("gameFloatStats", jsonout.json_obj([])), jsonout.json_pair("gameStringStats", jsonout.json_obj([])), jsonout.json_pair("gameJSONStats", jsonout.json_obj([])), jsonout.json_pair("gameData", jsonout.json_obj([])), pair_int("_createTime", now), pair_bool("_abbrivated", false)])
  compact_envelope(profile)
end

function user_profile_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let session: Session = session_for_token(query_value(path, "stoken"))
  let uid: text = json_text_or(req, "uid", if session.uid != "" then session.uid else "1000000000001" end)
  let name: text = if session.name != "" then session.name else "Commander" end
  let now: integer = floor(current_time_ms() / 1000)
  user_profile_response_values(uid, name, account_level(), now)
end

function profile_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if ends_with("/" ++ trim_path(p), "/userprofile") then user_profile_response(path, btxt) else "" end
end

function alliance_dynamic(path: text, p: text): text
  intent: encode
  if ends_with(p, "/alliances/refresh") or ends_with(p, "/alliances/details") then
  let session: Session = session_for_token(query_value(path, "stoken"))
  compact_envelope(synthetic_alliance(if session.uid != "" then session.uid else "1000000000001" end, if session.name != "" then session.name else "Commander" end, floor(current_time_ms() / 1000)))
else
  ""
end
end

public function dynamic(path: text, btxt: text): text
  intent: encode
  let p: text = unwrap_or(get(split(path, "?"), 0), path)
  let static: text = static_dynamic(path, p, btxt)
  if static != "" then
  static
else
  let profile: text = profile_dynamic(path, p, btxt)
  if profile != "" then profile else
  let alliance: text = alliance_dynamic(path, p)
  if alliance != "" then alliance else quest_dynamic(path, p, btxt) end
end
end
end

function file_name(path: text): text
  intent: get
  last_segment(path)
end

function advertised_canned_body(body: text): text
  intent: rewrite
  let host: text = unwrap_or(env_get("TFTF_SERVER_HOST"), "")
  if host == "" then
  body
else
  replace(body, "https://tform-0901-hzlhiniyfcwf.tf-cdn.net", gamedata.advertised_base_url())
end
end

public function resolve_response(method: text, path: text): ResponseChoice
  intent: response
  let exact: text = resp_path_for(method, path)
  if file_exists(exact) then
  ResponseChoice { source: "canned " ++ file_name(exact), body: advertised_canned_body(read_file(exact)) }
else
  let rules_path: text = path_join(resp_dir(), "_prefix_rules.json")
  if file_exists(rules_path) then
  let rules: a list of Json = jsonout.list_items(jsonout.parse_json(read_file(rules_path)))
  let p: text = unwrap_or(get(split(path, "?"), 0), path)
  for rule in rules do
    let pair: a list of Json = jsonout.list_items(rule)
    let prefix: text = jsonout.as_text(unwrap_or(get(pair, 0), jsonout.json_text("")))
    let filename: text = jsonout.as_text(unwrap_or(get(pair, 1), jsonout.json_text("")))
    let response: text = path_join(resp_dir(), filename)
    if starts_with(p, prefix) and file_exists(response) then
  return ResponseChoice { source: "rule " ++ prefix ++ " -> " ++ filename, body: advertised_canned_body(read_file(response)) }
end
  end
end
  ResponseChoice { source: "default", body: "\{" ++ "\"error\":null,\"result\":\{\}" ++ "\}" }
end
end

function timestamp(): text
  intent: get
  trim(unwrap_or(get(shell_exec("date +%H:%M:%S.%3N"), "stdout"), ""))
end

function log_line(line: text): nothing
  intent: log
  create_dir(log_dir())
  print(line)
  let old: text = if file_exists(logfile()) then
  read_file(logfile())
else
  ""
end
  write_file(logfile(), old ++ line ++ "\n")
end

function headers_text(headers: a mapping from text to text): text
  intent: get
  mutable out: text = ""
  mutable first: boolean = true
  for key in keys(headers) do
    if not first then
  set out = out ++ "; "
end
    set out = out ++ key ++ "=" ++ unwrap_or(get(headers, key), "")
    set first = false
  end
  out
end

function request_url(req: Request): text
  intent: join the request path and query
  if req.query == "" then req.path else req.path ++ "?" ++ req.query end
end

function log_request(req: Request, path: text): nothing
  intent: log the request line, headers and a clipped body
  let stamp: text = timestamp()
  let host: text = unwrap_or(get(req.headers, "host"), "?")
  log_line("[" ++ stamp ++ "] " ++ req.method ++ " https://" ++ host ++ path)
  log_line("    HDRS: " ++ headers_text(req.headers))
  if req.body != "" then
    log_line("    BODY(" ++ to_text(text_length(req.body)) ++ "): " ++ substring(req.body, 0, min(4000, text_length(req.body))))
  end
end

function log_choice(choice: ResponseChoice): nothing
  intent: log which source produced the response
  if choice.source == "dynamic" then
    log_line("    -> dynamic (" ++ to_text(text_length(choice.body)) ++ "B)")
  else if starts_with(choice.source, "canned ") or starts_with(choice.source, "rule ") then
    log_line("    -> " ++ choice.source ++ " (" ++ to_text(text_length(choice.body)) ++ "B)")
  else
    log_line("    -> default 200 envelope")
  end
end

function respond_to(req: Request, path: text): nothing
  intent: answer a request with the dynamic, canned or default body
  let generated: text = dynamic(path, req.body)
  let choice: ResponseChoice = if generated == "" then resolve_response(req.method, path) else ResponseChoice { source: "dynamic", body: generated } end
  log_choice(choice)
  http_respond_with_headers(200, {"Content-Type": "application/json", "Content-Length": to_text(text_length(choice.body))}, choice.body)
end

function request_loop(): nothing
  intent: serve requests forever logging each one
  while true do
    let req: Request = http_next_request()
    let path: text = request_url(req)
    log_request(req, path)
    if req.method == "HEAD" then http_respond_with_headers(200, {"Content-Length": "0"}, "") else respond_to(req, path) end
  end
end

public function serve_http(port: integer): nothing
  intent: serve
  create_dir(log_dir())
  http_start(port)
  log_line("[*] HTTP  listening on :" ++ to_text(port))
  request_loop()
end

public function serve_https(port: integer): nothing
  intent: serve
  create_dir(log_dir())
  http_start_https(port, pem_path(), pem_path())
  log_line("[*] HTTPS listening on :" ++ to_text(port))
  request_loop()
end

function emit(name: text, value: text): nothing
  intent: print
  print("## " ++ name)
  if value == "" then
  print("<NONE>")
else
  print(value)
end
end

function emit_resolve(name: text, method: text, path: text): nothing
  intent: print
  let choice: ResponseChoice = resolve_response(method, path)
  emit(name, "SRC " ++ choice.source ++ " LEN " ++ to_text(text_length(choice.body)))
end

