function dump_dynamic(): nothing
  intent: print
  dump_first_half()
  dump_second_half()
  dump_final_half()
end

function main(): nothing
  intent: serve
  let arguments: a list of text = get_args()
  let command: text = unwrap_or(get(arguments, 1), "")
  if command == "--dump-dynamic" then
  dump_dynamic()
else if command == "--http" then
  serve_http(unwrap_or(to_integer(unwrap_or(get(arguments, 2), "80")), 80))
else if command == "--https" then
  serve_https(unwrap_or(to_integer(unwrap_or(get(arguments, 2), "443")), 443))
else
  print("[*] One listener per process: run this with --http 80 and a second copy with --https 443.")
  serve_http(80)
end
end

main()
