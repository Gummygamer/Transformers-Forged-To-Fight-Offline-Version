  intent: print
  print("## saved_team_after_reset")
  print("")
  emit("dyn_unknown_path", "")
  emit_resolve("resolve_post_auth_login", "POST", "/auth/login")
  emit_resolve("resolve_get_auth_login", "GET", "/auth/login")
