use jsonout
use gamedata

record ResponseChoice
  source: text
  body: text
end

record Position
  qid: text
  x: integer
  y: integer
  pending: boolean
end

record ServerState
  team: a list of text
  positions: a list of Position
end

record Roster
  peer: text
  name: text
  heroes: a list of text
end

record Session
  fingerprint: text
  stoken: text
  uid: text
  name: text
end

record Request
  method: text
  path: text
  body: text
  query: text
  headers: a mapping from text to text
end

function last_slash(path: text): integer
  intent: find
  mutable result: integer = -1
  mutable index: integer = 0
  while index < text_length(path) do
    if substring(path, index, 1) == "/" then
  set result = index
end
    set index = index + 1
  end
  result
end

function directory_name(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then
  "."
else
  substring(path, 0, slash)
end
end

function absolute_script_path(arguments: a list of text): text
  intent: return
  let path: text = unwrap_or(get(arguments, 0), "")
  if starts_with(path, "/") then
  path
else
  path_join(get_cwd(), path)
end
end

public function here(): text
  intent: get
  directory_name(absolute_script_path(get_args()))
end

public function resp_dir(): text
  intent: get
  path_join(here(), "responses")
end

public function log_dir(): text
  intent: get
  path_join(here(), "logs")
end

public function pem_path(): text
  intent: get
  path_join(path_join(here(), "certs"), "server.pem")
end

public function logfile(): text
  intent: get
  path_join(log_dir(), "requests.log")
end

function state_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-state")
end

public function block_tutorials(): a list of text
  intent: return
  ["ShieldTutorial"]
end

public function live_tutorials(): a list of text
  intent: return
  ["FTE"]
end

function load_state(): ServerState
  intent: get
  if not file_exists(state_file()) then
  ServerState { team: [], positions: [] }
else
  let lines: a list of text = split(read_file(state_file()), "\n")
  mutable team: a list of text = []
  mutable positions: a list of Position = []
  for line in lines do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    if kind == "S" then
  let joined: text = unwrap_or(get(fields, 1), "")
  if joined != "" then
  set team = split(joined, ",")
end
else if kind == "Q" then
  let qid: text = unwrap_or(get(fields, 1), "")
  let x: integer = unwrap_or(to_integer(unwrap_or(get(fields, 2), "0")), 0)
  let y: integer = unwrap_or(to_integer(unwrap_or(get(fields, 3), "1")), 1)
  let pending: boolean = unwrap_or(get(fields, 5), "0") == "1"
  if qid != "" then
  set positions = append(positions, Position { qid: qid, x: x, y: y, pending: pending })
end
end
  end
  ServerState { team: team, positions: positions }
end
end

function save_state(state: ServerState): nothing
  intent: save
  create_dir(log_dir())
  mutable lines: a list of text = ["S|" ++ join(state.team, ",")]
  for position in state.positions do
    set lines = append(lines, "Q|" ++ position.qid ++ "|" ++ to_text(position.x) ++ "|" ++ to_text(position.y) ++ "|1|" ++ if position.pending then "1" else "0" end)
  end
  write_file(state_file(), join(lines, "\n"))
end

public function get_saved_team(): a list of text
  intent: get
  load_state().team
end

public function reset_saved_team(): nothing
  intent: reset
  let state: ServerState = load_state()
  save_state(ServerState { team: [], positions: state.positions })
end

public function reset_quest_positions(): nothing
  intent: reset
  let state: ServerState = load_state()
  save_state(ServerState { team: state.team, positions: [] })
end

function set_saved_team(team: a list of text): nothing
  intent: save
  let state: ServerState = load_state()
  save_state(ServerState { team: gamedata.resolve_team(team), positions: state.positions })
end

function position_for(qid: text): Position
  intent: get
  let state: ServerState = load_state()
  for position in state.positions do
    if position.qid == qid then
  return position
end
  end
  Position { qid: qid, x: 0, y: 1, pending: false }
end

function set_position(qid: text, x: integer, y: integer, pending: boolean): nothing
  intent: save
  let state: ServerState = load_state()
  mutable positions: a list of Position = []
  mutable replaced: boolean = false
  for position in state.positions do
    if position.qid == qid then
  set positions = append(positions, Position { qid: qid, x: x, y: y, pending: pending })
  set replaced = true
else
  set positions = append(positions, position)
end
  end
  if not replaced then
  set positions = append(positions, Position { qid: qid, x: x, y: y, pending: pending })
end
  save_state(ServerState { team: state.team, positions: positions })
end

function roster_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-rosters")
end

function roster_safe(value: text): text
  intent: clean
  replace(replace(replace(value, "|", "_"), ",", "_"), "\n", "_")
end

function session_file(): text
  intent: get
  path_join(log_dir(), ".fakeserver-sessions")
end

public function load_sessions(): a list of Session
  intent: load
  if not file_exists(session_file()) then
  []
else
  mutable sessions: a list of Session = []
  for line in split(read_file(session_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let fingerprint: text = unwrap_or(get(fields, 1), "")
    let stoken: text = unwrap_or(get(fields, 2), "")
    let uid: text = unwrap_or(get(fields, 3), "")
    let name: text = unwrap_or(get(fields, 4), "")
    if kind == "S" and fingerprint != "" and stoken != "" and uid != "" then
  set sessions = append(sessions, Session { fingerprint: fingerprint, stoken: stoken, uid: uid, name: name })
end
  end
  sessions
end
end

public function reset_sessions(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(session_file(), "")
end

public function session_for_token(stoken: text): Session
  intent: get
  for session in load_sessions() do
    if session.stoken == stoken then return session end
  end
  Session { fingerprint: "", stoken: "", uid: "", name: "" }
end

public function has_session_for_token(stoken: text): boolean
  intent: check
  session_for_token(stoken).stoken != ""
end

function token_characters(value: text): text
  intent: clean
  mutable result: text = ""
  mutable index: integer = 0
  while index < text_length(value) do
    let character: text = substring(value, index, 1)
    if contains_text("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", character) then
  set result = result ++ character
end
    set index = index + 1
  end
  result
end

function token_for_fingerprint(fingerprint: text, sessions: a list of Session): text
  intent: mint
  let base: text = substring("sess" ++ token_characters(fingerprint), 0, min(32, text_length("sess" ++ token_characters(fingerprint))))
  mutable taken: boolean = false
  for session in sessions do
    if session.stoken == base and session.fingerprint != fingerprint then
  set taken = true
end
  end
  if not taken then
  base
else
  let suffix: text = to_text(length(sessions))
  substring(base, 0, max(0, 32 - text_length(suffix))) ++ suffix
end
end

public function ensure_session(fingerprint: text, name: text): Session
  intent: ensure
  let safe_fingerprint: text = roster_safe(fingerprint)
  let safe_name: text = roster_safe(name)
  let sessions: a list of Session = load_sessions()
  for session in sessions do
    if session.fingerprint == safe_fingerprint then return session end
  end
  let created: Session = Session { fingerprint: safe_fingerprint, stoken: token_for_fingerprint(safe_fingerprint, sessions), uid: to_text(1000000000001 + length(sessions)), name: safe_name }
  create_dir(log_dir())
  let line: text = "S|" ++ created.fingerprint ++ "|" ++ created.stoken ++ "|" ++ created.uid ++ "|" ++ created.name
  let existing: text = if file_exists(session_file()) then read_file(session_file()) else "" end
  write_file(session_file(), if existing == "" then line else existing ++ "\n" ++ line end)
  created
end

public function load_rosters(): a list of Roster
  intent: load
  if not file_exists(roster_file()) then
  []
else
  mutable rosters: a list of Roster = []
  for line in split(read_file(roster_file()), "\n") do
    let fields: a list of text = split(line, "|")
    let kind: text = unwrap_or(get(fields, 0), "")
    let peer: text = unwrap_or(get(fields, 1), "")
    if kind == "R" and peer != "" then
  let joined: text = unwrap_or(get(fields, 3), "")
  let heroes: a list of text = if joined == "" then [] else split(joined, ",") end
  set rosters = append(rosters, Roster { peer: peer, name: unwrap_or(get(fields, 2), ""), heroes: heroes })
end
  end
  rosters
end
end

public function store_roster(peer: text, name: text, heroes: a list of text): nothing
  intent: save
  create_dir(log_dir())
  let key: text = roster_safe(peer)
  let heroes_resolved: a list of text = gamedata.resolve_team(heroes)
  mutable lines: a list of text = []
  for roster in load_rosters() do
    if roster.peer != key then
  set lines = append(lines, "R|" ++ roster.peer ++ "|" ++ roster.name ++ "|" ++ join(roster.heroes, ","))
end
  end
  set lines = append(lines, "R|" ++ key ++ "|" ++ roster_safe(name) ++ "|" ++ join(heroes_resolved, ","))
  write_file(roster_file(), join(lines, "\n"))
end

public function reset_rosters(): nothing
  intent: reset
  create_dir(log_dir())
  write_file(roster_file(), "")
end

public function opponent_roster(peer: text): Roster
  intent: get
  let key: text = roster_safe(peer)
  mutable found: boolean = false
  mutable opponent: Roster = Roster { peer: "house", name: "Autobot Garrison", heroes: gamedata.default_team() }
  for roster in load_rosters() do
    if roster.peer != key then
  set opponent = roster
  set found = true
end
  end
  if found then opponent else Roster { peer: "house", name: "Autobot Garrison", heroes: gamedata.default_team() } end
end

public function resp_path_for(method: text, path: text): text
  intent: get
  let stripped: text = trim_path(path)
  let key: text = method ++ "__" ++ unwrap_or(get(split(replace(stripped, "/", "_"), "?"), 0), "")
  if ends_with(key, ".json") then
  path_join(resp_dir(), key)
else
  path_join(resp_dir(), key ++ ".json")
end
end

function trim_path(path: text): text
  intent: path
  mutable start: integer = 0
  mutable finish: integer = text_length(path)
  while start < finish and substring(path, start, 1) == "/" do
    set start = start + 1
  end
  while finish > start and substring(path, finish - 1, 1) == "/" do
    set finish = finish - 1
  end
  substring(path, start, finish - start)
end

function request_object(body: text): Json
  intent: parse
  if starts_with(trim(body), "\{") then
  jsonout.parse_json(body)
else
  jsonout.json_obj([])
end
end

function json_text_or(node: Json, key: text, fallback: text): text
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "text" then
  jsonout.as_text(jsonout.obj_get(node, key))
else
  fallback
end
end

function json_text_first(node: Json, first: text, second: text, third: text): text
  intent: get
  let one: text = json_text_or(node, first, "")
  if one != "" then
  one
else
  let two: text = json_text_or(node, second, "")
  if two != "" then
  two
else
  json_text_or(node, third, "")
end
end
end

function json_list_or_empty(node: Json, key: text): a list of Json
  intent: get
  if jsonout.obj_has(node, key) and jsonout.type_name(jsonout.obj_get(node, key)) == "list" then
  jsonout.list_items(jsonout.obj_get(node, key))
else
  []
end
end

function text_list_from_json(node: Json): a list of text
  intent: get
  mutable result: a list of text = []
  if jsonout.type_name(node) == "list" then
  for item in jsonout.list_items(node) do
    if jsonout.type_name(item) == "text" then
  set result = append(result, jsonout.as_text(item))
end
  end
end
  result
end

function json_value_text(node: Json, fallback: text): text
  intent: get
  if jsonout.type_name(node) == "text" then
  jsonout.as_text(node)
else if jsonout.type_name(node) == "int" then
  to_text(jsonout.as_int(node))
else
  fallback
end
end

function query_has_missionsconfig(path: text): boolean
  intent: find
  let pieces: a list of text = split(path, "?")
  let query: text = unwrap_or(get(pieces, 1), "")
  mutable found: boolean = false
  for item in split(query, "&") do
    let pair: a list of text = split(item, "=")
    let key: text = url_decode(unwrap_or(get(pair, 0), ""))
    let value: text = url_decode(unwrap_or(get(pair, 1), ""))
    if starts_with(key, "groups.") and ends_with(key, ".name") and value == "missionsconfig" then
  set found = true
end
  end
  found
end

public function query_value(path: text, name: text): text
  intent: get
  let pieces: a list of text = split(path, "?")
  let query: text = unwrap_or(get(pieces, 1), "")
  mutable result: text = ""
  for item in split(query, "&") do
    let pair: a list of text = split(item, "=")
    let key: text = url_decode(unwrap_or(get(pair, 0), ""))
    let value: text = url_decode(unwrap_or(get(pair, 1), ""))
    if key == name then
  set result = value
end
  end
  result
end

public function peer_key(path: text): text
  intent: get
  let peer: text = query_value(path, "peer")
  let stoken: text = query_value(path, "stoken")
  if peer != "" then
  peer
else if stoken != "" then
  stoken
else
  "local"
end
end

function endpoint_is_tutorial(path: text): boolean
  intent: check
  ends_with(path, "/tutorial/start-tutorial") or ends_with(path, "/tutorial/start-branch") or ends_with(path, "/tutorial/early-start-branch") or ends_with(path, "/tutorial/complete-tutorial")
end

function last_segment(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then
  path
else
  substring(path, slash + 1, text_length(path) - slash - 1)
end
end

function movedir_qid(path: text): text
  intent: get
  let parts: a list of text = split(path, "/")
  let segment: text = unwrap_or(get(parts, length(parts) - 3), "")
  let bits: a list of text = split(segment, "-")
  mutable out: text = ""
  mutable index: integer = 0
  while index < length(bits) - 1 do
    if index > 0 then
  set out = out ++ "-"
end

    set out = out ++ unwrap_or(get(bits, index), "")
    set index = index + 1
  end
  out
end

function normalize_qid(qid: text): text
  intent: get
  let bits: a list of text = split(qid, "-")
  if length(bits) < 2 then
  qid
else
  mutable out: text = ""
  mutable index: integer = 0
  while index < length(bits) - 1 do
    if index > 0 then set out = out ++ "-" end
    set out = out ++ unwrap_or(get(bits, index), "")
    set index = index + 1
  end
  out
end
end

function movedir_offset(path: text, index: integer): integer
  intent: get
  let parts: a list of text = split(path, "/")
  unwrap_or(to_integer(unwrap_or(get(parts, length(parts) - index), "x")), 999999)
end

function compact_envelope(result: Json): text
  intent: encode
  jsonout.encode_compact(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result)]))
end

function spaced_envelope(result: Json): text
  intent: encode
  jsonout.encode_spaced(jsonout.json_obj([jsonout.json_pair("error", jsonout.json_null()), jsonout.json_pair("result", result)]))
end

function credentials_object(req: Json): Json
  intent: get
  if jsonout.obj_has(req, "credentials") and jsonout.type_name(jsonout.obj_get(req, "credentials")) == "object" then
  jsonout.obj_get(req, "credentials")
else
  jsonout.json_obj([])
end
end

function auth_login_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let credentials: Json = credentials_object(req)
  let udid: text = json_text_or(credentials, "udid", "")
  let bid: text = json_text_or(req, "bid", "")
  let device_name: text = json_text_or(credentials, "deviceName", "")
  let device_model: text = json_text_or(credentials, "deviceModel", "")
  let fingerprint: text = if udid != "" then
  udid
else if bid != "" then
  bid
else if device_name != "" then
  device_name
else if device_model != "" then
  device_model
else
  "local"
end
  let name: text = if device_name != "" then device_name else if device_model != "" then device_model else "Commander" end
  let session: Session = ensure_session(fingerprint, name)
  compact_envelope(jsonout.json_obj([jsonout.json_pair("stoken", jsonout.json_text(session.stoken)), jsonout.json_pair("server_tag", jsonout.json_text("prod")), jsonout.json_pair("userToken", jsonout.json_text("")), jsonout.json_pair("auth_data", jsonout.json_obj([])), jsonout.json_pair("user", jsonout.json_obj([jsonout.json_pair("uid", jsonout.json_int(unwrap_or(to_integer(session.uid), 1000000000001))), jsonout.json_pair("name", jsonout.json_text(session.name)), jsonout.json_pair("level", jsonout.json_int(1)), jsonout.json_pair("email", jsonout.json_text("")), jsonout.json_pair("fbid", jsonout.json_text("")), jsonout.json_pair("geo", jsonout.json_text("US")), jsonout.json_pair("naid", jsonout.json_text("")), jsonout.json_pair("cohort", jsonout.json_int(0)), jsonout.json_pair("revenue", jsonout.json_int(0))]))]))
end

function tutorial_response(p: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let tid: text = json_text_first(req, "tid", "tutorialId", "id")
  if tid == "" then
  ""
else if contains(block_tutorials(), tid) then
  jsonout.encode_spaced(jsonout.json_obj([jsonout.json_pair("err", jsonout.json_text("unavailable")), jsonout.json_pair("error", jsonout.json_text("unavailable")), jsonout.json_pair("retry", jsonout.json_bool(false)), jsonout.json_pair("fatal", jsonout.json_bool(false)), jsonout.json_pair("result", jsonout.json_obj([]))]))
else
  let bid: text = json_text_first(req, "bid", "branchId", "")
  let state: text = if contains(live_tutorials(), tid) and not ends_with(p, "/tutorial/complete-tutorial") then
  "started"
else
  "completed"
end
  let branches: Json = if bid == "" then
  jsonout.json_obj([])
else
  jsonout.json_obj([jsonout.json_pair(bid, jsonout.json_obj([jsonout.json_pair("s", jsonout.json_text(state))]))])
end
  spaced_envelope(jsonout.json_obj([jsonout.json_pair(tid, jsonout.json_obj([jsonout.json_pair("current_bid", jsonout.json_text(bid)), jsonout.json_pair("s", jsonout.json_text(state)), jsonout.json_pair("branches", branches)]))]))
end
end

function pvp_opponent_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let arena: text = json_text_or(req, "arenaID", "arena_versus")
  let opponent: Roster = opponent_roster(peer_key(path))
  mutable team: a list of Json = []
  for hero in opponent.heroes do
    set team = append(team, jsonout.json_text(hero))
  end
  let portrait: text = unwrap_or(get(opponent.heroes, 0), "")
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("pvpid", jsonout.json_text(arena ++ "-1")), jsonout.json_pair("state", jsonout.json_int(128)), jsonout.json_pair("opponentIndex", jsonout.json_int(0)), jsonout.json_pair("opponents", jsonout.json_list([jsonout.json_obj([jsonout.json_pair("uid", jsonout.json_text(opponent.peer)), jsonout.json_pair("team", jsonout.json_list(team)), jsonout.json_pair("matchups", jsonout.json_list([])), jsonout.json_pair("userData", jsonout.json_obj([jsonout.json_pair("name", jsonout.json_text(opponent.name)), jsonout.json_pair("tag", jsonout.json_text("LAN")), jsonout.json_pair("level", jsonout.json_int(40)), jsonout.json_pair("portrait", jsonout.json_text(portrait)), jsonout.json_pair("factionId", jsonout.json_text("")), jsonout.json_pair("arenaStats", jsonout.json_obj([]))]))])])), jsonout.json_pair("fightRewards", jsonout.json_list([])), jsonout.json_pair("seriesRewards", jsonout.json_list([])), jsonout.json_pair("milestones", jsonout.json_list([]))]))
end

function static_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if ends_with(p, "/auth/login") then
  auth_login_response(path, btxt)
else if ends_with(p, "/bcg/getUserData") then
  compact_envelope(gamedata.build_user_data(get_saved_team()))
else if ends_with(p, "/autorefresh/grouprefresh") then
  let updates: a list of Json = if query_has_missionsconfig(path) then
  [gamedata.build_missions_autorefresh_update()]
else
  []
end
  compact_envelope(jsonout.json_obj([jsonout.json_pair("updates", jsonout.json_list(updates))]))
else if ends_with(p, "/base/active") then
  compact_envelope(gamedata.build_base_active())
else if ends_with(p, "/pvp/find-arena-opponent") or ends_with(p, "/pvp/get-new-arena-opponent") or ends_with(p, "/pvp/get-opponents") then
  pvp_opponent_response(path, btxt)
else if endpoint_is_tutorial(p) then
  tutorial_response(p, btxt)
else if ends_with(p, "/bcg/getBaseHeroData") then
  let req: Json = request_object(btxt)
  spaced_envelope(gamedata.build_base_hero_details(json_list_or_empty(req, "heroes")))
else if contains_text(p, "/quests/quest-detail/") then
  let req: Json = request_object(btxt)
  spaced_envelope(gamedata.build_quest_detail(last_segment(p), json_text_or(req, "setId", "story_act1")))
else
  ""
end
end

function quest_begin_response(p: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  mutable posted: a list of text = []
  mutable index: integer = 0
  while index < gamedata.team_size_max() do
  let member: text = json_text_or(req, "tm" ++ to_text(index), "")
  if member != "" then set posted = append(posted, member) end
  set index = index + 1
end
  let overflow: text = json_text_or(req, "tm" ++ to_text(gamedata.team_size_max()), "")
  if overflow != "" then set posted = append(posted, overflow) end
  if length(posted) > 0 then
  set_saved_team(posted)
end
  let qid: text = last_segment(p)
  set_position(qid, 0, 1, false)
  spaced_envelope(gamedata.build_quest_begin(qid, json_text_or(req, "setId", "story_act1"), get_saved_team()))
end

function movedir_response(p: text): text
  intent: encode
  let qid: text = movedir_qid(p)
  mutable offx: integer = movedir_offset(p, 2)
  mutable offy: integer = movedir_offset(p, 1)
  if offx == 999999 or offy == 999999 then
  set offx = 1
  set offy = 0
  end
  let start: Position = position_for(qid)
  if start.pending then
  set offx = 0
  set offy = 0
  else
  let candidate_x: integer = start.x + offx
  let candidate_y: integer = start.y + offy
  if candidate_x >= 0 and candidate_x < gamedata.quest_dim() and candidate_y == gamedata.quest_path_col() then
  set_position(qid, candidate_x, candidate_y, gamedata.quest_has_encounter(candidate_x))
  else
    set offx = 0
    set offy = 0
  end
  end
  spaced_envelope(gamedata.build_quest_movedir(qid, offx, offy, start.x, start.y, get_saved_team()))
end

function resolve_match_response(btxt: text): text
  intent: resolve
  let req: Json = request_object(btxt)
  let nested: Json = if jsonout.obj_has(req, "results") and jsonout.type_name(jsonout.obj_get(req, "results")) == "object" then jsonout.obj_get(req, "results") else jsonout.json_obj([]) end
  let outcome: text = json_text_or(nested, "result", json_text_or(req, "result", ""))
  if uppercase(outcome) == "WON" then
  let submitted: text = json_text_or(req, "qid", "")
  let state: ServerState = load_state()
  mutable positions: a list of Position = []
  for position in state.positions do
    let clears: boolean = if submitted == "" then true else position.qid == normalize_qid(submitted) end
    set positions = append(positions, Position { qid: position.qid, x: position.x, y: position.y, pending: if clears then false else position.pending end })
  end
  save_state(ServerState { team: state.team, positions: positions })
end
  ""
end

function saved_team_envelope(team_id: text, heroes: a list of text): text
  intent: encode
  spaced_envelope(jsonout.json_obj([jsonout.json_pair("updates", jsonout.json_obj([jsonout.json_pair("savedTeams", jsonout.json_list([gamedata.build_saved_team(team_id, heroes)])), jsonout.json_pair("activeTeams", jsonout.json_list([gamedata.build_active_team("1.1.1-" ++ team_id, heroes)]))])), jsonout.json_pair("deletes", jsonout.json_obj([]))]))
end

function saved_team_response(path: text, btxt: text): text
  intent: encode
  let req: Json = request_object(btxt)
  let team_id: text = if jsonout.obj_has(req, "teamID") then
  json_value_text(jsonout.obj_get(req, "teamID"), "0")
else
  "0"
end
  let heroes: a list of text = text_list_from_json(if jsonout.obj_has(req, "heroes") then
  jsonout.obj_get(req, "heroes")
else
  jsonout.json_list([])
end)
  set_saved_team(heroes)
  let peer: text = peer_key(path)
  let session: Session = session_for_token(peer)
  let default_name: text = if session.name != "" then session.name else "Commander" end
  let name: text = if jsonout.obj_has(req, "name") and jsonout.type_name(jsonout.obj_get(req, "name")) == "text" then jsonout.as_text(jsonout.obj_get(req, "name")) else default_name end
  store_roster(peer, name, heroes)
  saved_team_envelope(team_id, heroes)
end

function quest_dynamic(path: text, p: text, btxt: text): text
  intent: encode
  if contains_text(p, "/quests/quest-begin/") then quest_begin_response(p, btxt)
  else if contains_text(p, "/quests/quest-movedir/") then movedir_response(p)
  else if contains_text(p, "/matches/resolve-match/") then resolve_match_response(btxt)
  else if ends_with(p, "/bcg/setSavedTeam") then saved_team_response(path, btxt)
  else ""
  end
end

public function dynamic(path: text, btxt: text): text
  intent: encode
  let p: text = unwrap_or(get(split(path, "?"), 0), path)
  let static: text = static_dynamic(path, p, btxt)
  if static != "" then
  static
else
  quest_dynamic(path, p, btxt)
end
end

function file_name(path: text): text
  intent: get
  last_segment(path)
end

function advertised_canned_body(body: text): text
  intent: rewrite
  let host: text = unwrap_or(env_get("TFTF_SERVER_HOST"), "")
  if host == "" then
  body
else
  replace(body, "https://tform-0901-hzlhiniyfcwf.tf-cdn.net", gamedata.advertised_base_url())
end
end

public function resolve_response(method: text, path: text): ResponseChoice
  intent: response
  let exact: text = resp_path_for(method, path)
  if file_exists(exact) then
  ResponseChoice { source: "canned " ++ file_name(exact), body: advertised_canned_body(read_file(exact)) }
else
  let rules_path: text = path_join(resp_dir(), "_prefix_rules.json")
  if file_exists(rules_path) then
  let rules: a list of Json = jsonout.list_items(jsonout.parse_json(read_file(rules_path)))
  let p: text = unwrap_or(get(split(path, "?"), 0), path)
  for rule in rules do
    let pair: a list of Json = jsonout.list_items(rule)
    let prefix: text = jsonout.as_text(unwrap_or(get(pair, 0), jsonout.json_text("")))
    let filename: text = jsonout.as_text(unwrap_or(get(pair, 1), jsonout.json_text("")))
    let response: text = path_join(resp_dir(), filename)
    if starts_with(p, prefix) and file_exists(response) then
  return ResponseChoice { source: "rule " ++ prefix ++ " -> " ++ filename, body: advertised_canned_body(read_file(response)) }
end
  end
end
  ResponseChoice { source: "default", body: "\{" ++ "\"error\":null,\"result\":\{\}" ++ "\}" }
end
end

function timestamp(): text
  intent: get
  trim(unwrap_or(get(shell_exec("date +%H:%M:%S.%3N"), "stdout"), ""))
end

function log_line(line: text): nothing
  intent: log
  create_dir(log_dir())
  print(line)
  let old: text = if file_exists(logfile()) then
  read_file(logfile())
else
  ""
end
  write_file(logfile(), old ++ line ++ "\n")
end

function headers_text(headers: a mapping from text to text): text
  intent: get
  mutable out: text = ""
  mutable first: boolean = true
  for key in keys(headers) do
    if not first then
  set out = out ++ "; "
end
    set out = out ++ key ++ "=" ++ unwrap_or(get(headers, key), "")
    set first = false
  end
  out
end

function request_loop(): nothing
  intent: serve
  while true do
    let req: Request = http_next_request()
    let path: text = if req.query == "" then
  req.path
else
  req.path ++ "?" ++ req.query
end
    let stamp: text = timestamp()
    let host: text = unwrap_or(get(req.headers, "host"), "?")
    log_line("[" ++ stamp ++ "] " ++ req.method ++ " https://" ++ host ++ path)
    log_line("    HDRS: " ++ headers_text(req.headers))
    if req.body != "" then
  log_line("    BODY(" ++ to_text(text_length(req.body)) ++ "): " ++ substring(req.body, 0, min(4000, text_length(req.body))))
end
    if req.method == "HEAD" then
  http_respond_with_headers(200, {"Content-Length": "0"}, "")
else
  let generated: text = dynamic(path, req.body)
  let choice: ResponseChoice = if generated == "" then
  resolve_response(req.method, path)
else
  ResponseChoice { source: "dynamic", body: generated }
end
  if choice.source == "dynamic" then
  log_line("    -> dynamic (" ++ to_text(text_length(choice.body)) ++ "B)")
else if starts_with(choice.source, "canned ") then
  log_line("    -> " ++ choice.source ++ " (" ++ to_text(text_length(choice.body)) ++ "B)")
else if starts_with(choice.source, "rule ") then
  log_line("    -> " ++ choice.source ++ " (" ++ to_text(text_length(choice.body)) ++ "B)")
else
  log_line("    -> default 200 envelope")
end
  http_respond_with_headers(200, {"Content-Type": "application/json", "Content-Length": to_text(text_length(choice.body))}, choice.body)
end
  end
end

public function serve_http(port: integer): nothing
  intent: serve
  create_dir(log_dir())
  http_start(port)
  log_line("[*] HTTP  listening on :" ++ to_text(port))
  request_loop()
end

public function serve_https(port: integer): nothing
  intent: serve
  create_dir(log_dir())
  http_start_https(port, pem_path(), pem_path())
  log_line("[*] HTTPS listening on :" ++ to_text(port))
  request_loop()
end

function emit(name: text, value: text): nothing
  intent: print
  print("## " ++ name)
  if value == "" then
  print("<NONE>")
else
  print(value)
end
end

function emit_resolve(name: text, method: text, path: text): nothing
  intent: print
  let choice: ResponseChoice = resolve_response(method, path)
  emit(name, "SRC " ++ choice.source ++ " LEN " ++ to_text(text_length(choice.body)))
end

