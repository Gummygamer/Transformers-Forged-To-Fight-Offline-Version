public function build_missions_config(): Json
  intent: build
  let combat: Json = jsonout.json_obj([jsonout.json_pair("armorRatingConstant", jsonout.json_dec(1000)), jsonout.json_pair("manaPerSpecial", jsonout.json_dec(300)), jsonout.json_pair("maxQueuedActionTime", jsonout.json_dec(0.2))])
  let user_base: Json = jsonout.json_obj([jsonout.json_pair("minClaimInterval", jsonout.json_int(60)), jsonout.json_pair("minClaimPercentage", jsonout.json_dec(0.1))])
  jsonout.json_obj([jsonout.json_pair("configsHash", jsonout.json_text("offline-v1")), jsonout.json_pair("configs", jsonout.json_obj([jsonout.json_pair("bcg-combat", combat), jsonout.json_pair("user-base", user_base)]))])
end

