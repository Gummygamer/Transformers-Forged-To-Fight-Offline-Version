public function default_team(): a list of text
  intent: return
  ["optimusprime_cin_tf", "optimusprimal_bw_mp32", "megatron_gs_leader2015"]
end

public function boss_blueprint(): text
  intent: return
  "nemesisprime_gs_voyager2015"
end

public function minion_blueprint(): text
  intent: return
  "sharkticon_gs_warrior"
end

public function quest_dim(): integer
  intent: return
  11
end

public function quest_path_col(): integer
  intent: return
  1
end

public function quest_has_encounter(row: integer): boolean
  intent: check
  row >= 1 and row <= quest_dim() - 1
end

public function quest_encounter(row: integer): QuestEncounter
  intent: get
  if row == 1 then
  QuestEncounter { key: minion_blueprint(), final_boss: false, label: "Patrol" }
else if row == 2 then
  QuestEncounter { key: "kickback_gs_kabam", final_boss: false, label: "Insecticon Scouts" }
else if row == 3 then
  QuestEncounter { key: "waspinator_gs_deluxe", final_boss: false, label: "Buzzsaw Swarm" }
else if row == 4 then
  QuestEncounter { key: "sharkticon_gs_demolition", final_boss: false, label: "Demolition Crew" }
else if row == 5 then
  QuestEncounter { key: "soundwave_gs", final_boss: false, label: "Interceptor" }
else if row == 6 then
  QuestEncounter { key: "cyclonus_gs_uw06", final_boss: false, label: "Sweep Patrol" }
else if row == 7 then
  QuestEncounter { key: "motormaster_gs_voyager2015", final_boss: false, label: "Highway Blockade" }
else if row == 8 then
  QuestEncounter { key: "bludgeon_gs_rd20", final_boss: false, label: "Blade Duel" }
else if row == 9 then
  QuestEncounter { key: "necrotronus_gs_kabam", final_boss: false, label: "Siege Breaker" }
else
  QuestEncounter { key: boss_blueprint(), final_boss: true, label: "Boss" }
end
end

public function custom_story_qid(): text
  intent: return
  "2.1.1"
end

public function custom_story_set_id(): text
  intent: return
  "custom_story_act1"
end

public function custom_story_enemy(): text
  intent: return
  "bludgeon_gs_rd20"
end

public function custom_story_team(): a list of text
  intent: return
  ["optimusprime_cin_tf"]
end

public function custom_story_set_hash(): text
  intent: return
  "custom-story-h1"
end

-- The client indexes every quest summary into per-set tables sized
-- actCount + 1 (Legacy.QuestSet.BuildSummaryTable), then indexes them by
-- the summary's act/chapter/mission fields. The custom quest lives in its
-- own single-act set, so its summary slot must be 1/1/1 even though the
-- qid string starts with 2. An act of 2 with actCount 1 throws
-- IndexOutOfRangeException while parsing the quest list.
public function custom_story_summary_act(): integer
  intent: return
  1
end

public function custom_story_summary_chapter(): integer
  intent: return
  1
end

public function custom_story_summary_mission(): integer
  intent: return
  1
end

public function quest_set_id_for(qid: text): text
  intent: get
  if qid == custom_story_qid() then custom_story_set_id() else "story_act1" end
end

-- The activeQuest wrapper hash must match the set hash advertised in the
-- quest list; the known-good template set carries "h1" in both places.
-- A mismatched wrapper hash makes the client retry quest-begin in a loop.
public function quest_set_hash_for(qid: text): text
  intent: get
  if qid == custom_story_qid() then custom_story_set_hash() else "h1" end
end

public function quest_dim_for(qid: text): integer
  intent: get
  if qid == custom_story_qid() then 2 else quest_dim() end
end

public function quest_path_col_for(qid: text): integer
  intent: get
  quest_path_col()
end

public function quest_start_x_for(qid: text): integer
  intent: get
  0
end

public function quest_start_y_for(qid: text): integer
  intent: get
  quest_path_col_for(qid)
end

public function quest_has_encounter_for(qid: text, row: integer): boolean
  intent: check
  if qid == custom_story_qid() then row == 1 else quest_has_encounter(row) end
end

public function quest_encounter_for(qid: text, row: integer): QuestEncounter
  intent: get
  if qid == custom_story_qid() then
  QuestEncounter { key: custom_story_enemy(), final_boss: true, label: "Bludgeon's Ambush" }
else
  quest_encounter(row)
end
end

public function resolve_quest_team(qid: text, team: a list of text): a list of text
  intent: return
  if qid == custom_story_qid() then custom_story_team() else resolve_team(team) end
end

function roster_has_bid(bid: text): boolean
  intent: find
  mutable found: boolean = false
  for entry in roster() do
    if entry.bid == bid then
  set found = true
end
  end
  found
end

public function team_size_max(): integer
  intent: return
  5
end

public function resolve_team(team: a list of text): a list of text
  intent: return
  if length(team) == 0 or length(team) > team_size_max() then
  default_team()
else
  mutable valid: boolean = true
  for bid in team do
    if not roster_has_bid(bid) then
  set valid = false
end
  end
  if valid then
  team
else
  default_team()
end
end
end

function dump_slice2(): nothing
  intent: print
  mutable bases: a list of Pair = []
  mutable entries: a list of Pair = []
  for bid in ["optimusprime_cin_tf", "sharkticon_gs_brawler", "fte_optimus_gs_t3", "megatron_g1_mp10"] do
    for rank in [1, 2, 3, 5] do
      set bases = append(bases, jsonout.json_pair(bid ++ "/" ++ to_text(rank), build_hero_base(bid, rank)))
    end
    for rank in [1, 3] do
      for level in [1, 7, 30] do
        set entries = append(entries, jsonout.json_pair(bid ++ "/" ++ to_text(rank) ++ "/" ++ to_text(level), build_hero_entry(bid, rank, level)))
      end
    end
  end
  print(jsonout.encode_compact(jsonout.json_obj([jsonout.json_pair("characters", build_characters()), jsonout.json_pair("attack_values", build_attack_values()), jsonout.json_pair("missions_config", build_missions_config()), jsonout.json_pair("missions_autorefresh_result", build_missions_autorefresh_result()), jsonout.json_pair("missions_autorefresh_update", build_missions_autorefresh_update()), jsonout.json_pair("missions_account_data", build_missions_account_data()), jsonout.json_pair("hero_classes", build_hero_classes()), jsonout.json_pair("rarity_properties", build_rarity_properties()), jsonout.json_pair("stat_modifiers", build_stat_modifiers()), jsonout.json_pair("heroes", build_heroes()), jsonout.json_pair("login_data", build_login_data()), jsonout.json_pair("hero_base", jsonout.json_obj(bases)), jsonout.json_pair("hero_entry", jsonout.json_obj(entries))])))
end

function dump_teams(): nothing
  intent: print
  print("DEFAULT_TEAM " ++ join(default_team(), ","))
  print("BOSS_BLUEPRINT " ++ boss_blueprint())
  print("TEAM NONE -> " ++ join(resolve_team([]), ","))
  print("TEAM EMPTY -> " ++ join(resolve_team([]), ","))
  print("TEAM optimusprime_cin_tf -> " ++ join(resolve_team(["optimusprime_cin_tf"]), ","))
  print("TEAM megatron_g1_mp10,optimusprime_cin_tf -> " ++ join(resolve_team(["megatron_g1_mp10", "optimusprime_cin_tf"]), ","))
  print("TEAM no_such_bot_xyz -> " ++ join(resolve_team(["no_such_bot_xyz"]), ","))
  print("TEAM optimusprime_cin_tf,no_such_bot_xyz -> " ++ join(resolve_team(["optimusprime_cin_tf", "no_such_bot_xyz"]), ","))
  print("TEAM optimusprime_cin_tf,megatron_g1_mp10,optimusprimal_bw_mp32 -> " ++ join(resolve_team(["optimusprime_cin_tf", "megatron_g1_mp10", "optimusprimal_bw_mp32"]), ","))
end

function main(): nothing
  intent: run
  let arguments: a list of text = get_args()
  let mode: text = unwrap_or(get(arguments, 1), "")
  if mode == "" then
  build_responses()
  print("roster: " ++ to_text(length(roster())) ++ " bots, " ++ to_text(length(owned())) ++ " owned")
else if mode == "--dump-blueprints" then
  print(jsonout.encode_compact(build_blueprints()))
else if mode == "--dump-helpers" then
  dump_helpers()
else if mode == "--dump-slice2" then
  dump_slice2()
else if mode == "--dump-teams" then
  dump_teams()
else if mode == "--dump-slice3" then
  dump_slice3()
else if mode == "--dump-arena" then
  dump_arena()
else if mode == "--dump-slice4" then
  dump_slice4()
else if mode == "--dump-mana-start" then
  dump_mana_start()
else
  print("usage: gamedata.lbl --dump-blueprints|--dump-helpers|--dump-slice2|--dump-teams|--dump-slice3|--dump-arena|--dump-slice4|--dump-mana-start")
end
end

function is_digits(value: text): boolean
  intent: check
  mutable index: integer = 0
  mutable valid: boolean = text_length(value) > 0
  while index < text_length(value) do
    if not contains_text("0123456789", substring(value, index, 1)) then
  set valid = false
end
    set index = index + 1
  end
  valid
end

function arena_levels_json(): Json
  intent: build
  let indices: Json = jsonout.json_list([jsonout.json_int(0), jsonout.json_int(1), jsonout.json_int(2)])
  jsonout.json_obj([jsonout.json_pair("chicago", indices), jsonout.json_pair("hongkong", indices), jsonout.json_pair("karnak", indices), jsonout.json_pair("mine", indices), jsonout.json_pair("rust", indices)])
end

function is_arena_level(level: text): boolean
  intent: check
  level == "chicago" or level == "hongkong" or level == "karnak" or level == "mine" or level == "rust"
end

public function arena_level(): text
  intent: get
  let level: text = unwrap_or(env_get("TFTF_ARENA_LEVEL"), "chicago")
  if is_arena_level(level) then
  level
else
  print("[!] gamedata: Invalid TFTF_ARENA_LEVEL '" ++ level ++ "'; valid levels: chicago, hongkong, karnak, mine, rust")
  exit_process(1)
  ""
end
end

-- These exact names must match the AIProfile and AIPersonality assets shipped in the client. Live testing proved valid names alone do not make the offline opponent select the ranged branch.
public function enemy_ai_profile(): text
  intent: name
  "Default"
end

public function enemy_ai_personality(): text
  intent: name
  "Ranged"
end

public function arena_tod_index(): integer
  intent: get
  let level: text = arena_level()
  let raw: text = unwrap_or(env_get("TFTF_ARENA_TOD"), "0")
  let index: integer = to_integer(raw)
  if is_digits(raw) and index >= 0 and index <= 2 then
  index
else
  print("[!] gamedata: Invalid TFTF_ARENA_TOD " ++ raw ++ " for level '" ++ level ++ "'; valid indices: 0, 1, 2")
  exit_process(1)
  0
end
end

function vec2(x: integer, y: integer): Json
  intent: build
  jsonout.json_obj([jsonout.json_pair("x", jsonout.json_int(x)), jsonout.json_pair("y", jsonout.json_int(y))])
end

