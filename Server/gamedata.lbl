function links_for(row: integer, col: integer): Json
  intent: build
  mutable links: a list of Json = []
  if col == 1 then
  if row - 1 >= 0 then
  set links = append(links, vec2(row - 1, 1))
end
  if row + 1 < quest_dim() then
  set links = append(links, vec2(row + 1, 1))
end
end
  jsonout.json_list(links)
end

function filler_tile(): Json
  intent: build
  jsonout.json_obj([jsonout.json_pair("walkable", jsonout.json_bool(false)), jsonout.json_pair("hidden", jsonout.json_bool(true))])
end

