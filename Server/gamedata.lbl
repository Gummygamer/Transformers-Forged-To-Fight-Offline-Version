  [BuildingSpec { bid: "bldg_battle_centre", name: "Battle Centre", desc: "Coordinate your Autobots' battles from here.", model: "z_bldg_battle_centre_01" }, BuildingSpec { bid: "bldg_away_team", name: "Away Team", desc: "Send bots on away missions across Cybertron.", model: "z_bldg_away_team_01" }, BuildingSpec { bid: "bldg_alliance_help", name: "Alliance Beacon", desc: "Call in help from allied Autobots.", model: "z_bldg_alliance_help_01" }, BuildingSpec { bid: "bldg_crystal_free", name: "Crystal Chamber", desc: "Synthesizes a free crystal now and then.", model: "z_bldg_gacha_free_01" }, BuildingSpec { bid: "bldg_crystal_daily", name: "Daily Crystal Vault", desc: "Produces one crystal every day.", model: "z_bldg_gacha_daily_01" }, BuildingSpec { bid: "bldg_crystal_premium", name: "Premium Crystal Vault", desc: "Stores premium crystals.", model: "z_bldg_gacha_other_01" }]
end

