function build_custom_story_map(qid: text): Json
  intent: build
  let first_links: Json = jsonout.json_list([vec2(1, 1)])
  let grid: Json = jsonout.json_list([jsonout.json_list([filler_tile(), start_tile(first_links)]), jsonout.json_list([filler_tile(), custom_story_encounter_tile()])])
  let path: Json = jsonout.json_list([vec2(0, 1), vec2(1, 1)])
  jsonout.json_obj([jsonout.json_pair("hash", jsonout.json_text("qm_" ++ qid)), jsonout.json_pair("v", jsonout.json_int(1)), jsonout.json_pair("mapHash", jsonout.json_text("qm_" ++ qid)), jsonout.json_pair("gridDimension", jsonout.json_int(2)), jsonout.json_pair("grid", grid), jsonout.json_pair("walkableCount", jsonout.json_int(2)), jsonout.json_pair("visibleWalkableCount", jsonout.json_int(2)), jsonout.json_pair("pathData", jsonout.json_list([jsonout.json_obj([jsonout.json_pair("path", path)])])), jsonout.json_pair("overrideZoom", jsonout.json_int(0))])
end

public function build_quest_map(qid: text): Json
  intent: build
  if qid == custom_story_qid() then
  build_custom_story_map(qid)
else
  mutable grid: a list of Json = []
  mutable row: integer = 0
  while row < quest_dim() do
    mutable tiles: a list of Json = []
    mutable col: integer = 0
    while col < quest_dim() do
      if col != quest_path_col() then
  set tiles = append(tiles, filler_tile())
else
  let links: Json = links_for(row, col)
  if row == 0 then
  set tiles = append(tiles, start_tile(links))
else if quest_has_encounter(row) then
  set tiles = append(tiles, encounter_tile(row, links))
else
  set tiles = append(tiles, middle_tile(row, links))
end
end
      set col = col + 1
    end
    set grid = append(grid, jsonout.json_list(tiles))
    set row = row + 1
  end
  mutable path_points: a list of Json = []
  mutable path_row: integer = 0
  while path_row < quest_dim() do
    set path_points = append(path_points, vec2(path_row, quest_path_col()))
    set path_row = path_row + 1
  end
  let path: Json = jsonout.json_list(path_points)
  jsonout.json_obj([jsonout.json_pair("hash", jsonout.json_text("qm_" ++ qid)), jsonout.json_pair("v", jsonout.json_int(1)), jsonout.json_pair("mapHash", jsonout.json_text("qm_" ++ qid)), jsonout.json_pair("gridDimension", jsonout.json_int(quest_dim())), jsonout.json_pair("grid", jsonout.json_list(grid)), jsonout.json_pair("walkableCount", jsonout.json_int(quest_dim())), jsonout.json_pair("visibleWalkableCount", jsonout.json_int(quest_dim())), jsonout.json_pair("pathData", jsonout.json_list([jsonout.json_obj([jsonout.json_pair("path", path)])])), jsonout.json_pair("overrideZoom", jsonout.json_int(0))])
end
end

public function build_quest_enemy_for(map_override: text, tod_index: integer, key: text, is_final_boss: boolean): Json
  intent: build
  let selected_map: text = if map_override == "" then
  arena_level()
else
  map_override
end
  let selected_tod: integer = if tod_index < 0 then
  arena_tod_index()
else
  tod_index
end
  jsonout.json_obj([jsonout.json_pair("key", jsonout.json_text(key)), jsonout.json_pair("entityType", jsonout.json_text("boss")), jsonout.json_pair("parentEntityType", jsonout.json_text("boss")), jsonout.json_pair("isFinalBoss", jsonout.json_bool(is_final_boss)), jsonout.json_pair("characters", jsonout.json_list([jsonout.json_text(key)])), jsonout.json_pair("rank", jsonout.json_int(1)), jsonout.json_pair("level", jsonout.json_int(1)), jsonout.json_pair("sig_lvl", jsonout.json_int(0)), jsonout.json_pair("flvl", jsonout.json_int(0)), jsonout.json_pair("aiType", jsonout.json_int(0)), jsonout.json_pair("aiString", jsonout.json_text(enemy_ai_profile())), jsonout.json_pair("aiPer", jsonout.json_text(enemy_ai_personality())), jsonout.json_pair("mapOverride", jsonout.json_text(selected_map)), jsonout.json_pair("todIndex", jsonout.json_int(selected_tod))])
end

public function build_quest_enemy(map_override: text, tod_index: integer): Json
  intent: build
  build_quest_enemy_for(map_override, tod_index, boss_blueprint(), true)
end

public function local_uid(): text
  intent: return
  "1000000000001"
end

function quest_team(bids: a list of text): Json
  intent: build
  mutable entries: a list of Pair = []
  for bid in bids do
    let stats: Stats = base_stats(bid, 1, 1)
    let pi: integer = to_integer(to_decimal(stats.hp + stats.atk) / 20)
    let hero: Json = jsonout.json_obj([jsonout.json_pair("hp", jsonout.json_dec(1)), jsonout.json_pair("pi", jsonout.json_int(pi)), jsonout.json_pair("sig_lvl", jsonout.json_int(0)), jsonout.json_pair("stat_mods", jsonout.json_list([])), jsonout.json_pair("sig_mods", jsonout.json_list([]))])
    set entries = append(entries, jsonout.json_pair(bid, hero))
  end
  jsonout.json_obj(entries)
end

function revealed_tiles(): Json
  intent: build
  mutable tiles: a list of Json = []
  mutable row: integer = 0
  while row < quest_dim() do
    set tiles = append(tiles, vec2(row, quest_path_col()))
    set row = row + 1
  end
  jsonout.json_list(tiles)
end

function revealed_tiles_for(qid: text): Json
  intent: build
  if qid == custom_story_qid() then
  jsonout.json_list([vec2(0, 1), vec2(1, 1)])
else
  revealed_tiles()
end
end

