use jsonout

record RosterEntry
  bid: text
  faction: text
  klass: text
  star: integer
end

record TextEntry
  key: text
  value: text
end

record IntEntry
  key: text
  value: integer
end

record Stats
  hp: integer
  atk: integer
end

function last_slash(path: text): integer
  intent: find
  mutable result: integer = -1
  mutable index: integer = 0
  while index < text_length(path) do
    if substring(path, index, 1) == "/" then
  set result = index
end
    set index = index + 1
  end
  result
end

function directory_name(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then
  "."
else
  substring(path, 0, slash)
end
end

function absolute_script_path(arguments: a list of text): text
  intent: return
  let path: text = unwrap_or(get(arguments, 0), "")
  if starts_with(path, "/") then
  path
else
  path_join(get_cwd(), path)
end
end

public function here(): text
  intent: get
  directory_name(absolute_script_path(get_args()))
end

public function resp_dir(): text
  intent: get
  path_join(here(), "responses")
end

public function diag_mana_start(): integer
  intent: get
  max(0, min(1, to_integer(unwrap_or(env_get("TFTF_DIAG_MANA_START"), "0"))))
end

public function mana_gain_rate(): decimal
  intent: return
  1
end

public function classes(): a list of text
  intent: return
  ["braw", "tact", "scou", "demo", "warr", "tech"]
end

public function cdn(): text
  intent: return
  "https://tform-0901-hzlhiniyfcwf.tf-cdn.net"
end

