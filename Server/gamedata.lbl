public function art_base(bid: text): text
  intent: find
  mutable result: text = ""
  mutable found: boolean = false
  for entry in art_overrides() do
    if entry.key == bid then
  set result = entry.value
  set found = true
end
  end
  if found then
  result
else
  let parts: a list of text = split(bid, "_")
  if length(parts) >= 2 then
  unwrap_or(get(parts, 0), "") ++ "_" ++ unwrap_or(get(parts, 1), "")
else
  bid
end
end
end

public function model_overrides(): a list of TextEntry
  intent: return
  [TextEntry { key: "fte_optimus_gs_t3", value: "optimusprime_cin_tf" }, TextEntry { key: "fte_stars_gs_t3", value: "skywarp_gs_leader2015" }]
end

public function model_id(bid: text): text
  intent: find
  mutable result: text = bid
  for entry in model_overrides() do
    if entry.key == bid then
  set result = entry.value
end
  end
  result
end

public function display_name(bid: text): text
  intent: build
  let parts: a list of text = split(bid, "_")
  mutable token: text = unwrap_or(get(parts, 0), "")
  if token == "fte" and length(parts) > 1 then
  set token = unwrap_or(get(parts, 1), "")
end
  uppercase(substring(token, 0, 1)) ++ substring(token, 1, text_length(token) - 1)
end

public function build_blueprints(): Json
  intent: build
  mutable output: a list of Pair = []
  for entry in roster() do
    let ratios: a list of decimal = special_damage_ratios(entry.bid, entry.star)
    let model: text = model_id(entry.bid)
    let art: text = art_base(entry.bid)
    let name: text = display_name(entry.bid)
    let blueprint: Json = jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(entry.bid)), jsonout.json_pair("et", jsonout.json_text("bot")), jsonout.json_pair("c", jsonout.json_text(entry.bid)), jsonout.json_pair("r", jsonout.json_int(entry.star)), jsonout.json_pair("a", jsonout.json_text(entry.faction)), jsonout.json_pair("cl", jsonout.json_text(entry.klass)), jsonout.json_pair("name", jsonout.json_text(name)), jsonout.json_pair("name_s", jsonout.json_text(name)), jsonout.json_pair("m", jsonout.json_text(model)), jsonout.json_pair("mdl", jsonout.json_text(model)), jsonout.json_pair("i", jsonout.json_text(art)), jsonout.json_pair("img", jsonout.json_text(art)), jsonout.json_pair("ma", jsonout.json_text(model)), jsonout.json_pair("map_asset", jsonout.json_text(model)), jsonout.json_pair("s1", jsonout.json_dec(unwrap_or(get(ratios, 0), 0))), jsonout.json_pair("s2", jsonout.json_dec(unwrap_or(get(ratios, 1), 0))), jsonout.json_pair("s3", jsonout.json_dec(unwrap_or(get(ratios, 2), 0))), jsonout.json_pair("msa", jsonout.json_int(max_special_attacks(entry.bid, entry.star))), jsonout.json_pair("ab", jsonout.json_dec(100)), jsonout.json_pair("gg", jsonout.json_int(1)), jsonout.json_pair("mfl", jsonout.json_int(0)), jsonout.json_pair("nfr", jsonout.json_int(0)), jsonout.json_pair("fcpg", jsonout.json_text("")), jsonout.json_pair("fhpag", jsonout.json_text(""))])
    set output = append(output, jsonout.json_pair(entry.bid, blueprint))
  end
  jsonout.json_obj(output)
end

function dump_helpers(): nothing
  intent: print
  for entry in roster() do
    for rank in [1, 2, 3, 5] do
      for level in [1, 7, 30] do
        let stats: Stats = base_stats(entry.bid, rank, level)
        print(entry.bid ++ " " ++ to_text(rank) ++ " " ++ to_text(level) ++ " " ++ to_text(stats.hp) ++ " " ++ to_text(stats.atk))
      end
    end
    print("MSA " ++ entry.bid ++ " " ++ to_text(max_special_attacks(entry.bid, entry.star)))
    print("NAME " ++ entry.bid ++ " " ++ display_name(entry.bid))
    print("ART " ++ entry.bid ++ " " ++ art_base(entry.bid))
    print("MODEL " ++ entry.bid ++ " " ++ model_id(entry.bid))
  end
  let unknown: Stats = base_stats("no_such_bot_xyz", 1, 1)
  let ids: a list of text = owned()
  print("UNKNOWN (" ++ to_text(unknown.hp) ++ ", " ++ to_text(unknown.atk) ++ ")")
  print("OWNED " ++ to_text(length(ids)) ++ " " ++ unwrap_or(get(ids, 0), "") ++ " " ++ unwrap_or(get(ids, length(ids) - 1), ""))
  print("CDN " ++ cdn())
  print("CLASSES " ++ join(classes(), ","))
  print("DIAG " ++ to_text(diag_mana_start()))
end

public function build_characters(): Json
  intent: build
  mutable output: a list of Pair = []
  for entry in roster() do
    let base: text = art_base(entry.bid)
    let name: text = display_name(entry.bid)
    let model: text = model_id(entry.bid)
    let character: Json = jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(entry.bid)), jsonout.json_pair("name", jsonout.json_text(name)), jsonout.json_pair("name_s", jsonout.json_text(name)), jsonout.json_pair("sg", jsonout.json_text("")), jsonout.json_pair("gen", jsonout.json_text(entry.faction)), jsonout.json_pair("aip", jsonout.json_text("")), jsonout.json_pair("sps", jsonout.json_text("")), jsonout.json_pair("i", jsonout.json_text(base)), jsonout.json_pair("img", jsonout.json_text(base)), jsonout.json_pair("m", jsonout.json_text(model)), jsonout.json_pair("mdl", jsonout.json_text(model)), jsonout.json_pair("ma", jsonout.json_text(model)), jsonout.json_pair("map_asset", jsonout.json_text(model)), jsonout.json_pair("hc", jsonout.json_text(entry.faction)), jsonout.json_pair("hero_colour", jsonout.json_text(entry.faction))])
    set output = append(output, jsonout.json_pair(entry.bid, character))
  end
  jsonout.json_obj(output)
end

function attack_value(attack_id: text, percent: decimal, mana: decimal, chance: decimal, damage: decimal, pierce: decimal): Json
  intent: build
  jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(attack_id)), jsonout.json_pair("a", jsonout.json_dec(percent)), jsonout.json_pair("m", jsonout.json_dec(mana)), jsonout.json_pair("c", jsonout.json_dec(chance)), jsonout.json_pair("d", jsonout.json_dec(damage)), jsonout.json_pair("p", jsonout.json_dec(pierce))])
end

