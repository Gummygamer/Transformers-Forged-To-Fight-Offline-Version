  jsonout.json_obj([jsonout.json_pair("version", jsonout.json_int(1)), jsonout.json_pair("currentPos", vec2(start_x, start_y)), jsonout.json_pair("cleared", jsonout.json_list([])), jsonout.json_pair("previouslyCleared", jsonout.json_list([])), jsonout.json_pair("revealed", revealed_tiles_for(qid)), jsonout.json_pair("users", jsonout.json_obj([jsonout.json_pair(local_uid(), user)]))])
