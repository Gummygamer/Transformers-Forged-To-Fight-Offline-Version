public function roster(): a list of RosterEntry
  intent: build
  mutable result: a list of RosterEntry = []
  for entry in roster_part_1() do
    set result = append(result, entry)
  end
  for entry in roster_part_2() do
    set result = append(result, entry)
  end
  for entry in roster_part_3() do
    set result = append(result, entry)
  end
  result
end

public function owned(): a list of text
  intent: build
  mutable result: a list of text = []
  for entry in roster() do
    set result = append(result, entry.bid)
  end
  result
end

function class_hp_mult(klass: text): decimal
  intent: return
  if klass == "braw" then
  1.25
else if klass == "scou" then
  0.85
else if klass == "demo" then
  1.1
else if klass == "warr" then
  0.95
else if klass == "tech" then
  1.05
else
  1
end
end

function class_atk_mult(klass: text): decimal
  intent: return
  if klass == "braw" then
  0.9
else if klass == "scou" then
  1.15
else if klass == "demo" then
  1.05
else if klass == "warr" then
  1.2
else if klass == "tech" then
  0.95
else
  1
end
end

function star_hp(star: integer): integer
  intent: return
  if star == 2 then
  3400
else if star == 3 then
  5200
else if star == 4 then
  7800
else if star == 5 then
  11500
else
  2200
end
end

function star_atk(star: integer): integer
  intent: return
  if star == 2 then
  300
else if star == 3 then
  430
else if star == 4 then
  610
else if star == 5 then
  850
else
  210
end
end

function roster_entry(bid: text): RosterEntry
  intent: find
  mutable result: RosterEntry = RosterEntry { bid: bid, faction: "decepticon", klass: "tact", star: 1 }
  for entry in roster() do
    if entry.bid == bid then
  set result = entry
end
  end
  result
end

public function final_boss_bid(): text
  intent: return
  "nemesisprime_gs_voyager2015"
end

public function final_boss_stats(): Stats
  intent: build
  Stats { hp: 300000, atk: 1000 }
end

public function base_stats(bid: text, rank: integer, level: integer): Stats
  intent: build
  let entry: RosterEntry = roster_entry(bid)
  let rank_mult: decimal = 1 + 0.35 * to_decimal(max(1, rank) - 1)
  let level_add: decimal = to_decimal(max(1, level) - 1) / 100
  let level_factor: decimal = 1 + level_add
  let factor: decimal = rank_mult * level_factor
  if bid == final_boss_bid() then
  final_boss_stats()
else
  Stats { hp: to_integer(to_decimal(star_hp(entry.star)) * class_hp_mult(entry.klass) * factor), atk: to_integer(to_decimal(star_atk(entry.star)) * class_atk_mult(entry.klass) * factor) }
end
end

public function max_special_attacks(bid: text, star: integer): integer
  intent: return
  -- Rarity still drives stats and presentation, but this preservation build has no
  -- functional rank-up path, so every bot exposes its three authored attacks immediately.
  3
end

public function special_damage_ratios(bid: text, star: integer): a list of decimal
  intent: return
  [1.75, 2.5, 3.5]
end

