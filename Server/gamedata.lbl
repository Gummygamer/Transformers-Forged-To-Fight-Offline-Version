use jsonout
use server_paths

record RosterEntry
  bid: text
  faction: text
  klass: text
  star: integer
end

record TextEntry
  key: text
  value: text
end

record Stats
  hp: integer
  atk: integer
end

record QuestEncounter
  key: text
  final_boss: boolean
  label: text
end

record BuildingSpec
  bid: text
  name: text
  desc: text
  model: text
end

record BasePlacement
  row: integer
  col: integer
  bid: text
end

public function here(): text
  intent: get
  server_paths.entry_directory("Server/gamedata.lbl")
end

public function resp_dir(): text
  intent: get
  path_join(here(), "responses")
end

public function diag_mana_start(): integer
  intent: get
  max(0, min(1, to_integer(unwrap_or(env_get("TFTF_DIAG_MANA_START"), "0"))))
end

public function mana_gain_rate(): decimal
  intent: return
  1
end

public function classes(): a list of text
  intent: return
  ["braw", "tact", "scou", "demo", "warr", "tech"]
end

public function build_advertised_base_url(host: text, scheme: text, port: text): text
  intent: build
  let selected_scheme: text = if scheme == "" then "https" else scheme end
  if selected_scheme != "https" and selected_scheme != "http" then
  print("[!] gamedata: Invalid TFTF_SERVER_SCHEME '" ++ selected_scheme ++ "'; valid schemes: https, http")
  exit_process(1)
  ""
else if port != "" and (not is_digits(port) or unwrap_or(to_integer(port), 0) < 1 or unwrap_or(to_integer(port), 0) > 65535) then
  print("[!] gamedata: Invalid TFTF_SERVER_PORT '" ++ port ++ "'; valid ports: 1..65535")
  exit_process(1)
  ""
else
  selected_scheme ++ "://" ++ host ++ if port == "" then "" else ":" ++ port end
end
end

public function advertised_base_url(): text
  intent: get
  let host: text = unwrap_or(env_get("TFTF_SERVER_HOST"), "")
  if host == "" then
  "https://tform-0901-hzlhiniyfcwf.tf-cdn.net"
else
  build_advertised_base_url(host, unwrap_or(env_get("TFTF_SERVER_SCHEME"), ""), unwrap_or(env_get("TFTF_SERVER_PORT"), ""))
end
end

public function cdn(): text
  intent: return
  advertised_base_url()
end

