  intent: build
  jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(base_id())), jsonout.json_pair("setId", jsonout.json_text("")), jsonout.json_pair("hash", jsonout.json_text("b1")), jsonout.json_pair("category", jsonout.json_text("base")), jsonout.json_pair("friendlyName", jsonout.json_text("Base")), jsonout.json_pair("description", jsonout.json_text("Your base.")), jsonout.json_pair("energyPerTile", jsonout.json_int(0)), jsonout.json_pair("minXpPerTile", jsonout.json_int(0)), jsonout.json_pair("maxXpPerTile", jsonout.json_int(0)), jsonout.json_pair("minHealthPerTile", jsonout.json_int(0)), jsonout.json_pair("maxHealthPerTile", jsonout.json_int(0)), jsonout.json_pair("image", jsonout.json_text("")), jsonout.json_pair("theme", jsonout.json_text(base_theme())), jsonout.json_pair("todIndex", jsonout.json_int(0))])
