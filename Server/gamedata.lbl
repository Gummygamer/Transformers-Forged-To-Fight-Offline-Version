public function default_team(): a list of text
  intent: return
  ["optimusprime_cin_tf", "optimusprimal_bw_mp32", "megatron_g1_mp10"]
end

public function boss_blueprint(): text
  intent: return
  "sharkticon_gs_brawler"
end

function roster_has_bid(bid: text): boolean
  intent: find
  mutable found: boolean = false
  for entry in roster() do
    if entry.bid == bid then
  set found = true
end
  end
  found
end

public function resolve_team(team: a list of text): a list of text
  intent: return
  if length(team) == 0 then
  default_team()
else
  mutable valid: boolean = true
  for bid in team do
    if not roster_has_bid(bid) then
  set valid = false
end
  end
  if valid then
  team
else
  default_team()
end
end
end

function dump_slice2(): nothing
  intent: print
  mutable bases: a list of Pair = []
  mutable entries: a list of Pair = []
  for bid in ["optimusprime_cin_tf", "sharkticon_gs_brawler", "fte_optimus_gs_t3", "megatron_g1_mp10"] do
    for rank in [1, 2, 3, 5] do
      set bases = append(bases, jsonout.json_pair(bid ++ "/" ++ to_text(rank), build_hero_base(bid, rank)))
    end
    for rank in [1, 3] do
      for level in [1, 7, 30] do
        set entries = append(entries, jsonout.json_pair(bid ++ "/" ++ to_text(rank) ++ "/" ++ to_text(level), build_hero_entry(bid, rank, level)))
      end
    end
  end
  print(jsonout.encode_compact(jsonout.json_obj([jsonout.json_pair("characters", build_characters()), jsonout.json_pair("attack_values", build_attack_values()), jsonout.json_pair("missions_config", build_missions_config()), jsonout.json_pair("missions_autorefresh_result", build_missions_autorefresh_result()), jsonout.json_pair("missions_autorefresh_update", build_missions_autorefresh_update()), jsonout.json_pair("missions_account_data", build_missions_account_data()), jsonout.json_pair("hero_classes", build_hero_classes()), jsonout.json_pair("rarity_properties", build_rarity_properties()), jsonout.json_pair("stat_modifiers", build_stat_modifiers()), jsonout.json_pair("heroes", build_heroes()), jsonout.json_pair("login_data", build_login_data()), jsonout.json_pair("hero_base", jsonout.json_obj(bases)), jsonout.json_pair("hero_entry", jsonout.json_obj(entries))])))
end

function dump_teams(): nothing
  intent: print
  print("DEFAULT_TEAM " ++ join(default_team(), ","))
  print("BOSS_BLUEPRINT " ++ boss_blueprint())
  print("TEAM NONE -> " ++ join(resolve_team([]), ","))
  print("TEAM EMPTY -> " ++ join(resolve_team([]), ","))
  print("TEAM optimusprime_cin_tf -> " ++ join(resolve_team(["optimusprime_cin_tf"]), ","))
  print("TEAM megatron_g1_mp10,optimusprime_cin_tf -> " ++ join(resolve_team(["megatron_g1_mp10", "optimusprime_cin_tf"]), ","))
  print("TEAM no_such_bot_xyz -> " ++ join(resolve_team(["no_such_bot_xyz"]), ","))
  print("TEAM optimusprime_cin_tf,no_such_bot_xyz -> " ++ join(resolve_team(["optimusprime_cin_tf", "no_such_bot_xyz"]), ","))
  print("TEAM optimusprime_cin_tf,megatron_g1_mp10,optimusprimal_bw_mp32 -> " ++ join(resolve_team(["optimusprime_cin_tf", "megatron_g1_mp10", "optimusprimal_bw_mp32"]), ","))
end

function main(): nothing
  intent: run
  let arguments: a list of text = get_args()
  let mode: text = unwrap_or(get(arguments, 1), "")
  if mode == "--dump-blueprints" then
  print(jsonout.encode_compact(build_blueprints()))
else if mode == "--dump-helpers" then
  dump_helpers()
else if mode == "--dump-slice2" then
  dump_slice2()
else if mode == "--dump-teams" then
  dump_teams()
else
  print("usage: gamedata.lbl --dump-blueprints|--dump-helpers|--dump-slice2|--dump-teams")
end
end

main()
