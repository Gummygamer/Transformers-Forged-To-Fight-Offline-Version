  jsonout.json_obj([jsonout.json_pair("walkable", jsonout.json_bool(true)), jsonout.json_pair("hidden", jsonout.json_bool(false)), jsonout.json_pair("final", jsonout.json_bool(true)), jsonout.json_pair("lab", jsonout.json_text("Bludgeon's Ambush")), jsonout.json_pair("links", links), jsonout.json_pair("visibleLinks", links), jsonout.json_pair("boss", jsonout.json_text(enemy_key)), jsonout.json_pair("entities", jsonout.json_obj([jsonout.json_pair(enemy_key, enemy)])), jsonout.json_pair("dialogue", jsonout.json_text("custom_opening_intro"))])
