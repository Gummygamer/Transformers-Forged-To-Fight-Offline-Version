public function build_heroes(): Json
  intent: build
  mutable output: a list of Pair = []
  for bid in owned() do
    set output = append(output, jsonout.json_pair(bid, jsonout.json_obj([jsonout.json_pair("1", build_hero_base(bid, 1))])))
  end
  jsonout.json_obj(output)
end

