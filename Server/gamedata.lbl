  jsonout.json_obj([jsonout.json_pair("walkable", jsonout.json_bool(true)), jsonout.json_pair("hidden", jsonout.json_bool(false)), jsonout.json_pair("start", jsonout.json_bool(true)), jsonout.json_pair("lab", jsonout.json_text("Start")), jsonout.json_pair("links", links), jsonout.json_pair("visibleLinks", links)])
end

function middle_tile(row: integer, links: Json): Json
  intent: build
  jsonout.json_obj([jsonout.json_pair("walkable", jsonout.json_bool(true)), jsonout.json_pair("hidden", jsonout.json_bool(false)), jsonout.json_pair("lab", jsonout.json_text("Node " ++ to_text(row))), jsonout.json_pair("links", links), jsonout.json_pair("visibleLinks", links)])
