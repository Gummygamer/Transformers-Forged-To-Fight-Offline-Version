public function build_quest_movedir(qid: text, offx: integer, offy: integer, start_x: integer, start_y: integer, team: a list of text): Json
  intent: build
  let next_x: integer = start_x + offx
  let next_y: integer = start_y + offy
  mutable results: a list of Json = [jsonout.json_obj([jsonout.json_pair("action", jsonout.json_obj([jsonout.json_pair("moveto", vec2(next_x, next_y))]))])]
  if next_y == quest_path_col_for(qid) and quest_has_encounter_for(qid, next_x) then
  let encounter: QuestEncounter = quest_encounter_for(qid, next_x)
  let battle_enemy: Json = if qid == custom_story_qid() then build_quest_enemy_for("chicago", 0, encounter.key, encounter.final_boss) else build_quest_enemy_for("", -1, encounter.key, encounter.final_boss) end
  let battle: Json = jsonout.json_obj([jsonout.json_pair("x", jsonout.json_int(next_x)), jsonout.json_pair("y", jsonout.json_int(next_y)), jsonout.json_pair("isFinalBoss", jsonout.json_bool(encounter.final_boss)), jsonout.json_pair("battleEnemy", battle_enemy)])
  set results = append(results, jsonout.json_obj([jsonout.json_pair("action", jsonout.json_obj([jsonout.json_pair("battle", battle)]))]))
end
  let initial: Json = build_quest_progression(qid, next_x, next_y, team)
  let with_cleared: Json = jsonout.obj_set(initial, "cleared", jsonout.json_list([vec2(start_x, start_y)]))
  let progression: Json = jsonout.obj_set(with_cleared, "revealed", revealed_tiles_for(qid))
  let final_progression: Json = if next_y == quest_path_col_for(qid) and quest_has_encounter_for(qid, next_x) then
  let encounter: QuestEncounter = quest_encounter_for(qid, next_x)
  let with_id: Json = jsonout.obj_set(progression, "currentBattleId", jsonout.json_text(encounter.key))
  let with_pos: Json = jsonout.obj_set(with_id, "currentBattlePos", vec2(next_x, next_y))
  let with_enemy: Json = jsonout.obj_set(with_pos, "currentBattleEnemy", jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(encounter.key))]))
  let with_health: Json = jsonout.obj_set(with_enemy, "currentBattleEnemyHealth", jsonout.json_dec(1))
  let users: Json = jsonout.obj_get(with_health, "users")
  jsonout.obj_set(with_health, "users", jsonout.obj_set(users, local_uid(), battle_user(jsonout.obj_get(users, local_uid()), next_x, next_y, encounter.key)))
else
  progression
end
  let team_data: Json = build_active_team(qid ++ "-0", resolve_quest_team(qid, team))
  jsonout.json_obj([jsonout.json_pair("results", jsonout.json_list(results)), jsonout.json_pair("progression", final_progression), jsonout.json_pair("teamData", team_data)])
end

