public function tile_dialogue_id(row: integer): text
  intent: get
  if row == 1 then
  "arrival_intro"
else if row == 5 then
  "midpoint_rally"
else if row == quest_dim() - 1 then
  "final_stand"
else
  ""
end
end

public function tile_dialogue_pe_id(row: integer): text
  intent: get
  if row == quest_dim() - 1 then
  "shore_secured"
else
  ""
end
end

function encounter_tile(row: integer, links: Json): Json
  intent: build
  let encounter: QuestEncounter = quest_encounter(row)
  let enemy: Json = build_quest_enemy_for("", -1, encounter.key, encounter.final_boss)
  mutable pairs: a list of Pair = [jsonout.json_pair("walkable", jsonout.json_bool(true)), jsonout.json_pair("hidden", jsonout.json_bool(false)), jsonout.json_pair("final", jsonout.json_bool(encounter.final_boss)), jsonout.json_pair("lab", jsonout.json_text(encounter.label)), jsonout.json_pair("links", links), jsonout.json_pair("visibleLinks", links), jsonout.json_pair("boss", jsonout.json_text(encounter.key)), jsonout.json_pair("entities", jsonout.json_obj([jsonout.json_pair(encounter.key, enemy)]))]
  let pre_dialogue: text = tile_dialogue_id(row)
  if pre_dialogue != "" then
  set pairs = append(pairs, jsonout.json_pair("dialogue", jsonout.json_text(pre_dialogue)))
end
  let post_dialogue: text = tile_dialogue_pe_id(row)
  if post_dialogue != "" then
  set pairs = append(pairs, jsonout.json_pair("dialoguePE", jsonout.json_text(post_dialogue)))
end
  jsonout.json_obj(pairs)
end

