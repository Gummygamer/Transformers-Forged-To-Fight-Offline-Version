function battle_user(user: Json, x: integer, y: integer, key: text): Json
  intent: build
  let with_id: Json = jsonout.obj_set(user, "currentBattleId", jsonout.json_text(key))
  let with_pos: Json = jsonout.obj_set(with_id, "currentBattlePos", vec2(x, y))
  jsonout.obj_set(with_pos, "currentBattleState", jsonout.json_text("activated"))
