  jsonout.json_obj([jsonout.json_pair("name", jsonout.json_text("missionsconfig")), jsonout.json_pair("error", jsonout.json_text("")), jsonout.json_pair("check", jsonout.obj_get(result, "check")), jsonout.json_pair("locHash", jsonout.json_text("")), jsonout.json_pair("refresh", jsonout.obj_get(result, "refresh")), jsonout.json_pair("data", jsonout.obj_get(result, "missionsconfig")), jsonout.json_pair("cache", jsonout.obj_get(result, "cache"))])
end

public function build_missions_account_data(): Json
  intent: build
  let config: Json = build_missions_config()
  let result: Json = build_missions_autorefresh_result()
  mutable account: Json = config
  set account = jsonout.obj_set(account, "check", jsonout.obj_get(result, "check"))
  set account = jsonout.obj_set(account, "refresh", jsonout.obj_get(result, "refresh"))
  set account = jsonout.obj_set(account, "cache", jsonout.obj_get(result, "cache"))
  set account = jsonout.obj_set(account, "missionsconfig", jsonout.obj_get(result, "missionsconfig"))
  account
end

function class_names(): a list of TextEntry
  intent: return
  [TextEntry { key: "braw", value: "Brawler" }, TextEntry { key: "tact", value: "Tactician" }, TextEntry { key: "scou", value: "Scout" }, TextEntry { key: "demo", value: "Demolitions" }, TextEntry { key: "warr", value: "Warrior" }, TextEntry { key: "tech", value: "Tech" }]
end

function class_ring(): a list of text
  intent: return
  ["braw", "tact", "scou", "demo", "warr", "tech"]
end

function class_name(cid: text): text
  intent: find
  mutable result: text = ""
  for entry in class_names() do
    if entry.key == cid then
  set result = entry.value
end
  end
  result
end

function next_class(ring: a list of text, index: integer): text
  intent: find
  if index == length(ring) - 1 then
  unwrap_or(get(ring, 0), "")
else
  unwrap_or(get(ring, index + 1), "")
end
end

public function build_hero_classes(): Json
  intent: build
  let ring: a list of text = class_ring()
  mutable output: a list of Pair = []
  mutable index: integer = 0
  for cid in ring do
    let beats: text = next_class(ring, index)
    let name: text = class_name(cid)
    let row: Json = jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(cid)), jsonout.json_pair("cid", jsonout.json_text(cid)), jsonout.json_pair("class_id", jsonout.json_text(cid)), jsonout.json_pair("n", jsonout.json_text(name)), jsonout.json_pair("name", jsonout.json_text(name)), jsonout.json_pair("class_name", jsonout.json_text(name)), jsonout.json_pair("ab", jsonout.json_dec(1.1)), jsonout.json_pair("atkb", jsonout.json_dec(1.1)), jsonout.json_pair("attack_bonus", jsonout.json_dec(1.1)), jsonout.json_pair("atkp", jsonout.json_dec(0.9)), jsonout.json_pair("attack_penalty", jsonout.json_dec(0.9)), jsonout.json_pair("ic", jsonout.json_list([jsonout.json_text(beats)])), jsonout.json_pair("ideal_contender", jsonout.json_list([jsonout.json_text(beats)]))])
    set output = append(output, jsonout.json_pair(cid, row))
    set index = index + 1
  end
  jsonout.json_obj(output)
end

public function build_rarity_properties(): Json
  intent: build
  mutable output: a list of Pair = []
  for star in [1, 2, 3, 4, 5] do
    let key: text = to_text(star)
    let name: text = key ++ " Star"
    let row: Json = jsonout.json_obj([jsonout.json_pair("id", jsonout.json_text(key)), jsonout.json_pair("n", jsonout.json_text(name)), jsonout.json_pair("name", jsonout.json_text(name)), jsonout.json_pair("mv", jsonout.json_int(star)), jsonout.json_pair("map_value", jsonout.json_int(star)), jsonout.json_pair("sp3qt", jsonout.json_dec(0.5)), jsonout.json_pair("sp3_quicktime", jsonout.json_dec(0.5)), jsonout.json_pair("ms", jsonout.json_int(99)), jsonout.json_pair("max_sig", jsonout.json_int(99))])
    set output = append(output, jsonout.json_pair(key, row))
  end
  jsonout.json_obj(output)
end

function rating_for(hp: integer, atk: integer): integer
  intent: build
  let total: integer = hp + atk
  total / 20
end

