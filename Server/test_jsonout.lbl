-- Regression tests for ordered compact JSON used by the Server port.

use jsonout

function last_slash(path: text): integer
  intent: find
  mutable result: integer = -1
  mutable index: integer = 0
  while index < text_length(path) do
    if substring(path, index, 1) == "/" then set result = index end
    set index = index + 1
  end
  result
end

function directory_name(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then "." else substring(path, 0, slash) end
end

function absolute_script_path(arguments: a list of text): text
  intent: return
  let path: text = unwrap_or(get(arguments, 0), "")
  if starts_with(path, "/") then path else path_join(get_cwd(), path) end
end

function report(name: text, passed: boolean, detail: text): integer
  intent: print
  if passed then
    print("[ok] " ++ name)
    0
  else
    print("[!] " ++ name ++ ": " ++ detail)
    1
  end
end

function compact(source: text): text
  intent: encode
  jsonout.encode_compact(jsonout.parse_json(source))
end

function corpus_tests(response_dir: text): integer
  intent: test
  mutable failed: integer = 0
  for name in list_dir(response_dir) do
    if ends_with(name, ".json") then
      let raw: text = read_file(path_join(response_dir, name))
      let encoded: text = compact(raw)
      if encoded == raw then
        set failed = failed + report("corpus exact " ++ name, true, "")
      else
        set failed = failed + report("corpus idempotent " ++ name, compact(encoded) == encoded, "second encoding changed")
      end
    end
  end
  failed
end

function unicode_tests(): integer
  intent: test
  mutable failed: integer = 0
  let unicode_2byte: text = "\{\"name\":\"Andr\\u00e9\"\}"
  set failed = failed + report("2-byte unicode escape (é)", compact(unicode_2byte) == unicode_2byte, "2-byte unicode escape did not round-trip")

  let unicode_3byte: text = "\{\"icon\":\"\\ue092\"\}"
  set failed = failed + report("3-byte unicode escape (U+E092)", compact(unicode_3byte) == unicode_3byte, "3-byte unicode escape did not round-trip")

  let unicode_4byte: text = "\{\"emoji\":\"\\ud83d\\ude00\"\}"
  set failed = failed + report("4-byte surrogate pair escape (U+1F600)", compact(unicode_4byte) == unicode_4byte, "4-byte surrogate pair escape did not round-trip")

  let mixed_unicode: text = "\{\"msg\":\"Hello \\u00e9 \\ue092 \\ud83d\\ude00!\"\}"
  set failed = failed + report("mixed ASCII and unicode", compact(mixed_unicode) == mixed_unicode, "mixed ASCII and unicode failed to round-trip")

  let unicode_key: text = "\{\"k\\u00e9y\":1\}"
  set failed = failed + report("non-ASCII object key", compact(unicode_key) == unicode_key, "non-ASCII key failed to round-trip")
  failed
end

function main_group_1(): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + unicode_tests()
  failed
end

function main_group_2(order_source: text): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("key order", compact(order_source) == order_source, "object keys were reordered")
  failed
end

function main_group_3(decimal_ok: boolean): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("decimal formatting", decimal_ok, "whole decimals lost .0 or integer changed")
  failed
end

function main_group_4(escaped: text): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("string escaping", compact(escaped) == escaped, "escaped characters changed")
  failed
end

function main_group_5(appended: Json): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("obj_set order", jsonout.encode_compact(appended) == "\{\"b\":1,\"a\":3,\"c\":4\}", "replacement or append position changed")
  failed
end

function main_group_6(nested: text): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("nesting and empties", compact(nested) == "\{\"x\":[[],\{\},[null,true,false,-2,1000.0]]\}", "nested values did not compact correctly")
  failed
end

function main_group_7(spaced: Json): integer
  intent: run
  mutable failed: integer = 0
  set failed = failed + report("spaced encoding", jsonout.encode_spaced(spaced) == "\{\"a\": [1, 2], \"b\": true\}", "spaced separators changed")
  failed
end

function decimal_encoding_ok(): boolean
  intent: check
  jsonout.encode_compact(jsonout.json_dec(1.0)) == "1.0" and jsonout.encode_compact(jsonout.json_dec(100.0)) == "100.0" and jsonout.encode_compact(jsonout.json_dec(1.75)) == "1.75" and jsonout.encode_compact(jsonout.json_int(1)) == "1"
end

function spaced_fixture(): Json
  intent: build
  jsonout.json_obj([jsonout.json_pair("a", jsonout.json_list([jsonout.json_int(1), jsonout.json_int(2)])), jsonout.json_pair("b", jsonout.json_bool(true))])
end

function main(): nothing
  intent: run
  let arguments: a list of text = get_args()
  let script: text = absolute_script_path(arguments)
  let responses: text = path_join(directory_name(script), "responses")
  if not file_exists(responses) then
    print("[!] responses directory not found: " ++ responses)
    exit_process(1)
  end
  mutable failed: integer = corpus_tests(responses)
  set failed = failed + main_group_1()
  let order_source: text = "\{" ++ "\"b\":1,\"a\":2" ++ "\}"
  set failed = failed + main_group_2(order_source)
  let decimal_ok: boolean = decimal_encoding_ok()
  set failed = failed + main_group_3(decimal_ok)
  let escaped: text = "\{\"s\":\"\\\"\\\\\\n\\t\\u0001\"\}"
  set failed = failed + main_group_4(escaped)
  let object: Json = jsonout.parse_json(order_source)
  let replaced: Json = jsonout.obj_set(object, "a", jsonout.json_int(3))
  let appended: Json = jsonout.obj_set(replaced, "c", jsonout.json_int(4))
  set failed = failed + main_group_5(appended)
  let nested: text = "\{\"x\":[[],\{\},[null,true,false,-2,1e3]]\}"
  set failed = failed + main_group_6(nested)
  let spaced: Json = spaced_fixture()
  set failed = failed + main_group_7(spaced)
  let total: integer = 28
  let passed: integer = total - failed
  print(to_text(passed) ++ " passed, " ++ to_text(failed) ++ " failed")
  if failed > 0 then exit_process(1) end
end

main()
