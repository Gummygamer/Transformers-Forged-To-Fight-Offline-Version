use jsonout
use gamedata

function last_slash(path: text): integer
  intent: find
  mutable result: integer = -1
  mutable index: integer = 0
  while index < text_length(path) do
    if substring(path, index, 1) == "/" then
  set result = index
end
    set index = index + 1
  end
  result
end

function directory_name(path: text): text
  intent: get
  let slash: integer = last_slash(path)
  if slash < 0 then
  "."
else
  substring(path, 0, slash)
end
end

function absolute_script_path(arguments: a list of text): text
  intent: return
  let path: text = unwrap_or(get(arguments, 0), "")
  if starts_with(path, "/") then
  path
else
  path_join(get_cwd(), path)
end
end

function report(name: text, passed: boolean, detail: text): integer
  intent: print
  if passed then
  print("[ok] " ++ name)
  0
else
  print("[!] " ++ name ++ ": " ++ detail)
  1
end
end

function blueprint(bid: text): Json
  intent: get
  jsonout.obj_get(gamedata.build_blueprints(), bid)
end

function field_text(node: Json, key: text): text
  intent: get
  jsonout.as_text(jsonout.obj_get(node, key))
end

function special_index(node: Json, key: text): integer
  intent: get
  let value: text = jsonout.encode_compact(jsonout.obj_get(node, key))
  if value == "1.75" then
  1
else if value == "2.5" then
  2
else if value == "3.5" then
  3
else
  0
end
end

function special_damage_percent(node: Json, key: text): integer
  intent: get
  let value: text = jsonout.encode_compact(jsonout.obj_get(node, key))
  if value == "1.75" then
  175
else if value == "2.5" then
  250
else if value == "3.5" then
  350
else
  0
end
end

function test_specials_escalate_by_index(): boolean
  intent: test
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let bp: Json = blueprint(entry.bid)
    set passed = passed and special_index(bp, "s1") < special_index(bp, "s2") and special_index(bp, "s2") < special_index(bp, "s3")
  end
  passed
end

function test_blueprint_model_id_matches_model_id_helper(): boolean
  intent: test
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let bp: Json = blueprint(entry.bid)
    set passed = passed and field_text(bp, "m") == gamedata.model_id(entry.bid) and field_text(bp, "mdl") == gamedata.model_id(entry.bid)
  end
  passed
end

function is_model_override(bid: text): boolean
  intent: find
  mutable found: boolean = false
  for entry in gamedata.model_overrides() do
    if entry.key == bid then
  set found = true
end
  end
  found
end

function test_non_override_model_id_is_the_full_bid(): boolean
  intent: test
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    if not is_model_override(entry.bid) then
  set passed = passed and gamedata.model_id(entry.bid) == entry.bid
end
  end
  passed
end

function test_fte_optimus_uses_real_optimus_prime_mesh(): boolean
  intent: test
  gamedata.model_id("fte_optimus_gs_t3") == "optimusprime_cin_tf" and field_text(blueprint("fte_optimus_gs_t3"), "mdl") == "optimusprime_cin_tf"
end

function test_portrait_stays_short_art_base(): boolean
  intent: test
  let bp: Json = blueprint("optimusprime_cin_tf")
  field_text(bp, "img") == "optimus_c_tf" and field_text(bp, "mdl") == "optimusprime_cin_tf"
end

function has_prefix(names: a list of text, prefix: text): boolean
  intent: find
  mutable found: boolean = false
  for name in names do
    if starts_with(name, prefix) then
  set found = true
end
  end
  found
end

function test_all_roster_portraits_ship_both_sizes(): boolean
  intent: test
  let server: text = directory_name(absolute_script_path(get_args()))
  let root: text = directory_name(server)
  let portraits: text = path_join(root, "Transformers 9.2 extracted/assets/assetpack/portraits_odr/portraits")
  if not is_dir(portraits) then
  true
else
  let names: a list of text = list_dir(portraits)
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let base: text = gamedata.art_base(entry.bid)
    set passed = passed and has_prefix(names, "portrait_" ++ base ++ "_large.") and has_prefix(names, "portrait_" ++ base ++ "_small.") and field_text(blueprint(entry.bid), "img") == base
  end
  passed
end
end

function roster_has(bid: text): boolean
  intent: find
  mutable found: boolean = false
  for entry in gamedata.roster() do
    if entry.bid == bid then
  set found = true
end
  end
  found
end

function is_fallback_bot(bid: text): boolean
  intent: find
  contains(["arcee_gs_deluxe2014", "cheetor_bw_transmetal", "jazz_gs_twm05", "jetfire_gs_leader2014", "prowl_gs_deluxe2016", "dirge_gs_deluxe2008", "galvatron_gs_voyager2016", "ramjet_gs_deluxe2008", "scorponok_bw_kabam", "skywarp_gs_leader2015", "slipstream_gs", "tantrum_gs_kabam"], bid)
end

function fallback_base(bid: text): text
  intent: build
  let parts: a list of text = split(bid, "_")
  unwrap_or(get(parts, 0), "") ++ "_" ++ unwrap_or(get(parts, 1), "")
end

function test_art_base_overrides_cover_only_irregular_roster_bots(): boolean
  intent: test
  let overrides: a list of TextEntry = gamedata.art_overrides()
  mutable passed: boolean = length(overrides) == 49
  for entry in overrides do
    set passed = passed and roster_has(entry.key) and entry.value != entry.key and entry.value != fallback_base(entry.key) and not is_fallback_bot(entry.key)
  end
  passed
end

function test_base_stats_spot_checks(): boolean
  intent: test
  let optimus: Stats = gamedata.base_stats("fte_optimus_gs_t3", 1, 1)
  let unknown: Stats = gamedata.base_stats("no_such_bot_xyz", 1, 1)
  optimus.hp == 5200 and optimus.atk == 430 and unknown.hp == 2200 and unknown.atk == 210
end

function has_three_special_attacks(node: Json): boolean
  intent: check
  jsonout.as_int(jsonout.obj_get(node, "special_attacks")) == 3
end

function test_max_special_attacks_are_three_for_every_bot_and_wire_builder(): boolean
  intent: test
  let blueprints: Json = gamedata.build_blueprints()
  mutable requests: a list of Json = []
  mutable passed: boolean = gamedata.max_special_attacks("waspinator_gs_deluxe", 2) == 3 and gamedata.max_special_attacks("bumblebee_gs_kabam", 3) == 3 and gamedata.max_special_attacks("sharkticon_gs_kabam", 1) == 3 and gamedata.max_special_attacks("fte_optimus_gs_t3", 3) == 3 and gamedata.max_special_attacks("fte_stars_gs_t3", 3) == 3
  for entry in gamedata.roster() do
    let bp: Json = jsonout.obj_get(blueprints, entry.bid)
    set requests = append(requests, jsonout.json_obj([jsonout.json_pair("bid", jsonout.json_text(entry.bid))]))
    set passed = passed and gamedata.max_special_attacks(entry.bid, entry.star) == 3 and jsonout.as_int(jsonout.obj_get(bp, "msa")) == 3 and has_three_special_attacks(gamedata.build_hero_base(entry.bid, 1)) and has_three_special_attacks(gamedata.build_hero_entry(entry.bid, 1, 1))
  end
  for bid in gamedata.default_team() do
    set requests = append(requests, jsonout.json_obj([jsonout.json_pair("bid", jsonout.json_text(bid))]))
    set passed = passed and has_three_special_attacks(gamedata.build_hero_entry(bid, 1, 1))
  end
  for detail in jsonout.list_items(gamedata.build_base_hero_details(requests)) do
    set passed = passed and has_three_special_attacks(detail)
  end
  passed
end

function encoded_field(node: Json, key: text): text
  intent: get
  jsonout.encode_compact(jsonout.obj_get(node, key))
end

function test_default_mana_start_is_zero(): boolean
  intent: test
  encoded_field(gamedata.build_hero_base(unwrap_or(get(gamedata.default_team(), 0), ""), 1), "mana_start") == "0"
end

function test_combat_attribute_builders_carry_authored_mana_fields(): boolean
  intent: test
  let entry: Json = gamedata.build_hero_entry(unwrap_or(get(gamedata.default_team(), 0), ""), 1, 1)
  let details: a list of Json = jsonout.list_items(gamedata.build_base_hero_details([jsonout.json_obj([jsonout.json_pair("bid", jsonout.json_text(unwrap_or(get(gamedata.default_team(), 0), "")))]), jsonout.json_obj([jsonout.json_pair("bid", jsonout.json_text(unwrap_or(get(gamedata.default_team(), 1), "")))])]))
  mutable passed: boolean = encoded_field(entry, "mana_gain") == "1.0" and jsonout.as_int(jsonout.obj_get(entry, "mana_start")) == gamedata.diag_mana_start() and length(details) == 2
  for detail in details do
    set passed = passed and encoded_field(detail, "mana_gain") == "1.0" and jsonout.as_int(jsonout.obj_get(detail, "mana_start")) == gamedata.diag_mana_start()
  end
  passed
end

function test_generated_user_data_has_mana_gain_for_every_owned_bot(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__bcg_getUserData.json")))
  let updates: Json = jsonout.obj_get(jsonout.obj_get(response, "result"), "updates")
  let heroes: a list of Json = jsonout.list_items(jsonout.obj_get(updates, "heroes"))
  mutable passed: boolean = length(heroes) > 0
  for hero in heroes do
    if encoded_field(hero, "entity_type") == "\"bot\"" then
  set passed = passed and encoded_field(hero, "mana_gain") == "1.0" and encoded_field(hero, "mana_start") == "0"
end
  end
  passed
end

function test_generated_login_snapshot_has_three_specials_for_every_bot(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__bcg_getLoginData.json")))
  let result: Json = jsonout.obj_get(response, "result")
  let blueprints: Json = jsonout.obj_get(result, "blueprints")
  let heroes: Json = jsonout.obj_get(result, "heroes")
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let blueprint_record: Json = jsonout.obj_get(blueprints, entry.bid)
    let hero_record: Json = jsonout.obj_get(jsonout.obj_get(heroes, entry.bid), "1")
    set passed = passed and jsonout.as_int(jsonout.obj_get(blueprint_record, "msa")) == 3 and has_three_special_attacks(hero_record)
  end
  passed
end

function test_generated_user_data_snapshot_has_three_specials_for_every_bot(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__bcg_getUserData.json")))
  let updates: Json = jsonout.obj_get(jsonout.obj_get(response, "result"), "updates")
  let owned: a list of Json = jsonout.list_items(jsonout.obj_get(updates, "heroes"))
  let saved_team: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(updates, "savedTeams")), 0), jsonout.json_obj([]))
  let saved: a list of Json = jsonout.list_items(jsonout.obj_get(saved_team, "heroes"))
  let active_team: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(updates, "activeTeams")), 0), jsonout.json_obj([]))
  let active: Json = jsonout.obj_get(active_team, "heroes")
  let defaults: a list of text = gamedata.default_team()
  mutable passed: boolean = length(owned) == length(gamedata.owned()) and length(saved) == length(defaults)
  for hero in owned do
    set passed = passed and encoded_field(hero, "entity_type") == "\"bot\"" and has_three_special_attacks(hero)
  end
  mutable index: integer = 0
  while index < length(defaults) do
    let bid: text = unwrap_or(get(defaults, index), "")
    let saved_hero: Json = unwrap_or(get(saved, index), jsonout.json_obj([]))
    let active_hero: Json = jsonout.obj_get(active, bid)
    set passed = passed and field_text(saved_hero, "bid") == bid and has_three_special_attacks(saved_hero) and has_three_special_attacks(active_hero)
    set index = index + 1
  end
  passed
end

function test_normal_attack_levels_have_nonzero_damage_rows(): boolean
  intent: test
  let rows: Json = gamedata.build_attack_values()
  let config: Json = gamedata.build_missions_config()
  let light: Json = jsonout.obj_get(rows, "Light")
  let medium: Json = jsonout.obj_get(rows, "Medium")
  let heavy: Json = jsonout.obj_get(rows, "Heavy")
  let ranged: Json = jsonout.obj_get(rows, "Ranged")
  field_text(light, "id") == "Light" and field_text(medium, "id") == "Medium" and field_text(heavy, "id") == "Heavy" and field_text(ranged, "id") == "Ranged" and encoded_field(light, "a") == "0.35" and encoded_field(light, "m") == "50.0" and encoded_field(medium, "a") == "0.6" and encoded_field(medium, "m") == "75.0" and encoded_field(heavy, "a") == "1.0" and encoded_field(heavy, "m") == "120.0" and encoded_field(ranged, "a") == "0.4" and encoded_field(ranged, "m") == "55.0" and encoded_field(jsonout.obj_get(jsonout.obj_get(config, "configs"), "bcg-combat"), "manaPerSpecial") == "300.0"
end

function test_generated_login_response_contains_current_attack_rows(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__bcg_getLoginData.json")))
  jsonout.encode_compact(jsonout.obj_get(jsonout.obj_get(response, "result"), "attackValues")) == jsonout.encode_compact(gamedata.build_attack_values())
end

function test_gp_hit_stun_is_a_complete_harvested_stat_modifier_row(): boolean
  intent: test
  let rows: Json = gamedata.build_stat_modifiers()
  let row: Json = jsonout.obj_get(rows, "gp_hit_stun")
  jsonout.obj_has(rows, "gp_hit_stun") and encoded_field(row, "id") == "\"gp_hit_stun\"" and encoded_field(row, "t") == "\"hit_stun\"" and encoded_field(row, "ta") == "\"self\"" and encoded_field(row, "mt") == "\"debuff\"" and encoded_field(row, "tr") == "[]" and encoded_field(row, "uit") == "[]" and jsonout.encode_compact(jsonout.obj_get(gamedata.build_login_data(), "statMods")) == jsonout.encode_compact(rows)
end

function test_every_special_out_damages_every_normal_attack(): boolean
  intent: test
  let blueprints: Json = gamedata.build_blueprints()
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let bp: Json = jsonout.obj_get(blueprints, entry.bid)
    set passed = passed and special_damage_percent(bp, "s1") > 100 and special_damage_percent(bp, "s2") > 100 and special_damage_percent(bp, "s3") > 100
  end
  passed
end

function test_character_model_id_matches_model_id_helper(): boolean
  intent: test
  let characters: Json = gamedata.build_characters()
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let character: Json = jsonout.obj_get(characters, entry.bid)
    set passed = passed and field_text(character, "m") == gamedata.model_id(entry.bid) and field_text(character, "mdl") == gamedata.model_id(entry.bid)
  end
  passed
end

function test_player_lead_is_optimus_prime(): boolean
  intent: test
  unwrap_or(get(gamedata.default_team(), 0), "") == "optimusprime_cin_tf"
end

function test_combat_armor_rating_constant_is_finite_and_positive(): boolean
  intent: test
  let config: Json = gamedata.build_missions_config()
  let configs: Json = jsonout.obj_get(config, "configs")
  let combat: Json = jsonout.obj_get(configs, "bcg-combat")
  encoded_field(config, "configsHash") == "\"offline-v1\"" and jsonout.obj_has(configs, "bcg-combat") and jsonout.obj_has(configs, "user-base") and encoded_field(combat, "armorRatingConstant") == "1000.0" and encoded_field(combat, "manaPerSpecial") == "300.0" and encoded_field(combat, "maxQueuedActionTime") == "0.2"
end

function test_account_response_contains_current_missions_config(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__account_data.json")))
  let data: Json = jsonout.obj_get(jsonout.obj_get(response, "result"), "missionsconfig")
  jsonout.encode_compact(data) == jsonout.encode_compact(gamedata.build_missions_account_data()) and jsonout.encode_compact(jsonout.obj_get(data, "missionsconfig")) == jsonout.encode_compact(gamedata.build_missions_config())
end

function test_direct_autorefresh_repeats_current_missions_config(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__autorefresh_missionsconfig_refresh.json")))
  let result: Json = jsonout.obj_get(response, "result")
  jsonout.encode_compact(result) == jsonout.encode_compact(gamedata.build_missions_autorefresh_result()) and encoded_field(result, "refresh") == "0"
end

function test_group_autorefresh_update_has_exact_client_fields(): boolean
  intent: test
  let update: Json = gamedata.build_missions_autorefresh_update()
  let expected: Json = jsonout.json_obj([jsonout.json_pair("name", jsonout.json_text("missionsconfig")), jsonout.json_pair("error", jsonout.json_text("")), jsonout.json_pair("check", jsonout.json_text("offline-v1")), jsonout.json_pair("locHash", jsonout.json_text("")), jsonout.json_pair("refresh", jsonout.json_int(0)), jsonout.json_pair("data", gamedata.build_missions_config()), jsonout.json_pair("cache", jsonout.json_bool(false))])
  jsonout.encode_compact(update) == jsonout.encode_compact(expected)
end

function story_grid(): a list of Json
  intent: get
  jsonout.list_items(jsonout.obj_get(gamedata.build_quest_map("1.1.1"), "grid"))
end

function test_story_board_authors_at_least_ten_encounter_tiles(): boolean
  intent: test
  mutable encounters: integer = 0
  for row in story_grid() do
    for tile in jsonout.list_items(row) do
      if jsonout.obj_has(tile, "entities") then set encounters = encounters + 1 end
    end
  end
  encounters >= 10
end

function test_story_board_has_exactly_one_final_encounter_and_it_is_the_boss(): boolean
  intent: test
  mutable finals: integer = 0
  mutable boss_is_final: boolean = false
  for row in story_grid() do
    for tile in jsonout.list_items(row) do
      if jsonout.obj_has(tile, "final") then
        if jsonout.as_bool(jsonout.obj_get(tile, "final")) then
          set finals = finals + 1
          set boss_is_final = jsonout.as_text(jsonout.obj_get(tile, "boss")) == gamedata.boss_blueprint()
        end
      end
    end
  end
  finals == 1 and boss_is_final
end

function test_story_board_geometry_is_square_and_fully_revealed(): boolean
  intent: test
  let map: Json = gamedata.build_quest_map("1.1.1")
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(map, "grid"))
  let paths: a list of Json = jsonout.list_items(jsonout.obj_get(map, "pathData"))
  let path: Json = unwrap_or(get(paths, 0), jsonout.json_obj([]))
  mutable passed: boolean = length(grid) == gamedata.quest_dim() and jsonout.as_int(jsonout.obj_get(map, "walkableCount")) == gamedata.quest_dim() and jsonout.as_int(jsonout.obj_get(map, "visibleWalkableCount")) == gamedata.quest_dim() and length(jsonout.list_items(jsonout.obj_get(path, "path"))) == gamedata.quest_dim()
  for row in grid do
    set passed = passed and length(jsonout.list_items(row)) == gamedata.quest_dim()
  end
  passed
end

function test_every_encounter_row_triggers_a_battle_on_movedir(): boolean
  intent: test
  mutable row: integer = 1
  mutable passed: boolean = true
  while row < gamedata.quest_dim() do
    let result: Json = gamedata.build_quest_movedir("1.1.1", 1, 0, row - 1, gamedata.quest_path_col(), [])
    let results: a list of Json = jsonout.list_items(jsonout.obj_get(result, "results"))
    let action: Json = unwrap_or(get(results, 1), jsonout.json_obj([]))
    let battle: Json = jsonout.obj_get(jsonout.obj_get(action, "action"), "battle")
    let encounter: QuestEncounter = gamedata.quest_encounter(row)
    set passed = passed and jsonout.obj_has(jsonout.obj_get(action, "action"), "battle") and jsonout.as_text(jsonout.obj_get(jsonout.obj_get(battle, "battleEnemy"), "key")) == encounter.key
    set row = row + 1
  end
  passed
end

function story_bosses_are_distinct(bosses: a list of text, bid: text): boolean
  intent: find
  not contains(bosses, bid)
end

function test_story_encounters_use_varied_enemy_blueprints(): boolean
  intent: test
  mutable bosses: a list of text = []
  for row in story_grid() do
    for tile in jsonout.list_items(row) do
      if jsonout.obj_has(tile, "entities") then
        let bid: text = jsonout.as_text(jsonout.obj_get(tile, "boss"))
        if story_bosses_are_distinct(bosses, bid) then set bosses = append(bosses, bid) end
      end
    end
  end
  length(bosses) >= 8
end

function dialogue_set_is_authored(sets: Json, id: text): boolean
  intent: check
  let entries: a list of Json = jsonout.list_items(jsonout.obj_get(sets, id))
  mutable passed: boolean = jsonout.obj_has(sets, id) and length(entries) >= 2
  for entry in entries do
    set passed = passed and jsonout.obj_has(entry, "inShadow") and jsonout.obj_has(entry, "character") and jsonout.obj_has(entry, "side") and jsonout.obj_has(entry, "style") and jsonout.obj_has(entry, "line") and text_length(jsonout.as_text(jsonout.obj_get(entry, "line"))) > 0
  end
  passed
end

function test_quest_summary_exposes_authored_dialogue_sets(): boolean
  intent: test
  let summary: Json = gamedata.build_quest_summary("1.1.1", "story_act1")
  let sets: Json = jsonout.obj_get(summary, "dialogueTable")
  jsonout.obj_has(summary, "dialogueTable") and dialogue_set_is_authored(sets, "arrival_intro") and dialogue_set_is_authored(sets, "midpoint_rally") and dialogue_set_is_authored(sets, "final_stand") and dialogue_set_is_authored(sets, "shore_secured")
end

function main(): nothing
  intent: test
  mutable failed: integer = 0
  set failed = failed + report("test_specials_escalate_by_index", test_specials_escalate_by_index(), "special ratios did not escalate")
  set failed = failed + report("test_blueprint_model_id_matches_model_id_helper", test_blueprint_model_id_matches_model_id_helper(), "blueprint model id differed")
  set failed = failed + report("test_non_override_model_id_is_the_full_bid", test_non_override_model_id_is_the_full_bid(), "non-override model id changed")
  set failed = failed + report("test_fte_optimus_uses_real_optimus_prime_mesh", test_fte_optimus_uses_real_optimus_prime_mesh(), "FTE Optimus mesh was wrong")
  set failed = failed + report("test_portrait_stays_short_art_base", test_portrait_stays_short_art_base(), "portrait base was wrong")
  set failed = failed + report("test_all_roster_portraits_ship_both_sizes", test_all_roster_portraits_ship_both_sizes(), "a portrait size was missing")
  set failed = failed + report("test_art_base_overrides_cover_only_irregular_roster_bots", test_art_base_overrides_cover_only_irregular_roster_bots(), "override coverage was wrong")
  set failed = failed + report("base_stats spot checks", test_base_stats_spot_checks(), "stat arithmetic differed")
  set failed = failed + report("test_max_special_attacks_are_three_for_every_bot_and_wire_builder", test_max_special_attacks_are_three_for_every_bot_and_wire_builder(), "a bot or wire builder did not expose three specials")
  set failed = failed + report("test_default_mana_start_is_zero", test_default_mana_start_is_zero(), "default mana start was not zero")
  set failed = failed + report("test_mana_start_diagnostic_can_be_enabled", test_mana_start_diagnostic_can_be_enabled(), "mana start diagnostic did not reload")
  set failed = failed + report("test_combat_attribute_builders_carry_authored_mana_fields", test_combat_attribute_builders_carry_authored_mana_fields(), "hero entry mana fields were wrong")
  set failed = failed + report("test_generated_user_data_has_mana_gain_for_every_owned_bot", test_generated_user_data_has_mana_gain_for_every_owned_bot(), "generated user data mana fields were wrong")
  set failed = failed + report("test_generated_login_snapshot_has_three_specials_for_every_bot", test_generated_login_snapshot_has_three_specials_for_every_bot(), "generated login special counts were wrong")
  set failed = failed + report("test_generated_user_data_snapshot_has_three_specials_for_every_bot", test_generated_user_data_snapshot_has_three_specials_for_every_bot(), "generated user-data special counts were wrong")
  set failed = failed + report("test_normal_attack_levels_have_nonzero_damage_rows", test_normal_attack_levels_have_nonzero_damage_rows(), "attack values were wrong")
  set failed = failed + report("test_generated_login_response_contains_current_attack_rows", test_generated_login_response_contains_current_attack_rows(), "login attack values differed")
  set failed = failed + report("test_generated_login_response_uses_current_special_ratios", test_generated_login_response_uses_current_special_ratios(), "login special ratios differed")
  set failed = failed + report("test_login_response_carries_model_ids", test_login_response_carries_model_ids(), "login model ids differed")
  set failed = failed + report("test_gp_hit_stun_is_a_complete_harvested_stat_modifier_row", test_gp_hit_stun_is_a_complete_harvested_stat_modifier_row(), "hit stun row was wrong")
  set failed = failed + report("test_every_special_out_damages_every_normal_attack", test_every_special_out_damages_every_normal_attack(), "special damage was too low")
  set failed = failed + report("test_character_model_id_matches_model_id_helper", test_character_model_id_matches_model_id_helper(), "character model id differed")
  set failed = failed + report("test_player_lead_is_optimus_prime", test_player_lead_is_optimus_prime(), "team lead was wrong")
  set failed = failed + report("test_combat_armor_rating_constant_is_finite_and_positive", test_combat_armor_rating_constant_is_finite_and_positive(), "combat config was wrong")
  set failed = failed + report("test_account_response_contains_current_missions_config", test_account_response_contains_current_missions_config(), "account missions config differed")
  set failed = failed + report("test_direct_autorefresh_repeats_current_missions_config", test_direct_autorefresh_repeats_current_missions_config(), "direct autorefresh differed")
  set failed = failed + report("test_group_autorefresh_update_has_exact_client_fields", test_group_autorefresh_update_has_exact_client_fields(), "group autorefresh update was wrong")
  set failed = failed + report("test_story_board_authors_at_least_ten_encounter_tiles", test_story_board_authors_at_least_ten_encounter_tiles(), "story board had too few encounters")
  set failed = failed + report("test_story_board_has_exactly_one_final_encounter_and_it_is_the_boss", test_story_board_has_exactly_one_final_encounter_and_it_is_the_boss(), "story final encounter was wrong")
  set failed = failed + report("test_story_board_geometry_is_square_and_fully_revealed", test_story_board_geometry_is_square_and_fully_revealed(), "story board geometry was wrong")
  set failed = failed + report("test_every_encounter_row_triggers_a_battle_on_movedir", test_every_encounter_row_triggers_a_battle_on_movedir(), "story encounter did not trigger")
  set failed = failed + report("test_story_encounters_use_varied_enemy_blueprints", test_story_encounters_use_varied_enemy_blueprints(), "story encounters were not varied")
  set failed = failed + report("test_quest_summary_exposes_authored_dialogue_sets", test_quest_summary_exposes_authored_dialogue_sets(), "story dialogue sets were missing")
  set failed = failed + run_slice3_tests()
  set failed = failed + run_slice4_tests()
  print(to_text(64 - failed) ++ " passed, " ++ to_text(failed) ++ " failed")
  if failed > 0 then
  exit_process(1)
end
end

function arena_level_known(level: text): boolean
  intent: check
  level == "chicago" or level == "hongkong" or level == "karnak" or level == "mine" or level == "rust"
end

function run_slice3_tests(): integer
  intent: test
  mutable failed: integer = 0
  set failed = failed + report("test_intermediate_map_tile_carries_an_authored_nonfinal_encounter", test_intermediate_map_tile_carries_an_authored_nonfinal_encounter(), "intermediate encounter tile was wrong")
  set failed = failed + report("test_intermediate_blueprint_is_a_distinct_owned_roster_member", test_intermediate_blueprint_is_a_distinct_owned_roster_member(), "intermediate blueprint roster membership was wrong")
  set failed = failed + report("test_move_to_intermediate_tile_opens_the_minion_battle", test_move_to_intermediate_tile_opens_the_minion_battle(), "intermediate battle was wrong")
  set failed = failed + report("test_move_to_final_tile_still_opens_the_boss_battle", test_move_to_final_tile_still_opens_the_boss_battle(), "final battle was wrong")
  set failed = failed + report("test_default_quest_enemy_remains_the_final_boss", test_default_quest_enemy_remains_the_final_boss(), "default quest enemy was wrong")
  set failed = failed + report("test_quest_enemy_names_a_shipped_ai_profile_and_personality", test_quest_enemy_names_a_shipped_ai_profile_and_personality(), "enemy AI profile or personality was invalid")
  set failed = failed + report("test_default_arena_is_not_the_black_karnak_fallback", test_default_arena_is_not_the_black_karnak_fallback(), "default arena was invalid")
  set failed = failed + report("test_quest_enemy_assigns_a_nonempty_shipped_arena_level", test_quest_enemy_assigns_a_nonempty_shipped_arena_level(), "enemy arena assignment was invalid")
  set failed = failed + report("test_quest_enemy_tod_is_valid_for_its_arena_level", test_quest_enemy_tod_is_valid_for_its_arena_level(), "enemy time of day was invalid")
  set failed = failed + report("test_arena_environment_overrides_are_applied_on_reload", test_arena_environment_overrides_are_applied_on_reload(), "arena environment override failed")
  set failed = failed + report("test_invalid_arena_level_raises_on_reload", test_invalid_arena_level_raises_on_reload(), "invalid arena level did not fail")
  set failed = failed + report("test_invalid_arena_tod_raises_on_reload", test_invalid_arena_tod_raises_on_reload(), "invalid arena time of day did not fail")
  set failed = failed + report("test_final_map_tile_carries_the_authored_arena_assignment", test_final_map_tile_carries_the_authored_arena_assignment(), "final tile arena assignment was wrong")
  set failed = failed + report("test_arena_inventory_matches_shipped_level_prefabs_when_available", test_arena_inventory_matches_shipped_level_prefabs_when_available(), "arena asset inventory was wrong")
  set failed = failed + report("test_quest_progression_uses_the_supplied_squad", test_quest_progression_uses_the_supplied_squad(), "quest squad was lost")
  set failed = failed + report("test_quest_begin_threads_the_squad_into_its_instance_progression", test_quest_begin_threads_the_squad_into_its_instance_progression(), "quest begin squad was lost")
  set failed = failed + report("test_three_member_quest_squad_reaches_quest_and_active_teams", test_three_member_quest_squad_reaches_quest_and_active_teams(), "three member squad was lost")
  set failed = failed + report("test_quest_movedir_preserves_the_squad_in_progression_and_team_data", test_quest_movedir_preserves_the_squad_in_progression_and_team_data(), "move squad was lost")
  set failed = failed + report("test_user_data_uses_the_supplied_saved_and_active_team", test_user_data_uses_the_supplied_saved_and_active_team(), "user data squad was lost")
  set failed = failed + report("test_none_and_empty_team_preserve_default_json", test_none_and_empty_team_preserve_default_json(), "empty team builder was not deterministic")
  set failed = failed + report("test_unknown_blueprint_falls_back_to_the_default_squad", test_unknown_blueprint_falls_back_to_the_default_squad(), "unknown squad did not fall back")
  failed
end

function team_object_matches(node: Json, team: a list of text): boolean
  intent: check
  mutable expected: a list of Pair = []
  for bid in team do
    set expected = append(expected, jsonout.json_pair(bid, jsonout.obj_get(node, bid)))
  end
  jsonout.encode_compact(node) == jsonout.encode_compact(jsonout.json_obj(expected))
end

function test_intermediate_map_tile_carries_an_authored_nonfinal_encounter(): boolean
  intent: test
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(gamedata.build_quest_map("1.1.1"), "grid"))
  let row: Json = unwrap_or(get(grid, 1), jsonout.json_list([]))
  let tile: Json = unwrap_or(get(jsonout.list_items(row), 1), jsonout.json_obj([]))
  let enemy: Json = jsonout.obj_get(jsonout.obj_get(tile, "entities"), gamedata.minion_blueprint())
  jsonout.as_bool(jsonout.obj_get(tile, "walkable")) and (not jsonout.obj_has(tile, "final") or not jsonout.as_bool(jsonout.obj_get(tile, "final"))) and jsonout.as_text(jsonout.obj_get(tile, "boss")) == gamedata.minion_blueprint() and jsonout.as_text(jsonout.obj_get(enemy, "entityType")) == "boss" and jsonout.as_bool(jsonout.obj_get(enemy, "isFinalBoss")) == false and jsonout.encode_compact(jsonout.obj_get(enemy, "characters")) == jsonout.encode_compact(jsonout.json_list([jsonout.json_text(gamedata.minion_blueprint())])) and jsonout.as_text(jsonout.obj_get(enemy, "mapOverride")) == gamedata.arena_level() and jsonout.as_int(jsonout.obj_get(enemy, "todIndex")) == gamedata.arena_tod_index()
end

function test_intermediate_blueprint_is_a_distinct_owned_roster_member(): boolean
  intent: test
  mutable minion_found: boolean = false
  mutable boss_found: boolean = false
  for entry in gamedata.roster() do
    if entry.bid == gamedata.minion_blueprint() then
  set minion_found = true
end
    if entry.bid == gamedata.boss_blueprint() then
  set boss_found = true
end
  end
  gamedata.minion_blueprint() != gamedata.boss_blueprint() and minion_found and boss_found
end

function test_move_to_intermediate_tile_opens_the_minion_battle(): boolean
  intent: test
  let result: Json = gamedata.build_quest_movedir("1.1.1", 1, 0, 0, 1, [])
  let action: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(result, "results")), 1), jsonout.json_obj([]))
  let battle: Json = jsonout.obj_get(jsonout.obj_get(action, "action"), "battle")
  let progression: Json = jsonout.obj_get(result, "progression")
  let user: Json = jsonout.obj_get(jsonout.obj_get(progression, "users"), gamedata.local_uid())
  jsonout.as_text(jsonout.obj_get(jsonout.obj_get(battle, "battleEnemy"), "key")) == gamedata.minion_blueprint() and jsonout.as_bool(jsonout.obj_get(battle, "isFinalBoss")) == false and jsonout.as_text(jsonout.obj_get(progression, "currentBattleId")) == gamedata.minion_blueprint() and jsonout.as_text(jsonout.obj_get(user, "currentBattleState")) == "activated"
end

function test_move_to_final_tile_still_opens_the_boss_battle(): boolean
  intent: test
  let result: Json = gamedata.build_quest_movedir("1.1.1", 1, 0, gamedata.quest_dim() - 2, 1, [])
  let action: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(result, "results")), 1), jsonout.json_obj([]))
  let battle: Json = jsonout.obj_get(jsonout.obj_get(action, "action"), "battle")
  jsonout.as_text(jsonout.obj_get(jsonout.obj_get(battle, "battleEnemy"), "key")) == gamedata.boss_blueprint() and jsonout.as_bool(jsonout.obj_get(battle, "isFinalBoss")) == true
end

function test_default_quest_enemy_remains_the_final_boss(): boolean
  intent: test
  let enemy: Json = gamedata.build_quest_enemy("", -1)
  jsonout.as_text(jsonout.obj_get(enemy, "key")) == gamedata.boss_blueprint() and jsonout.as_bool(jsonout.obj_get(enemy, "isFinalBoss")) == true
end

function test_quest_enemy_names_a_shipped_ai_profile_and_personality(): boolean
  intent: test
  let enemy: Json = gamedata.build_quest_enemy("", -1)
  let profile: text = jsonout.as_text(jsonout.obj_get(enemy, "aiString"))
  let personality: text = jsonout.as_text(jsonout.obj_get(enemy, "aiPer"))
  profile == gamedata.enemy_ai_profile() and profile == "Default" and profile != "default" and personality == gamedata.enemy_ai_personality() and personality == "Ranged" and personality != "default"
end

function test_default_arena_is_not_the_black_karnak_fallback(): boolean
  intent: test
  gamedata.arena_level() != "karnak" and arena_level_known(gamedata.arena_level())
end

function test_quest_enemy_assigns_a_nonempty_shipped_arena_level(): boolean
  intent: test
  let enemy: Json = gamedata.build_quest_enemy("", -1)
  let level: text = jsonout.as_text(jsonout.obj_get(enemy, "mapOverride"))
  text_length(level) > 0 and level == gamedata.arena_level() and arena_level_known(level)
end

function test_quest_enemy_tod_is_valid_for_its_arena_level(): boolean
  intent: test
  let enemy: Json = gamedata.build_quest_enemy("", -1)
  let tod: integer = jsonout.as_int(jsonout.obj_get(enemy, "todIndex"))
  tod >= 0 and tod <= 2 and arena_level_known(jsonout.as_text(jsonout.obj_get(enemy, "mapOverride")))
end

function arena_command(environment: text): a mapping from text to text
  intent: run
  shell_exec(environment ++ " legible run " ++ path_join(gamedata.here(), "gamedata.lbl") ++ " --dump-arena")
end

function command_code(result: a mapping from text to text): integer
  intent: get
  to_integer(unwrap_or(get(result, "exit_code"), "1"))
end

function command_stdout(result: a mapping from text to text): text
  intent: get
  unwrap_or(get(result, "stdout"), "")
end

function test_arena_environment_overrides_are_applied_on_reload(): boolean
  intent: test
  let result: a mapping from text to text = arena_command("TFTF_ARENA_LEVEL=mine TFTF_ARENA_TOD=2")
  command_code(result) == 0 and contains_text(command_stdout(result), "ENEMY_MAPOVERRIDE mine") and contains_text(command_stdout(result), "ENEMY_TOD 2")
end

function test_invalid_arena_level_raises_on_reload(): boolean
  intent: test
  command_code(arena_command("TFTF_ARENA_LEVEL=not-a-level")) == 1
end

function test_invalid_arena_tod_raises_on_reload(): boolean
  intent: test
  command_code(arena_command("TFTF_ARENA_LEVEL=mine TFTF_ARENA_TOD=3")) == 1
end

function test_final_map_tile_carries_the_authored_arena_assignment(): boolean
  intent: test
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(gamedata.build_quest_map("1.1.1"), "grid"))
  mutable finals: integer = 0
  mutable correct: boolean = false
  for row in grid do
    for tile in jsonout.list_items(row) do
      if jsonout.obj_has(tile, "final") then
  if jsonout.as_bool(jsonout.obj_get(tile, "final")) then
  let boss: Json = jsonout.obj_get(jsonout.obj_get(tile, "entities"), gamedata.boss_blueprint())
  set finals = finals + 1
  set correct = jsonout.as_text(jsonout.obj_get(boss, "mapOverride")) == gamedata.arena_level() and jsonout.as_int(jsonout.obj_get(boss, "todIndex")) == gamedata.arena_tod_index()
end
end
    end
  end
  finals == 1 and correct
end

function test_arena_inventory_matches_shipped_level_prefabs_when_available(): boolean
  intent: test
  let assets: text = path_join(path_join(directory_name(gamedata.here()), "Transformers 9.2 extracted"), "assets")
  if not is_dir(assets) then
  print("[skip] arena inventory: user-owned extracted game assets are not available")
  true
else
  mutable passed: boolean = true
  for level in ["chicago", "hongkong", "karnak", "mine", "rust"] do
    let toc_path: text = path_join(path_join(assets, level), "toc.txt")
    set passed = passed and file_exists(toc_path)
    if file_exists(toc_path) then
  let toc: Json = jsonout.parse_json(read_file(toc_path))
  let paths: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(toc, "bundles"), level ++ "_merged"), "paths")
  set passed = passed and jsonout.obj_has(paths, level ++ "_merged/" ++ level ++ "_merged") and jsonout.obj_has(paths, level ++ "_merged/" ++ level ++ "_timeofday_0_forward") and jsonout.obj_has(paths, level ++ "_merged/" ++ level ++ "_timeofday_1_forward") and jsonout.obj_has(paths, level ++ "_merged/" ++ level ++ "_timeofday_2_forward")
end
  end
  passed
end
end

function test_quest_progression_uses_the_supplied_squad(): boolean
  intent: test
  let team: a list of text = ["grimlock_gs_mp08", "megatron_cin_rotf"]
  let user: Json = jsonout.obj_get(jsonout.obj_get(gamedata.build_quest_progression("1.1.1", 0, 1, team), "users"), gamedata.local_uid())
  team_object_matches(jsonout.obj_get(user, "team"), team) and jsonout.as_text(jsonout.obj_get(user, "strongestHero")) == "grimlock_gs_mp08"
end

function test_quest_begin_threads_the_squad_into_its_instance_progression(): boolean
  intent: test
  let team: a list of text = ["grimlock_gs_mp08", "megatron_cin_rotf"]
  let active: Json = jsonout.obj_get(jsonout.obj_get(gamedata.build_quest_begin("1.1.1", "story_act1", team), "activeQuests"), "1.1.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(active, "instances")), 0), jsonout.json_obj([]))
  let user: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(instance, "progression"), "users"), gamedata.local_uid())
  team_object_matches(jsonout.obj_get(user, "team"), team)
end

function test_three_member_quest_squad_reaches_quest_and_active_teams(): boolean
  intent: test
  let team: a list of text = gamedata.default_team()
  let active: Json = jsonout.obj_get(jsonout.obj_get(gamedata.build_quest_begin("1.1.1", "story_act1", team), "activeQuests"), "1.1.1")
  let instance: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(active, "instances")), 0), jsonout.json_obj([]))
  let user: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(instance, "progression"), "users"), gamedata.local_uid())
  team_object_matches(jsonout.obj_get(user, "team"), team) and team_object_matches(jsonout.obj_get(gamedata.build_active_team("1.1.1-0", team), "heroes"), team)
end

function test_quest_movedir_preserves_the_squad_in_progression_and_team_data(): boolean
  intent: test
  let team: a list of text = ["grimlock_gs_mp08", "megatron_cin_rotf"]
  let result: Json = gamedata.build_quest_movedir("1.1.1", 1, 0, 0, 1, team)
  let user: Json = jsonout.obj_get(jsonout.obj_get(jsonout.obj_get(result, "progression"), "users"), gamedata.local_uid())
  team_object_matches(jsonout.obj_get(user, "team"), team) and team_object_matches(jsonout.obj_get(jsonout.obj_get(result, "teamData"), "heroes"), team)
end

function saved_team_bids_match(saved: Json, team: a list of text): boolean
  intent: check
  let heroes: a list of Json = jsonout.list_items(jsonout.obj_get(saved, "heroes"))
  mutable passed: boolean = length(heroes) == length(team)
  mutable index: integer = 0
  while index < length(team) do
    let hero: Json = unwrap_or(get(heroes, index), jsonout.json_obj([]))
    set passed = passed and jsonout.as_text(jsonout.obj_get(hero, "bid")) == unwrap_or(get(team, index), "")
    set index = index + 1
  end
  passed
end

function test_user_data_uses_the_supplied_saved_and_active_team(): boolean
  intent: test
  let team: a list of text = ["grimlock_gs_mp08", "megatron_cin_rotf"]
  let updates: Json = jsonout.obj_get(gamedata.build_user_data(team), "updates")
  let saved: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(updates, "savedTeams")), 0), jsonout.json_obj([]))
  let active: Json = unwrap_or(get(jsonout.list_items(jsonout.obj_get(updates, "activeTeams")), 0), jsonout.json_obj([]))
  saved_team_bids_match(saved, team) and team_object_matches(jsonout.obj_get(active, "heroes"), team)
end

function test_none_and_empty_team_preserve_default_json(): boolean
  intent: test
  jsonout.encode_compact(gamedata.build_quest_progression("1.1.1", 0, 1, [])) == jsonout.encode_compact(gamedata.build_quest_progression("1.1.1", 0, 1, [])) and jsonout.encode_compact(gamedata.build_active_quest("1.1.1", "story_act1", [])) == jsonout.encode_compact(gamedata.build_active_quest("1.1.1", "story_act1", [])) and jsonout.encode_compact(gamedata.build_quest_begin("1.1.1", "story_act1", [])) == jsonout.encode_compact(gamedata.build_quest_begin("1.1.1", "story_act1", [])) and jsonout.encode_compact(gamedata.build_quest_movedir("1.1.1", 1, 0, 0, 1, [])) == jsonout.encode_compact(gamedata.build_quest_movedir("1.1.1", 1, 0, 0, 1, [])) and jsonout.encode_compact(gamedata.build_user_data([])) == jsonout.encode_compact(gamedata.build_user_data([]))
end

function test_unknown_blueprint_falls_back_to_the_default_squad(): boolean
  intent: test
  let user: Json = jsonout.obj_get(jsonout.obj_get(gamedata.build_quest_progression("1.1.1", 0, 1, ["not-a-blueprint"]), "users"), gamedata.local_uid())
  team_object_matches(jsonout.obj_get(user, "team"), gamedata.default_team()) and jsonout.as_text(jsonout.obj_get(user, "strongestHero")) == unwrap_or(get(gamedata.default_team(), 0), "")
end

function base_active(): Json
  intent: build
  gamedata.build_base_active()
end

function test_keys_use_the_concatenated_user_prefix(): boolean
  intent: test
  let result: Json = base_active()
  let expected: Json = jsonout.json_obj([jsonout.json_pair("userBase", jsonout.obj_get(result, "userBase")), jsonout.json_pair("userAvailableBuildings", jsonout.obj_get(result, "userAvailableBuildings")), jsonout.json_pair("userBuildings", jsonout.obj_get(result, "userBuildings")), jsonout.json_pair("userSockets", jsonout.obj_get(result, "userSockets"))])
  jsonout.obj_has(result, "userBase") and jsonout.obj_has(result, "userAvailableBuildings") and jsonout.obj_has(result, "userBuildings") and jsonout.obj_has(result, "userSockets") and jsonout.encode_compact(result) == jsonout.encode_compact(expected)
end

function test_mission_identity_fields_are_all_non_empty(): boolean
  intent: test
  let mission: Json = jsonout.obj_get(base_active(), "userBase")
  text_length(jsonout.as_text(jsonout.obj_get(mission, "mode"))) > 0 and text_length(jsonout.as_text(jsonout.obj_get(mission, "category"))) > 0 and text_length(jsonout.as_text(jsonout.obj_get(mission, "id"))) > 0 and jsonout.as_text(jsonout.obj_get(mission, "uid")) == gamedata.local_uid()
end

function test_summary_theme_resolves_to_a_bundled_base_library(): boolean
  intent: test
  let mission: Json = jsonout.obj_get(base_active(), "userBase")
  jsonout.as_text(jsonout.obj_get(jsonout.obj_get(mission, "data"), "theme")) == "primordial"
end

function test_map_grid_is_square_and_has_exactly_one_start_tile(): boolean
  intent: test
  let mission: Json = jsonout.obj_get(base_active(), "userBase")
  let map: Json = jsonout.obj_get(mission, "map")
  let dim: integer = jsonout.as_int(jsonout.obj_get(map, "gridDimension"))
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(map, "grid"))
  mutable passed: boolean = length(grid) == dim
  mutable starts: integer = 0
  for row in grid do
    set passed = passed and length(jsonout.list_items(row)) == dim
    for tile in jsonout.list_items(row) do
      if jsonout.obj_has(tile, "start") then
  if jsonout.as_bool(jsonout.obj_get(tile, "start")) then
  set starts = starts + 1
end
end
    end
  end
  passed and starts == 1
end

function test_map_has_path_data_so_the_path_analyzer_cannot_null_deref(): boolean
  intent: test
  let mission: Json = jsonout.obj_get(base_active(), "userBase")
  let paths: a list of Json = jsonout.list_items(jsonout.obj_get(jsonout.obj_get(mission, "map"), "pathData"))
  mutable passed: boolean = length(paths) >= 1
  for path in paths do
    set passed = passed and length(jsonout.list_items(jsonout.obj_get(path, "path"))) >= 1
  end
  passed
end

function test_every_walkable_tile_offers_an_unlocked_building_socket(): boolean
  intent: test
  let result: Json = base_active()
  let map: Json = jsonout.obj_get(jsonout.obj_get(result, "userBase"), "map")
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(map, "grid"))
  let user_sockets: Json = jsonout.obj_get(result, "userSockets")
  mutable passed: boolean = true
  mutable walkable: integer = 0
  mutable row_index: integer = 0
  for row in grid do
    mutable col_index: integer = 0
    for tile in jsonout.list_items(row) do
      if jsonout.as_bool(jsonout.obj_get(tile, "walkable")) then
  set walkable = walkable + 1
  let socket_id: text = gamedata.base_socket_id(row_index, col_index)
  let sockets: Json = jsonout.obj_get(tile, "sockets")
  let socket: Json = jsonout.obj_get(sockets, socket_id)
  let expected: Json = jsonout.json_obj([jsonout.json_pair(socket_id, socket)])
  set passed = passed and jsonout.obj_has(sockets, socket_id) and jsonout.encode_compact(sockets) == jsonout.encode_compact(expected) and jsonout.as_text(jsonout.obj_get(socket, "entityType")) == "building" and jsonout.obj_has(user_sockets, socket_id) and jsonout.as_bool(jsonout.obj_get(user_sockets, socket_id))
end
      set col_index = col_index + 1
    end
    set row_index = row_index + 1
  end
  passed and walkable == jsonout.as_int(jsonout.obj_get(map, "walkableCount"))
end

function available_has(available: a list of Json, bid: text): boolean
  intent: find
  mutable found: boolean = false
  for building in available do
    if jsonout.as_text(jsonout.obj_get(building, "id")) == bid then
  set found = true
end
  end
  found
end

function test_placements_reference_authored_sockets_and_buildings(): boolean
  intent: test
  let result: Json = base_active()
  let mission: Json = jsonout.obj_get(result, "userBase")
  let placements: Json = jsonout.obj_get(mission, "placements")
  let available: a list of Json = jsonout.list_items(jsonout.obj_get(result, "userAvailableBuildings"))
  let expected: Json = jsonout.json_obj([jsonout.json_pair(gamedata.base_socket_id(2, 2), jsonout.obj_get(placements, gamedata.base_socket_id(2, 2))), jsonout.json_pair(gamedata.base_socket_id(2, 1), jsonout.obj_get(placements, gamedata.base_socket_id(2, 1))), jsonout.json_pair(gamedata.base_socket_id(2, 3), jsonout.obj_get(placements, gamedata.base_socket_id(2, 3))), jsonout.json_pair(gamedata.base_socket_id(1, 2), jsonout.obj_get(placements, gamedata.base_socket_id(1, 2))), jsonout.json_pair(gamedata.base_socket_id(3, 2), jsonout.obj_get(placements, gamedata.base_socket_id(3, 2)))])
  mutable passed: boolean = jsonout.encode_compact(placements) == jsonout.encode_compact(expected)
  for socket_id in [gamedata.base_socket_id(2, 2), gamedata.base_socket_id(2, 1), gamedata.base_socket_id(2, 3), gamedata.base_socket_id(1, 2), gamedata.base_socket_id(3, 2)] do
    let placement: Json = jsonout.obj_get(placements, socket_id)
    set passed = passed and jsonout.obj_has(placements, socket_id) and gamedata.base_is_walkable(jsonout.as_int(jsonout.obj_get(jsonout.obj_get(placement, "position"), "x")), jsonout.as_int(jsonout.obj_get(jsonout.obj_get(placement, "position"), "y"))) and jsonout.as_text(jsonout.obj_get(placement, "entityType")) == "building" and available_has(available, jsonout.as_text(jsonout.obj_get(placement, "key")))
  end
  passed
end

function test_owned_buildings_come_from_the_available_catalogue(): boolean
  intent: test
  let result: Json = base_active()
  let available: a list of Json = jsonout.list_items(jsonout.obj_get(result, "userAvailableBuildings"))
  let owned: a list of Json = jsonout.list_items(jsonout.obj_get(result, "userBuildings"))
  let sockets: Json = jsonout.obj_get(result, "userSockets")
  mutable passed: boolean = length(owned) > 0
  for building in owned do
    set passed = passed and available_has(available, jsonout.as_text(jsonout.obj_get(building, "id"))) and jsonout.obj_has(sockets, jsonout.as_text(jsonout.obj_get(building, "key")))
  end
  passed
end

function shipped_model(model: text): boolean
  intent: check
  contains(["z_bldg_alliance_help_00", "z_bldg_alliance_help_01", "z_bldg_alliance_help_02", "z_bldg_alliance_help_03", "z_bldg_away_team_00", "z_bldg_away_team_01", "z_bldg_away_team_02", "z_bldg_away_team_03", "z_bldg_battle_centre_00", "z_bldg_battle_centre_01", "z_bldg_battle_centre_02", "z_bldg_battle_centre_03", "z_bldg_gacha_daily_01", "z_bldg_gacha_free_01", "z_bldg_gacha_other_01"], model)
end

function test_available_buildings_use_shipped_model_ids(): boolean
  intent: test
  let buildings: a list of Json = jsonout.list_items(jsonout.obj_get(base_active(), "userAvailableBuildings"))
  mutable passed: boolean = length(buildings) > 0
  for building in buildings do
    set passed = passed and jsonout.as_text(jsonout.obj_get(building, "entityType")) == "building" and shipped_model(jsonout.as_text(jsonout.obj_get(building, "modelId"))) and text_length(jsonout.as_text(jsonout.obj_get(building, "id"))) > 0 and text_length(jsonout.as_text(jsonout.obj_get(building, "name"))) > 0
  end
  passed
end

function test_links_only_point_at_walkable_neighbours(): boolean
  intent: test
  let map: Json = jsonout.obj_get(jsonout.obj_get(base_active(), "userBase"), "map")
  let grid: a list of Json = jsonout.list_items(jsonout.obj_get(map, "grid"))
  mutable passed: boolean = true
  for row in grid do
    for tile in jsonout.list_items(row) do
      if jsonout.obj_has(tile, "links") then
  for link in jsonout.list_items(jsonout.obj_get(tile, "links")) do
    let target_row: Json = unwrap_or(get(grid, jsonout.as_int(jsonout.obj_get(link, "x"))), jsonout.json_list([]))
    let target: Json = unwrap_or(get(jsonout.list_items(target_row), jsonout.as_int(jsonout.obj_get(link, "y"))), jsonout.json_obj([]))
    set passed = passed and jsonout.as_bool(jsonout.obj_get(target, "walkable"))
  end
end
    end
  end
  passed
end

function run_slice4_tests(): integer
  intent: test
  mutable failed: integer = 0
  set failed = failed + report("test_keys_use_the_concatenated_user_prefix", test_keys_use_the_concatenated_user_prefix(), "base active keys were wrong")
  set failed = failed + report("test_mission_identity_fields_are_all_non_empty", test_mission_identity_fields_are_all_non_empty(), "mission identity was wrong")
  set failed = failed + report("test_summary_theme_resolves_to_a_bundled_base_library", test_summary_theme_resolves_to_a_bundled_base_library(), "base theme was wrong")
  set failed = failed + report("test_map_grid_is_square_and_has_exactly_one_start_tile", test_map_grid_is_square_and_has_exactly_one_start_tile(), "base map shape was wrong")
  set failed = failed + report("test_map_has_path_data_so_the_path_analyzer_cannot_null_deref", test_map_has_path_data_so_the_path_analyzer_cannot_null_deref(), "base paths were missing")
  set failed = failed + report("test_every_walkable_tile_offers_an_unlocked_building_socket", test_every_walkable_tile_offers_an_unlocked_building_socket(), "base sockets were wrong")
  set failed = failed + report("test_placements_reference_authored_sockets_and_buildings", test_placements_reference_authored_sockets_and_buildings(), "base placements were wrong")
  set failed = failed + report("test_owned_buildings_come_from_the_available_catalogue", test_owned_buildings_come_from_the_available_catalogue(), "owned buildings were wrong")
  set failed = failed + report("test_available_buildings_use_shipped_model_ids", test_available_buildings_use_shipped_model_ids(), "building models were wrong")
  set failed = failed + report("test_links_only_point_at_walkable_neighbours", test_links_only_point_at_walkable_neighbours(), "base links were wrong")
  failed
end

function mana_command(environment: text): a mapping from text to text
  intent: run
  shell_exec(environment ++ " legible run " ++ path_join(gamedata.here(), "gamedata.lbl") ++ " --dump-mana-start")
end

function test_mana_start_diagnostic_can_be_enabled(): boolean
  intent: test
  let enabled: a mapping from text to text = mana_command("TFTF_DIAG_MANA_START=1")
  let default: a mapping from text to text = mana_command("")
  command_code(enabled) == 0 and contains_text(command_stdout(enabled), "MANA_START 1") and command_code(default) == 0 and contains_text(command_stdout(default), "MANA_START 0")
end

function test_generated_login_response_uses_current_special_ratios(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__bcg_getLoginData.json")))
  let blueprints: Json = jsonout.obj_get(jsonout.obj_get(response, "result"), "blueprints")
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let response_blueprint: Json = jsonout.obj_get(blueprints, entry.bid)
    let built_blueprint: Json = blueprint(entry.bid)
    set passed = passed and jsonout.obj_has(blueprints, entry.bid) and encoded_field(response_blueprint, "s1") == encoded_field(built_blueprint, "s1") and encoded_field(response_blueprint, "s2") == encoded_field(built_blueprint, "s2") and encoded_field(response_blueprint, "s3") == encoded_field(built_blueprint, "s3")
  end
  passed
end

function test_login_response_carries_model_ids(): boolean
  intent: test
  let response: Json = jsonout.parse_json(read_file(path_join(gamedata.resp_dir(), "GET__bcg_getLoginData.json")))
  let blueprints: Json = jsonout.obj_get(jsonout.obj_get(response, "result"), "blueprints")
  mutable passed: boolean = true
  for entry in gamedata.roster() do
    let response_blueprint: Json = jsonout.obj_get(blueprints, entry.bid)
    set passed = passed and jsonout.obj_has(blueprints, entry.bid) and field_text(response_blueprint, "mdl") == gamedata.model_id(entry.bid)
  end
  passed
end

main()
