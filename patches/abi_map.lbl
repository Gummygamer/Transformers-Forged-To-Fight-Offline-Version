-- Translate arm64 Il2CppDumper addresses and field offsets to armeabi-v7a.
-- Address and field-offset mapper; it deliberately uses no regexes.

record Method
  rva: integer
  owner: text
  declaration: text
end

record Field
  declaration: text
  offset: integer
end

record NameMaps
  methods: a mapping from integer to integer
  names: a mapping from integer to text
end

function is_word_char(ch: text): boolean
  intent: return result
  contains_text("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch)
end

function is_identifier_char(ch: text): boolean
  intent: return result
  is_word_char(ch) or ch == "." or ch == "<" or ch == ">" or ch == "`"
end

function is_type_keyword(word: text): boolean
  intent: return result
  word == "class" or word == "struct" or word == "enum" or word == "interface"
end

function is_modifier_word(word: text): boolean
  intent: return result
  mutable i: integer = 0
  mutable valid: boolean = text_length(word) > 0
  while i < text_length(word) do
    if not is_word_char(substring(word, i, 1)) then
      set valid = false
    end
    set i = i + 1
  end
  valid
end

function parse_hex(value: text): integer
  intent: return result
  let body: text = if starts_with(value, "0x") or starts_with(value, "0X") then substring(value, 2, text_length(value) - 2) else value end
  mutable result: integer = 0
  mutable i: integer = 0
  while i < text_length(body) do
    let ch: text = lowercase(substring(body, i, 1))
    let digit: integer = unwrap_or(index_of("0123456789abcdef", ch), -1)
    if digit < 0 then
      print("[!] invalid hexadecimal value " ++ value)
      exit_process(1)
    end
    set result = result * 16 + digit
    set i = i + 1
  end
  result
end

function is_hex_text(value: text): boolean
  intent: return result
  let body: text = if starts_with(value, "0x") or starts_with(value, "0X") then substring(value, 2, text_length(value) - 2) else value end
  mutable i: integer = 0
  mutable valid: boolean = text_length(body) > 0
  while i < text_length(body) do
    if is_none(index_of("0123456789abcdef", lowercase(substring(body, i, 1)))) then
      set valid = false
    end
    set i = i + 1
  end
  valid
end

function to_hex_upper(number: integer): text
  intent: return result
  if number == 0 then
    "0"
  else
    mutable value: integer = number
    mutable out: text = ""
    while value > 0 do
      let digit: integer = value % 16
      let ch: text = substring("0123456789ABCDEF", digit, 1)
      set out = ch ++ out
      set value = floor(value / 16)
    end
    out
  end
end

function pad_right(value: text, width: integer): text
  intent: return result
  mutable out: text = value
  while text_length(out) < width do
    set out = out ++ " "
  end
  out
end

function dump_path(directory: text, name: text): text
  intent: return result
  let path: text = if is_dir(directory) then path_join(directory, name) else directory end
  if not file_exists(path) then
    print("[!] " ++ path ++ " not found (pass the Il2CppDumper output directory)")
    exit_process(1)
  end
  path
end

function identifier_prefix(value: text): text
  intent: return result
  mutable i: integer = 0
  while i < text_length(value) and is_identifier_char(substring(value, i, 1)) do
    set i = i + 1
  end
  substring(value, 0, i)
end

function preceding_words_are_modifiers(words: a list of text, end_at: integer): boolean
  intent: return result
  mutable i: integer = 0
  mutable valid: boolean = true
  while i < end_at do
    if not is_modifier_word(unwrap_or(get(words, i), "")) then
      set valid = false
    end
    set i = i + 1
  end
  valid
end

function owner_from_line(line: text): text
  intent: return result
  let words: a list of text = split(trim(line), " ")
  mutable i: integer = 0
  mutable owner: text = "?"
  while i + 1 < length(words) do
    let word: text = unwrap_or(get(words, i), "")
    if is_type_keyword(word) and preceding_words_are_modifiers(words, i) then
      set owner = identifier_prefix(unwrap_or(get(words, i + 1), ""))
    end
    set i = i + 1
  end
  owner
end

function rva_from_line(stripped: text): integer
  intent: return result
  let rest: text = substring(stripped, 8, text_length(stripped) - 8)
  let finish: integer = unwrap_or(index_of(rest, " "), text_length(rest))
  parse_hex(substring(rest, 0, finish))
end

function parse_methods(path: text): a list of Method
  intent: return result
  let lines: a list of text = split(read_file(path), "\n")
  mutable methods: a list of Method = []
  mutable owner: text = "?"
  mutable pending: integer = 0
  mutable has_pending: boolean = false
  for line in lines do
    let stripped: text = trim(line)
    if starts_with(stripped, "// RVA: 0x") then
      set pending = rva_from_line(stripped)
      set has_pending = true
    else if text_length(stripped) > 0 then
      if has_pending and not starts_with(stripped, "[") and not starts_with(stripped, "//") then
        set methods = append(methods, Method { rva: pending, owner: owner, declaration: stripped })
        set has_pending = false
      end
      let found_owner: text = owner_from_line(line)
      if found_owner != "?" then
        set owner = found_owner
      end
    end
  end
  methods
end

function type_line_matches(line: text, wanted: text): boolean
  intent: return result
  let stripped: text = trim(line)
  let words: a list of text = split(stripped, " ")
  mutable i: integer = 0
  mutable matched: boolean = false
  while i + 1 < length(words) do
    let word: text = unwrap_or(get(words, i), "")
    let candidate: text = unwrap_or(get(words, i + 1), "")
    if (word == "class" or word == "struct") and starts_with(candidate, wanted) then
      let next: text = substring(candidate, text_length(wanted), text_length(candidate) - text_length(wanted))
      if text_length(next) == 0 or not is_identifier_char(substring(next, 0, 1)) then
        set matched = true
      end
    end
    set i = i + 1
  end
  matched and not starts_with(stripped, "//")
end

function last_index_of(value: text, wanted: text): integer
  intent: return result
  mutable cursor: integer = 0
  mutable found: integer = -1
  mutable searching: boolean = true
  while searching do
    let remaining: text = substring(value, cursor, text_length(value) - cursor)
    let at: integer = unwrap_or(index_of(remaining, wanted), -1)
    if at < 0 then
      set searching = false
    else
      set found = cursor + at
      set cursor = found + text_length(wanted)
      if cursor >= text_length(value) then
        set searching = false
      end
    end
  end
  found
end

function field_from_line(line: text): an optional Field
  intent: return result
  let stripped: text = trim(line)
  let comment: integer = last_index_of(stripped, "//")
  let semicolon: integer = last_index_of(stripped, ";")
  if comment > semicolon and semicolon >= 0 then
    let offset_text: text = trim(substring(stripped, comment + 2, text_length(stripped) - comment - 2))
    if (starts_with(offset_text, "0x") or starts_with(offset_text, "0X")) and is_hex_text(offset_text) then
      Field { declaration: trim(substring(stripped, 0, semicolon)), offset: parse_hex(offset_text) }
    else
      none
    end
  else
    none
  end
end

function parse_fields(path: text, wanted: text): a list of Field
  intent: return result
  let lines: a list of text = split(read_file(path), "\n")
  mutable fields: a list of Field = []
  mutable inside: boolean = false
  mutable finished: boolean = false
  for line in lines do
    if not inside and type_line_matches(line, wanted) then
      set inside = true
    else if inside and not finished then
      if starts_with(line, "}") then
        set finished = true
      else
        let field: an optional Field = field_from_line(line)
        if is_some(field) then
          set fields = append(fields, unwrap(field))
        end
      end
    end
  end
  fields
end

function append_group(groups: a mapping from text to a list of integer, name: text, address: integer): a mapping from text to a list of integer
  intent: return result
  let old: a list of integer = unwrap_or(get(groups, name), [])
  put(groups, name, append(old, address))
end

function group_methods(items: a list of a mapping from text to text): a mapping from text to a list of integer
  intent: return result
  mutable groups: a mapping from text to a list of integer = {}
  for item in items do
    let name: text = get(item, "Name")
    let address: integer = get(item, "Address")
    set groups = append_group(groups, name, address)
  end
  groups
end

function disagreeing_name_count(a: a mapping from text to a list of integer, b: a mapping from text to a list of integer): integer
  intent: return result
  mutable count: integer = 0
  for name in keys(a) do
    if not has_key(b, name) then
      set count = count + 1
    end
  end
  for name in keys(b) do
    if not has_key(a, name) then
      set count = count + 1
    end
  end
  count
end

function put_if_absent(map: a mapping from integer to integer, key: integer, value: integer): a mapping from integer to integer
  intent: return result
  if has_key(map, key) then map else put(map, key, value) end
end

function put_name_if_absent(map: a mapping from integer to text, key: integer, value: text): a mapping from integer to text
  intent: return result
  if has_key(map, key) then map else put(map, key, value) end
end

function name_map(a_directory: text, b_directory: text): NameMaps
  intent: return result
  let a_root: a mapping from text to text = json_parse(read_file(dump_path(a_directory, "script.json")))
  let b_root: a mapping from text to text = json_parse(read_file(dump_path(b_directory, "script.json")))
  let a_groups: a mapping from text to a list of integer = group_methods(get(a_root, "ScriptMethod"))
  let b_groups: a mapping from text to a list of integer = group_methods(get(b_root, "ScriptMethod"))
  let disagreement: integer = disagreeing_name_count(a_groups, b_groups)
  if disagreement > 0 then
    print("[!] the two dumps disagree on " ++ to_text(disagreement) ++ " method names; they must come from the same global-metadata.dat")
    exit_process(1)
  end
  mutable methods: a mapping from integer to integer = {}
  mutable names: a mapping from integer to text = {}
  for name in keys(a_groups) do
    let a_addresses: a list of integer = get(a_groups, name)
    let b_addresses: a list of integer = get(b_groups, name)
    if length(a_addresses) == length(b_addresses) then
      mutable i: integer = 0
      while i < length(a_addresses) do
        let a_address: integer = unwrap_or(get(a_addresses, i), 0)
        let b_address: integer = unwrap_or(get(b_addresses, i), 0)
        set methods = put_if_absent(methods, a_address, b_address)
        set names = put_name_if_absent(names, a_address, name)
        set i = i + 1
      end
    end
  end
  NameMaps { methods: methods, names: names }
end

function count_matching_methods(a: a list of Method, b: a list of Method, maps: NameMaps): a list of integer
  intent: return result
  mutable agree: integer = 0
  mutable disagree: integer = 0
  mutable absent: integer = 0
  mutable i: integer = 0
  while i < length(a) do
    let left: Method = unwrap_or(get(a, i), Method { rva: 0, owner: "", declaration: "" })
    let right: Method = unwrap_or(get(b, i), Method { rva: 0, owner: "", declaration: "" })
    if not has_key(maps.methods, left.rva) then
      set absent = absent + 1
    else if get(maps.methods, left.rva) == right.rva then
      set agree = agree + 1
    else
      set disagree = disagree + 1
    end
    set i = i + 1
  end
  [agree, disagree, absent]
end

function declaration_difference_stats(a: a list of Method, b: a list of Method): a list of integer
  intent: return result
  mutable i: integer = 0
  mutable found: integer = -1
  mutable count: integer = 0
  while i < length(a) do
    let left: Method = unwrap_or(get(a, i), Method { rva: 0, owner: "", declaration: "" })
    let right: Method = unwrap_or(get(b, i), Method { rva: 0, owner: "", declaration: "" })
    if left.owner != right.owner or left.declaration != right.declaration then
      set count = count + 1
      if found < 0 then
        set found = i
      end
    end
    set i = i + 1
  end
  [count, found]
end

function cmd_verify(a_directory: text, b_directory: text): nothing
  intent: return result
  let maps: NameMaps = name_map(a_directory, b_directory)
  print("[*] name map: " ++ to_text(length(keys(maps.methods))) ++ " methods (generics included)")
  let a: a list of Method = parse_methods(dump_path(a_directory, "dump.cs"))
  let b: a list of Method = parse_methods(dump_path(b_directory, "dump.cs"))
  if length(a) != length(b) then
    print("[!] dump.cs method counts differ (" ++ to_text(length(a)) ++ " vs " ++ to_text(length(b)) ++ ")")
    exit_process(1)
  end
  let differences: a list of integer = declaration_difference_stats(a, b)
  if get(differences, 0) > 0 then
    print("[!] " ++ to_text(get(differences, 0)) ++ " dump.cs declarations differ; first at index " ++ to_text(get(differences, 1)))
    exit_process(1)
  end
  print("[*] dump.cs positional map: " ++ to_text(length(a)) ++ " methods, all declarations match")
  let counts: a list of integer = count_matching_methods(a, b, maps)
  print("[*] cross-check: " ++ to_text(get(counts, 0)) ++ " agree, " ++ to_text(get(counts, 1)) ++ " disagree, " ++ to_text(get(counts, 2)) ++ " absent from the name map")
  if get(counts, 1) > 0 then
    print("[!] the two mappings disagree; do not trust either")
    exit_process(1)
  end
  print("[+] both mappings agree")
end

function preceding_start(starts: a list of integer, address: integer): integer
  intent: return result
  mutable low: integer = 0
  mutable high: integer = length(starts)
  while low < high do
    let middle: integer = floor((low + high) / 2)
    if unwrap_or(get(starts, middle), 0) <= address then
      set low = middle + 1
    else
      set high = middle
    end
  end
  low - 1
end

function sorted_integers(values: a list of integer): a list of integer
  intent: return result
  mutable sorted: a list of integer = []
  for value in values do
    mutable next: a list of integer = []
    mutable inserted: boolean = false
    for existing in sorted do
      if not inserted and value < existing then
        set next = append(next, value)
        set inserted = true
      end
      set next = append(next, existing)
    end
    if not inserted then
      set next = append(next, value)
    end
    set sorted = next
  end
  sorted
end

function print_method_match(query: text, address: integer, start: integer, maps: NameMaps): nothing
  intent: return result
  let target: integer = get(maps.methods, start)
  let name: text = get(maps.names, start)
  if address == start then
    print("arm64 " ++ query ++ " -> armv7 0x" ++ to_hex_upper(target) ++ "\n    " ++ name)
  else
    let delta: integer = address - start
    print("arm64 " ++ query ++ " -> armv7 0x" ++ to_hex_upper(target) ++ " (+0x" ++ to_hex_upper(delta) ++ " into the function)\n    " ++ name)
  end
end

function cmd_method(a_directory: text, b_directory: text, queries: a list of text): nothing
  intent: return result
  let maps: NameMaps = name_map(a_directory, b_directory)
  let starts: a list of integer = sorted_integers(keys(maps.methods))
  for query in queries do
    let address: integer = parse_hex(query)
    if has_key(maps.methods, address) then
      print_method_match(query, address, address, maps)
    else
      let index: integer = preceding_start(starts, address)
      if index < 0 then
        print("arm64 " ++ query ++ ": no match")
      else
        let start: integer = unwrap_or(get(starts, index), 0)
        let delta: integer = address - start
        if delta > 16384 then
          print("arm64 " ++ query ++ ": no match (nearest symbol is 0x" ++ to_hex_upper(delta) ++ " back; treating as unmapped rather than guessing)")
        else
          print_method_match(query, address, start, maps)
        end
      end
    end
  end
end

function cmd_fields(a_directory: text, b_directory: text, types: a list of text): nothing
  intent: return result
  let a_dump: text = dump_path(a_directory, "dump.cs")
  let b_dump: text = dump_path(b_directory, "dump.cs")
  for wanted in types do
    let a_fields: a list of Field = parse_fields(a_dump, wanted)
    let b_fields: a list of Field = parse_fields(b_dump, wanted)
    if length(a_fields) == 0 then
      print("[!] type " ++ wanted ++ " not found")
    else if length(a_fields) != length(b_fields) then
      print("[!] " ++ wanted ++ ": field counts differ (" ++ to_text(length(a_fields)) ++ " vs " ++ to_text(length(b_fields)) ++ ")")
    else
      print("=== " ++ wanted)
      mutable i: integer = 0
      while i < length(a_fields) do
        let left: Field = unwrap_or(get(a_fields, i), Field { declaration: "", offset: 0 })
        let right: Field = unwrap_or(get(b_fields, i), Field { declaration: "", offset: 0 })
        print("    arm64 0x" ++ pad_right(to_hex_upper(left.offset), 5) ++ " -> armv7 0x" ++ pad_right(to_hex_upper(right.offset), 5) ++ "  " ++ left.declaration)
        set i = i + 1
      end
    end
  end
end

function tail(arguments: a list of text, start: integer): a list of text
  intent: return result
  mutable out: a list of text = []
  mutable i: integer = start
  while i < length(arguments) do
    set out = append(out, unwrap_or(get(arguments, i), ""))
    set i = i + 1
  end
  out
end

function main(): nothing
  intent: return result
  let arguments: a list of text = get_args()
  if length(arguments) < 4 then
    print("usage: legible run patches/abi_map.lbl <a64_dir> <v7_dir> <verify|method|fields> ...")
    exit_process(1)
  end
  let a_directory: text = unwrap_or(get(arguments, 1), "")
  let b_directory: text = unwrap_or(get(arguments, 2), "")
  let mode: text = unwrap_or(get(arguments, 3), "")
  if mode == "verify" then
    cmd_verify(a_directory, b_directory)
  else if mode == "method" then
    cmd_method(a_directory, b_directory, tail(arguments, 4))
  else if mode == "fields" then
    cmd_fields(a_directory, b_directory, tail(arguments, 4))
  else
    print("usage: legible run patches/abi_map.lbl <a64_dir> <v7_dir> <verify|method|fields> ...")
    exit_process(1)
  end
end
