function armv7_sites_second(): a list of Site
  intent: return the second half of the armv7_sites patch sites
  [
    Site { offset: 11832648, patch: bytes_concat(bytes_from_hex("0000a0e3"), bytes_from_hex("1eff2fe1")), name: "LevelLockWidget.get_Locked -> false (game modes never padlocked by profile level)" }, -- 0xB48D48
    Site { offset: 11836396, patch: bytes_concat(bytes_from_hex("0000a0e3"), bytes_from_hex("1eff2fe1")), name: "LevelLockManager.IsLocked -> false (every lock ID reports unlocked)" }, -- 0xB49BEC
    Site { offset: 11836620, patch: bytes_concat(bytes_from_hex("0000a0e3"), bytes_from_hex("1eff2fe1")), name: "LevelLockManager.GetMinLevel -> 0 (lock tooltips have no level requirement)" }, -- 0xB49CCC
    Site { offset: 11943044, patch: bytes_concat(bytes_from_hex("0000a0e3"), bytes_from_hex("1eff2fe1")), name: "PVPRaidFlow.IsLevelLocked -> false (Raids entry gate)" }, -- 0xB63C84
    Site { offset: 12808412, patch: bytes_concat(bytes_from_hex("0100a0e3"), bytes_from_hex("1eff2fe1")), name: "AvXModeButtonData.IsInAlliance -> true (AvE tile is usable without a real alliance)" }, -- 0xC370DC
