    Site { offset: 8011440, patch: bytes_from_hex("400000ea"), name: "BCGBlueprintBase.get_SynergyBonuses -> skip the null throw and return the fresh empty list" } -- 0x7A3EB0: b 0x7A3FB8
  ]
