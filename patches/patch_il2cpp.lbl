  intent: return the first half of the armv7_sites patch sites
  [
    Site { offset: 15919104, patch: bytes_concat(bytes_from_hex("0100a0e3"), bytes_from_hex("1eff2fe1")), name: "TcpClientSSL.CertificateValidation -> true" }, -- 0xF2E800
    Site { offset: 19285720, patch: bytes_from_hex("1eff2fe1"), name: "TcpClientBouncy.NotifyServerCertificate -> noop" }, -- 0x12646D8
