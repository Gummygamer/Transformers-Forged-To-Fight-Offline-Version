-- Patch libil2cpp.so to get past the dead-server checks, for either shipped ABI.
-- Native patcher implementation.

record Site
  offset: integer
  patch: integer
  name: text
end

record Section
  index: integer
  kind: integer
  offset: integer
  size: integer
  link: integer
  entsize: integer
end

record Symbol
  index: integer
  entry_offset: integer
  name_offset: integer
  value: integer
  size: integer
  kind: integer
  section: integer
end

record SectionsResult
  error: text
  sections: a list of Section
end

record StringResult
  error: text
  value: text
end

record InplaceResult
  error: text
  changed: boolean
end

record ContextResult
  error: text
  dynsym: Section
  dynamic: Section
  dynstr: Section
  str_start: integer
  str_limit: integer
  dynamic_end: integer
end

record BoolResult
  error: text
  value: boolean
end

record SymbolsResult
  error: text
  donor: Symbol
  alias: Symbol
  has_donor: boolean
  has_alias: boolean
end

record ErrorResult
  error: text
end

record OffsetResult
  error: text
  offset: integer
end

record ParsedArguments
  valid: boolean
  so: text
  abi: text
  apply: boolean
  needed: text
  out: text
  has_out: boolean
end

function to_hex_upper(number: integer): text
  intent: format hexadecimal text
  if number == 0 then
    "0"
  else
    mutable value: integer = number
    mutable out: text = ""
    while value > 0 do
      let digit: integer = value % 16
      let ch: text = substring("0123456789ABCDEF", digit, 1)
      set out = ch ++ out
      set value = floor(value / 16)
    end
    out
  end
end

function pad_right(value: text, width: integer): text
  intent: pad text right
  mutable out: text = value
  while text_length(out) < width do
    set out = out ++ " "
  end
  out
end

function print_disassembly(instructions: a list of a mapping from text to text): nothing
  intent: print disassembly address mnemonic operand
  for instruction in instructions do
    let address: integer = unwrap_or(get(instruction, "address"), 0)
    let mnemonic: text = unwrap_or(get(instruction, "mnemonic"), "")
    let operand: text = unwrap_or(get(instruction, "op_str"), "")
    print("    0x" ++ to_hex_upper(address) ++ ": " ++ pad_right(mnemonic, 8) ++ " " ++ operand)
  end
end

function print_before_arm64(blob: integer, offset: integer): nothing
  intent: return result
  let instructions: a list of a mapping from text to text = disasm_arm64(blob, offset, 20, offset)
  for instruction in instructions do
    let address: integer = unwrap_or(get(instruction, "address"), 0)
    let mnemonic: text = unwrap_or(get(instruction, "mnemonic"), "")
    let operand: text = unwrap_or(get(instruction, "op_str"), "")
    print("    0x" ++ to_hex_upper(address) ++ ": " ++ pad_right(mnemonic, 8) ++ " " ++ operand)
    if address >= offset + 16 then
      return
    end
  end
end

function print_before_arm32(blob: integer, offset: integer): nothing
  intent: return result
  let instructions: a list of a mapping from text to text = disasm_arm32(blob, offset, 20, offset)
  for instruction in instructions do
    let address: integer = unwrap_or(get(instruction, "address"), 0)
    let mnemonic: text = unwrap_or(get(instruction, "mnemonic"), "")
    let operand: text = unwrap_or(get(instruction, "op_str"), "")
    print("    0x" ++ to_hex_upper(address) ++ ": " ++ pad_right(mnemonic, 8) ++ " " ++ operand)
    if address >= offset + 16 then
      return
    end
  end
end

