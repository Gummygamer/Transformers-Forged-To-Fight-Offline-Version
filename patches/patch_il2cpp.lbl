-- Patch libil2cpp.so to get past the dead-server checks, for either shipped ABI.
-- Native patcher implementation.

record Site
  offset: integer
  patch: integer
  name: text
end

record Section
  index: integer
  kind: integer
  offset: integer
  size: integer
  link: integer
  entsize: integer
end

record Symbol
  index: integer
  entry_offset: integer
  name_offset: integer
  value: integer
  size: integer
  kind: integer
  section: integer
end

record SectionsResult
  error: text
  sections: a list of Section
end

record StringResult
  error: text
  value: text
end

record InplaceResult
  error: text
  changed: boolean
end

record ContextResult
  error: text
  dynsym: Section
  dynamic: Section
  dynstr: Section
  str_start: integer
  str_limit: integer
  dynamic_end: integer
end

record BoolResult
  error: text
  value: boolean
end

record SymbolsResult
  error: text
  donor: Symbol
  alias: Symbol
  has_donor: boolean
  has_alias: boolean
end

record ErrorResult
  error: text
end

record OffsetResult
  error: text
  offset: integer
end

record ParsedArguments
  valid: boolean
  so: text
  abi: text
  apply: boolean
  needed: text
  out: text
  has_out: boolean
end

function to_hex_upper(number: integer): text
  intent: format hexadecimal text
  if number == 0 then
    "0"
  else
    mutable value: integer = number
    mutable out: text = ""
    while value > 0 do
      let digit: integer = value % 16
      let ch: text = substring("0123456789ABCDEF", digit, 1)
      set out = ch ++ out
      set value = floor(value / 16)
    end
    out
  end
end

function pad_right(value: text, width: integer): text
  intent: pad text right
  mutable out: text = value
  while text_length(out) < width do
    set out = out ++ " "
  end
  out
end

function print_disassembly(instructions: a list of a mapping from text to text): nothing
  intent: print disassembly address mnemonic operand
  for instruction in instructions do
    let address: integer = unwrap_or(get(instruction, "address"), 0)
    let mnemonic: text = unwrap_or(get(instruction, "mnemonic"), "")
    let operand: text = unwrap_or(get(instruction, "op_str"), "")
    print("    0x" ++ to_hex_upper(address) ++ ": " ++ pad_right(mnemonic, 8) ++ " " ++ operand)
  end
end

function print_before_arm64(blob: integer, offset: integer): nothing
  intent: return result
  let instructions: a list of a mapping from text to text = disasm_arm64(blob, offset, 20, offset)
  for instruction in instructions do
    let address: integer = unwrap_or(get(instruction, "address"), 0)
    let mnemonic: text = unwrap_or(get(instruction, "mnemonic"), "")
    let operand: text = unwrap_or(get(instruction, "op_str"), "")
    print("    0x" ++ to_hex_upper(address) ++ ": " ++ pad_right(mnemonic, 8) ++ " " ++ operand)
    if address >= offset + 16 then
      return
    end
  end
end

function print_before_arm32(blob: integer, offset: integer): nothing
  intent: return result
  let instructions: a list of a mapping from text to text = disasm_arm32(blob, offset, 20, offset)
  for instruction in instructions do
    let address: integer = unwrap_or(get(instruction, "address"), 0)
    let mnemonic: text = unwrap_or(get(instruction, "mnemonic"), "")
    let operand: text = unwrap_or(get(instruction, "op_str"), "")
    print("    0x" ++ to_hex_upper(address) ++ ": " ++ pad_right(mnemonic, 8) ++ " " ++ operand)
    if address >= offset + 16 then
      return
    end
  end
end

function arm64_sites_first(): a list of Site
  intent: return the first half of the arm64_sites patch sites
  [
    Site { offset: 19113788, patch: bytes_concat(bytes_from_hex("20008052"), bytes_from_hex("c0035fd6")), name: "TcpClientSSL.CertificateValidation -> true" }, -- 0x123A73C
    Site { offset: 21940544, patch: bytes_from_hex("c0035fd6"), name: "TcpClientBouncy.NotifyServerCertificate -> noop" }, -- 0x14EC940
    Site { offset: 16523700, patch: bytes_from_hex("09000014"), name: "Hub.InitializeComponents -> register managers past OTAConfig gate" }, -- 0xFC21B4
    Site { offset: 23246480, patch: bytes_from_hex("1f2003d5"), name: "LoginManager._PostInit -> skip 'no valid authenticators' fail on Count==0" }, -- 0x162B690
    Site { offset: 16529176, patch: bytes_from_hex("1f2003d5"), name: "Hub.SubSystemConnecting -> skip FatalError on subsystem error-state 3" }, -- 0xFC3718
    Site { offset: 19056256, patch: bytes_from_hex("c0035fd6"), name: "SubSystem.FatalError -> ret instead of tail-call Hub.FatalError (silence subsystem fatals)" }, -- 0x122C680
    Site { offset: 28599028, patch: bytes_concat(bytes_from_hex("40008052"), bytes_from_hex("c0035fd6")), name: "Application.internetReachability -> ReachableViaLocalAreaNetwork (bundled loopback server needs no Wi-Fi AP)" }, -- 0x1B462F4
    Site { offset: 20135496, patch: bytes_concat(bytes_from_hex("20008052"), bytes_from_hex("c0035fd6")), name: "EndPoint.HasInternetConnectivity -> true (bundled loopback server needs no Wi-Fi AP)" } -- 0x1333E48
  ]
end

function arm64_sites_second(): a list of Site
  intent: return the second half of the arm64_sites patch sites
  [
    Site { offset: 15779872, patch: bytes_concat(bytes_from_hex("00008052"), bytes_from_hex("c0035fd6")), name: "LevelLockWidget.get_Locked -> false (game modes never padlocked by profile level)" }, -- 0xF0C820
    Site { offset: 15782864, patch: bytes_concat(bytes_from_hex("00008052"), bytes_from_hex("c0035fd6")), name: "LevelLockManager.IsLocked -> false (every lock ID reports unlocked)" }, -- 0xF0D3D0
    Site { offset: 15783048, patch: bytes_concat(bytes_from_hex("00008052"), bytes_from_hex("c0035fd6")), name: "LevelLockManager.GetMinLevel -> 0 (lock tooltips have no level requirement)" }, -- 0xF0D488
    Site { offset: 15868548, patch: bytes_concat(bytes_from_hex("00008052"), bytes_from_hex("c0035fd6")), name: "PVPRaidFlow.IsLevelLocked -> false (Raids entry gate)" }, -- 0xF22284
    Site { offset: 16569924, patch: bytes_concat(bytes_from_hex("20008052"), bytes_from_hex("c0035fd6")), name: "AvXModeButtonData.IsInAlliance -> true (AvE tile is usable without a real alliance)" }, -- 0xFCD644
    Site { offset: 15373560, patch: bytes_from_hex("1f2003d5"), name: "FightLandingModel.ProcessAvxModeClick -> skip null-alliance branch (open AvE difficulty selection)" }, -- 0xEA94F8
    Site { offset: 16567012, patch: bytes_concat(bytes_from_hex("20008052"), bytes_from_hex("c0035fd6")), name: "AvEEvent.IsAvailable -> true (keep the supplied offline AvE event out of the no-events empty state)" }, -- 0xFCCAE4
    Site { offset: 12677752, patch: bytes_from_hex("400600b4"), name: "BCGBlueprintBase.get_SynergyBonuses -> return the fresh empty list when offline synergy data is null" } -- 0xC17278: cbz x0, 0xC17340
  ]
end

public function arm64_sites(): a list of Site
  intent: return arm64 patch sites
  concat(arm64_sites_first(), arm64_sites_second())
end

