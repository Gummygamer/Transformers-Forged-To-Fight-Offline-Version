public function armv7_sites(): a list of Site
  intent: return armv7 patch sites
  concat(armv7_sites_first(), armv7_sites_second())
end

function print_sites(blob: integer, sites: a list of Site, abi: text, apply: boolean): nothing
  intent: print patch sites and optionally apply bytes
  for site in sites do
    print("=== 0x" ++ to_hex_upper(site.offset) ++ "  " ++ site.name)
    print("  BEFORE:")
    if abi == "arm64-v8a" then
      print_before_arm64(blob, site.offset)
    else
      print_before_arm32(blob, site.offset)
    end
    if apply then
      bytes_write_bytes(blob, site.offset, site.patch)
      print("  AFTER:")
      if abi == "arm64-v8a" then
        print_disassembly(disasm_arm64(blob, site.offset, bytes_length(site.patch), site.offset))
      else
        print_disassembly(disasm_arm32(blob, site.offset, bytes_length(site.patch), site.offset))
      end
    end
    print("")
  end
end

function inject_needed_bytes(blob: integer): nothing
  intent: return result
  bytes_write_bytes(blob, 8204340, bytes_from_text("libdothook.so")) -- 0x7D3034
  bytes_set(blob, 45781592, 1) -- 0x2BA9258
  bytes_write_bytes(blob, 45781600, bytes_from_hex("5cfe7b")) -- 0x2BA9260
end

function elf32_header_valid(blob: integer): boolean
  intent: check the ELF32 little-endian identification bytes
  bytes_length(blob) >= 52 and bytes_get(blob, 0) == 127 and bytes_get(blob, 1) == 69 and bytes_get(blob, 2) == 76 and bytes_get(blob, 3) == 70 and bytes_get(blob, 4) == 1 and bytes_get(blob, 5) == 1
end

function read_section(blob: integer, shoff: integer, shentsize: integer, index: integer): Section
  intent: read one ELF32 section header
  let offset: integer = shoff + index * shentsize
  Section { index: index, kind: bytes_read_u32_le(blob, offset + 4), offset: bytes_read_u32_le(blob, offset + 16), size: bytes_read_u32_le(blob, offset + 20), link: bytes_read_u32_le(blob, offset + 24), entsize: bytes_read_u32_le(blob, offset + 36) }
end

function elf32_sections(blob: integer): SectionsResult
  intent: read elf32 section headers
  if not elf32_header_valid(blob) then
    SectionsResult { error: "in-place dependency injection needs a little-endian ELF32 library", sections: [] }
  else
    let shoff: integer = bytes_read_u32_le(blob, 32)
    let shentsize: integer = bytes_read_u16_le(blob, 46)
    let shnum: integer = bytes_read_u16_le(blob, 48)
    if shentsize < 40 or shoff == 0 or shnum == 0 then
      SectionsResult { error: "ELF32 section headers are missing", sections: [] }
    else if shoff + shentsize * shnum > bytes_length(blob) then
      SectionsResult { error: "ELF32 section header table is outside the file", sections: [] }
    else
      mutable sections: a list of Section = []
      mutable index: integer = 0
      while index < shnum do
        set sections = append(sections, read_section(blob, shoff, shentsize, index))
        set index = index + 1
      end
      SectionsResult { error: "", sections: sections }
    end
  end
end

function elf_cstring(blob: integer, start: integer, limit: integer): StringResult
  intent: read a null terminated elf string
  if start < 0 or start >= limit or limit > bytes_length(blob) then
    StringResult { error: "ELF string offset is outside the file", value: "" }
  else
    mutable end_at: integer = start
    while end_at < limit and bytes_get(blob, end_at) != 0 do
      set end_at = end_at + 1
    end
    if end_at >= limit then
      StringResult { error: "unterminated ELF string", value: "" }
    else
      StringResult { error: "", value: bytes_to_text(bytes_slice(blob, start, end_at - start)) }
    end
  end
end

function empty_section(): Section
  intent: return an empty section
  Section { index: 0, kind: 0, offset: 0, size: 0, link: 0, entsize: 0 }
end

function empty_symbol(): Symbol
  intent: return an empty symbol
  Symbol { index: 0, entry_offset: 0, name_offset: 0, value: 0, size: 0, kind: 0, section: 0 }
end

function context_failure(message: text): ContextResult
  intent: build a failed context result
  ContextResult { error: message, dynsym: empty_section(), dynamic: empty_section(), dynstr: empty_section(), str_start: 0, str_limit: 0, dynamic_end: 0 }
end

function elf_context(blob: integer): ContextResult
  intent: validate elf dynamic sections
  let result: SectionsResult = elf32_sections(blob)
  mutable dynsym: Section = empty_section()
  mutable dynamic: Section = empty_section()
  mutable dynsym_count: integer = 0
  mutable dynamic_count: integer = 0
  for section in result.sections do
    if section.kind == 11 then
      set dynsym = section
      set dynsym_count = dynsym_count + 1
    else if section.kind == 6 then
      set dynamic = section
      set dynamic_count = dynamic_count + 1
    end
  end
  if result.error != "" then
    context_failure(result.error)
  else if dynsym_count != 1 or dynamic_count != 1 then
    context_failure("expected exactly one ELF32 .dynsym and .dynamic section")
  else if dynsym.entsize != 16 or dynamic.entsize != 8 then
    context_failure("unexpected ELF32 dynamic table entry size")
  else if dynsym.link < 0 or dynsym.link >= length(result.sections) then
    context_failure("ELF32 .dynsym has an invalid string-table link")
  else
    let dynstr: Section = unwrap_or(get(result.sections, dynsym.link), empty_section())
    let limit: integer = dynstr.offset + dynstr.size
    if limit > bytes_length(blob) then context_failure("ELF32 dynamic string table is outside the file") else ContextResult { error: "", dynsym: dynsym, dynamic: dynamic, dynstr: dynstr, str_start: dynstr.offset, str_limit: limit, dynamic_end: dynamic.offset + dynamic.size } end
  end
end

record NeededStep
  error: text
  found: boolean
  stop: boolean
end

function needed_step(blob: integer, context: ContextResult, offset: integer): NeededStep
  intent: inspect one dynamic table entry for the needed dependency
  if offset + 8 > bytes_length(blob) then
    NeededStep { error: "ELF32 dynamic table is outside the file", found: false, stop: false }
  else
    let tag: integer = bytes_read_u32_le(blob, offset)
    let value: integer = bytes_read_u32_le(blob, offset + 4)
    if tag == 0 then
      NeededStep { error: "", found: false, stop: true }
    else if tag == 1 and value >= context.dynstr.size then
      NeededStep { error: "ELF32 DT_NEEDED string is outside .dynstr", found: false, stop: false }
    else if tag == 1 then
      let text_result: StringResult = elf_cstring(blob, context.str_start + value, context.str_limit)
      NeededStep { error: text_result.error, found: text_result.error == "" and text_result.value == "libdothook.so", stop: false }
    else
      NeededStep { error: "", found: false, stop: false }
    end
  end
end

function needed_present(blob: integer, context: ContextResult): BoolResult
  intent: find existing needed dependency
  mutable offset: integer = context.dynamic.offset
  mutable error: text = ""
  mutable found: boolean = false
  while offset < context.dynamic_end and error == "" and not found do
    let step: NeededStep = needed_step(blob, context, offset)
    set error = step.error
    set found = step.found
    if step.stop then set offset = context.dynamic_end end
    set offset = offset + context.dynamic.entsize
  end
  BoolResult { error: error, value: found }
end

function symbol_at(blob: integer, offset: integer, index: integer): Symbol
  intent: read a dynamic symbol
  Symbol { index: index, entry_offset: offset, name_offset: bytes_read_u32_le(blob, offset), value: bytes_read_u32_le(blob, offset + 4), size: bytes_read_u32_le(blob, offset + 8), kind: bit_and(bytes_get(blob, offset + 12), 15), section: bytes_read_u16_le(blob, offset + 14) }
end

function find_alias_symbols(blob: integer, context: ContextResult): SymbolsResult
  intent: find armv7 alias symbols
  mutable donor: Symbol = empty_symbol()
  mutable alias: Symbol = empty_symbol()
  mutable has_donor: boolean = false
  mutable has_alias: boolean = false
  mutable error: text = ""
  mutable index: integer = 0
  while index < floor(context.dynsym.size / context.dynsym.entsize) and error == "" do
    let offset: integer = context.dynsym.offset + index * context.dynsym.entsize
    if offset + 16 > bytes_length(blob) then
      set error = "ELF32 dynamic symbol table is outside the file"
    else
      let symbol: Symbol = symbol_at(blob, offset, index)
      if symbol.name_offset >= context.dynstr.size then
        set error = "ELF32 dynamic symbol name is outside .dynstr"
      else
        let text_result: StringResult = elf_cstring(blob, context.str_start + symbol.name_offset, context.str_limit)
        if text_result.error != "" then
          set error = text_result.error
        else if text_result.value == "__floatundidf" then
          set donor = symbol
          set has_donor = true
        else if text_result.value == "__aeabi_ul2d" then
          set alias = symbol
          set has_alias = true
        end
      end
    end
    set index = index + 1
  end
  SymbolsResult { error: error, donor: donor, alias: alias, has_donor: has_donor, has_alias: has_alias }
end

function relocation_table_error(blob: integer, relocation: Section, entry_size: integer, donor: Symbol): text
  intent: scan one relocation table for references to the donor alias
  mutable error: text = ""
  mutable offset: integer = relocation.offset
  while offset < relocation.offset + relocation.size and error == "" do
    if offset + entry_size > bytes_length(blob) then
      set error = "ELF32 relocation table is outside the file"
    else if shift_right_unsigned(bytes_read_u32_le(blob, offset + 4), 8) == donor.index then
      set error = "the ARMv7 donor alias is referenced by a relocation"
    end
    set offset = offset + entry_size
  end
  error
end

function section_relocation_error(blob: integer, relocation: Section, donor: Symbol): text
  intent: validate one relocation section
  let expected: integer = if relocation.kind == 4 then 12 else 8 end
  let entry_size: integer = if relocation.entsize == 0 then expected else relocation.entsize end
  if entry_size != expected then "unexpected ELF32 relocation entry size" else relocation_table_error(blob, relocation, entry_size, donor) end
end

function relocation_error(blob: integer, sections: a list of Section, donor: Symbol): ErrorResult
  intent: validate donor relocations
  mutable error: text = ""
  for relocation in sections do
    if (relocation.kind == 4 or relocation.kind == 9) and error == "" then
      set error = section_relocation_error(blob, relocation, donor)
    end
  end
  ErrorResult { error: error }
end

function first_null_entry(blob: integer, context: ContextResult): OffsetResult
  intent: find spare dynamic null entry
  mutable offset: integer = context.dynamic.offset
  mutable first_null: integer = -1
  mutable error: text = ""
  while offset < context.dynamic_end and first_null < 0 and error == "" do
    if offset + 8 > bytes_length(blob) then
      set error = "ELF32 dynamic table is outside the file"
    else if bytes_read_u32_le(blob, offset) == 0 then
      set first_null = offset
    end
    set offset = offset + context.dynamic.entsize
  end
  if error != "" then OffsetResult { error: error, offset: -1 } else if first_null < 0 or first_null + 16 > context.dynamic_end then OffsetResult { error: "ELF32 .dynamic has no spare entry for DT_NEEDED", offset: -1 } else if bytes_read_u32_le(blob, first_null + 8) != 0 or bytes_read_u32_le(blob, first_null + 12) != 0 then OffsetResult { error: "ELF32 .dynamic has no terminating DT_NULL after the spare entry", offset: -1 } else OffsetResult { error: "", offset: first_null } end
end

function finish_inplace(blob: integer, context: ContextResult, donor: Symbol, alias: Symbol): InplaceResult
  intent: validate and write inplace dependency
  let old_slot: integer = context.str_start + donor.name_offset
  let old_name: StringResult = elf_cstring(blob, old_slot, context.str_limit)
  if old_name.error != "" then
    InplaceResult { error: old_name.error, changed: false }
  else if old_name.value != "__floatundidf" then
    InplaceResult { error: "ARMv7 donor string changed unexpectedly", changed: false }
  else if text_length("libdothook.so") > text_length("__floatundidf") then
    InplaceResult { error: "ARMv7 donor string slot is too short", changed: false }
  else
    let first_null: OffsetResult = first_null_entry(blob, context)
    if first_null.error != "" then
      InplaceResult { error: first_null.error, changed: false }
    else
      bytes_write_u32_le(blob, donor.entry_offset, alias.name_offset)
      bytes_write_bytes(blob, old_slot, bytes_from_text("libdothook.so"))
      bytes_set(blob, old_slot + text_length("libdothook.so"), 0)
      bytes_write_u32_le(blob, first_null.offset, 1)
      bytes_write_u32_le(blob, first_null.offset + 4, donor.name_offset)
      InplaceResult { error: "", changed: true }
    end
  end
end

function alias_symbols_error(symbols: SymbolsResult): text
  intent: validate the armv7 alias symbols
  if symbols.error != "" then
    symbols.error
  else if not symbols.has_donor or not symbols.has_alias then
    "expected ARMv7 alias symbols were not found; is this the 9.2.0 library?"
  else if symbols.donor.value != symbols.alias.value or symbols.donor.size != symbols.alias.size or symbols.donor.kind != symbols.alias.kind or symbols.donor.section != symbols.alias.section or symbols.donor.section == 0 then
    "ARMv7 alias symbols no longer describe the same defined function"
  else
    ""
  end
end

function inject_with_symbols(blob: integer, context: ContextResult, symbols: SymbolsResult): InplaceResult
  intent: inject the dependency once the alias symbols are validated
  let symbol_error: text = alias_symbols_error(symbols)
  if symbol_error != "" then
    InplaceResult { error: symbol_error, changed: false }
  else
    let relocation: ErrorResult = relocation_error(blob, elf32_sections(blob).sections, symbols.donor)
    if relocation.error != "" then InplaceResult { error: relocation.error, changed: false } else finish_inplace(blob, context, symbols.donor, symbols.alias) end
  end
end

function inject_needed_armv7_inplace(blob: integer): InplaceResult
  intent: inject armv7 dependency without layout change
  let context: ContextResult = elf_context(blob)
  if context.error != "" then
    InplaceResult { error: context.error, changed: false }
  else
    let existing: BoolResult = needed_present(blob, context)
    if existing.error != "" then
      InplaceResult { error: existing.error, changed: false }
    else if existing.value then
      InplaceResult { error: "", changed: false }
    else
      inject_with_symbols(blob, context, find_alias_symbols(blob, context))
    end
  end
end

function usage(): nothing
  intent: print patcher usage
  print("[!] usage: legible run patches/patch_il2cpp.lbl [so] [--abi arm64-v8a|armeabi-v7a] [--apply] [--needed byte|inplace|patchelf|none] [-o path]")
  exit_process(1)
end

function shell_quote(value: text): text
  intent: return result
  "'" ++ replace(value, "'", "'\"'\"'") ++ "'"
end

record ParseCursor
  parsed: ParsedArguments
  has_so: boolean
  index: integer
end

function with_abi(p: ParsedArguments, abi: text): ParsedArguments
  intent: return the arguments with a new abi
  ParsedArguments { valid: p.valid, so: p.so, abi: abi, apply: p.apply, needed: p.needed, out: p.out, has_out: p.has_out }
end

function with_apply(p: ParsedArguments): ParsedArguments
  intent: return the arguments with apply enabled
  ParsedArguments { valid: p.valid, so: p.so, abi: p.abi, apply: true, needed: p.needed, out: p.out, has_out: p.has_out }
end

function with_needed(p: ParsedArguments, needed: text): ParsedArguments
  intent: return the arguments with a new needed strategy
  ParsedArguments { valid: p.valid, so: p.so, abi: p.abi, apply: p.apply, needed: needed, out: p.out, has_out: p.has_out }
end

function with_out(p: ParsedArguments, out: text): ParsedArguments
  intent: return the arguments with an output path
  ParsedArguments { valid: p.valid, so: p.so, abi: p.abi, apply: p.apply, needed: p.needed, out: out, has_out: true }
end

function with_invalid(p: ParsedArguments): ParsedArguments
  intent: return the arguments marked invalid
  ParsedArguments { valid: false, so: p.so, abi: p.abi, apply: p.apply, needed: p.needed, out: p.out, has_out: p.has_out }
end

function with_so(p: ParsedArguments, so: text): ParsedArguments
  intent: return the arguments with a library path
  ParsedArguments { valid: p.valid, so: so, abi: p.abi, apply: p.apply, needed: p.needed, out: p.out, has_out: p.has_out }
end

function scan_argument(arguments: a list of text, cursor: ParseCursor): ParseCursor
  intent: consume one command line argument
  let argument: text = unwrap_or(get(arguments, cursor.index), "")
  let value: text = unwrap_or(get(arguments, cursor.index + 1), "")
  let parsed: ParsedArguments = cursor.parsed
  if argument == "--abi" then
    ParseCursor { parsed: with_abi(parsed, value), has_so: cursor.has_so, index: cursor.index + 2 }
  else if argument == "--apply" then
    ParseCursor { parsed: with_apply(parsed), has_so: cursor.has_so, index: cursor.index + 1 }
  else if argument == "--needed" then
    ParseCursor { parsed: with_needed(parsed, value), has_so: cursor.has_so, index: cursor.index + 2 }
  else if argument == "-o" or argument == "--out" then
    ParseCursor { parsed: with_out(parsed, value), has_so: cursor.has_so, index: cursor.index + 2 }
  else if starts_with(argument, "-") or cursor.has_so then
    ParseCursor { parsed: with_invalid(parsed), has_so: cursor.has_so, index: cursor.index + 1 }
  else
    ParseCursor { parsed: with_so(parsed, argument), has_so: true, index: cursor.index + 1 }
  end
end

function parse_arguments(arguments: a list of text): ParsedArguments
  intent: parse patcher arguments
  mutable cursor: ParseCursor = ParseCursor { parsed: ParsedArguments { valid: true, so: "extracted/lib/arm64-v8a/libil2cpp.so", abi: "arm64-v8a", apply: false, needed: "", out: "", has_out: false }, has_so: false, index: 1 }
  while cursor.index < length(arguments) do set cursor = scan_argument(arguments, cursor) end
  let parsed: ParsedArguments = cursor.parsed
  let abi_valid: boolean = parsed.abi == "arm64-v8a" or parsed.abi == "armeabi-v7a"
  let needed_valid: boolean = parsed.needed == "" or parsed.needed == "byte" or parsed.needed == "inplace" or parsed.needed == "patchelf" or parsed.needed == "none"
  ParsedArguments { valid: parsed.valid and abi_valid and needed_valid, so: parsed.so, abi: parsed.abi, apply: parsed.apply, needed: parsed.needed, out: parsed.out, has_out: parsed.has_out }
end

function normalized_arguments(arguments: ParsedArguments): ParsedArguments
  intent: return result
  if arguments.needed != "" then
    arguments
  else if arguments.abi == "arm64-v8a" then
    ParsedArguments { valid: arguments.valid, so: arguments.so, abi: arguments.abi, apply: arguments.apply, needed: "byte", out: arguments.out, has_out: arguments.has_out }
  else
    -- Python selects inplace only on Windows; this Legible port runs on POSIX here.
    ParsedArguments { valid: arguments.valid, so: arguments.so, abi: arguments.abi, apply: arguments.apply, needed: "patchelf", out: arguments.out, has_out: arguments.has_out }
  end
end

function output_path(arguments: ParsedArguments): text
  intent: select patched output path
  if arguments.has_out then arguments.out else if contains_text(arguments.so, ".patched") then arguments.so else replace(arguments.so, ".so", ".patched.so") end
end

function add_needed(blob: integer, needed: text): InplaceResult
  intent: add selected needed entry
  if needed == "byte" then
    inject_needed_bytes(blob)
    print("[+] re-injected DT_NEEDED libdothook.so (byte cave)")
    InplaceResult { error: "", changed: true }
  else if needed == "inplace" then
    let result: InplaceResult = inject_needed_armv7_inplace(blob)
    if result.error != "" then
      print("[!] ARMv7 in-place DT_NEEDED injection failed: " ++ result.error)
      exit_process(1)
    else if result.changed then
      print("[+] added DT_NEEDED libdothook.so (ARMv7 in-place, no layout shift)")
    else
      print("[i] DT_NEEDED libdothook.so already present")
    end
    result
  else
    InplaceResult { error: "", changed: false }
  end
end

function finish_output(blob: integer, path: text, needed: text): nothing
  intent: return result
  write_file_bytes(path, blob)
  if needed == "patchelf" then
    if get(shell_exec("command -v patchelf"), "exit_code") != 0 then
      print("[!] patchelf not found on PATH; install it or, for the pristine 9.2.0 ARMv7 library, pass --needed inplace")
      exit_process(1)
    else if get(shell_exec("patchelf --add-needed libdothook.so " ++ shell_quote(path)), "exit_code") != 0 then
      print("[!] patchelf failed")
      exit_process(1)
    else
      print("[+] added DT_NEEDED libdothook.so (patchelf)")
    end
  else if needed == "none" then
    print("[!] no DT_NEEDED entry added; the runtime hook will NOT load")
  end
  print("[+] wrote " ++ path)
end

function main(): nothing
  intent: patch il2cpp library bytes and dependencies
  let parsed: ParsedArguments = normalized_arguments(parse_arguments(get_args()))
  if not parsed.valid then
    usage()
  else if parsed.needed == "byte" and parsed.abi != "arm64-v8a" then
    print("[!] --needed byte is arm64-only (the cave offsets are specific to that binary)")
    exit_process(1)
  else if parsed.needed == "inplace" and parsed.abi != "armeabi-v7a" then
    print("[!] --needed inplace is armeabi-v7a-only")
    exit_process(1)
  else
    let blob: integer = read_file_bytes(parsed.so)
    let apply_text: text = if parsed.apply then "True" else "False" end
    print("[*] " ++ parsed.so ++ " (" ++ to_text(bytes_length(blob)) ++ " bytes)  abi=" ++ parsed.abi ++ "  apply=" ++ apply_text ++ "\n")
    if parsed.abi == "arm64-v8a" then
      print_sites(blob, arm64_sites(), parsed.abi, parsed.apply)
    else
      print_sites(blob, armv7_sites(), parsed.abi, parsed.apply)
    end
    if not parsed.apply then
      print("[i] verify-only (pass --apply to write patched copy)")
    else
      add_needed(blob, parsed.needed)
      finish_output(blob, output_path(parsed), parsed.needed)
    end
  end
end
