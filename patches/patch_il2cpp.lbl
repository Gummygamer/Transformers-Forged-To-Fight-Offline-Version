    Site { offset: 15782864, patch: bytes_concat(bytes_from_hex("00008052"), bytes_from_hex("c0035fd6")), name: "LevelLockManager.IsLocked -> false (every lock ID reports unlocked)" }, -- 0xF0D3D0
