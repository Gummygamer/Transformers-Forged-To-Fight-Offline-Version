/Transformers *
/build/

# Native libraries and APKs are local build/input artifacts. Regenerate native
# hooks from source and obtain the base APK from an entitled copy of the game.
*.so
*.apk

# Backups of built native libraries (for example libdothook.so.pre-pr-backup).
*.so.*

# Local media captures (including screenshots and recordings) must never be committed.
/media/

# Local demo captures (screen recordings of the running game contain copyrighted
# game audiovisual content and must stay local -- see COMPLIANCE.md "never add game
# assets or binaries to this repository").
/probe/

# Local debugging scratch space: session logs, screenshots, wire captures, payload
# binaries, and device pulls. Nothing here is an input to any build or test.
/.scratch/

# Generated IL2CPP metadata dump. Regenerate locally from an entitled copy of
# the 9.2 APK; do not commit it.
/re_notes/dump.cs

# Symlinks into /build/dumps, which is itself ignored; the dump they point at is
# generated locally from an entitled copy of the APK.
/il2cpp_out/

# Generated local-server artifacts; certificates and request logs can contain
# private keys and session data and must remain local.
/Server/__pycache__/
/patches/__pycache__/
/Server/certs/
/Server/logs/

# Local ffmpeg two-pass encoding artifacts.
/ffmpeg2pass-*.log
/ffmpeg2pass-*.log.mbtree
.longtask/

# Compiled netrelay and its test binaries; rebuild them with tools/netrelay/run_tests.sh.
/tools/netrelay/netrelay
/tools/netrelay/test_netclient
/tools/netrelay/test_arena
/tools/netrelay/test_arena_defaults
