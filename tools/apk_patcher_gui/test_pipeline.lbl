use pipeline

record Fixture
  root: text
  request: BuildRequest
  patched: text
  pristine: text
end

record Counts
  passed: integer
  failed: integer
end

function report(name: text, passed: boolean): Counts
  intent: test
  if passed then
    print("[ok] " ++ name)
    Counts { passed: 1, failed: 0 }
  else
    print("[!] " ++ name)
    Counts { passed: 0, failed: 1 }
  end
end

function make_elf(path: text, machine: integer): nothing
  intent: create
  let data: integer = bytes_new(64)
  bytes_set(data, 0, 127)
  bytes_set(data, 1, 69)
  bytes_set(data, 2, 76)
  bytes_set(data, 3, 70)
  bytes_set(data, 5, 1)
  bytes_set(data, 18, machine % 256)
  bytes_set(data, 19, floor(machine / 256))
  write_file_bytes(path, data)
  bytes_free(data)
end

function fixture(): Fixture
  intent: create pipeline fixtures
  let root: text = path_join(path_join(pipeline.project_root(), "build"), ".test-apk-patcher-pipeline")
  if not is_dir(root) then create_dir(root) end
  let source: text = path_join(root, "source with spaces.apk")
  let destination: text = path_join(root, "patched.apk")
  let keystore: text = path_join(root, "debug.keystore")
  let pristine: text = path_join(root, "libil2cpp-pristine.so")
  let patched: text = path_join(root, "libil2cpp-patched.so")
  write_file(source, "source")
  write_file(keystore, "key")
  write_file(pristine, "pristine")
  write_file(patched, "patched")
  Fixture {
    root: root,
    patched: patched,
    pristine: pristine,
    request: BuildRequest {
      source_apk: source, dest_apk: destination, abi: pipeline.arm64(),
      server_mode: pipeline.bundled(), server_host: "127.0.0.1", server_port: 8080,
      scheme: "http", keep_other_abi: false, patched_il2cpp: "", auto_patch_il2cpp: false,
      il2cpp_source: pristine, keystore: keystore, ks_pass: "android", key_pass: "android",
      do_install: false, rebuild_hook: false, legible: "legible", zipalign: "zipalign", apksigner: "apksigner",
      java: "/jdk/bin/java", adb: "adb", device_serial: "", clang: "ndk-clang"
    }
  }
end

function native_hook_command_test(fix: Fixture): boolean
  intent: test native hook rebuild command and ordering
  let request: BuildRequest = fix.request with { rebuild_hook: true }
  let command: a list of text = pipeline.build_hook_command(request)
  let steps: a list of Step = pipeline.plan_steps(request)
  let nativehook: text = path_join(path_join(pipeline.project_root(), "tools"), "nativehook")
  length(command) == 10 and unwrap_or(get(command, 0), "") == request.clang and contains(command, "-Wl,-soname,libdothook.so") and contains(command, pipeline.native_hook_output(pipeline.arm64())) and contains(command, path_join(nativehook, "hook.c")) and contains(command, path_join(nativehook, "inapk_server.c")) and netcode_in_arm64(command, nativehook) and length(steps) == 6 and unwrap(get(steps, 0)).name == "build native hook" and unwrap(get(steps, 1)).name == "build APK"
end

-- The realtime Arena netcode is experimental and opt-in; production hook commands do not
-- link it, so ordinary login/offline APKs stay independent of its native transport.
function netcode_in_arm64(command: a list of text, nativehook: text): boolean
  intent: test that production commands do not compile Arena sources
  not contains(command, path_join(nativehook, "arena.c")) and not contains(command, path_join(nativehook, "netclient.c"))
end

function armv7_hook_command_test(fix: Fixture): boolean
  intent: test that the armeabi-v7a hook command omits the experimental netcode
  let request: BuildRequest = fix.request with { rebuild_hook: true, abi: "armeabi-v7a" }
  let command: a list of text = pipeline.build_hook_command(request)
  let nativehook: text = path_join(path_join(pipeline.project_root(), "tools"), "nativehook")
  length(command) == 10 and contains(command, path_join(nativehook, "hook_arm32.c")) and netcode_in_arm64(command, nativehook) and contains(command, pipeline.native_hook_output("armeabi-v7a"))
end

-- Every device step must name its target. adb aborts with "more than one device/emulator"
-- when two are attached and no -s is given, which is what made the install step fail nine
-- tenths of the way through an otherwise successful build. An empty serial keeps today's
-- behaviour of letting adb choose, so the selector is only emitted when there is one.
function adb_device_serial_test(fix: Fixture): boolean
  intent: test that a chosen serial selects the device for install and verify
  let request: BuildRequest = fix.request with { device_serial: "emulator-5554" }
  let install: a list of text = pipeline.adb_install_command(request)
  let verify: a list of text = pipeline.adb_verify_install_command(request)
  let arguments: a list of text = pipeline.adb_device_arguments(request)
  length(arguments) == 2 and unwrap_or(get(arguments, 0), "") == "-s" and unwrap_or(get(arguments, 1), "") == "emulator-5554" and unwrap_or(get(install, 0), "") == request.adb and unwrap_or(get(install, 1), "") == "-s" and unwrap_or(get(install, 2), "") == "emulator-5554" and unwrap_or(get(install, 3), "") == "install" and contains(install, "-r") and contains(install, "--no-incremental") and contains(install, "--abi") and contains(install, request.abi) and contains(install, request.dest_apk) and unwrap_or(get(verify, 0), "") == request.adb and unwrap_or(get(verify, 1), "") == "-s" and unwrap_or(get(verify, 2), "") == "emulator-5554" and contains(verify, "com.kabam.bigrobot")
end

function adb_no_serial_test(fix: Fixture): boolean
  intent: test that no serial leaves the selector out so adb picks the device itself
  let install: a list of text = pipeline.adb_install_command(fix.request)
  let verify: a list of text = pipeline.adb_verify_install_command(fix.request)
  length(pipeline.adb_device_arguments(fix.request)) == 0 and not contains(install, "-s") and not contains(verify, "-s") and unwrap_or(get(install, 1), "") == "install" and unwrap_or(get(verify, 1), "") == "shell"
end

-- A serial with surrounding whitespace would reach adb as "-s ' '" and fail, so the command
-- builders trim it rather than trust the caller.
function adb_serial_trimming_test(fix: Fixture): boolean
  intent: test that a padded serial is trimmed before it reaches adb
  let request: BuildRequest = fix.request with { device_serial: "  RX8R30BF6SZ  " }
  let arguments: a list of text = pipeline.adb_device_arguments(request)
  length(arguments) == 2 and unwrap_or(get(arguments, 1), "") == "RX8R30BF6SZ" and not contains(pipeline.adb_install_command(request), "  RX8R30BF6SZ  ")
end

-- A stand-in for adb, so the listing parser is driven by real `adb devices` output rather
-- than by a string assembled inside the test. write_file emits the TABs the parser splits on
-- literally, and the stub just cats them back -- the same bytes a two-device host prints.
function fake_adb(root: text, name: text, listing: text): text
  intent: write an executable stub adb that prints a fixed device listing
  let data: text = path_join(root, name ++ "-devices.txt")
  let stub: text = path_join(root, name ++ "-adb")
  write_file(data, listing)
  write_file(stub, "#!/bin/sh\ncat " ++ pipeline.shell_quote(data) ++ "\n")
  shell_exec("chmod +x " ++ pipeline.shell_quote(stub))
  stub
end

function adb_device_listing_test(fix: Fixture): boolean
  intent: test that only authorised devices are parsed out of an adb listing
  -- offline and unauthorized entries must not be offered as install targets: installing to
  -- them fails after the whole build has already run.
  let stub: text = fake_adb(fix.root, "mixed", "List of devices attached\nAAA\tdevice usb:1-1 product:x\nBBB\toffline\nCCC\tunauthorized\nDDD\tdevice\n")
  let serials: a list of text = pipeline.attached_device_serials(stub)
  length(serials) == 1 and unwrap_or(get(serials, 0), "") == "DDD" and pipeline.find_device_serial(stub) == "DDD"
end

function adb_two_devices_are_ambiguous_test(fix: Fixture): boolean
  intent: test that two attached devices resolve to no automatic choice
  let stub: text = fake_adb(fix.root, "two", "List of devices attached\nAAA\tdevice\nBBB\tdevice\n")
  let serials: a list of text = pipeline.attached_device_serials(stub)
  length(serials) == 2 and pipeline.find_device_serial(stub) == ""
end

function adb_no_devices_test(fix: Fixture): boolean
  intent: test that an empty listing resolves to no device
  let stub: text = fake_adb(fix.root, "none", "List of devices attached\n")
  length(pipeline.attached_device_serials(stub)) == 0 and pipeline.find_device_serial(stub) == ""
end

function adb_missing_tool_test(): boolean
  intent: test that a missing adb reports no devices instead of running anything
  length(pipeline.attached_device_serials("")) == 0 and pipeline.find_device_serial("") == ""
end

function adb_install_serial_warning_test(fix: Fixture): boolean
  intent: test that installing with no serial warns about an ambiguous device choice
  let chosen: BuildRequest = fix.request with { do_install: true, device_serial: "emulator-5554" }
  let ambiguous: BuildRequest = fix.request with { do_install: true, device_serial: "" }
  let not_installing: BuildRequest = fix.request with { do_install: false, device_serial: "" }
  length(pipeline.validate(chosen).warnings) == 0 and length(pipeline.validate(not_installing).warnings) == 0 and length(pipeline.validate(ambiguous).warnings) == 1 and contains_text(join(pipeline.validate(ambiguous).warnings, "\n"), "device serial")
end

function adb_serial_mapping_test(fix: Fixture): boolean
  intent: test that the browser can send a device serial
  let values: a mapping from text to text = {"source_apk": fix.request.source_apk, "dest_apk": fix.request.dest_apk, "device_serial": "emulator-5554"}
  pipeline.request_from_mapping(values).device_serial == "emulator-5554"
end

function native_hook_compiler_validation_test(fix: Fixture): boolean
  intent: validate
  let checked: Validation = pipeline.validate(fix.request with { rebuild_hook: true, clang: "" })
  contains_text(join(checked.errors, "\n"), "NDK clang")
end

function bundled_command_test(fix: Fixture): boolean
  intent: test bundled command
  let paths: IntermediatePaths = pipeline.intermediate_paths(fix.request)
  let command: a list of text = pipeline.build_apk_command(fix.request, paths.unsigned)
  unwrap_or(get(command, 0), "") == "legible" and unwrap_or(get(command, 2), "") == path_join(path_join(pipeline.project_root(), "Server"), "build_phone_apk.lbl") and unwrap_or(get(command, 3), "") == fix.request.source_apk and unwrap_or(get(command, 4), "") == paths.unsigned and contains(command, "--bundle-server") and not contains(command, "--patched-il2cpp")
end

function server_validation_test(fix: Fixture): boolean
  intent: test bundled server validation
  let invalid: BuildRequest = fix.request with { scheme: "https", server_host: "10.0.0.5" }
  let checked: Validation = pipeline.validate(invalid)
  length(checked.errors) == 2 and contains_text(join(checked.errors, "\n"), "only supports http") and contains_text(join(checked.errors, "\n"), "127.0.0.1")
end

function armv7_patch_test(fix: Fixture): boolean
  intent: test armv7 patch validation
  let missing: BuildRequest = fix.request with { abi: pipeline.armv7() }
  let errors: Validation = pipeline.validate(missing)
  let supplied: Validation = pipeline.validate(missing with { patched_il2cpp: fix.patched })
  let automatic: Validation = pipeline.validate(missing with { auto_patch_il2cpp: true })
  contains_text(join(errors.errors, "\n"), "TFTFHOOK") and length(supplied.errors) == 0 and length(automatic.errors) == 0
end

function command_order_test(fix: Fixture): boolean
  intent: test
  let full: BuildRequest = fix.request with { do_install: true }
  let steps: a list of Step = pipeline.plan_steps(full)
  length(steps) == 7 and unwrap(get(steps, 0)).name == "build APK" and unwrap(get(steps, 1)).name == "zipalign APK" and unwrap(get(steps, 2)).name == "sign APK" and unwrap(get(steps, 3)).name == "verify APK alignment" and unwrap(get(steps, 4)).name == "verify APK signature" and unwrap(get(steps, 5)).name == "install APK" and contains(unwrap(get(steps, 5)).argv, "--no-incremental") and unwrap(get(steps, 6)).name == "verify installed package" and contains(unwrap(get(steps, 6)).argv, "com.kabam.bigrobot")
end

function automatic_patch_command_test(fix: Fixture): boolean
  intent: test automatic patch command
  let armv7_steps: a list of Step = pipeline.plan_steps(fix.request with { abi: pipeline.armv7(), auto_patch_il2cpp: true })
  let armv7_command: a list of text = unwrap(get(armv7_steps, 0)).argv
  let arm64_steps: a list of Step = pipeline.plan_steps(fix.request with { abi: pipeline.arm64(), auto_patch_il2cpp: true })
  let arm64_command: a list of text = unwrap(get(arm64_steps, 0)).argv
  length(armv7_steps) == 6 and unwrap(get(armv7_steps, 0)).name == "patch il2cpp" and contains(armv7_command, "--needed") and contains(armv7_command, "inplace") and contains(armv7_command, "--apply") and unwrap(get(armv7_steps, 1)).name == "build APK" and unwrap(get(armv7_steps, 2)).name == "zipalign APK" and unwrap(get(armv7_steps, 3)).name == "sign APK" and unwrap(get(armv7_steps, 4)).name == "verify APK alignment" and unwrap(get(armv7_steps, 5)).name == "verify APK signature" and length(arm64_steps) == 6 and contains(arm64_command, "--needed") and contains(arm64_command, "byte") and not contains(arm64_command, "inplace")
end

function final_verification_command_test(fix: Fixture): boolean
  intent: test final verification commands
  let paths: IntermediatePaths = pipeline.intermediate_paths(fix.request)
  let alignment: a list of text = pipeline.verify_alignment_command(fix.request)
  let signature: a list of text = pipeline.verify_signature_command(fix.request)
  length(alignment) == 5 and unwrap_or(get(alignment, 0), "") == fix.request.zipalign and unwrap_or(get(alignment, 1), "") == "-c" and unwrap_or(get(alignment, 2), "") == "-p" and unwrap_or(get(alignment, 3), "") == "4" and unwrap_or(get(alignment, 4), "") == fix.request.dest_apk and not contains(alignment, paths.unsigned) and not contains(alignment, paths.aligned) and length(signature) == 4 and unwrap_or(get(signature, 0), "") == fix.request.apksigner and unwrap_or(get(signature, 1), "") == "verify" and unwrap_or(get(signature, 2), "") == "--verbose" and unwrap_or(get(signature, 3), "") == fix.request.dest_apk and not contains(signature, paths.unsigned) and not contains(signature, paths.aligned)
end

function final_steps_for(request: BuildRequest): boolean
  intent: test verification plan for one ABI and server mode
  let steps: a list of Step = pipeline.plan_steps(request)
  let alignment: Step = unwrap(get(steps, 3))
  let signature: Step = unwrap(get(steps, 4))
  length(steps) == 5 and alignment.name == "verify APK alignment" and unwrap_or(get(alignment.argv, 4), "") == request.dest_apk and signature.name == "verify APK signature" and unwrap_or(get(signature.argv, 3), "") == request.dest_apk and signature.java == request.java
end

function verification_abi_and_server_mode_test(fix: Fixture): boolean
  intent: test verification for every ABI and server mode
  let arm64_bundled: BuildRequest = fix.request with { abi: pipeline.arm64(), server_mode: pipeline.bundled() }
  let arm64_separate: BuildRequest = fix.request with { abi: pipeline.arm64(), server_mode: pipeline.separate() }
  let armv7_bundled: BuildRequest = fix.request with { abi: pipeline.armv7(), server_mode: pipeline.bundled() }
  let armv7_separate: BuildRequest = fix.request with { abi: pipeline.armv7(), server_mode: pipeline.separate() }
  final_steps_for(arm64_bundled) and final_steps_for(arm64_separate) and final_steps_for(armv7_bundled) and final_steps_for(armv7_separate)
end

function arm64_bundled_auto_patch_plan_test(fix: Fixture): boolean
  intent: test complete arm64 bundled auto-patch plan
  let request: BuildRequest = fix.request with { auto_patch_il2cpp: true, do_install: true }
  let steps: a list of Step = pipeline.plan_steps(request)
  let patch: Step = unwrap(get(steps, 0))
  let build: Step = unwrap(get(steps, 1))
  let signature: Step = unwrap(get(steps, 5))
  let install: Step = unwrap(get(steps, 6))
  length(steps) == 8 and patch.name == "patch il2cpp" and contains(patch.argv, "--needed") and contains(patch.argv, "byte") and build.name == "build APK" and contains(build.argv, "--bundle-server") and contains(build.argv, "--patched-il2cpp") and contains(build.argv, pipeline.auto_patch_output(request)) and unwrap(get(steps, 2)).name == "zipalign APK" and unwrap(get(steps, 3)).name == "sign APK" and unwrap(get(steps, 4)).name == "verify APK alignment" and signature.name == "verify APK signature" and signature.java == request.java and install.name == "install APK" and unwrap(get(steps, 7)).name == "verify installed package"
end

function elf_test(fix: Fixture): boolean
  intent: test ELF architecture detection
  let elf64: text = path_join(fix.root, "arm64.so")
  let elf7: text = path_join(fix.root, "armv7.so")
  make_elf(elf64, 183)
  make_elf(elf7, 40)
  pipeline.elf_abi(elf64) == pipeline.arm64() and pipeline.elf_abi(elf7) == pipeline.armv7() and pipeline.elf_abi(path_join(fix.root, "missing.so")) == ""
end

function elf_mismatch_test(fix: Fixture): boolean
  intent: test ELF mismatch validation
  let elf7: text = path_join(fix.root, "mismatch.so")
  make_elf(elf7, 40)
  let checked: Validation = pipeline.validate(fix.request with { patched_il2cpp: elf7 })
  contains_text(join(checked.errors, "\n"), "is armeabi-v7a") and contains_text(join(checked.errors, "\n"), "targets arm64-v8a")
end

function pristine_elf_mismatch_test(fix: Fixture): boolean
  intent: test pristine ELF mismatch validation
  let elf7: text = path_join(fix.root, "pristine-armv7.so")
  make_elf(elf7, 40)
  let checked: Validation = pipeline.validate(fix.request with { auto_patch_il2cpp: true, il2cpp_source: elf7 })
  contains_text(join(checked.errors, "\n"), "pristine libil2cpp.so source") and contains_text(join(checked.errors, "\n"), "is armeabi-v7a") and contains_text(join(checked.errors, "\n"), "targets arm64-v8a")
end

function automatic_apk_extraction_test(fix: Fixture): boolean
  intent: test fallback extraction when the optional pristine path is missing
  let missing: text = path_join(fix.root, "missing-pristine.so")
  let request: BuildRequest = fix.request with { auto_patch_il2cpp: true, il2cpp_source: missing }
  let checked: Validation = pipeline.validate(request)
  let steps: a list of Step = pipeline.plan_steps(request)
  let extract: Step = unwrap(get(steps, 0))
  let patch: Step = unwrap(get(steps, 1))
  length(checked.errors) == 0 and length(steps) == 7 and extract.name == "extract pristine il2cpp" and contains(extract.argv, request.source_apk) and contains(extract.argv, request.abi) and contains(extract.argv, pipeline.auto_patch_extracted_source(request)) and patch.name == "patch il2cpp" and contains(patch.argv, pipeline.auto_patch_extracted_source(request))
end

function defaults_test(): boolean
  intent: test
  let request: BuildRequest = pipeline.default_request()
  let home: text = unwrap_or(env_get("HOME"), unwrap_or(env_get("USERPROFILE"), ""))
  request.abi == pipeline.arm64() and request.rebuild_hook and request.patched_il2cpp == "" and request.il2cpp_source == pipeline.default_il2cpp_source(pipeline.arm64()) and request.keystore == path_join(path_join(home, ".android"), "debug.keystore") and contains(pipeline.sdk_roots(), path_join(path_join(home, "Android"), "Sdk"))
end

function mapping_test(fix: Fixture): boolean
  intent: test
  let values: a mapping from text to text = {"source_apk": fix.request.source_apk, "dest_apk": fix.request.dest_apk, "keep_other_abi": "true", "do_install": "false", "server_port": "8123"}
  let request: BuildRequest = pipeline.request_from_mapping(values)
  request.keep_other_abi and not request.do_install and request.server_port == 8123
end

function windows_directory_name_test(): boolean
  intent: test
  pipeline.directory_name("C:\\Users\\Acer\\Downloads\\revival\\patched.apk") == "C:\\Users\\Acer\\Downloads\\revival"
end

function windows_sdk_root_test(): boolean
  intent: test that the per-user LOCALAPPDATA Android SDK location is probed
  let local_app_data: text = unwrap_or(env_get("LOCALAPPDATA"), "")
  if local_app_data == "" then true else
    contains(pipeline.sdk_roots(), path_join(path_join(local_app_data, "Android"), "Sdk"))
  end
end

function windows_executable_variants_test(): boolean
  intent: test that Windows wrapper extensions are probed for build tools
  let variants: a list of text = pipeline.executable_name_variants("apksigner")
  contains(variants, "apksigner") and contains(variants, "apksigner.bat") and contains(variants, "apksigner.exe") and contains(variants, "apksigner.cmd")
end

function windows_native_path_test(): boolean
  intent: test MSYS drive path conversion for native process launchers
  pipeline.windows_native_path("/c/Users/Acer/My Project/legible.exe") == "c:\\Users\\Acer\\My Project\\legible.exe" and pipeline.windows_native_path("C:\\Tools\\legible.exe") == "C:\\Tools\\legible.exe" and pipeline.windows_native_path("legible") == "legible" and pipeline.windows_native_executable("/c/Users/Acer/.cargo/bin/legible") == "c:\\Users\\Acer\\.cargo\\bin\\legible.exe" and pipeline.windows_native_executable("/c/Tools/legible.exe") == "c:\\Tools\\legible.exe" and pipeline.windows_native_executable("C:\\Tools\\legible") == "C:\\Tools\\legible.exe" and pipeline.windows_native_executable("legible") == "legible"
end

function add(counts: Counts, result: Counts): Counts
  intent: add test counts
  Counts { passed: counts.passed + result.passed, failed: counts.failed + result.failed }
end

function main(): nothing
  intent: run pipeline tests
  let fix: Fixture = fixture()
  mutable counts: Counts = Counts { passed: 0, failed: 0 }
  set counts = add(counts, report("bundled build command", bundled_command_test(fix)))
  set counts = add(counts, report("native hook build command", native_hook_command_test(fix)))
  set counts = add(counts, report("armv7 hook omits the arm64-only netcode", armv7_hook_command_test(fix)))
  set counts = add(counts, report("native hook compiler validation", native_hook_compiler_validation_test(fix)))
  set counts = add(counts, report("adb install targets the chosen device", adb_device_serial_test(fix)))
  set counts = add(counts, report("adb without a serial lets adb choose", adb_no_serial_test(fix)))
  set counts = add(counts, report("adb serial is trimmed", adb_serial_trimming_test(fix)))
  set counts = add(counts, report("adb listing skips unauthorised devices", adb_device_listing_test(fix)))
  set counts = add(counts, report("two attached devices are ambiguous", adb_two_devices_are_ambiguous_test(fix)))
  set counts = add(counts, report("no attached devices resolve to none", adb_no_devices_test(fix)))
  set counts = add(counts, report("a missing adb reports no devices", adb_missing_tool_test()))
  set counts = add(counts, report("installing with no serial warns", adb_install_serial_warning_test(fix)))
  set counts = add(counts, report("browser sends a device serial", adb_serial_mapping_test(fix)))
  set counts = add(counts, report("bundled validation", server_validation_test(fix)))
  set counts = add(counts, report("armv7 patch requirement", armv7_patch_test(fix)))
  set counts = add(counts, report("pipeline command order", command_order_test(fix)))
  set counts = add(counts, report("automatic patch command", automatic_patch_command_test(fix)))
  set counts = add(counts, report("final verification commands", final_verification_command_test(fix)))
  set counts = add(counts, report("verification ABI and server modes", verification_abi_and_server_mode_test(fix)))
  set counts = add(counts, report("arm64 bundled auto-patch plan", arm64_bundled_auto_patch_plan_test(fix)))
  set counts = add(counts, report("ELF ABI detection", elf_test(fix)))
  set counts = add(counts, report("ELF mismatch validation", elf_mismatch_test(fix)))
  set counts = add(counts, report("pristine ELF mismatch validation", pristine_elf_mismatch_test(fix)))
  set counts = add(counts, report("automatic APK extraction fallback", automatic_apk_extraction_test(fix)))
  set counts = add(counts, report("user-specific defaults", defaults_test()))
  set counts = add(counts, report("browser mapping", mapping_test(fix)))
  set counts = add(counts, report("Windows directory names", windows_directory_name_test()))
  set counts = add(counts, report("Windows LOCALAPPDATA SDK root", windows_sdk_root_test()))
  set counts = add(counts, report("Windows executable variants", windows_executable_variants_test()))
  set counts = add(counts, report("Windows native executable paths", windows_native_path_test()))
  print(to_text(counts.passed) ++ " passed, " ++ to_text(counts.failed) ++ " failed")
  if counts.failed > 0 then exit_process(1) end
end

main()
