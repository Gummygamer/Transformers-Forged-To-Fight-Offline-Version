new file mode 100644
index 0000000..c300be4
--- /dev/null
+++ b/Cpp2IL.Core/ISIL/ManagedParameterBinding.cs
@@ -0,0 +1,27 @@
+using System.Collections.Generic;
+using Cpp2IL.Core.Model.Contexts;
+
+namespace Cpp2IL.Core.ISIL;
+
+/// <summary>
+/// Describes the native register(s) that supply one managed method parameter.
+/// Aggregate components retain their field path so IL generation can materialize
+/// the scalar native values from the original managed argument.
+/// </summary>
+public sealed class ManagedParameterBinding(int parameterIndex, TypeAnalysisContext parameterType,
+    Register parameterRegister, bool isAggregate)
+{
+    public int ParameterIndex { get; } = parameterIndex;
+    public TypeAnalysisContext ParameterType { get; } = parameterType;
+    public Register ParameterRegister { get; } = parameterRegister;
+    public bool IsAggregate { get; } = isAggregate;
+    public List<ManagedParameterComponent> Components { get; } = [];
+}
+
+public sealed class ManagedParameterComponent(Register register, TypeAnalysisContext componentType,
+    IReadOnlyList<FieldAnalysisContext> fieldPath)
+{
+    public Register Register { get; set; } = register;
+    public TypeAnalysisContext ComponentType { get; } = componentType;
+    public IReadOnlyList<FieldAnalysisContext> FieldPath { get; } = fieldPath;
+}
