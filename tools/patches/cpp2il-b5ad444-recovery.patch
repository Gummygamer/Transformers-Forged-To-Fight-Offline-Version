+        var integerRequired = (ctx.IsStatic ? 0 : 1) + 1; // this + MethodInfo
+        var floatingRequired = 0;
+        foreach (var parameter in ctx.Parameters)
+        {
+            if (hfas[parameter.ParameterIndex] is { } hfa)
+                floatingRequired += hfa.Count;
+            else if (integerAggregates[parameter.ParameterIndex] is { } aggregate)
+                integerRequired += aggregate.Count;
+            else if (IsFloatingPoint(parameter.ParameterType))
+                floatingRequired++;
+            else
+                integerRequired++;
+        }
+
+        // This patch handles register-resident aggregates. Keep the established
+        // mapping intact when a signature spills, rather than assigning only part
+        // of an aggregate to registers and corrupting all later arguments.
+        if (integerRequired > IntegerRegisters.Length || floatingRequired > FloatRegisters.Length)
+        {
+            bindings = [];
+            return ResolveForManaged(ctx);
+        }
+
+        var args = new List<IOperand>();
+        bindings = [];
+        var integer = 0;
+        var floating = 0;
+
+        Register NextInteger() => new(null, IntegerRegisters[integer++]);
+        Register NextFloat() => new(null, FloatRegisters[floating++]);
+
+        if (!ctx.IsStatic)
+            args.Add(NextInteger());
+
+        foreach (var parameter in ctx.Parameters)
+        {
+            var parameterIndex = parameter.ParameterIndex;
+            var components = hfas[parameterIndex] ?? integerAggregates[parameterIndex];
+            if (components == null)
+            {
+                args.Add(IsFloatingPoint(parameter.ParameterType)
+                    ? NextFloat()
+                    : NextInteger());
+                continue;
+            }
+
+            var logicalParameter = new Register(null, $"__managed_arg_{parameterIndex}");
+            args.Add(logicalParameter);
+            var binding = new ManagedParameterBinding(parameterIndex, parameter.ParameterType,
+                logicalParameter, isAggregate: true);
+            var isHfa = hfas[parameterIndex] != null;
+            foreach (var component in components)
+            {
+                var register = isHfa ? NextFloat() : NextInteger();
+                binding.Components.Add(new ManagedParameterComponent(register,
+                    component.ComponentType, component.FieldPath));
+            }
+            bindings.Add(binding);
+        }
