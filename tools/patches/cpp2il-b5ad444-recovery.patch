+            // At that point only the original argument registers remain in the
+            // call operands. Preserve their SSA versions and attach aggregate leaf
+            // bindings when every required component is already present.
+            var availableRegisters = call.Operands.Skip(ArgBase(call))
+                .OfType<LocalVariable>()
+                .GroupBy(local => local.Register.Name)
+                .ToDictionary(group => group.Key, group => group.First());
+            ResolveForManagedCall(resolved, out var specializedBindings);
+            var allComponentsAvailable = specializedBindings.Count > 0
+                && specializedBindings.SelectMany(binding => binding.Components)
+                    .All(component => availableRegisters.ContainsKey(component.Register.Name));
+            if (allComponentsAvailable)
+            {
+                foreach (var component in specializedBindings.SelectMany(binding => binding.Components))
+                    component.Register = availableRegisters[component.Register.Name].Register;
+
+                call.ManagedParameterBindings.Clear();
+                call.ManagedParameterBindings.AddRange(specializedBindings);
+                call.ManagedReturnBinding = ResolveManagedReturn(resolved);
+                return;
+            }
+
+            base.RemapRawArguments(call, resolved);
+            return;
+        }
+
+        var argBase = ArgBase(call);
+        var rawArguments = call.Operands.Skip(argBase).ToArray();
+        var rawByRegister = rawArguments
+            .Select(operand => (Operand: operand, Name: operand switch
+            {
+                Register register => register.Name,
+                LocalVariable { Register.Name: var name } => name,
+                _ => null
+            }))
+            .Where(item => item.Name != null)
+            .GroupBy(item => item.Name!)
+            .ToDictionary(group => group.Key, group => group.First().Operand);
+
+        var managedArguments = ResolveForManagedCall(resolved, out var bindings);
+        var remapped = new List<IOperand>(argBase + managedArguments.Length);
+        for (var i = 0; i < argBase; i++)
+            remapped.Add(call.Operands[i]);
+
+        foreach (var argument in managedArguments)
+        {
+            if (argument is Register register && rawByRegister.TryGetValue(register.Name, out var raw))
+                remapped.Add(raw);
+            else
+                remapped.Add(argument);
+        }
+
+        call.SetOperands(remapped);
+        call.ManagedParameterBindings.Clear();
+        call.ManagedParameterBindings.AddRange(bindings);
+        call.ManagedReturnBinding = ResolveManagedReturn(resolved);
+    }
+
+    /// <summary>
+    /// Resolve managed method-entry arguments while preserving one logical operand
+    /// per managed parameter. Register-resident HFAs use a synthetic whole-value
+    /// parameter operand; their scalar V-register live-ins are recorded separately
+    /// for the IL entry adapter. Outgoing calls continue to use ResolveForManaged
+    /// until aggregate call lowering is implemented.
+    /// </summary>
+    public IOperand[] ResolveForManagedEntry(MethodAnalysisContext ctx)
+    {
+        var hfas = ctx.Parameters.ToDictionary(parameter => parameter.ParameterIndex,
+            parameter => TryGetHfaComponents(parameter.ParameterType, out var components) ? components : null);
+
+        // This first slice only lowers HFAs that fit wholly in V0-V7. If any HFA
+        // spills, retain the existing resolver for the complete signature rather
+        // than partially applying an incompatible register map.
+        var nextFloat = 0;
+        foreach (var parameter in ctx.Parameters)
+        {
+            var hfa = hfas[parameter.ParameterIndex];
+            if (hfa != null)
+            {
+                if (nextFloat + hfa.Count > FloatRegisters.Length)
+                {
+                    ctx.ManagedParameterBindings = [];
+                    return ResolveForManaged(ctx);
+                }
+                nextFloat += hfa.Count;
+            }
+            else if (IsFloatingPoint(parameter.ParameterType) && nextFloat < FloatRegisters.Length)
+            {
+                nextFloat++;
+            }
+        }
+
+        var args = new List<IOperand>();
+        var bindings = new List<ManagedParameterBinding>();
+        var integer = 0;
+        var floating = 0;
+        var stack = 0;
+
+        IOperand AddIntegerParameter()
+        {
+            if (integer < IntegerRegisters.Length)
+                return new Register(null, IntegerRegisters[integer++]);
+
+            var result = new StackOffset(stack);
+            stack += PtrSize;
+            return result;
+        }
+
+        IOperand AddScalarParameter(ParameterAnalysisContext parameter)
+        {
+            if (IsFloatingPoint(parameter))
+            {
+                if (floating < FloatRegisters.Length)
+                    return new Register(null, FloatRegisters[floating++]);
+            }
+            else if (integer < IntegerRegisters.Length)
+            {
+                return new Register(null, IntegerRegisters[integer++]);
+            }
+
+            var result = new StackOffset(stack);
+            stack += PtrSize;
+            return result;
+        }
+
+        if (!ctx.IsStatic)
+            args.Add(AddIntegerParameter());
+
+        foreach (var parameter in ctx.Parameters)
+        {
+            if (hfas[parameter.ParameterIndex] is { } components)
+            {
+                var logicalParameter = new Register(null, $"__managed_arg_{parameter.ParameterIndex}");
+                args.Add(logicalParameter);
+
+                var binding = new ManagedParameterBinding(parameter.ParameterIndex,
+                    parameter.ParameterType, logicalParameter, isAggregate: true);
+                foreach (var component in components)
+                {
+                    var register = new Register(null, FloatRegisters[floating++]);
+                    binding.Components.Add(new ManagedParameterComponent(register,
+                        component.ComponentType, component.FieldPath));
+                }
+                bindings.Add(binding);
+            }
+            else
+            {
+                var nativeParameter = AddScalarParameter(parameter);
+                args.Add(nativeParameter);
+            }
+        }
+
+        args.Add(AddIntegerParameter()); // The MethodInfo argument.
+        ctx.ManagedParameterBindings = bindings;
+        return args.ToArray();
+    }
+
+    private static bool TryGetHfaComponents(TypeAnalysisContext type, out List<HfaComponentLayout> components)
+    {
+        components = [];
+        if (!type.IsValueType || type.IsEnumType || IsFloatingPoint(type))
+            return false;
+
+        var visiting = new HashSet<TypeAnalysisContext>();
+        var flattened = FlattenHfa(type, [], visiting);
+        if (flattened == null || flattened.Count is < 1 or > 4)
+            return false;
+
+        var elementType = flattened[0].ComponentType;
+        if (flattened.Any(component => component.ComponentType != elementType))
+            return false;
+
+        components = flattened;
+        return true;
+    }
+
+    private static bool TryGetIntegerAggregateComponents(TypeAnalysisContext type,
+        out List<HfaComponentLayout> components)
+    {
+        components = [];
+        if (!type.IsValueType || type.IsEnumType || IsFloatingPoint(type)
+            || type.Fields.Count == 0 || TypeSizes.UnboxedSize(type, PtrSize) is not (>= 1 and <= 16))
+            return false;
+
+        var definition = type is GenericInstanceTypeAnalysisContext generic ? generic.GenericType : type;
+        if ((definition.Attributes & TypeAttributes.LayoutMask) == TypeAttributes.ExplicitLayout)
+            return false;
+
+        var size = TypeSizes.UnboxedSize(type, PtrSize);
+        if (type.Fields.All(field => field.Offset < 0))
+        {
+            // Some Unity metadata omits field offsets even for sequential-layout
+            // structs. Recover only the no-padding case: every field is a direct
+            // pointer-sized reference and the known value size matches the field
+            // count exactly. This covers QueuedState without guessing at packing.
+            var sequentialFields = type is GenericInstanceTypeAnalysisContext sequentialGeneric
+                ? sequentialGeneric.GenericType.Fields
+                    .Select(field => (Field: (FieldAnalysisContext)field.MakeConcreteGenericField(sequentialGeneric.GenericArguments),
+                        Type: GenericInstantiation.Instantiate(field.FieldType, sequentialGeneric.GenericArguments, [])))
+                    .ToList()
+                : type.Fields.Select(field => (Field: field, Type: field.FieldType)).ToList();
+            sequentialFields = sequentialFields.Where(field => !field.Field.IsStatic
+                    && !field.Field.Attributes.HasFlag(FieldAttributes.Literal))
+                .ToList();
+            if ((definition.Attributes & TypeAttributes.LayoutMask) != TypeAttributes.SequentialLayout
+                || sequentialFields.Count == 0
+                || sequentialFields.Any(field => field.Type.IsValueType
+                    || TypeSizes.UnboxedSize(field.Type, PtrSize) is not (0 or PtrSize))
+                || size != sequentialFields.Count * PtrSize)
+                return false;
+
+            components = sequentialFields.Select(field => new HfaComponentLayout(field.Type,
+                new FieldAnalysisContext[] { field.Field })).ToList();
+            return true;
+        }
+
+        var slotCount = (size + PtrSize - 1) / PtrSize;
+        var flattened = FlattenIntegerAggregate(type, [], 0, new HashSet<TypeAnalysisContext>());
+        if (flattened == null || flattened.Count != slotCount
+            || flattened.Select(item => item.Offset / PtrSize).Distinct().Count() != slotCount
+            || flattened.Any(item => item.Offset % PtrSize != 0))
+            return false;
+
+        components = flattened.OrderBy(item => item.Offset).Select(item => item.Component).ToList();
+        return true;
+    }
+
+    private static List<(int Offset, HfaComponentLayout Component)>? FlattenIntegerAggregate(
+        TypeAnalysisContext type, List<FieldAnalysisContext> prefix, int baseOffset,
+        HashSet<TypeAnalysisContext> visiting)
+    {
+        var definition = type is GenericInstanceTypeAnalysisContext generic ? generic.GenericType : type;
+        var fields = type is GenericInstanceTypeAnalysisContext genericType
+            ? genericType.GenericType.Fields
+                .Select(field => (Field: (FieldAnalysisContext)field.MakeConcreteGenericField(genericType.GenericArguments),
+                    Type: GenericInstantiation.Instantiate(field.FieldType, genericType.GenericArguments, [])))
+                .ToList()
+            : type.Fields.Select(field => (Field: field, Type: field.FieldType)).ToList();
+        fields = fields.Where(field => !field.Field.IsStatic
+                && !field.Field.Attributes.HasFlag(FieldAttributes.Literal))
+            .OrderBy(field => field.Field.Offset).ToList();
+
+        if (!type.IsValueType || type.IsEnumType || fields.Count == 0)
+        {
+            // Managed references occupy one native pointer even when this
+            // metadata helper reports no unboxed size for the referenced class.
+            var leafSize = type.IsValueType ? TypeSizes.UnboxedSize(type, PtrSize) : PtrSize;
+            if (leafSize is < 1 or > PtrSize || baseOffset % PtrSize != 0)
+                return null;
+            return [(baseOffset, new HfaComponentLayout(type, prefix.ToArray()))];
+        }
+
+        if (!visiting.Add(type))
+            return null;
+
+        try
+        {
+            if ((definition.Attributes & TypeAttributes.LayoutMask) == TypeAttributes.ExplicitLayout
+                || fields.Any(field => field.Field.Offset < 0))
+                return null;
+
+            var result = new List<(int Offset, HfaComponentLayout Component)>();
+            foreach (var (field, fieldType) in fields)
+            {
+                var fieldPath = new List<FieldAnalysisContext>(prefix) { field };
+                var nested = FlattenIntegerAggregate(fieldType, fieldPath,
+                    baseOffset + field.Offset, visiting);
+                if (nested == null)
+                    return null;
+                result.AddRange(nested);
+            }
+            return result;
+        }
+        finally
+        {
+            visiting.Remove(type);
+        }
+    }
+
+    private static List<HfaComponentLayout>? FlattenHfa(TypeAnalysisContext type,
+        List<FieldAnalysisContext> prefix, HashSet<TypeAnalysisContext> visiting)
+    {
+        if (IsFloatingPoint(type))
+            return [new HfaComponentLayout(type, prefix.ToArray())];
+
+        if (!type.IsValueType || type.IsEnumType || !visiting.Add(type))
+            return null;
+
+        try
+        {
+            var definition = type is GenericInstanceTypeAnalysisContext generic ? generic.GenericType : type;
+            if ((definition.Attributes & TypeAttributes.LayoutMask) == TypeAttributes.ExplicitLayout)
+                return null;
+
+            var fields = type is GenericInstanceTypeAnalysisContext genericType
+                ? genericType.GenericType.Fields
+                    .Select(field => (Field: (FieldAnalysisContext)field.MakeConcreteGenericField(genericType.GenericArguments),
+                        Type: GenericInstantiation.Instantiate(field.FieldType, genericType.GenericArguments, [])))
+                    .ToList()
+                : type.Fields.Select(field => (Field: field, Type: field.FieldType)).ToList();
+
+            fields = fields.Where(field => !field.Field.IsStatic
+                    && !field.Field.Attributes.HasFlag(FieldAttributes.Literal))
+                .ToList();
+            if (fields.Count == 0)
+                return null;
+
+            if (fields.Any(field => field.Field.Offset < 0))
+            {
+                if ((definition.Attributes & TypeAttributes.LayoutMask) != TypeAttributes.SequentialLayout
+                    || fields.Any(field => field.Field.Offset >= 0))
+                    return null;
+            }
+            else
+            {
+                fields = fields.OrderBy(field => field.Field.Offset).ToList();
+            }
+
+            var result = new List<HfaComponentLayout>();
+            foreach (var (field, fieldType) in fields)
+            {
+                var nestedPrefix = new List<FieldAnalysisContext>(prefix) { field };
+                var nested = FlattenHfa(fieldType, nestedPrefix, visiting);
+                if (nested == null)
+                    return null;
+                result.AddRange(nested);
+                if (result.Count > 4)
+                    return null;
+            }
+
+            return result;
+        }
+        finally
+        {
+            visiting.Remove(type);
+        }
+    }
+
+    private sealed record HfaComponentLayout(TypeAnalysisContext ComponentType,
+        IReadOnlyList<FieldAnalysisContext> FieldPath);
