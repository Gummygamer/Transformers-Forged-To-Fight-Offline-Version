.gradle/
build/
app/build/
app/src/main/assets/*.bin
/.scratch/
*.keystore
*.jks

# Release signing material. The keystore itself lives outside the repository;
# this file only holds its path and passwords, and must never be committed --
# losing it means users cannot upgrade in place over an existing install.
keystore.properties
*.pkcs12
*.p12

# Machine-local Android SDK path, written by the Gradle plugin. Each developer
# points this at their own SDK install; see BUILD.md for the SDK requirements.
local.properties
